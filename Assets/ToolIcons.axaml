<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      One glyph per tool, shared by both shells (desktop tab rail + mobile drawer).

      Each is an outline geometry drawn in a 24x24 box and *stroked* rather than filled, so a single
      set reads correctly on any background and its colour can follow the row/tab state. Consumers
      style them via `Path.ico` (see AppStyles) — a Path does not inherit Foreground the way a
      TextBlock does, so the colour has to be set through Stroke.
    -->
    <StreamGeometry x:Key="IcoPing">M4.5 11 a10.6 10.6 0 0 1 15 0 M7.5 14 a6.4 6.4 0 0 1 9 0 M10.5 17 a2.2 2.2 0 0 1 3 0</StreamGeometry>
    <StreamGeometry x:Key="IcoDns">M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 Z M3 12 H21 M12 3 A5.5 9 0 0 0 12 21 M12 3 A5.5 9 0 0 1 12 21</StreamGeometry>
    <StreamGeometry x:Key="IcoScanner">M11 4 A7 7 0 1 0 11 18 A7 7 0 1 0 11 4 Z M16 16 L21 21</StreamGeometry>
    <StreamGeometry x:Key="IcoNetwork">M9.5 3 h5 v4 h-5 Z M2.5 17 h5 v4 h-5 Z M16.5 17 h5 v4 h-5 Z M12 7 v3.5 M5 17 v-2.5 h14 v2.5 M12 10.5 v4</StreamGeometry>
    <StreamGeometry x:Key="IcoProxy">M3 8.5 H17 M14 5.5 L17 8.5 L14 11.5 M21 15.5 H7 M10 12.5 L7 15.5 L10 18.5</StreamGeometry>
    <StreamGeometry x:Key="IcoWebServer">M3.5 4.5 h17 v5 h-17 Z M3.5 14.5 h17 v5 h-17 Z M6.5 7 m-0.8 0 a0.8 0.8 0 1 0 1.6 0 a0.8 0.8 0 1 0 -1.6 0 M6.5 17 m-0.8 0 a0.8 0.8 0 1 0 1.6 0 a0.8 0.8 0 1 0 -1.6 0</StreamGeometry>
    <StreamGeometry x:Key="IcoIpInfo">M12 21 C12 21 18.5 14.4 18.5 10 A6.5 6.5 0 1 0 5.5 10 C5.5 14.4 12 21 12 21 Z M12 12.5 A2.5 2.5 0 1 0 12 7.5 A2.5 2.5 0 1 0 12 12.5</StreamGeometry>
    <StreamGeometry x:Key="IcoCheckHost">M10 3 A7 7 0 1 0 10 17 A7 7 0 1 0 10 3 Z M3 10 H17 M10 3 A4.4 7 0 0 0 10 17 M10 3 A4.4 7 0 0 1 10 17 M14.5 18.5 l2.2 2.2 L21.5 16</StreamGeometry>
    <StreamGeometry x:Key="IcoCurl">M3 5 h18 v14 h-18 Z M3 9 h18 M7 12.5 l2 2 l-2 2 M12.5 16.5 h5</StreamGeometry>
    <StreamGeometry x:Key="IcoTelegram">M21.5 3.5 L2.5 11 l7 2.5 l2.5 7 Z M9.5 13.5 L21.5 3.5</StreamGeometry>
    <StreamGeometry x:Key="IcoMonitor">M2.5 12 H7 L9.5 6.5 L13 17.5 L15.5 12 H21.5</StreamGeometry>
    <StreamGeometry x:Key="IcoCloudflare">M18.5 18 H7 A4.5 4.5 0 1 1 7.6 9 A5.5 5.5 0 0 1 18 11.2 A3.4 3.4 0 0 1 18.5 18 Z</StreamGeometry>
    <StreamGeometry x:Key="IcoSsh">M4 6.5 l4.5 5 l-4.5 5 M12.5 17 h7.5</StreamGeometry>
    <StreamGeometry x:Key="IcoStringLab">M9 6.5 L3.5 12 L9 17.5 M15 6.5 L20.5 12 L15 17.5</StreamGeometry>
    <StreamGeometry x:Key="IcoNotes">M6 3 h8 l4 4 v14 h-12 Z M14 3 v4 h4 M8.5 12 h7 M8.5 16 h7</StreamGeometry>
    <StreamGeometry x:Key="IcoBackup">M3.5 4.5 h17 v4 h-17 Z M5 8.5 v11 h14 v-11 M12 11 v5 M9.5 13.5 L12 16 l2.5 -2.5</StreamGeometry>
    <StreamGeometry x:Key="IcoHistory">M12 3 A9 9 0 1 1 3.6 15 M3 4 v5 h5 M12 7.5 V12.5 L15.5 14.5</StreamGeometry>
    <StreamGeometry x:Key="IcoAbout">M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 Z M12 11 V16.5 M12 7.3 V8.8</StreamGeometry>
</ResourceDictionary>
