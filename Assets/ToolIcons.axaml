    <!-- socket tool: a plug -->
    <StreamGeometry x:Key="IcoSocket">M9 3 v4 M15 3 v4 M6.5 7 h11 v4 a5.5 5.5 0 0 1 -11 0 Z M12 16.5 V21</StreamGeometry>
    <!-- (the light / dark switch's sun / moon is IcoThemeToggle in Styles/Tokens.axaml: a per-theme resource) -->

    <!--
      Glyphs of the page header's tabs (Views/Controls/PageTabStrip picks one per tab title), on the same 24x24 grid,
      stroked. Tabs named like a tool use that tool's glyph above.
    -->
