<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (Android 8/API 26+). The foreground is the full 108dp layer with the circular
     logo baked in at 68dp (icon_fg.png) — comfortably inside the 72dp mask viewport, so no launcher
     mask (circle / squircle / rounded square) clips the logo's rim. The background is the solid
     dark plate that matches the logo's interior. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/icon_background"/>
    <foreground android:drawable="@mipmap/icon_fg"/>
</adaptive-icon>
