<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (targetSdk 31+): allowBackup="false" only stops CLOUD backup; device-to-device transfer
     (setting up a new phone) still copies app data unless it is excluded here. The profile holds plaintext
     proxy passwords next to the encrypted vaults, so nothing leaves the device.  Referenced from AndroidManifest.xml. -->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
  </cloud-backup>
  <device-transfer>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
  </device-transfer>
</data-extraction-rules>
