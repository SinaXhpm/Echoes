<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Avalonia.Android 12.x ships only for net10.0-android; the desktop head stays net8.0. -->
    <TargetFramework>net10.0-android</TargetFramework>
    <!-- Avalonia 12's androidx.lifecycle dependency requires API 23+. -->
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Keep the assembly name "Echoes" so existing avares://Echoes/... URIs resolve. -->
    <AssemblyName>Echoes</AssemblyName>
    <RootNamespace>Echoes.Android</RootNamespace>

    <ApplicationId>com.sinaxhpm.echoes</ApplicationId>
    <ApplicationVersion>6</ApplicationVersion>
    <ApplicationDisplayVersion>0.3.1</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- Ship only real-device ABIs; x86/x86_64 are emulator-only and roughly double the native payload. -->
    <RuntimeIdentifiers>android-arm64;android-arm</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.2" />
    <PackageReference Include="Avalonia.Android" Version="12.0.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.2" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.0.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="DnsClient" Version="1.8.0" />
    <PackageReference Include="SSH.NET" Version="2025.1.0" />
  </ItemGroup>

  <!-- Shared source from the desktop project (Program.cs / app.manifest are desktop-only and excluded). -->
  <ItemGroup>
    <Compile Include="..\App.axaml.cs" Link="App.axaml.cs" />
    <Compile Include="..\ViewLocator.cs" Link="ViewLocator.cs" />
    <Compile Include="..\ViewModels\**\*.cs" Link="ViewModels\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Views\**\*.cs" Link="Views\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Helpers\**\*.cs" Link="Helpers\%(RecursiveDir)%(Filename)%(Extension)" />

    <AvaloniaXaml Include="..\App.axaml" Link="App.axaml" />
    <AvaloniaXaml Include="..\Views\**\*.axaml" Link="Views\%(RecursiveDir)%(Filename)%(Extension)" />
    <AvaloniaXaml Include="..\Styles\**\*.axaml" Link="Styles\%(RecursiveDir)%(Filename)%(Extension)" />

    <AvaloniaResource Include="..\Assets\**" Link="Assets\%(RecursiveDir)%(Filename)%(Extension)" />
    <AvaloniaResource Remove="..\Assets\echoes.ico" />
  </ItemGroup>
</Project>
