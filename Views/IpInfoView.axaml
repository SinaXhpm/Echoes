<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Echoes.ViewModels"
             xmlns:ctl="using:Echoes.Views.Controls"
             xmlns:helpers="using:Echoes.Helpers"
             x:Class="Echoes.Views.IpInfoView"
             x:DataType="vm:IpInfoViewModel">

    <UserControl.Styles>
        <!-- ===== Lookup form. Wide: [target | source]. Narrow (phone): stacked. ===== -->
        <Style Selector="Grid#IpForm.wide > StackPanel#IpTarget">
            <Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="1"/>
        </Style>
        <Style Selector="Grid#IpForm.narrow > StackPanel#IpTarget">
            <Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
        <Style Selector="Grid#IpForm.wide > StackPanel#IpSource">
            <Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.Column" Value="1"/><Setter Property="Grid.ColumnSpan" Value="1"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style Selector="Grid#IpForm.narrow > StackPanel#IpSource">
            <Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="2"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>

        <!-- actions. Wide: [proxy toggle ...... My IP | Look up] under the inputs, proxy fields below.
             Narrow: toggle, proxy fields, then the two buttons as equal halves at the end of the form. -->
        <Style Selector="Grid#IpCard.wide > CheckBox#ProxyToggle">
            <Setter Property="Grid.ColumnSpan" Value="1"/>
        </Style>
        <Style Selector="Grid#IpCard.narrow > CheckBox#ProxyToggle">
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
        <Style Selector="Grid#IpCard.wide > Grid#IpButtons">
            <Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="1"/><Setter Property="Grid.ColumnSpan" Value="1"/>
            <Setter Property="Margin" Value="12,12,0,0"/>
        </Style>
        <Style Selector="Grid#IpCard.narrow > Grid#IpButtons">
            <Setter Property="Grid.Row" Value="3"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="2"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>

        <!-- proxy fields (same pattern as Check Host). Wide: [address | user | password]. Narrow: address first. -->
        <Style Selector="Grid#IpProxy.wide > StackPanel#IpProxyUser">
            <Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.Column" Value="1"/><Setter Property="Grid.ColumnSpan" Value="1"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style Selector="Grid#IpProxy.narrow > StackPanel#IpProxyUser">
            <Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="1"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>
        <Style Selector="Grid#IpProxy.wide > StackPanel#IpProxyPass">
            <Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.Column" Value="2"/><Setter Property="Grid.ColumnSpan" Value="1"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style Selector="Grid#IpProxy.narrow > StackPanel#IpProxyPass">
            <Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="1"/><Setter Property="Grid.ColumnSpan" Value="2"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>
        <Style Selector="Grid#IpProxy.wide > StackPanel#IpProxyAddr">
            <Setter Property="Grid.ColumnSpan" Value="1"/>
        </Style>
        <Style Selector="Grid#IpProxy.narrow > StackPanel#IpProxyAddr">
            <Setter Property="Grid.ColumnSpan" Value="3"/>
        </Style>

        <!-- ===== hero: map / copy beside the address when wide, under it when narrow ===== -->
        <Style Selector="Grid#IpHero.wide > StackPanel#IpHeroActions">
            <Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.Column" Value="2"/><Setter Property="Grid.ColumnSpan" Value="1"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
        </Style>
        <Style Selector="Grid#IpHero.narrow > StackPanel#IpHeroActions">
            <Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="1"/><Setter Property="Grid.ColumnSpan" Value="2"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>

        <!-- ===== per-provider cards: 3 columns when there is room, 2 on a narrow window, 1 on a phone ===== -->
        <Style Selector="ItemsControl#ProviderList.wide">
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" ColumnSpacing="12" RowSpacing="12"/>
                </ItemsPanelTemplate>
            </Setter>
        </Style>
        <Style Selector="StackPanel#IpResults.wide ItemsControl#ProviderList.narrow">
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2" ColumnSpacing="12" RowSpacing="12"/>
                </ItemsPanelTemplate>
            </Setter>
        </Style>
        <Style Selector="StackPanel#IpResults.narrow ItemsControl#ProviderList">
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <UniformGrid Columns="1" RowSpacing="12"/>
                </ItemsPanelTemplate>
            </Setter>
        </Style>

        <!-- key / value rows inside a provider card -->
        <Style Selector="TextBlock.k">
            <Setter Property="FontSize" Value="{StaticResource Font.Small}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
        </Style>
        <Style Selector="SelectableTextBlock.v">
            <Setter Property="FontSize" Value="{StaticResource Font.Small}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Styles>

    <TabControl Padding="0,12,0,0" SelectedIndex="{Binding TabIndex}">

        <!-- ============================ LOOKUP ============================ -->
        <TabItem Header="Lookup">
            <Grid RowDefinitions="Auto, *" RowSpacing="12">

                <!-- address + source, proxy toggle + actions, optional proxy settings. Rows are spaced with
                     margins, so a hidden / empty row adds no gap. -->
                <Border Grid.Row="0" Classes="card" Padding="12">
                    <Grid x:Name="IpCard" helpers:Responsive.BreakWidth="560"
                          ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto, Auto">
                        <Grid x:Name="IpForm" Grid.Row="0" Grid.ColumnSpan="2" helpers:Responsive.BreakWidth="560"
                              ColumnDefinitions="*, 220" RowDefinitions="Auto, Auto" ColumnSpacing="12">
                            <StackPanel x:Name="IpTarget">
                                <TextBlock Classes="fieldLabel" Text="IP or host"/>
                                <AutoCompleteBox x:Name="IpBox" Classes="field" helpers:InputAssist.SelectAllOnFocus="True" helpers:InputAssist.PasteMode="Ip" helpers:InputAssist.PasteButton="True" Text="{Binding TargetIp}" PlaceholderText="Empty for your own public IP"
                                                 ToolTip.Tip="An IP address or host name. Leave it empty to look up your own public IP."
                                                 AutomationProperties.Name="IP address or host"
                                                 FontFamily="{StaticResource MonoFont}"
                                                 ItemsSource="{Binding TargetHistory}" FilterMode="ContainsOrdinal" MinimumPrefixLength="0">
                                    <AutoCompleteBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding LookupIpCommand}"/>
                                    </AutoCompleteBox.KeyBindings>
                                </AutoCompleteBox>
                            </StackPanel>

                            <!-- provider selector (Auto = query & cross-check all sources) -->
                            <StackPanel x:Name="IpSource">
                                <TextBlock Classes="fieldLabel" Text="Source"/>
                                <ComboBox Classes="field" ItemsSource="{Binding Providers}" SelectedIndex="{Binding SelectedProviderIndex}"
                                          ToolTip.Tip="Auto queries several providers at once and merges the result; or pin a single provider."/>
                            </StackPanel>
                        </Grid>

                        <CheckBox Grid.Row="1" Grid.Column="0" IsChecked="{Binding UseProxy}" Name="ProxyToggle"
                                  Content="Use a proxy" VerticalAlignment="Center" Margin="0,12,0,0"
                                  ToolTip.Tip="Send the lookups through a proxy (useful if the providers are filtered on your network)"/>

                        <Grid x:Name="IpButtons" ColumnDefinitions="*, *" ColumnSpacing="8">
                            <Button Grid.Column="0" Classes="secondary" Command="{Binding GetMyIpCommand}" Content="My IP"
                                    MinWidth="96" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsWorking}"
                                    ToolTip.Tip="Look up your own public IP"/>
                            <Button Grid.Column="1" Classes="primary" Command="{Binding LookupIpCommand}" Content="Look up"
                                    MinWidth="96" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsWorking}"/>
                        </Grid>

                        <!-- proxy credentials -->
                        <Grid x:Name="IpProxy" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0"
                              helpers:Responsive.BreakWidth="520" IsVisible="{Binding UseProxy}"
                              ColumnDefinitions="2*, *, *" RowDefinitions="Auto, Auto" ColumnSpacing="8">
                            <StackPanel x:Name="IpProxyAddr" Grid.Column="0">
                                <TextBlock Classes="fieldLabel" Text="Address"/>
                                <AutoCompleteBox Classes="field" helpers:InputAssist.SelectAllOnFocus="True" Text="{Binding ProxyAddress}" TextInputOptions.ContentType="Url" PlaceholderText="host:port"
                                                 ToolTip.Tip="The proxy as host:port, e.g. 127.0.0.1:8080" AutomationProperties.Name="Proxy address"
                                                 FontFamily="{StaticResource MonoFont}"
                                                 ItemsSource="{Binding ProxyHistory}" FilterMode="ContainsOrdinal" MinimumPrefixLength="0"/>
                            </StackPanel>
                            <StackPanel x:Name="IpProxyUser">
                                <TextBlock Classes="fieldLabel" Text="User"/>
                                <TextBox Classes="field" Text="{Binding ProxyUser}" PlaceholderText="Optional"/>
                            </StackPanel>
                            <StackPanel x:Name="IpProxyPass">
                                <TextBlock Classes="fieldLabel" Text="Password"/>
                                <TextBox Classes="field" Text="{Binding ProxyPass}" PlaceholderText="Optional" IsUndoEnabled="False" PasswordChar="*"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ===== result ===== -->
                <Panel Grid.Row="1">

                    <!-- cards (shown once a source answers) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  IsVisible="{Binding Result, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <ctl:Deferred><DataTemplate x:DataType="vm:IpInfoViewModel">
                        <StackPanel x:Name="IpResults" helpers:Responsive.BreakWidth="560" Spacing="12">

                            <!-- hero: flag + IP + location, with map / copy -->
                            <Border Classes="card" Padding="12">
                                <Grid x:Name="IpHero" helpers:Responsive.BreakWidth="520"
                                      ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto, Auto">
                                    <Panel Grid.Column="0" Width="40" Height="24" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IcoDns}" Width="22" Height="22" Stretch="Uniform"
                                              Stroke="{DynamicResource Text.Muted}" StrokeThickness="1.5"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsVisible="{Binding !Result.HasFlag}"/>
                                        <Border CornerRadius="4" ClipToBounds="True" VerticalAlignment="Center"
                                                IsVisible="{Binding Result.HasFlag}">
                                            <Image Source="{Binding Result.CountryCode, Converter={x:Static helpers:CountryFlagConverter.Instance}}"
                                                   Stretch="Uniform"/>
                                        </Border>
                                    </Panel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <WrapPanel ItemSpacing="10" LineSpacing="4">
                                            <SelectableTextBlock Text="{Binding Result.Ip}" FontSize="20" FontWeight="Bold"
                                                                 Foreground="{DynamicResource Text.Primary}" FontFamily="{StaticResource MonoFont}"
                                                                 TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            <Border Classes="badge accent" VerticalAlignment="Center"
                                                    IsVisible="{Binding Result.HasVersion}">
                                                <TextBlock Text="{Binding Result.Version}"/>
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding Result.HeroLocation}" FontSize="{StaticResource Font.Body}"
                                                   Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel x:Name="IpHeroActions" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Classes="ghost" Command="{Binding OpenMapCommand}" Content="Open map"
                                                IsVisible="{Binding Result.HasCoordinates}"
                                                ToolTip.Tip="Show the location on OpenStreetMap"/>
                                        <Button Classes="ghost" Command="{Binding CopyResultCommand}" Content="Copy IP"
                                                ToolTip.Tip="Copy the IP address"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- per-provider breakdown: exactly what each source returned -->
                            <TextBlock Classes="fieldLabel" Text="By provider" Margin="2,4,0,0"/>
                            <ItemsControl x:Name="ProviderList" helpers:Responsive.BreakWidth="900"
                                          ItemsSource="{Binding ProviderResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:IpProviderResult">
                                        <Border Classes="card" Padding="14,12">
                                            <StackPanel Spacing="6">
                                                <TextBlock Classes="cardHeader" Margin="0,0,0,4" Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Grid ColumnDefinitions="76,*" IsVisible="{Binding Data.HeroLocation, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                    <TextBlock Grid.Column="0" Classes="k" Text="Location"/>
                                                    <SelectableTextBlock Grid.Column="1" Classes="v" Text="{Binding Data.HeroLocation}"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="76,*" IsVisible="{Binding Data.Isp, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                    <TextBlock Grid.Column="0" Classes="k" Text="ISP"/>
                                                    <SelectableTextBlock Grid.Column="1" Classes="v" Text="{Binding Data.Isp}"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="76,*" IsVisible="{Binding Data.Org, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                    <TextBlock Grid.Column="0" Classes="k" Text="Org"/>
                                                    <SelectableTextBlock Grid.Column="1" Classes="v" Text="{Binding Data.Org}"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="76,*" IsVisible="{Binding Data.Asn, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                    <TextBlock Grid.Column="0" Classes="k" Text="ASN"/>
                                                    <SelectableTextBlock Grid.Column="1" Classes="v" Text="{Binding Data.Asn}"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="76,*" IsVisible="{Binding Data.Hostname, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                    <TextBlock Grid.Column="0" Classes="k" Text="Host"/>
                                                    <SelectableTextBlock Grid.Column="1" Classes="v" Text="{Binding Data.Hostname}"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="76,*" IsVisible="{Binding Data.HasCoordinates}">
                                                    <TextBlock Grid.Column="0" Classes="k" Text="Coordinates"/>
                                                    <SelectableTextBlock Grid.Column="1" Classes="v" Text="{Binding Data.Coordinates}"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="76,*" IsVisible="{Binding Data.Timezone, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                    <TextBlock Grid.Column="0" Classes="k" Text="Time zone"/>
                                                    <SelectableTextBlock Grid.Column="1" Classes="v" Text="{Binding Data.Timezone}"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="76,*" IsVisible="{Binding Data.Postal, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                    <TextBlock Grid.Column="0" Classes="k" Text="Postal"/>
                                                    <SelectableTextBlock Grid.Column="1" Classes="v" Text="{Binding Data.Postal}"/>
                                                </Grid>
                                                <!-- proxy / hosting / mobile flags -->
                                                <Border Classes="badge warning" HorizontalAlignment="Left" Margin="0,4,0,0"
                                                        IsVisible="{Binding Data.HasSecurity}">
                                                    <TextBlock Text="{Binding Data.SecurityText}" TextWrapping="Wrap"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- sources / cross-check line -->
                            <TextBlock Text="{Binding StatusLine}" FontSize="{StaticResource Font.Small}" Foreground="{DynamicResource Text.Muted}"
                                       TextWrapping="Wrap" Margin="2,0,0,4"
                                       IsVisible="{Binding StatusLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                        </DataTemplate></ctl:Deferred>
                    </ScrollViewer>

                    <!-- empty / working / error state -->
                    <Border Classes="card output" IsVisible="{Binding Result, Converter={x:Static ObjectConverters.IsNull}}">
                        <Panel Margin="24">
                            <TextBlock Text="{Binding RawResult}" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource Text.Secondary}"
                                       FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                            <TextBlock Classes="muted" IsVisible="{Binding RawResult, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                                       Text="Enter an IP or host, or press My&#160;IP."
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="340"/>
                        </Panel>
                    </Border>
                </Panel>
            </Grid>
        </TabItem>

        <!-- ============================ SUBNET / CIDR ============================ -->
        <TabItem Header="Subnet / CIDR">
            <ctl:Deferred><DataTemplate x:DataType="vm:IpInfoViewModel">
            <Grid RowDefinitions="Auto, *" RowSpacing="12">
                <Border Grid.Row="0" Classes="card" Padding="12">
                    <StackPanel>
                        <TextBlock Classes="fieldLabel" Text="CIDR or IP"/>
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                            <TextBox Grid.Column="0" Classes="field" helpers:InputAssist.SelectAllOnFocus="True" Text="{Binding SubnetInput}" AcceptsReturn="False"
                                     ToolTip.Tip="A network in CIDR form (10.0.0.0/8) or a single IP address" AutomationProperties.Name="Network (CIDR) or IP address"
                                     PlaceholderText="192.168.1.0/24"
                                     FontFamily="{StaticResource MonoFont}">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding RunSubnetCommand}"/>
                                </TextBox.KeyBindings>
                            </TextBox>
                            <Button Grid.Column="1" Classes="primary" Command="{Binding RunSubnetCommand}" Content="Calculate"
                                    MinWidth="96"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Classes="card output">
                    <Grid RowDefinitions="Auto, Auto, *">
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="16,8,8,8" MinHeight="{DynamicResource Control.Height}">
                            <TextBlock Classes="cardHeader" Margin="0" Text="Subnet" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Classes="ghost" Command="{Binding CopySubnetCommand}" Content="Copy"
                                    IsVisible="{Binding SubnetOutput, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </Grid>
                        <Border Grid.Row="1" Classes="divider"/>
                        <Panel Grid.Row="2">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <SelectableTextBlock Text="{Binding SubnetOutput}"
                                                     FontFamily="{StaticResource MonoFont}"
                                                     FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource Text.Primary}"
                                                     Margin="16,12" LineHeight="22"/>
                            </ScrollViewer>
                            <TextBlock Classes="muted" IsHitTestVisible="False"
                                       IsVisible="{Binding SubnetOutput, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                                       Text="Enter a network, e.g. 10.0.0.0/8."
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="320" Margin="24"/>
                        </Panel>
                    </Grid>
                </Border>
            </Grid>
            </DataTemplate></ctl:Deferred>
        </TabItem>
    </TabControl>
</UserControl>
