<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Echoes.ViewModels"
             x:Class="Echoes.Views.DnsView"
             x:DataType="vm:DnsViewModel">

    <Grid RowDefinitions="Auto, *" Margin="15">
        <Grid Grid.Row="0" ColumnDefinitions="*, 178" Margin="0,0,0,12">

            <!-- Left: domain + record types + actions (kept short) -->
            <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Classes="fieldLabel" Text="TARGET DOMAIN"/>
                    <AutoCompleteBox Classes="field" Text="{Binding DomainName}" Watermark="example.com"
                             ItemsSource="{Binding DomainHistory}" FilterMode="ContainsOrdinal" MinimumPrefixLength="0">
                        <AutoCompleteBox.KeyBindings>
                            <KeyBinding Command="{Binding RunLookupCommand}" Gesture="Enter"/>
                        </AutoCompleteBox.KeyBindings>
                    </AutoCompleteBox>
                </StackPanel>

                <WrapPanel>
                    <WrapPanel.Styles>
                        <Style Selector="CheckBox">
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="MinWidth" Value="0"/>
                            <Setter Property="Margin" Value="0,0,6,3"/>
                            <Setter Property="Padding" Value="4,0,0,0"/>
                        </Style>
                    </WrapPanel.Styles>
                    <CheckBox IsChecked="{Binding TypeA}" Content="A"/>
                    <CheckBox IsChecked="{Binding TypeAAAA}" Content="AAAA"/>
                    <CheckBox IsChecked="{Binding TypeMX}" Content="MX"/>
                    <CheckBox IsChecked="{Binding TypeNS}" Content="NS"/>
                    <CheckBox IsChecked="{Binding TypeTXT}" Content="TXT"/>
                    <CheckBox IsChecked="{Binding TypeCNAME}" Content="CNAME"/>
                    <CheckBox IsChecked="{Binding TypeSOA}" Content="SOA"/>
                    <CheckBox IsChecked="{Binding TypeSRV}" Content="SRV"/>
                    <CheckBox IsChecked="{Binding TypeCAA}" Content="CAA"/>
                    <CheckBox IsChecked="{Binding TypePTR}" Content="PTR"/>
                </WrapPanel>

                <Grid ColumnDefinitions="*, *">
                    <Button Grid.Column="0" Classes="secondary" Command="{Binding RunWhoisCommand}" Content="WHOIS" Margin="0,0,5,0"
                            HorizontalAlignment="Stretch"/>
                    <Button Grid.Column="1" Classes="primary" Command="{Binding RunLookupCommand}" Content="LOOKUP" Margin="5,0,0,0"
                            HorizontalAlignment="Stretch"/>
                </Grid>
            </StackPanel>

            <!-- Right: resolvers — needs height, not width -->
            <Grid Grid.Column="1" RowDefinitions="Auto, *">
                <TextBlock Grid.Row="0" Classes="fieldLabel" Text="DNS RESOLVERS"/>
                <TextBox Grid.Row="1" Classes="field multiline" Text="{Binding DnsServersText}" AcceptsReturn="True" FontSize="11"
                         MinHeight="90" FontFamily="Cascadia Code,Consolas"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <Border Classes="card output">
                <TextBox Text="{Binding LogText}" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         FontFamily="Cascadia Code,Consolas" FontSize="12" Background="Transparent"
                         BorderThickness="0" Foreground="#00FF99" Padding="12"/>
            </Border>
            <Button Classes="ghost" Command="{Binding CopyResultCommand}" Content="COPY"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,18,0"
                    Height="26" FontSize="9" Padding="10,0"
                    IsVisible="{Binding LogText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </Grid>
    </Grid>
</UserControl>