<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Echoes.ViewModels"
             x:Class="Echoes.Views.DnsView"
             x:DataType="vm:DnsViewModel">

    <Grid RowDefinitions="140, *" Margin="15">
        <Grid Grid.Row="0" ColumnDefinitions="*, 240" Margin="0,0,0,15">
            <Grid Grid.Column="0" RowDefinitions="Auto, Auto, *" Margin="0,0,15,0">
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="TARGET DOMAIN" FontSize="10" FontWeight="Bold" Opacity="0.4" Margin="5,0,0,5"/>
                    <TextBox Text="{Binding DomainName}" Height="32" Watermark="example.com" 
                             VerticalContentAlignment="Center" Background="#10000000" BorderBrush="#30FFFFFF">
                        <TextBox.KeyBindings>
                            <KeyBinding Command="{Binding RunLookupCommand}" Gesture="Enter"/>
                        </TextBox.KeyBindings>
                    </TextBox>
                </StackPanel>

                <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,10">
                    <CheckBox IsChecked="{Binding TypeA}" Content="A" FontSize="10"/>
                    <CheckBox IsChecked="{Binding TypeAAAA}" Content="AAAA" FontSize="10"/>
                    <CheckBox IsChecked="{Binding TypeMX}" Content="MX" FontSize="10"/>
                    <CheckBox IsChecked="{Binding TypeNS}" Content="NS" FontSize="10"/>
                    <CheckBox IsChecked="{Binding TypeTXT}" Content="TXT" FontSize="10"/>
                    <CheckBox IsChecked="{Binding TypeCNAME}" Content="CN" FontSize="10"/>
                </UniformGrid>

                <Grid Grid.Row="2" ColumnDefinitions="*, *" VerticalAlignment="Bottom">
                    <Button Grid.Column="0" Command="{Binding RunWhoisCommand}" Content="WHOIS" Margin="0,0,5,0" Height="32" 
                            Background="#2E86C1" Foreground="White" FontSize="11" FontWeight="Bold" 
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button Grid.Column="1" Command="{Binding RunLookupCommand}" Content="LOOKUP" Margin="5,0,0,0" Height="32" 
                            Background="#42B883" Foreground="White" FontSize="11" FontWeight="Bold" 
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                </Grid>
            </Grid>

            <Grid Grid.Column="1" RowDefinitions="Auto, *">
                <TextBlock Grid.Row="0" Text="DNS RESOLVERS" FontSize="10" FontWeight="Bold" Opacity="0.4" Margin="5,0,0,5"/>
                <TextBox Grid.Row="1" Text="{Binding DnsServersText}" AcceptsReturn="True" FontSize="11" 
                         FontFamily="Cascadia Code,Consolas" Background="#10000000" BorderBrush="#30FFFFFF" 
                         Padding="8" VerticalAlignment="Stretch"/>
            </Grid>
        </Grid>

        <TextBox Grid.Row="1" Text="{Binding LogText}" IsReadOnly="True" AcceptsReturn="True" 
                 FontFamily="Cascadia Code,Consolas" FontSize="12" Background="#08000000" 
                 BorderBrush="#20FFFFFF" Padding="12" CornerRadius="4"/>
    </Grid>
</UserControl>