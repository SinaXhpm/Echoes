<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Echoes.ViewModels"
             xmlns:helpers="using:Echoes.Helpers"
             x:Class="Echoes.Views.DnsView"
             x:DataType="vm:DnsViewModel">

    <!-- Query controls grouped in one card (top), results fill the rest -->
    <Grid RowDefinitions="Auto, *" RowSpacing="10" Margin="15">

        <Border Grid.Row="0" Classes="card" Padding="12,9">
            <!-- Wide: query controls on the LEFT (flex to fill), the RESOLVERS box on the RIGHT.
                 Narrow (phone): RESOLVERS drops to its own row underneath, so the query column gets
                 the full card width instead of being squeezed to ~90px. -->
            <Grid helpers:Responsive.BreakWidth="430"
                  ColumnDefinitions="*, 210" RowDefinitions="Auto, Auto" ColumnSpacing="12" RowSpacing="8">
                <Grid.Styles>
                    <Style Selector="Grid.wide > StackPanel#DnsQuery">
                        <Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="1"/>
                    </Style>
                    <Style Selector="Grid.narrow > StackPanel#DnsQuery">
                        <Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="2"/>
                    </Style>
                    <Style Selector="Grid.wide > Grid#DnsResolvers">
                        <Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.Column" Value="1"/><Setter Property="Grid.ColumnSpan" Value="1"/>
                    </Style>
                    <Style Selector="Grid.narrow > Grid#DnsResolvers">
                        <Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="2"/>
                    </Style>
                    <!-- stretched by the query column when wide; needs its own height once stacked -->
                    <Style Selector="Grid.narrow TextBox#DnsResolverBox">
                        <Setter Property="Height" Value="56"/>
                    </Style>
                </Grid.Styles>

                <!-- LEFT: domain + record-types + WHOIS + LOOKUP, stacked and compact -->
                <StackPanel x:Name="DnsQuery" Spacing="6" VerticalAlignment="Top">

                    <!-- Wide: domain input + record-type select side by side. Narrow: the domain input
                         gets a full dedicated row and TYPES drops beneath it. -->
                    <Grid helpers:Responsive.BreakWidth="430"
                          ColumnDefinitions="*, 104" RowDefinitions="Auto, Auto" ColumnSpacing="6" RowSpacing="6">
                        <Grid.Styles>
                            <Style Selector="Grid.wide > StackPanel#DnsDomain">
                                <Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="1"/>
                            </Style>
                            <Style Selector="Grid.narrow > StackPanel#DnsDomain">
                                <Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="2"/>
                            </Style>
                            <Style Selector="Grid.wide > StackPanel#DnsTypes">
                                <Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.Column" Value="1"/><Setter Property="Grid.ColumnSpan" Value="1"/>
                            </Style>
                            <Style Selector="Grid.narrow > StackPanel#DnsTypes">
                                <Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="2"/>
                            </Style>
                        </Grid.Styles>
                    <StackPanel x:Name="DnsDomain">
                        <TextBlock Classes="fieldLabel" Text="TARGET DOMAIN"/>
                        <AutoCompleteBox Classes="field" x:Name="DomainBox" Text="{Binding DomainName}" PlaceholderText="example.com"
                                 ItemsSource="{Binding DomainHistory}" FilterMode="ContainsOrdinal" MinimumPrefixLength="0">
                            <AutoCompleteBox.KeyBindings>
                                <KeyBinding Command="{Binding RunLookupCommand}" Gesture="Enter"/>
                            </AutoCompleteBox.KeyBindings>
                        </AutoCompleteBox>
                    </StackPanel>

                    <!-- RECORD TYPES → compact multi-select dropdown (expands via its flyout) -->
                    <StackPanel x:Name="DnsTypes">
                        <TextBlock Classes="fieldLabel" Text="TYPES"/>
                        <DropDownButton HorizontalAlignment="Stretch" Height="30" Padding="6,0"
                                        Background="#1D1E25" BorderBrush="#3B3D47" BorderThickness="1" CornerRadius="6"
                                        Foreground="#ECECEF">
                            <TextBlock Text="{Binding SelectedTypesSummary}" FontSize="10.5" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <DropDownButton.Flyout>
                                <Flyout Placement="Bottom">
                                    <Border Background="#191A1F" CornerRadius="6" Padding="12,10" MinWidth="210">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="RECORD TYPES" Classes="fieldLabel" Margin="0,0,0,2"/>
                                            <UniformGrid Columns="2">
                                                <UniformGrid.Styles>
                                                    <Style Selector="CheckBox">
                                                        <Setter Property="FontSize" Value="12"/>
                                                        <Setter Property="MinHeight" Value="28"/>
                                                        <Setter Property="Padding" Value="6,0,0,0"/>
                                                    </Style>
                                                </UniformGrid.Styles>
                                                <CheckBox IsChecked="{Binding TypeA}" Content="A"/>
                                                <CheckBox IsChecked="{Binding TypeAAAA}" Content="AAAA"/>
                                                <CheckBox IsChecked="{Binding TypeCNAME}" Content="CNAME"/>
                                                <CheckBox IsChecked="{Binding TypeMX}" Content="MX"/>
                                                <CheckBox IsChecked="{Binding TypeTXT}" Content="TXT"/>
                                                <CheckBox IsChecked="{Binding TypeNS}" Content="NS"/>
                                                <CheckBox IsChecked="{Binding TypeSOA}" Content="SOA"/>
                                                <CheckBox IsChecked="{Binding TypeSRV}" Content="SRV"/>
                                                <CheckBox IsChecked="{Binding TypeCAA}" Content="CAA"/>
                                                <CheckBox IsChecked="{Binding TypePTR}" Content="PTR"/>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>
                    </Grid>

                    <!-- WHOIS + LOOKUP, equal width. (The "Wrap result" toggle moved to the results
                         header so this row stays roomy when RESOLVERS widens the right column.) -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="6">
                        <Button Grid.Column="0" x:Name="WhoisBtn" Classes="secondary" Command="{Binding RunWhoisCommand}" Content="WHOIS"
                                IsEnabled="{Binding !IsWorking}" Height="30" FontSize="11" HorizontalAlignment="Stretch"/>
                        <Panel Grid.Column="1" x:Name="LookupHost">
                            <Button Classes="primary" Command="{Binding RunLookupCommand}" Content="LOOKUP"
                                    Height="30" HorizontalAlignment="Stretch" FontSize="11" IsVisible="{Binding !IsWorking}"/>
                            <Button Classes="toggle active" Command="{Binding StopCommand}" Content="STOP"
                                    Height="30" HorizontalAlignment="Stretch" FontSize="11" IsVisible="{Binding IsWorking}"/>
                        </Panel>
                    </Grid>
                </StackPanel>

                <!-- RIGHT: resolvers box (fills remaining height) with the result Wrap + Copy
                     controls tucked underneath, which trims the resolvers height a little. -->
                <Grid x:Name="DnsResolvers" RowDefinitions="Auto, *">
                    <TextBlock Grid.Row="0" Classes="fieldLabel" Text="RESOLVERS"/>
                    <TextBox x:Name="DnsResolverBox" Grid.Row="1" Classes="field multiline" Text="{Binding DnsServersText}" AcceptsReturn="True" FontSize="11.5"
                             VerticalAlignment="Stretch" FontFamily="Cascadia Code,Consolas"
                             PlaceholderText="one&#x0a;per&#x0a;line"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Results — header bar (count + result actions) over the output card -->
        <Grid Grid.Row="1" RowDefinitions="Auto, *" RowSpacing="6">
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="2,0">
                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="10" Foreground="#9E9FA8"
                           IsVisible="{Binding ShowRecords}"
                           Text="{Binding Records.Count, StringFormat='{}{0} record(s)'}"/>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" Foreground="#9E9FA8"
                           IsVisible="{Binding !ShowRecords}" Text="WHOIS / RDAP"/>
                <!-- Wrap toggle for the WHOIS/RDAP text output (moved here from the query card). -->
                <CheckBox Grid.Column="1" IsChecked="{Binding WrapResult}" Content="Wrap result" FontSize="10.5" FontWeight="SemiBold"
                          Foreground="#9E9FA8" VerticalAlignment="Center" MinHeight="0"
                          IsVisible="{Binding !ShowRecords}"/>
            </Grid>

            <Border Grid.Row="1" Classes="card output">
                <Panel>
                    <!-- DNS lookup → record cards -->
                    <ScrollViewer IsVisible="{Binding ShowRecords}" VerticalScrollBarVisibility="Auto" Padding="8">
                        <ItemsControl ItemsSource="{Binding Records}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DnsRecordRow">
                                    <Border Background="#191A1F" BorderBrush="#2F3139" BorderThickness="1"
                                            CornerRadius="6" Padding="8,6" Margin="0,0,0,5">
                                        <Grid ColumnDefinitions="48, *, Auto">
                                            <Border Grid.Column="0" Background="#2042B883" CornerRadius="4" Height="20"
                                                    VerticalAlignment="Top" Margin="0,1,8,0">
                                                <TextBlock Text="{Binding Type}" FontSize="10" FontWeight="Bold" Foreground="#55C795"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"
                                                                 FontFamily="Cascadia Code,Consolas" FontSize="12"
                                                                 Foreground="#4FCB97" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Server}" FontSize="9.5" Foreground="#9E9FA8" VerticalAlignment="Center"/>
                                                <!-- Copy this record. Vector icon (two overlapping pages) so it's
                                                     always pixel-centered — a glyph sits off-centre in a tiny button. -->
                                                <Button IsVisible="{Binding IsRecord}"
                                                        Command="{Binding $parent[ItemsControl].((vm:DnsViewModel)DataContext).CopyRowCommand}"
                                                        CommandParameter="{Binding}"
                                                        Width="24" Height="22" Padding="0"
                                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                        Background="#2A2C33" BorderThickness="0" CornerRadius="4"
                                                        ToolTip.Tip="Copy this record">
                                                    <Button.Styles>
                                                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                            <Setter Property="Background" Value="#33353E"/>
                                                        </Style>
                                                        <Style Selector="Button Border.pg">
                                                            <Setter Property="BorderBrush" Value="#C7C8CF"/>
                                                        </Style>
                                                        <Style Selector="Button:pointerover Border.pg">
                                                            <Setter Property="BorderBrush" Value="#FFFFFF"/>
                                                        </Style>
                                                    </Button.Styles>
                                                    <Grid Width="13" Height="13">
                                                        <Border Classes="pg" Width="8" Height="9" CornerRadius="2"
                                                                BorderThickness="1.2"
                                                                HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                                        <Border Classes="pg" Width="8" Height="9" CornerRadius="2"
                                                                BorderThickness="1.2" Background="#2A2C33"
                                                                HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                                    </Grid>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- WHOIS / RDAP → freeform text -->
                    <TextBox IsVisible="{Binding !ShowRecords}" Text="{Binding LogText}" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="{Binding ResultWrapping}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Code,Consolas" FontSize="12" Background="Transparent"
                             BorderThickness="0" Foreground="#4FCB97" Padding="12"/>
                </Panel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
