<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Echoes.ViewModels"
             xmlns:helpers="using:Echoes.Helpers"
             x:Class="Echoes.Views.CheckHostView"
             x:DataType="vm:CheckHostViewModel">

    <UserControl.Styles>
        <Style Selector="Border.pill">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="MinWidth" Value="118"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#26272E"/>
        </Style>
        <Style Selector="Border.pill.ok"><Setter Property="Background" Value="#16311F"/></Style>
        <Style Selector="Border.pill.fail"><Setter Property="Background" Value="#2C1B1D"/></Style>
        <Style Selector="Border.pill.pending"><Setter Property="Background" Value="#26272E"/></Style>
        <Style Selector="Border.pill TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Cascadia Code,Consolas"/>
            <Setter Property="Foreground" Value="#9E9FA8"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.pill.ok TextBlock"><Setter Property="Foreground" Value="#7FCBA6"/></Style>
        <Style Selector="Border.pill.fail TextBlock"><Setter Property="Foreground" Value="#E5716F"/></Style>
    </UserControl.Styles>

    <Grid Margin="14" RowDefinitions="Auto, Auto, Auto, Auto, *" RowSpacing="0">

        <!-- host + RUN -->
        <StackPanel Grid.Row="0">
            <TextBlock Classes="fieldLabel" Text="TARGET HOST / IP / URL"/>
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                <AutoCompleteBox Grid.Column="0" Classes="field" Text="{Binding Host}"
                                 PlaceholderText="example.com  ·  1.2.3.4  ·  host:port  ·  https://url"
                                 FontFamily="Cascadia Code,Consolas"
                                 ItemsSource="{Binding HostHistory}" FilterMode="ContainsOrdinal" MinimumPrefixLength="0">
                    <AutoCompleteBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding ToggleRunCommand}"/>
                    </AutoCompleteBox.KeyBindings>
                </AutoCompleteBox>
                <Button Grid.Column="1" Classes="toggle" Command="{Binding ToggleRunCommand}" Classes.active="{Binding IsWorking}"
                        Height="34" Width="94">
                    <Panel>
                        <TextBlock Text="RUN" IsVisible="{Binding !IsWorking}" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="STOP" IsVisible="{Binding IsWorking}" FontSize="12" FontWeight="Bold"/>
                    </Panel>
                </Button>
            </Grid>
        </StackPanel>

        <!-- check type + max nodes + proxy toggle -->
        <Border Grid.Row="1" Classes="card" Padding="12,7" Margin="0,10,0,0">
            <WrapPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,20,3">
                    <TextBlock Text="Check" FontSize="11" Foreground="#9E9FA8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding CheckTypes}" SelectedIndex="{Binding SelectedTypeIndex}"
                              MinHeight="30" Height="30" Width="110" FontSize="11.5" CornerRadius="6"
                              Background="#1D1E25" BorderBrush="#3B3D47" Foreground="#ECECEF"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,20,3">
                    <TextBlock Text="Max nodes" FontSize="11" Foreground="#9E9FA8" VerticalAlignment="Center" Margin="0,0,8,0"
                               ToolTip.Tip="How many worldwide nodes to probe from"/>
                    <NumericUpDown Value="{Binding MaxNodes}" Minimum="1" Maximum="100" ShowButtonSpinner="False"
                                   Height="30" Width="58" FontSize="11.5" HorizontalContentAlignment="Center" CornerRadius="6"
                                   Foreground="#ECECEF" Background="#1D1E25" BorderBrush="#3B3D47"/>
                </StackPanel>
                <CheckBox IsChecked="{Binding UseProxy}" Name="ProxyToggle" Content="Proxy" FontSize="11.5"
                          FontWeight="SemiBold" Foreground="#ECECEF" VerticalAlignment="Center" Margin="0,3,0,3"
                          ToolTip.Tip="Tunnel the check-host.net API calls through a proxy (useful if it's filtered on your network)"/>
            </WrapPanel>
        </Border>

        <!-- proxy credentials -->
        <StackPanel Grid.Row="2" Spacing="8" Margin="0,10,0,0" IsVisible="{Binding UseProxy}">
            <AutoCompleteBox Classes="field" Text="{Binding ProxyAddress}" PlaceholderText="Proxy Host:Port (127.0.0.1:8080)"
                             FontFamily="Cascadia Code,Consolas"
                             ItemsSource="{Binding ProxyHistory}" FilterMode="ContainsOrdinal" MinimumPrefixLength="0"/>
            <Grid ColumnDefinitions="*, *">
                <TextBox Grid.Column="0" Classes="field" Text="{Binding ProxyUser}" PlaceholderText="User (optional)" Margin="0,0,4,0"/>
                <TextBox Grid.Column="1" Classes="field" Text="{Binding ProxyPass}" PlaceholderText="Pass (optional)" PasswordChar="*" Margin="4,0,0,0"/>
            </Grid>
        </StackPanel>

        <!-- status line -->
        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" FontSize="10.5" Foreground="#42B883"
                   FontFamily="Cascadia Code,Consolas" Margin="2,11,2,7" TextTrimming="CharacterEllipsis"/>

        <!-- node results -->
        <Border Grid.Row="4" Classes="card output" Padding="0">
            <Panel>
                <TextBlock Text="Results from worldwide nodes appear here." FontSize="11.5" Foreground="#6B6C74"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding !TotalCount}"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Nodes}" Margin="8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CheckHostNodeRow">
                                <Border Background="#191A1F" BorderBrush="#2A2C33" BorderThickness="1" CornerRadius="7"
                                        Padding="10,7" Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <Panel Grid.Column="0" Width="26" Height="19" Margin="0,0,11,0" VerticalAlignment="Center">
                                            <TextBlock Text="🌐" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       IsVisible="{Binding !HasFlag}"/>
                                            <Border CornerRadius="3" ClipToBounds="True" IsVisible="{Binding HasFlag}">
                                                <Image Source="{Binding CountryCode, Converter={x:Static helpers:CountryFlagConverter.Instance}}"
                                                       Stretch="Uniform"/>
                                            </Border>
                                        </Panel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Location}" FontSize="12" Foreground="#ECECEF" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding NodeHost}" FontSize="9.5" Foreground="#6B6C74"
                                                       FontFamily="Cascadia Code,Consolas" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Classes="pill"
                                                Classes.ok="{Binding IsOk}" Classes.fail="{Binding IsFail}" Classes.pending="{Binding IsPending}">
                                            <TextBlock Text="{Binding ResultText}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Panel>
        </Border>
    </Grid>
</UserControl>
