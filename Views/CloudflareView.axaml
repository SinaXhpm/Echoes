<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Echoes.ViewModels"
             xmlns:helpers="using:Echoes.Helpers"
             xmlns:ctl="using:Echoes.Views.Controls"
             x:Class="Echoes.Views.CloudflareView"
             x:DataType="vm:CloudflareViewModel">

    <UserControl.Resources>
        <!-- Stroked glyphs drawn in a 16x16 box (Path.glyph, Stretch=None) -->
        <StreamGeometry x:Key="CfGlyphLock">M4.5 7 H11.5 A1 1 0 0 1 12.5 8 V12.5 A1 1 0 0 1 11.5 13.5 H4.5 A1 1 0 0 1 3.5 12.5 V8 A1 1 0 0 1 4.5 7 Z M5.5 7 V5 A2.5 2.5 0 0 1 10.5 5 V7</StreamGeometry>
        <StreamGeometry x:Key="CfGlyphHelp">M8 1.75 A6.25 6.25 0 1 0 8 14.25 A6.25 6.25 0 1 0 8 1.75 Z M6.25 6.3 A1.8 1.8 0 1 1 8.85 7.9 C8.3 8.2 8 8.6 8 9.25 V9.5 M8 11.5 V11.6</StreamGeometry>
        <StreamGeometry x:Key="CfGlyphRefresh">M14 8 A6 6 0 1 1 8 2 C9.68 2 11.29 2.67 12.49 3.83 L14 5.33 M14 2 V5.33 H10.67</StreamGeometry>
        <StreamGeometry x:Key="CfGlyphSearch">M7 2.5 A4.5 4.5 0 1 0 7 11.5 A4.5 4.5 0 1 0 7 2.5 Z M10.3 10.3 L13.5 13.5</StreamGeometry>
        <StreamGeometry x:Key="CfGlyphPlus">M8 3 V13 M3 8 H13</StreamGeometry>
        <StreamGeometry x:Key="CfGlyphEdit">M10.75 2.75 L13.25 5.25 L5.5 13 H3 V10.5 Z M9.25 4.25 L11.75 6.75</StreamGeometry>
        <StreamGeometry x:Key="CfGlyphTrash">M2.5 4.5 H13.5 M6.5 4.5 V2.75 H9.5 V4.5 M4 4.5 L4.7 12.6 A1 1 0 0 0 5.7 13.5 H10.3 A1 1 0 0 0 11.3 12.6 L12 4.5 M6.75 7 V11 M9.25 7 V11</StreamGeometry>
        <StreamGeometry x:Key="CfGlyphCopy">M6 5.5 H12 A1.5 1.5 0 0 1 13.5 7 V13 A1.5 1.5 0 0 1 12 14.5 H6 A1.5 1.5 0 0 1 4.5 13 V7 A1.5 1.5 0 0 1 6 5.5 Z M2.5 10.5 V4 A1.5 1.5 0 0 1 4 2.5 H10.5</StreamGeometry>
        <StreamGeometry x:Key="CfGlyphBackup">M8 2.5 V10 M4.75 6.75 L8 10 L11.25 6.75 M2.5 10.5 V12 A1.5 1.5 0 0 0 4 13.5 H12 A1.5 1.5 0 0 0 13.5 12 V10.5</StreamGeometry>
        <StreamGeometry x:Key="CfGlyphRestore">M8 10 V2.5 M4.75 5.75 L8 2.5 L11.25 5.75 M2.5 10.5 V12 A1.5 1.5 0 0 0 4 13.5 H12 A1.5 1.5 0 0 0 13.5 12 V10.5</StreamGeometry>
        <StreamGeometry x:Key="CfGlyphMore">M3.5 8 H3.6 M8 8 H8.1 M12.5 8 H12.6</StreamGeometry>
        <StreamGeometry x:Key="CfGlyphDown">M4 6 L8 10 L12 6</StreamGeometry>
        <StreamGeometry x:Key="CfGlyphUp">M4 10 L8 6 L12 10</StreamGeometry>
        <StreamGeometry x:Key="CfGlyphWarning">M8 2.5 L14 13 H2 Z M8 6.5 V9.25 M8 11.25 V11.35</StreamGeometry>
        <StreamGeometry x:Key="CfGlyphShield">M8 1.75 L13 3.75 V7.5 C13 10.75 10.9 13.1 8 14.25 C5.1 13.1 3 10.75 3 7.5 V3.75 Z M5.75 8 L7.25 9.5 L10.25 6.5</StreamGeometry>
        <!-- dynamic DNS: two arrows chasing round (the record follows the IP) -->
        <StreamGeometry x:Key="CfGlyphSync">M13.25 6.5 A5.5 5.5 0 0 0 3.1 5.4 M2.75 2.5 V5.5 H5.75 M2.75 9.5 A5.5 5.5 0 0 0 12.9 10.6 M13.25 13.5 V10.5 H10.25</StreamGeometry>
        <StreamGeometry x:Key="CfHeroLock">M7.5 10.5 H16.5 A2 2 0 0 1 18.5 12.5 V18 A2 2 0 0 1 16.5 20 H7.5 A2 2 0 0 1 5.5 18 V12.5 A2 2 0 0 1 7.5 10.5 Z M8.5 10.5 V7.5 A3.5 3.5 0 0 1 15.5 7.5 V10.5 M12 14 V16.5</StreamGeometry>

        <!-- ===== one zone setting: title, description, note / error, and its control (switch, list, segments, or the
             plan it needs); a switch that asks before turning off shows its confirmation under the row ===== -->
        <DataTemplate x:Key="SettingRow" x:DataType="vm:CfSetting">
            <Border Classes="setRow" ToolTip.Tip="{Binding DisabledTip}" IsVisible="{Binding IsRowVisible}">
                <StackPanel>
                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" ColumnSpacing="12">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="setTitle" Text="{Binding Title}"/>
                            <TextBlock Classes="setDesc" Text="{Binding Description}"/>
                            <TextBlock Classes="setNote" Text="{Binding Note}" IsVisible="{Binding HasNote}"/>
                            <TextBlock Classes="setBusy" Text="Saving…" IsVisible="{Binding IsBusy}"/>
                            <TextBlock Classes="setError" Text="{Binding Error}" IsVisible="{Binding HasError}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" Classes="set" IsVisible="{Binding ShowToggle}" IsChecked="{Binding IsOn}"
                                      IsEnabled="{Binding CanEdit}" OnContent="On" OffContent="Off"/>
                        <!-- no local Grid.Row / Column: the wide / narrow styles place it -->
                        <ComboBox Classes="field setChoice" IsVisible="{Binding ShowChoice}"
                                  ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" IsEnabled="{Binding CanEdit}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:CfOption"><TextBlock Text="{Binding Label}"/></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Border Grid.Column="1" Classes="badge" IsVisible="{Binding ShowNotAvailable}" VerticalAlignment="Center">
                            <TextBlock Text="Not available"/>
                        </Border>
                        <Border Grid.Column="1" Classes="badge info" IsVisible="{Binding PlanLocked}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PlanBadge}"/>
                        </Border>
                        <!-- items panel from the styles: one row of segments, or 2x2 on phones -->
                        <ListBox Grid.Row="1" Grid.ColumnSpan="2" Classes="segPick" IsVisible="{Binding ShowSegmented}"
                                 ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" IsEnabled="{Binding CanEdit}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:CfOption"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <Border Classes="confirm" IsVisible="{Binding ConfirmingOff}" Margin="0,10,0,0">
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                            <TextBlock Classes="confirmText" Text="{Binding ConfirmOffText}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Classes="secondary" Content="Cancel" Command="{Binding CancelOffCommand}"/>
                                <Button Classes="danger" Content="Turn off" Command="{Binding ConfirmOffCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ===== top of a settings tab, only while it loads or when it couldn't load ===== -->
        <DataTemplate x:Key="SettingsState" x:DataType="vm:CloudflareViewModel">
            <StackPanel Spacing="8">
                <TextBlock Classes="tabHint" Text="Loading settings…" IsVisible="{Binding CurrentSettings.IsLoading, FallbackValue=False}"/>
                <Border Classes="note danger" IsVisible="{Binding CurrentSettings.HasLoadError, FallbackValue=False}">
                    <TextBlock Text="{Binding CurrentSettings.LoadError, FallbackValue=''}"/>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- ===== I'm under attack: one big switch; the row turns red while it's on ===== -->
        <DataTemplate x:Key="UnderAttackRow" x:DataType="vm:CfUnderAttack">
            <Border Classes="setRow uam" Classes.on="{Binding IsOn}">
                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                    <Border Classes="uamIcon" VerticalAlignment="Top">
                        <Path Classes="glyph" Data="{StaticResource CfGlyphShield}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Classes="setTitle" Text="I'm under attack mode"/>
                        <TextBlock Classes="setDesc" Text="Challenges every visitor first. Use it during a DDoS."
                                   ToolTip.Tip="Shows every visitor a short challenge first. Use it during a DDoS attack."/>
                        <TextBlock Classes="setNote" Text="{Binding Note}"
                                   IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <TextBlock Classes="setBusy" Text="Saving…" IsVisible="{Binding IsBusy}"/>
                        <TextBlock Classes="setError" Text="{Binding Error}" IsVisible="{Binding HasError}"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" Classes="set" IsChecked="{Binding IsOn}" IsEnabled="{Binding CanEdit}"
                                  OnContent="On" OffContent="Off" AutomationProperties.Name="I'm under attack mode"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ===== HSTS: the summary; "Change" opens the fields (widening it needs "I understand") ===== -->
        <DataTemplate x:Key="HstsCard" x:DataType="vm:CfHsts">
            <StackPanel Spacing="10" Margin="16,12">
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Classes="setTitle" Text="HSTS" ToolTip.Tip="HTTP Strict Transport Security"/>
                        <TextBlock Classes="setDesc" Text="Browsers use HTTPS only, even for http:// links."
                                   ToolTip.Tip="Tells browsers to reach this site over HTTPS only, even when someone types http://."/>
                        <TextBlock Classes="setNote" Text="{Binding Summary}"/>
                        <TextBlock Classes="setBusy" Text="Saving…" IsVisible="{Binding IsBusy}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="secondary" Content="Change" Command="{Binding BeginEditCommand}"
                            IsVisible="{Binding !IsEditing}" IsEnabled="{Binding CanChange}" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Spacing="10" IsVisible="{Binding IsEditing}">
                    <Border Classes="divider"/>
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                        <TextBlock Classes="setTitle" Text="Send HSTS header" VerticalAlignment="Center"/>
                        <ToggleSwitch Grid.Column="1" Classes="set" IsChecked="{Binding EditEnabled}" OnContent="On" OffContent="Off"
                                      AutomationProperties.Name="Send the HSTS header"/>
                    </Grid>
                    <Grid x:Name="HstsAge" ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" ColumnSpacing="12" IsVisible="{Binding EditEnabled}">
                        <TextBlock Classes="setTitle" Text="Max age" VerticalAlignment="Center"
                                   ToolTip.Tip="How long browsers keep insisting on HTTPS"/>
                        <ComboBox Classes="field setChoice" ItemsSource="{Binding MaxAgeOptions}" SelectedItem="{Binding EditMaxAge}"
                                  ToolTip.Tip="How long browsers keep insisting on HTTPS" AutomationProperties.Name="Max age">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:CfOption"><TextBlock Text="{Binding Label}"/></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <WrapPanel ItemSpacing="16" LineSpacing="4">
                        <CheckBox IsChecked="{Binding EditSubdomains}" IsVisible="{Binding EditEnabled}" Content="Include subdomains"
                                  ToolTip.Tip="Apply to subdomains too (includeSubDomains)"/>
                        <CheckBox IsChecked="{Binding EditPreload}" IsVisible="{Binding EditEnabled}" Content="Preload"
                                  ToolTip.Tip="Preload: browsers can ship the policy built in"/>
                        <CheckBox IsChecked="{Binding EditNosniff}" Content="No-sniff header"
                                  ToolTip.Tip="Also send X-Content-Type-Options: nosniff"/>
                    </WrapPanel>
                    <Border Classes="note warning" IsVisible="{Binding NeedsAcknowledge}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Browsers will refuse plain HTTP for the whole max age, even if you turn HTTPS or Cloudflare off later. Every covered hostname must keep working over HTTPS."/>
                            <CheckBox IsChecked="{Binding Acknowledged}" Content="I understand"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="note danger" IsVisible="{Binding HasError}">
                        <TextBlock Text="{Binding Error}"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Classes="ghost" Content="Cancel" Command="{Binding CancelEditCommand}"/>
                        <Button Classes="primary" Content="Save" Command="{Binding SaveEditCommand}" IsEnabled="{Binding CanSave}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- ===== a copyable value (DS record fields, a new zone's name servers) ===== -->
        <!-- label | value | copy (wide) · label over the value (a narrow page: StackPanel.page.narrow) -->
        <DataTemplate x:Key="FieldRow" x:DataType="vm:CfField">
            <Border Classes="rrow">
                <Grid Classes="fieldGrid" ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto, Auto" ColumnSpacing="10">
                    <TextBlock Classes="fieldName" Text="{Binding Label}"/>
                    <SelectableTextBlock Classes="fieldValue" Classes.mono="{Binding Mono}" Text="{Binding Value}"/>
                    <Button Grid.Column="2" Grid.RowSpan="2" Classes="rowBtn" VerticalAlignment="Center"
                            Command="{Binding $parent[UserControl].((vm:CloudflareViewModel)DataContext).CopyFieldCommand}" CommandParameter="{Binding}"
                            ToolTip.Tip="Copy" AutomationProperties.Name="Copy">
                        <Path Classes="glyph" Data="{StaticResource CfGlyphCopy}"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ===== a line of a preview (import): action badge, type, name, content, why ===== -->
        <DataTemplate x:Key="ChangeRow" x:DataType="vm:CfRestoreRow">
            <Border Classes="rrow">
                <Grid ColumnDefinitions="Auto, Auto, *" ColumnSpacing="10">
                    <Border Grid.Column="0" Classes="badge" Width="64" VerticalAlignment="Top"
                            Classes.accent="{Binding IsAdd}" Classes.info="{Binding IsUpdate}" Classes.danger="{Binding IsFailed}">
                        <TextBlock Text="{Binding Action}" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Type}" FontFamily="{StaticResource MonoFont}" Width="44"
                               FontSize="{StaticResource Font.Small}" Foreground="{DynamicResource Text.Secondary}" Margin="0,3,0,0"/>
                    <StackPanel Grid.Column="2" Spacing="2">
                        <TextBlock Text="{Binding Name}" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource Text.Primary}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Content}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource Font.Small}"
                                   Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding Content, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <TextBlock Text="{Binding Detail}" FontSize="{StaticResource Font.Small}" Foreground="{DynamicResource Text.Muted}"
                                   TextWrapping="Wrap" IsVisible="{Binding HasDetail}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ===== a rule list (WAF custom rules / redirect rules): count + add, then the rules (virtualized) ===== -->
        <DataTemplate x:Key="RuleList" x:DataType="vm:CfRuleList">
            <Grid RowDefinitions="Auto, Auto, *">
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                    <TextBlock Classes="tabHint" VerticalAlignment="Center" Text="{Binding CountText}"/>
                    <Button Grid.Column="1" Classes="primary" CommandParameter="{Binding}"
                            Command="{Binding $parent[UserControl].((vm:CloudflareViewModel)DataContext).NewRuleCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Classes="glyph" Data="{StaticResource CfGlyphPlus}"/>
                            <TextBlock Text="Add rule" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <Border Grid.Row="1" Classes="note danger" IsVisible="{Binding HasError}" Margin="0,12,0,0">
                    <TextBlock Text="{Binding Error}"/>
                </Border>
                <Border Grid.Row="2" Classes="card output" Margin="0,12,0,0" ClipToBounds="True">
                    <Panel>
                        <ListBox Classes="plainList" ItemsSource="{Binding Rules}" Background="{DynamicResource Bg.Inset}" BorderThickness="0"
                                 Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:CfRule">
                                    <Panel>
                                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10" Margin="12,6,4,6">
                                            <ToggleSwitch Classes="mini" IsChecked="{Binding Enabled}" IsEnabled="{Binding IsIdle}"
                                                          ToolTip.Tip="Turn the rule on or off" AutomationProperties.Name="Rule on"/>
                                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                                    <TextBlock Classes="recName" Text="{Binding Title}"/>
                                                    <Border Grid.Column="1" Classes="badge" Classes.danger="{Binding IsBlock}"
                                                            Classes.warning="{Binding IsChallenge}" Classes.success="{Binding IsSkip}"
                                                            Classes.info="{Binding IsRedirect}">
                                                        <TextBlock Text="{Binding ActionText}"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Classes="recContent" Text="{Binding Detail}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Button Classes="rowBtn" IsEnabled="{Binding IsIdle}"
                                                        Command="{Binding $parent[UserControl].((vm:CloudflareViewModel)DataContext).EditRuleCommand}"
                                                        CommandParameter="{Binding}" ToolTip.Tip="Edit" AutomationProperties.Name="Edit rule">
                                                    <Path Classes="glyph" Data="{StaticResource CfGlyphEdit}"/>
                                                </Button>
                                                <Button Classes="rowBtn del" IsEnabled="{Binding IsIdle}"
                                                        Command="{Binding $parent[UserControl].((vm:CloudflareViewModel)DataContext).RequestDeleteRuleCommand}"
                                                        CommandParameter="{Binding}" ToolTip.Tip="Delete" AutomationProperties.Name="Delete rule">
                                                    <Path Classes="glyph" Data="{StaticResource CfGlyphTrash}"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <Border Classes="confirm" IsVisible="{Binding PendingDelete}" Margin="6,3">
                                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                                <TextBlock Classes="confirmText" Text="{Binding Title, StringFormat='Delete {0}?'}"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                    <Button Classes="secondary" Content="Cancel"
                                                            Command="{Binding $parent[UserControl].((vm:CloudflareViewModel)DataContext).CancelDeleteRuleCommand}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Classes="danger" Content="Delete"
                                                            Command="{Binding $parent[UserControl].((vm:CloudflareViewModel)DataContext).DeleteRuleCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Panel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Classes="emptyText" IsVisible="{Binding ShowLoading}" Text="Loading rules…"/>
                        <TextBlock Classes="emptyText" IsVisible="{Binding IsEmpty}" Text="{Binding EmptyText}"/>
                    </Panel>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- ===== glyphs (a Path doesn't inherit Foreground: follow the button's text color) ===== -->
        <Style Selector="Path.glyph">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="None"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeJoin" Value="Round"/>
            <Setter Property="Stroke" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Path.glyph.dots">
            <Setter Property="StrokeThickness" Value="2.4"/>
        </Style>
        <Style Selector="Button.primary Path.glyph">
            <Setter Property="Stroke" Value="{DynamicResource Text.OnAccent}"/>
        </Style>
        <Style Selector="Button.primary:disabled Path.glyph">
            <Setter Property="Stroke" Value="{DynamicResource Text.OnAccentDisabled}"/>
        </Style>
        <Style Selector="Button.secondary Path.glyph">
            <Setter Property="Stroke" Value="{DynamicResource Text.Primary}"/>
        </Style>
        <Style Selector="Button.ghost:pointerover Path.glyph">
            <Setter Property="Stroke" Value="{DynamicResource Text.Primary}"/>
        </Style>
        <Style Selector="Button.icon:pointerover Path.glyph">
            <Setter Property="Stroke" Value="{DynamicResource Accent.Text}"/>
        </Style>
        <Style Selector="Button.secondary:disabled Path.glyph, Button.ghost:disabled Path.glyph, Button.icon:disabled Path.glyph">
            <Setter Property="Stroke" Value="{DynamicResource Text.Disabled}"/>
        </Style>

        <!-- no sliding knob: the switch just flips (no animations anywhere in the app) -->
        <Style Selector="ToggleSwitch">
            <Setter Property="KnobTransitions" Value="{x:Null}"/>
        </Style>

        <!-- ===== small text styles ===== -->
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="{StaticResource Font.Small}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.tabHint">
            <Setter Property="FontSize" Value="{StaticResource Font.Small}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- tinted note (a solid soft fill + hairline per tone) -->
        <Style Selector="Border.note">
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Bg.Raised}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}"/>
        </Style>
        <Style Selector="Border.note TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Font.Small}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="17"/>
        </Style>
        <Style Selector="Border.note.warning">
            <Setter Property="Background" Value="{DynamicResource Warning.Soft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Warning.Border}"/>
        </Style>
        <Style Selector="Border.note.warning TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
        </Style>
        <Style Selector="Border.note.danger">
            <Setter Property="Background" Value="{DynamicResource Danger.Soft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Danger.Border}"/>
        </Style>
        <Style Selector="Border.note.danger TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
        </Style>
        <Style Selector="Border.note.success">
            <Setter Property="Background" Value="{DynamicResource Success.Soft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Success.Border}"/>
        </Style>
        <Style Selector="Border.note.success TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Success}"/>
        </Style>
        <Style Selector="Border.note.info">
            <Setter Property="Background" Value="{DynamicResource Info.Soft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Info.Border}"/>
        </Style>
        <Style Selector="Border.note.info TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Info}"/>
        </Style>

        <!-- inline confirmation (delete, purge, pause): a solid danger-tinted strip -->
        <Style Selector="Border.confirm">
            <Setter Property="Background" Value="{DynamicResource Danger.Soft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Danger.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}"/>
            <Setter Property="Padding" Value="12,6,6,6"/>
        </Style>
        <Style Selector="Border.confirm TextBlock.confirmText">
            <Setter Property="FontSize" Value="{StaticResource Font.Body}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ===== account panel ===== -->
        <Style Selector="TextBlock.acctSummary">
            <Setter Property="FontSize" Value="{StaticResource Font.Body}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.acctStatus">
            <Setter Property="FontSize" Value="{StaticResource Font.Small}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Ellipse.acctDot">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="{DynamicResource Text.Disabled}"/>
        </Style>
        <Style Selector="Ellipse.acctDot.on">
            <Setter Property="Fill" Value="{DynamicResource Success}"/>
        </Style>

        <!-- ===== zone line ===== -->
        <Style Selector="TextBlock.zoneMeta">
            <Setter Property="FontSize" Value="{StaticResource Font.Small}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="SelectableTextBlock.zoneNs">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Small}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- quiet square icon button for rows (edit / delete / copy): no fill until hovered; Control.Height square,
             so it is a 44px touch target on phones -->
        <Style Selector="Button.rowBtn">
            <Setter Property="Width" Value="{DynamicResource Control.Height}"/>
            <Setter Property="Height" Value="{DynamicResource Control.Height}"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.rowBtn Path.glyph">
            <Setter Property="Stroke" Value="{DynamicResource Text.Muted}"/>
        </Style>
        <Style Selector="Button.rowBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Bg.RaisedHover}"/>
        </Style>
        <Style Selector="Button.rowBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Bg.RaisedPressed}"/>
        </Style>
        <Style Selector="Button.rowBtn:pointerover Path.glyph">
            <Setter Property="Stroke" Value="{DynamicResource Text.Primary}"/>
        </Style>
        <Style Selector="Button.rowBtn.del:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Danger.Soft}"/>
        </Style>
        <Style Selector="Button.rowBtn.del:pointerover Path.glyph">
            <Setter Property="Stroke" Value="{DynamicResource Danger}"/>
        </Style>
        <Style Selector="Button.rowBtn:disabled Path.glyph">
            <Setter Property="Stroke" Value="{DynamicResource Text.Disabled}"/>
        </Style>
        <Style Selector="Button.rowBtn:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- ===== DNS record rows (virtualized list: a handful of elements per row) ===== -->
        <Style Selector="ListBox#RecordList > ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Border.recType">
            <Setter Property="Width" Value="62"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.recType TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- dynamic DNS on a record row: the ↻ button (accent while the record follows the public IP, amber when its
             last check failed); on phones the button gives way to a small mark in the type badge -->
        <Style Selector="Button.rowBtn.ddns.on /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Accent.Soft}"/>
        </Style>
        <Style Selector="Button.rowBtn.ddns.on Path.glyph, Button.rowBtn.ddns.on:pointerover Path.glyph">
            <Setter Property="Stroke" Value="{DynamicResource Accent.Text}"/>
        </Style>
        <Style Selector="Button.rowBtn.ddns.on.err /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Warning.Soft}"/>
        </Style>
        <Style Selector="Button.rowBtn.ddns.on.err Path.glyph, Button.rowBtn.ddns.on.err:pointerover Path.glyph">
            <Setter Property="Stroke" Value="{DynamicResource Warning}"/>
        </Style>
        <Style Selector="Path.ddnsMark">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="StrokeThickness" Value="1.4"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeJoin" Value="Round"/>
            <Setter Property="Stroke" Value="{DynamicResource Accent.Text}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
        <Style Selector="Grid#CfMain.wide Panel.ddnsMarkSlot">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Grid#DdnsPage.narrow TextBlock.wideOnly, Grid#DdnsPage.narrow Border.ddnsType, Grid#DdnsPage.wide TextBlock.narrowOnly">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Button.chip.on Path.glyph">
            <Setter Property="Stroke" Value="{DynamicResource Success}"/>
        </Style>
        <Style Selector="Button.chip.pending Path.glyph">
            <Setter Property="Stroke" Value="{DynamicResource Warning}"/>
        </Style>
        <Style Selector="Grid#CfMain.narrow Panel.ddnsSlot">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <!-- the dynamic DNS panel's rows -->
        <Style Selector="Border.ddnsRow">
            <Setter Property="Padding" Value="12,8,6,8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style Selector="TextBlock.ddnsMsg">
            <Setter Property="FontSize" Value="{StaticResource Font.Small}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.ddnsMsg.warn">
            <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
        </Style>
        <Style Selector="TextBlock.ddnsMsg.bad">
            <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
        </Style>
        <Style Selector="TextBlock.recName">
            <Setter Property="FontSize" Value="{StaticResource Font.Body}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.recContent">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Small}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.recTtl">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Caption}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style Selector="TextBlock.dnsOnly">
            <Setter Property="FontSize" Value="{StaticResource Font.Caption}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.colHead">
            <Setter Property="FontSize" Value="{StaticResource Font.Caption}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="0.3"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
        </Style>

        <!-- proxied pill: a small toggle button; orange-cloud (warning tint) when proxied -->
        <Style Selector="Button.pill">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Bg.Raised}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Caption}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.pill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Bg.RaisedHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        </Style>
        <Style Selector="Button.pill.on">
            <Setter Property="Background" Value="{DynamicResource Warning.Soft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Warning.Border}"/>
            <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
        </Style>
        <Style Selector="Button.pill.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Warning.Soft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Warning}"/>
            <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
        </Style>
        <Style Selector="Button.pill:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Bg.RaisedPressed}"/>
        </Style>
        <Style Selector="Button.pill:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Bg.Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Disabled}"/>
        </Style>

        <!-- ===== settings ===== -->
        <!-- desktop: a gutter on the right for the scroll bar, so it never sits on the cards' edge -->
        <Style Selector="StackPanel.setStack">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style Selector="Grid#CfMain.wide StackPanel.setStack">
            <Setter Property="Margin" Value="0,0,14,4"/>
        </Style>
        <Style Selector="Border.setCard">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>
        <Style Selector="Border.setCard.ech">
            <Setter Property="BorderBrush" Value="{DynamicResource Accent.Border}"/>
        </Style>
        <Style Selector="Border.setRow">
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Background" Value="{DynamicResource Bg.Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
        </Style>
        <!-- the first row of a card draws no divider above it -->
        <Style Selector="ContentPresenter:nth-child(1) > Border.setRow">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBlock.setTitle">
            <Setter Property="FontSize" Value="{StaticResource Font.Body}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.setDesc">
            <Setter Property="FontSize" Value="{StaticResource Font.Small}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.setNote">
            <Setter Property="FontSize" Value="{StaticResource Font.Small}"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent.Text}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style Selector="TextBlock.setBusy">
            <Setter Property="FontSize" Value="{StaticResource Font.Small}"/>
            <Setter Property="Foreground" Value="{DynamicResource Info}"/>
        </Style>
        <Style Selector="TextBlock.setError">
            <Setter Property="FontSize" Value="{StaticResource Font.Small}"/>
            <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style Selector="ToggleSwitch.set">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Width" Value="84"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Body}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="ComboBox.setChoice">
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="Width" Value="220"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- segmented picker (encryption mode): pills in one inset track -->
        <Style Selector="ListBox.segPick">
            <Setter Property="Margin" Value="0,12,0,0"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="Height" Value="{DynamicResource Control.Height}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="{DynamicResource Bg.Inset}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBox.segPick > ListBoxItem">
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ListBox.segPick > ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}"/>
        </Style>
        <Style Selector="ListBox.segPick > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Bg.Hover}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        </Style>
        <Style Selector="ListBox.segPick > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                         ListBox.segPick > ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         ListBox.segPick > ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter,
                         ListBox.segPick > ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Accent.Soft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent.Text}"/>
        </Style>
        <Style Selector="ListBox.segPick:disabled > ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource Text.Disabled}"/>
        </Style>

        <!-- restore preview / summary rows -->
        <Style Selector="Border.rrow">
            <Setter Property="Padding" Value="0,8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
        </Style>
        <Style Selector="Border.stat">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Bg.Inset}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}"/>
        </Style>
        <Style Selector="Border.stat TextBlock.statNum">
            <Setter Property="FontSize" Value="{StaticResource Font.Page}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        </Style>
        <Style Selector="Border.stat TextBlock.statLabel">
            <Setter Property="FontSize" Value="{StaticResource Font.Small}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="Border.stat.add TextBlock.statNum">
            <Setter Property="Foreground" Value="{DynamicResource Accent.Text}"/>
        </Style>
        <Style Selector="Border.stat.upd TextBlock.statNum">
            <Setter Property="Foreground" Value="{DynamicResource Info}"/>
        </Style>

        <!-- status line, tinted on failure -->
        <Style Selector="Border#StatusBar">
            <Setter Property="Background" Value="{DynamicResource Bg.Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}"/>
        </Style>
        <Style Selector="Border#StatusBar.error">
            <Setter Property="Background" Value="{DynamicResource Danger.Soft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Danger.Border}"/>
        </Style>
        <Style Selector="Border#StatusBar TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        </Style>
        <Style Selector="Border#StatusBar.error TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
        </Style>
        <Style Selector="Ellipse.statusDot">
            <Setter Property="Fill" Value="{DynamicResource Accent}"/>
        </Style>
        <Style Selector="Ellipse.statusDot.busy">
            <Setter Property="Fill" Value="{DynamicResource Warning}"/>
        </Style>
        <Style Selector="Border#StatusBar.error Ellipse.statusDot">
            <Setter Property="Fill" Value="{DynamicResource Danger}"/>
        </Style>

        <!-- ===== Responsive: CfMain gets narrow / wide from its own width (helpers:Responsive) =====
             wide   : account picker, status and buttons in one line; the form's name | sign-in method, email | key and
                      proxy fields side by side; one-line record rows under column heads; choice settings beside their text
             narrow : the picker takes the line, icon-only buttons; fields stack; two-line record rows, no heads; choice
                      settings under their text -->
        <Style Selector="ComboBox#AccountPicker">
            <Setter Property="MinWidth" Value="170"/>
            <Setter Property="MaxWidth" Value="260"/>
        </Style>
        <Style Selector="Grid#CfMain.narrow ComboBox#AccountPicker">
            <Setter Property="Grid.ColumnSpan" Value="2"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MaxWidth" Value="100000"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Grid#CfMain.wide StackPanel#AcctMethodField">
            <Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.Column" Value="1"/>
        </Style>
        <Style Selector="Grid#CfMain.narrow StackPanel#AcctNameField">
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
        <Style Selector="Grid#CfMain.narrow StackPanel#AcctMethodField">
            <Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="2"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>
        <Style Selector="Grid#KeyEmailFields > StackPanel#AcctKeyField">
            <Setter Property="Grid.Column" Value="1"/>
        </Style>
        <Style Selector="Grid#CfMain.narrow Grid#KeyEmailFields > StackPanel#AcctEmailField">
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
        <Style Selector="Grid#CfMain.narrow Grid#KeyEmailFields > StackPanel#AcctKeyField">
            <Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.ColumnSpan" Value="2"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>
        <Style Selector="Grid#CfMain.wide StackPanel#CfProxyUserField">
            <Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.Column" Value="1"/>
        </Style>
        <Style Selector="Grid#CfMain.wide StackPanel#CfProxyPassField">
            <Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.Column" Value="2"/><Setter Property="Grid.ColumnSpan" Value="1"/>
        </Style>
        <Style Selector="Grid#CfMain.narrow StackPanel#CfProxyAddrField">
            <Setter Property="Grid.ColumnSpan" Value="3"/>
        </Style>
        <Style Selector="Grid#CfMain.narrow StackPanel#CfProxyUserField">
            <Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>
        <Style Selector="Grid#CfMain.narrow StackPanel#CfProxyPassField">
            <Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="1"/><Setter Property="Grid.ColumnSpan" Value="2"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>
        <!-- phones: the account buttons are icon-only, and the status beside the picker gives way to it -->
        <Style Selector="Grid#CfMain.narrow TextBlock.wideOnly">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <!-- phones: the open account panel takes the page (there is no room for it and the records); folding it brings
             the zone back -->
        <Style Selector="Grid#CfMain.narrow.account > Grid#ZoneArea">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <!-- record list: one line under column heads (wide) / two lines, heads hidden (narrow) -->
        <Style Selector="Grid#CfMain.narrow Border#RecHeader">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Grid.recRow > TextBlock.recName">
            <Setter Property="Grid.Column" Value="1"/>
        </Style>
        <Style Selector="Grid#CfMain.wide Grid.recRow > TextBlock.recContent">
            <Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.Column" Value="2"/><Setter Property="Grid.ColumnSpan" Value="1"/>
        </Style>
        <Style Selector="Grid#CfMain.wide Grid.recRow > StackPanel.recMeta">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Spacing" Value="12"/>
        </Style>
        <Style Selector="Grid#CfMain.narrow Grid.recRow > TextBlock.recName">
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
        <Style Selector="Grid#CfMain.narrow Grid.recRow > TextBlock.recContent">
            <Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="1"/><Setter Property="Grid.ColumnSpan" Value="2"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style Selector="Grid#CfMain.narrow Grid.recRow > Border.recType">
            <Setter Property="Width" Value="54"/>
        </Style>
        <Style Selector="Grid#CfMain.narrow Grid.recRow > StackPanel.recMeta">
            <Setter Property="Grid.RowSpan" Value="2"/>
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Spacing" Value="4"/>
        </Style>
        <Style Selector="Grid#CfMain.narrow Grid.recRow > StackPanel.recActions">
            <Setter Property="Grid.RowSpan" Value="2"/>
        </Style>
        <Style Selector="Grid#CfMain.narrow Button.pill">
            <Setter Property="Height" Value="30"/>
        </Style>

        <!-- DNS toolbar: search + type filter, then the actions; the actions take their own row when narrow -->
        <Style Selector="Grid#DnsBar.wide > WrapPanel#DnsActions">
            <Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.Column" Value="1"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <Style Selector="Grid#DnsBar.narrow > Grid#DnsFind">
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
        <Style Selector="Grid#DnsBar.narrow > WrapPanel#DnsActions">
            <Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="2"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <Style Selector="Grid#DnsFind ComboBox#TypeFilterBox">
            <Setter Property="Width" Value="150"/>
        </Style>
        <!-- the search row's own width decides (the box shares it with the type filter and its count) -->
        <Style Selector="Grid#DnsFind.wide TextBox#RecordSearch">
            <Setter Property="PlaceholderText" Value="Search name or content"/>
        </Style>
        <Style Selector="Grid#DnsFind.narrow TextBox#RecordSearch">
            <Setter Property="PlaceholderText" Value="Search"/>
        </Style>
        <Style Selector="WrapPanel#DnsActions > Button.primary, WrapPanel#DnsActions > Button.secondary">
            <Setter Property="Padding" Value="14,0"/>
        </Style>
        <!-- phones: the four actions share one line -->
        <Style Selector="Grid#CfMain.narrow WrapPanel#DnsActions > Button.primary, Grid#CfMain.narrow WrapPanel#DnsActions > Button.secondary">
            <Setter Property="Padding" Value="10,0"/>
        </Style>
        <Style Selector="Grid#CfMain.narrow Grid#DnsFind ComboBox#TypeFilterBox">
            <Setter Property="Width" Value="124"/>
        </Style>

        <!-- settings: a choice sits beside its text (wide) or under it, full width (narrow); the segmented picker
             becomes a 2x2 block on phones -->
        <Style Selector="Grid#CfMain.narrow ComboBox.setChoice">
            <Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="2"/>
            <Setter Property="Width" Value="NaN"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
        <Style Selector="Grid#CfMain.narrow ListBox.segPick">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Height" Value="NaN"/>
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
            </Setter>
        </Style>
        <Style Selector="Grid#CfMain.narrow ListBox.segPick > ListBoxItem">
            <Setter Property="Height" Value="38"/>
        </Style>
        <Style Selector="Grid#PurgeAllRow > Button, Grid#PauseRow > Panel#PauseButtons">
            <Setter Property="Grid.Column" Value="1"/>
        </Style>
        <Style Selector="Grid#CfMain.narrow Grid#PurgeAllRow > Button">
            <Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="2"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="Grid#CfMain.narrow Grid#PauseRow > Panel#PauseButtons">
            <Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="2"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <!-- the tab strip: "DNS records" reads "DNS" on phones so the five tabs fit one line -->
        <Style Selector="Grid#CfMain.narrow TabControl#CfTabs > TabItem">
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <!-- ===== Record editor: EdForm gets narrow/wide from its own width ===== -->
        <Style Selector="Grid#EdForm.wide StackPanel#EdNameField">
            <Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.Column" Value="1"/><Setter Property="Grid.ColumnSpan" Value="1"/>
        </Style>
        <Style Selector="Grid#EdForm.narrow StackPanel#EdTypeField">
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
        <Style Selector="Grid#EdForm.narrow StackPanel#EdNameField">
            <Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="2"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>

        <!-- ===================== overview, sub-tabs, rules, IP access, DNSSEC chip, overlays ===================== -->

        <!-- the zone tabs wrap onto a second line on phones: a little air between the lines -->
        <Style Selector="Grid#CfMain.narrow TabControl#CfTabs > TabItem">
            <Setter Property="Margin" Value="0,0,4,6"/>
        </Style>
        <!-- sub-tabs inside a zone tab (the app's underline tabs, a bit tighter) -->
        <Style Selector="TabControl.sub">
            <Setter Property="Padding" Value="0,10,0,0"/>
        </Style>
        <Style Selector="TabControl.sub > TabItem">
            <Setter Property="Margin" Value="0,0,20,0"/>
        </Style>
        <Style Selector="Grid#CfMain.narrow TabControl.sub > TabItem">
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>

        <!-- the scroll bar gutter of the overview (like the settings stacks) -->
        <Style Selector="Grid#OverviewGrid">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style Selector="Grid#CfMain.wide Grid#OverviewGrid">
            <Setter Property="Margin" Value="0,0,14,4"/>
        </Style>
        <!-- overview: traffic | quick actions over top countries (wide) · one column (narrow) -->
        <Style Selector="Grid#OverviewGrid.wide > Border#TrafficCard">
            <Setter Property="Grid.RowSpan" Value="2"/>
        </Style>
        <Style Selector="Grid#OverviewGrid.wide > Border#QuickCard">
            <Setter Property="Grid.Column" Value="1"/>
        </Style>
        <Style Selector="Grid#OverviewGrid.wide > Border#CountryCard">
            <Setter Property="Grid.Column" Value="1"/><Setter Property="Grid.Row" Value="1"/>
        </Style>
        <Style Selector="Grid#OverviewGrid.narrow > Border#TrafficCard">
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
        <Style Selector="Grid#OverviewGrid.narrow > Border#QuickCard">
            <Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
        <Style Selector="Grid#OverviewGrid.narrow > Border#CountryCard">
            <Setter Property="Grid.Row" Value="2"/><Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
        <Style Selector="UniformGrid#Tiles">
            <Setter Property="Columns" Value="3"/>
        </Style>
        <Style Selector="Grid#OverviewGrid.narrow UniformGrid#Tiles">
            <Setter Property="Columns" Value="2"/>
        </Style>

        <!-- traffic tiles: compact stats -->
        <Style Selector="UniformGrid#Tiles > Border.stat">
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style Selector="UniformGrid#Tiles TextBlock.statNum">
            <Setter Property="FontSize" Value="{StaticResource Font.Title}"/>
        </Style>
        <Style Selector="TextBlock.axis">
            <Setter Property="FontSize" Value="{StaticResource Font.Caption}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
        </Style>
        <!-- the period switch next to "Traffic": no top margin, compact -->
        <Style Selector="ListBox.segPick.rangePick">
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style Selector="ListBox.segPick.rangePick > ListBoxItem">
            <Setter Property="Padding" Value="10,0"/>
        </Style>
        <Style Selector="Grid#CfMain.narrow ListBox.segPick.rangePick">
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <!-- top countries: name, count and a thin share bar -->
        <Style Selector="TextBlock.cName">
            <Setter Property="FontSize" Value="{StaticResource Font.Small}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.cNum">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Small}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="ProgressBar.share">
            <Setter Property="Height" Value="4"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="Background" Value="{DynamicResource Bg.Inset}"/>
        </Style>

        <!-- I'm under attack: red while it's on -->
        <Style Selector="Border.uamIcon">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Bg.Raised}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}"/>
        </Style>
        <Style Selector="Border.uamIcon > Path.glyph">
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.setRow.uam.on">
            <Setter Property="Background" Value="{DynamicResource Danger.Soft}"/>
        </Style>
        <Style Selector="Border.setRow.uam.on Border.uamIcon">
            <Setter Property="Background" Value="{DynamicResource Danger.Soft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Danger.Border}"/>
        </Style>
        <Style Selector="Border.setRow.uam.on Path.glyph">
            <Setter Property="Stroke" Value="{DynamicResource Danger}"/>
        </Style>
        <Style Selector="Border.setRow.uam.on TextBlock.setNote">
            <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
        </Style>
        <Style Selector="Border.setCard.uamOn">
            <Setter Property="BorderBrush" Value="{DynamicResource Danger.Border}"/>
        </Style>

        <!-- a certificate that expires within two weeks (renewal is overdue) -->
        <Style Selector="TextBlock.setDesc.warnText">
            <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
        </Style>

        <!-- compact on/off switch for rule rows (no text) -->
        <Style Selector="ToggleSwitch.mini">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="OnContent" Value="{x:Null}"/>
            <Setter Property="OffContent" Value="{x:Null}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- rule / IP access lists: rows with hairlines, no selection look (a row is acted on with its buttons) -->
        <Style Selector="ListBox.plainList > ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ListBox.plainList > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                         ListBox.plainList > ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         ListBox.plainList > ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Bg.Hover}"/>
        </Style>
        <Style Selector="TextBlock.emptyText">
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="24"/>
            <Setter Property="MaxWidth" Value="460"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Small}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
        </Style>
        <Style Selector="TextBlock.recMeta">
            <Setter Property="FontSize" Value="{StaticResource Font.Small}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- IP access form: value | action | note | add (wide) · value + add, then action | note (narrow) -->
        <Style Selector="Grid#AccessForm.wide > ComboBox#AccessModeBox">
            <Setter Property="Grid.Column" Value="1"/>
        </Style>
        <Style Selector="Grid#AccessForm.wide > TextBox#AccessNoteBox">
            <Setter Property="Grid.Column" Value="2"/>
        </Style>
        <Style Selector="Grid#AccessForm > Button#AccessAddButton">
            <Setter Property="Grid.Column" Value="3"/>
        </Style>
        <Style Selector="Grid#AccessForm.narrow > TextBox#AccessValueBox">
            <Setter Property="Grid.ColumnSpan" Value="3"/>
        </Style>
        <Style Selector="Grid#AccessForm.narrow > ComboBox#AccessModeBox">
            <Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.ColumnSpan" Value="2"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <Style Selector="Grid#AccessForm.narrow > TextBox#AccessNoteBox">
            <Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="2"/><Setter Property="Grid.ColumnSpan" Value="2"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>

        <!-- DNSSEC chip on the zone line: opens the DNSSEC page -->
        <Style Selector="Button.chip">
            <Setter Property="Height" Value="22"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Bg.Raised}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Caption}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Bg.RaisedHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        </Style>
        <Style Selector="Button.chip.on">
            <Setter Property="Background" Value="{DynamicResource Success.Soft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Success.Border}"/>
            <Setter Property="Foreground" Value="{DynamicResource Success}"/>
        </Style>
        <Style Selector="Button.chip.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Success.Soft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Success}"/>
            <Setter Property="Foreground" Value="{DynamicResource Success}"/>
        </Style>
        <Style Selector="Button.chip.pending">
            <Setter Property="Background" Value="{DynamicResource Warning.Soft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Warning.Border}"/>
            <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
        </Style>
        <Style Selector="Button.chip.pending:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Warning.Soft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Warning}"/>
            <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
        </Style>
        <!-- the DNS toolbar's dynamic DNS button: a chip at toolbar height (after the chip styles, so it wins) -->
        <Style Selector="Button.chip.tool">
            <Setter Property="Height" Value="{DynamicResource Control.Height}"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Small}"/>
        </Style>

        <!-- copyable values (DS record, name servers) -->
        <Style Selector="TextBlock.fieldName">
            <Setter Property="Width" Value="112"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Small}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="Grid.fieldGrid > SelectableTextBlock.fieldValue">
            <Setter Property="Grid.Column" Value="1"/>
        </Style>
        <Style Selector="StackPanel.page.narrow Grid.fieldGrid > TextBlock.fieldName">
            <Setter Property="Width" Value="NaN"/>
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
        <Style Selector="StackPanel.page.narrow Grid.fieldGrid > SelectableTextBlock.fieldValue">
            <Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="2"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style Selector="SelectableTextBlock.fieldValue">
            <Setter Property="FontSize" Value="{StaticResource Font.Small}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="SelectableTextBlock.fieldValue.mono">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        </Style>
        <!-- body text of an overlay page -->
        <Style Selector="TextBlock.pageText">
            <Setter Property="FontSize" Value="{StaticResource Font.Small}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="18"/>
        </Style>
        <!-- the rule editor's two-column row (status code | keep query string) -->
        <Style Selector="Grid#RuleBottom.narrow > CheckBox#RulePreserveBox">
            <Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="2"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
        <Style Selector="Grid#RuleBottom.narrow > StackPanel#RuleStatusField">
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
        <!-- the IP access note box: a shorter placeholder when it's narrow -->
        <Style Selector="Grid#AccessForm.wide > TextBox#AccessNoteBox">
            <Setter Property="PlaceholderText" Value="Note (optional)"/>
        </Style>
        <Style Selector="Grid#AccessForm.narrow > TextBox#AccessNoteBox">
            <Setter Property="PlaceholderText" Value="Note"/>
        </Style>
        <Style Selector="Grid#RuleBottom.wide > CheckBox#RulePreserveBox">
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </UserControl.Styles>

    <Panel>

      <!-- ============ LOCK SCREEN (master password). MaxWidth (not a fixed Width) so it fits a phone. ============ -->
      <ScrollViewer IsVisible="{Binding IsLocked}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <Border Classes="card" Padding="24" MaxWidth="400" Margin="0,8"
                  HorizontalAlignment="Stretch" VerticalAlignment="Center">
              <StackPanel Spacing="12">
                  <StackPanel Spacing="8">
                      <Border Width="44" Height="44" CornerRadius="{StaticResource Radius.Lg}" HorizontalAlignment="Center"
                              Background="{DynamicResource Accent.Soft}" BorderBrush="{DynamicResource Accent.Border}" BorderThickness="1">
                          <Path Data="{StaticResource CfHeroLock}" Stroke="{DynamicResource Accent.Text}" StrokeThickness="1.6"
                                StrokeLineCap="Round" StrokeJoin="Round" Width="24" Height="24" Stretch="None"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <TextBlock Classes="sectionTitle" Text="Encrypted vault" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                      <TextBlock IsVisible="{Binding HasVault}" TextWrapping="Wrap" TextAlignment="Center"
                                 FontSize="{StaticResource Font.Small}" Foreground="{DynamicResource Text.Secondary}"
                                 Text="Enter your master password to unlock."/>
                      <TextBlock IsVisible="{Binding !HasVault}" TextWrapping="Wrap" TextAlignment="Center"
                                 FontSize="{StaticResource Font.Small}" Foreground="{DynamicResource Text.Secondary}"
                                 Text="Set a master password to encrypt your tokens. It can't be recovered."/>
                  </StackPanel>
                  <StackPanel>
                      <TextBlock Classes="fieldLabel" Text="Master password"/>
                      <TextBox Classes="field" Text="{Binding MasterKey}" PasswordChar="*" IsUndoEnabled="False" PlaceholderText="Master password">
                          <TextBox.KeyBindings>
                              <KeyBinding Command="{Binding UnlockCommand}" Gesture="Enter"/>
                          </TextBox.KeyBindings>
                      </TextBox>
                  </StackPanel>
                  <!-- "Unlocking…" + disabled (command CanExecute) while the key is derived off the UI thread -->
                  <Button Classes="primary" Command="{Binding UnlockCommand}" Content="{Binding UnlockLabel}" HorizontalAlignment="Stretch"/>
                  <TextBlock Text="{Binding UnlockError}" Foreground="{DynamicResource Danger}" FontSize="{StaticResource Font.Small}"
                             HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                             IsVisible="{Binding UnlockError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              </StackPanel>
          </Border>
      </ScrollViewer>

      <Grid x:Name="CfMain" IsVisible="{Binding !IsLocked}" RowDefinitions="Auto, Auto, *, Auto" helpers:Responsive.BreakWidth="640"
            Classes.account="{Binding IsAccountExpanded}">

        <!-- ============ ACCOUNT: the account picker with Add account / Edit / Lock; the account form folds out below ============ -->
        <Border Grid.Row="0" Classes="card" Padding="12,8,8,8">
            <StackPanel>
                <Grid x:Name="AccountHeader" ColumnDefinitions="Auto, Auto, *, Auto" ColumnSpacing="10">
                    <Ellipse Grid.Column="0" Classes="acctDot" Classes.on="{Binding !!Zones.Count}"/>
                    <ComboBox x:Name="AccountPicker" Grid.Column="1" Classes="field" ItemsSource="{Binding Profiles}"
                              SelectedItem="{Binding SelectedProfile}" IsVisible="{Binding HasAccounts}"
                              PlaceholderText="Choose an account" ToolTip.Tip="Switch account" AutomationProperties.Name="Account">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:CfProfile"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Grid.Column="1" Classes="acctSummary" Text="No account yet" IsVisible="{Binding !HasAccounts}"/>
                    <TextBlock Grid.Column="2" Classes="acctStatus wideOnly" Text="{Binding AccountStatus}"/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                        <Button Classes="ghost" Command="{Binding AddAccountCommand}" Padding="10,0"
                                ToolTip.Tip="Add another Cloudflare account" AutomationProperties.Name="Add account">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Classes="glyph" Data="{StaticResource CfGlyphPlus}"/>
                                <TextBlock Classes="wideOnly" Text="Add account" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="ghost" Command="{Binding EditAccountCommand}" Padding="10,0" IsVisible="{Binding HasAccounts}"
                                ToolTip.Tip="Edit or remove this account: name, API token, proxy" AutomationProperties.Name="Edit account">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Classes="glyph" Data="{StaticResource CfGlyphEdit}"/>
                                <TextBlock Classes="wideOnly" Text="Edit" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="ghost" Command="{Binding LockAppCommand}" Padding="10,0"
                                ToolTip.Tip="Lock the vault (Notes lock too)" AutomationProperties.Name="Lock">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Classes="glyph" Data="{StaticResource CfGlyphLock}"/>
                                <TextBlock Classes="wideOnly" Text="Lock" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- the account form: add an account, or edit / remove the active one. It works on a draft: nothing changes
                     until Cloudflare accepts it -->
                <StackPanel x:Name="AccountForm" IsVisible="{Binding IsAccountExpanded}" Spacing="12" Margin="4,10,4,4">
                    <Border Classes="divider"/>
                    <StackPanel Spacing="3">
                        <TextBlock Classes="sectionTitle" Text="{Binding AccountPanelTitle}"/>
                        <TextBlock Classes="hint" Text="{Binding AccountPanelHint}"/>
                    </StackPanel>

                    <!-- name | sign-in method (wide) · stacked (narrow): placed by the styles -->
                    <Grid x:Name="AcctTop" ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" ColumnSpacing="16">
                        <StackPanel x:Name="AcctNameField">
                            <TextBlock Classes="fieldLabel" Text="Name"/>
                            <TextBox Classes="field" Text="{Binding Draft.Name}" MaxLength="60" PlaceholderText="Optional, e.g. Work"/>
                        </StackPanel>
                        <StackPanel x:Name="AcctMethodField">
                            <!-- phones: no label (the two choices say it), so the key + proxy form fits the screen -->
                            <TextBlock Classes="fieldLabel wideOnly" Text="Sign in with"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ListBox Classes="segPick" Margin="0" SelectedIndex="{Binding Draft.AuthIndex}" AutomationProperties.Name="Sign in with"
                                         ToolTip.Tip="Sign in with an API token or the Global API key">
                                    <ListBoxItem Content="API token"/>
                                    <ListBoxItem Content="Global API key"/>
                                </ListBox>
                                <!-- Help: which token, and which permission each feature needs -->
                                <Button Classes="icon" VerticalAlignment="Center"
                                        ToolTip.Tip="Which API token do I need?" AutomationProperties.Name="Which API token?">
                                    <Path Classes="glyph" Data="{StaticResource CfGlyphHelp}"/>
                                    <Button.Flyout>
                                        <Flyout Placement="Bottom">
                                            <StackPanel MaxWidth="360" Spacing="8" Margin="2">
                                                <TextBlock Text="Which API token?" FontWeight="SemiBold" FontSize="{StaticResource Font.Body}"
                                                           Foreground="{DynamicResource Text.Primary}"/>
                                                <TextBlock TextWrapping="Wrap" FontSize="{StaticResource Font.Small}" LineHeight="18"
                                                           Foreground="{DynamicResource Text.Secondary}"
                                                           Text="Cloudflare dashboard → My Profile → API Tokens → Create Token. Start from the &quot;Edit zone DNS&quot; template and give it the permissions for what you use here:"/>
                                                <TextBlock TextWrapping="Wrap" FontSize="{StaticResource Font.Small}" LineHeight="18"
                                                           Foreground="{DynamicResource Text.Secondary}" FontFamily="{StaticResource MonoFont}"
                                                           Text="Zone → Zone : Read&#10;  list your zones (always needed)&#10;Zone → DNS : Edit&#10;  records, backup, import, DNSSEC&#10;Zone → Zone Settings : Edit&#10;  SSL/TLS, HSTS, security, speed, cache&#10;Zone → Cache Purge : Purge&#10;  purge the cache&#10;Zone → Analytics : Read&#10;  the traffic overview&#10;Zone → Zone WAF : Edit&#10;  WAF custom rules&#10;Zone → Firewall Services : Edit&#10;  IP access rules&#10;Zone → Bot Management : Edit&#10;  Bot Fight Mode, AI crawlers&#10;Zone → Single Redirect : Edit&#10;  redirect rules&#10;Zone → SSL and Certificates : Edit&#10;  edge certificates, Universal SSL&#10;Zone → Zone : Edit&#10;  pause Cloudflare, add a site"/>
                                                <TextBlock TextWrapping="Wrap" FontSize="{StaticResource Font.Small}" LineHeight="18"
                                                           Foreground="{DynamicResource Text.Secondary}"
                                                           Text="Zone Resources: Include → All zones (or pick yours). A missing permission shows up as an error (code 10000 / 9109) that names the one to add."/>
                                                <TextBlock Text="The Global API key (with your account email) has full access to your account. A scoped token is safer."
                                                           TextWrapping="Wrap" FontSize="{StaticResource Font.Small}" FontStyle="Italic"
                                                           Foreground="{DynamicResource Text.Muted}"/>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- credentials: an API token, or the Global API key + account email -->
                    <StackPanel IsVisible="{Binding Draft.UseApiToken}">
                        <TextBlock Classes="fieldLabel" Text="API token"/>
                        <TextBox Classes="field" Text="{Binding Draft.ApiToken}" PasswordChar="●" IsUndoEnabled="False"
                                 PlaceholderText="Paste your API token" AutomationProperties.Name="API token"
                                 ToolTip.Tip="Create it in the Cloudflare dashboard: My Profile → API Tokens (the ? shows which permissions)">
                            <TextBox.KeyBindings>
                                <KeyBinding Command="{Binding SubmitAccountCommand}" Gesture="Enter"/>
                            </TextBox.KeyBindings>
                        </TextBox>
                    </StackPanel>
                    <!-- side by side (wide) or stacked (narrow): placed by the styles, so no local Grid.* here -->
                    <Grid x:Name="KeyEmailFields" ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="12"
                          IsVisible="{Binding !Draft.UseApiToken}">
                        <StackPanel x:Name="AcctEmailField">
                            <TextBlock Classes="fieldLabel" Text="Account email"/>
                            <TextBox Classes="field" Text="{Binding Draft.ApiEmail}" PlaceholderText="you@example.com"/>
                        </StackPanel>
                        <StackPanel x:Name="AcctKeyField">
                            <TextBlock Classes="fieldLabel" Text="Global API key"/>
                            <TextBox Classes="field" Text="{Binding Draft.ApiKey}" PasswordChar="●" IsUndoEnabled="False"
                                     PlaceholderText="Paste the key" AutomationProperties.Name="Global API key"
                                     ToolTip.Tip="Cloudflare dashboard → My Profile → API Tokens → Global API Key">
                                <TextBox.KeyBindings>
                                    <KeyBinding Command="{Binding SubmitAccountCommand}" Gesture="Enter"/>
                                </TextBox.KeyBindings>
                            </TextBox>
                        </StackPanel>
                    </Grid>

                    <!-- proxy: the fields appear only when it's on -->
                    <CheckBox IsChecked="{Binding Draft.UseProxy}" Content="Use a proxy"
                              ToolTip.Tip="Send this account's API calls through an HTTP or SOCKS5 proxy"/>
                    <Grid ColumnDefinitions="2*, *, *" RowDefinitions="Auto, Auto" ColumnSpacing="12" Margin="0,-4,0,0"
                          IsVisible="{Binding Draft.UseProxy}">
                        <StackPanel x:Name="CfProxyAddrField">
                            <TextBlock Classes="fieldLabel" Text="Proxy"/>
                            <AutoCompleteBox Classes="field" helpers:InputAssist.SelectAllOnFocus="True" Text="{Binding Draft.ProxyAddress}"
                                     ItemsSource="{Binding ProxyHistory}" FilterMode="ContainsOrdinal" MinimumPrefixLength="0"
                                     PlaceholderText="host:port" ToolTip.Tip="HTTP or SOCKS5 proxy, e.g. 127.0.0.1:1080"/>
                        </StackPanel>
                        <StackPanel x:Name="CfProxyUserField">
                            <TextBlock Classes="fieldLabel" Text="User"/>
                            <TextBox Classes="field" Text="{Binding Draft.ProxyUser}" PlaceholderText="Optional"/>
                        </StackPanel>
                        <StackPanel x:Name="CfProxyPassField">
                            <TextBlock Classes="fieldLabel" Text="Password"/>
                            <TextBox Classes="field" Text="{Binding Draft.ProxyPass}" PasswordChar="*" IsUndoEnabled="False" PlaceholderText="Optional"/>
                        </StackPanel>
                    </Grid>

                    <!-- why the check failed: refused, unreachable, a duplicate… -->
                    <Border Classes="note danger" IsVisible="{Binding AccountError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding AccountError}"/>
                    </Border>

                    <!-- removing an account drops its token from the vault for good: asks first -->
                    <Border Classes="confirm" IsVisible="{Binding DeleteProfileConfirm}">
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                            <TextBlock Classes="confirmText"
                                       Text="{Binding SelectedProfile.Name, StringFormat='Remove {0}? Its token or key is deleted from the vault.', FallbackValue=''}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Classes="secondary" Content="Cancel" Command="{Binding CancelDeleteProfileCommand}"/>
                                <Button Classes="danger" Content="Remove" Command="{Binding DeleteProfileCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                        <WrapPanel Grid.Column="0" ItemSpacing="8" LineSpacing="8">
                            <Button x:Name="SubmitAccountButton" Classes="primary" Command="{Binding SubmitAccountCommand}" Content="{Binding SubmitLabel}"/>
                            <Button Classes="secondary" Command="{Binding SaveAccountAnywayCommand}" Content="Save anyway"
                                    IsVisible="{Binding CanSaveUnchecked}" ToolTip.Tip="Save it without the check; it connects once Cloudflare can be reached"/>
                            <Button Classes="secondary" Command="{Binding CancelAccountCommand}" Content="Cancel" IsVisible="{Binding CanCancelAccount}"/>
                        </WrapPanel>
                        <Button Grid.Column="1" Classes="ghost" Command="{Binding RequestDeleteProfileCommand}" Padding="10,0" VerticalAlignment="Top"
                                IsVisible="{Binding IsEditingAccount}" ToolTip.Tip="Remove this account from Echoes" AutomationProperties.Name="Remove account">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Classes="glyph" Data="{StaticResource CfGlyphTrash}"/>
                                <TextBlock Text="Remove" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- zone picker + tabs. On a phone the open account panel takes the page instead (styles: CfMain.narrow.account) -->
        <Grid x:Name="ZoneArea" Grid.Row="1" Grid.RowSpan="2" RowDefinitions="Auto, *">
            <!-- ============ ZONE PICKER + ZONE INFO ============ -->
            <StackPanel Grid.Row="0" Margin="0,12,0,0" Spacing="8" IsVisible="{Binding !!Zones.Count}">
                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="8">
                    <ComboBox x:Name="ZonePicker" Grid.Column="0" Classes="field" ItemsSource="{Binding Zones}" SelectedItem="{Binding SelectedZone}"
                              PlaceholderText="Choose a zone" AutomationProperties.Name="Zone">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:CfZone"><TextBlock Text="{Binding Name}"/></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="1" Classes="icon" Command="{Binding OpenAddZoneCommand}"
                            ToolTip.Tip="Add a site to Cloudflare" AutomationProperties.Name="Add a site">
                        <Path Classes="glyph" Data="{StaticResource CfGlyphPlus}"/>
                    </Button>
                    <Button Grid.Column="2" Classes="icon" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}"
                            ToolTip.Tip="Reload this zone: records, settings, rules" AutomationProperties.Name="Reload the zone">
                        <Path Classes="glyph" Data="{StaticResource CfGlyphRefresh}"/>
                    </Button>
                </Grid>

                <!-- status · under attack · plan · name servers (what to set at the registrar while pending) · DNSSEC -->
                <WrapPanel x:Name="ZoneInfo" IsVisible="{Binding HasZone}" ItemSpacing="8" LineSpacing="4" Margin="2,0,0,0">
                    <Border Classes="badge" VerticalAlignment="Center"
                            Classes.success="{Binding SelectedZone.IsActive, FallbackValue=False}"
                            Classes.warning="{Binding SelectedZone.IsWarning, FallbackValue=False}"
                            Classes.danger="{Binding SelectedZone.IsInactive, FallbackValue=False}">
                        <TextBlock Text="{Binding SelectedZone.StatusText, FallbackValue=''}"/>
                    </Border>
                    <Border Classes="badge danger" VerticalAlignment="Center" IsVisible="{Binding SelectedZone.UnderAttack, FallbackValue=False}"
                            ToolTip.Tip="I'm under attack mode is on: every visitor gets a challenge first">
                        <TextBlock Text="Under attack"/>
                    </Border>
                    <TextBlock Classes="zoneMeta" Text="{Binding SelectedZone.PlanText, FallbackValue=''}"/>
                    <TextBlock Classes="zoneMeta" Text="·  Name servers" IsVisible="{Binding SelectedZone.HasNameServers, FallbackValue=False}"/>
                    <SelectableTextBlock Classes="zoneNs" Text="{Binding SelectedZone.NameServer1, FallbackValue=''}"
                                         IsVisible="{Binding SelectedZone.HasNameServers, FallbackValue=False}"/>
                    <SelectableTextBlock Classes="zoneNs" Text="{Binding SelectedZone.NameServer2, FallbackValue=''}"
                                         IsVisible="{Binding SelectedZone.NameServer2, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}"/>
                    <TextBlock Classes="zoneMeta" Text="{Binding SelectedZone.MoreNameServers, FallbackValue=''}"
                               IsVisible="{Binding SelectedZone.MoreNameServers, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}"/>
                    <Button Classes="rowBtn" Command="{Binding CopyNameServersCommand}" Margin="-4,0,0,0"
                            IsVisible="{Binding SelectedZone.HasNameServers, FallbackValue=False}"
                            ToolTip.Tip="Copy the name servers" AutomationProperties.Name="Copy the name servers">
                        <Path Classes="glyph" Data="{StaticResource CfGlyphCopy}"/>
                    </Button>
                    <Button Classes="chip" Command="{Binding OpenDnssecCommand}"
                            Classes.on="{Binding SelectedZone.DnssecOn, FallbackValue=False}"
                            Classes.pending="{Binding SelectedZone.DnssecPending, FallbackValue=False}"
                            Content="{Binding SelectedZone.DnssecText, FallbackValue='DNSSEC'}"
                            ToolTip.Tip="DNSSEC: its status, and the DS record for your registrar"/>
                </WrapPanel>
                <Border Classes="note warning" IsVisible="{Binding SelectedZone.IsPending, FallbackValue=False}">
                    <TextBlock Text="Set these name servers at your registrar to activate."
                               ToolTip.Tip="This zone isn't active yet. Cloudflare activates it once your domain registrar points to these name servers."/>
                </Border>
            </StackPanel>

            <!-- ============ ZONE TABS ============ -->
            <TabControl x:Name="CfTabs" Grid.Row="1" Classes="seg" Margin="0,12,0,0" Padding="0,12,0,0"
                        SelectedIndex="{Binding SelectedTabIndex}" IsVisible="{Binding HasZone}">
                <TabControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </TabControl.ItemsPanel>

                <!-- ======================= OVERVIEW ======================= -->
                <TabItem Header="Overview">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="OverviewGrid" ColumnDefinitions="*, 320" RowDefinitions="Auto, Auto, Auto" ColumnSpacing="12" RowSpacing="12"
                              helpers:Responsive.BreakWidth="700">
                            <!-- traffic: GraphQL analytics -->
                            <Border x:Name="TrafficCard" Classes="card" Padding="12" VerticalAlignment="Top">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                        <TextBlock Classes="setTitle" Text="Traffic" VerticalAlignment="Center"/>
                                        <ListBox Grid.Column="1" Classes="segPick rangePick" ItemsSource="{Binding AnalyticsRanges}"
                                                 SelectedIndex="{Binding AnalyticsRange}"/>
                                    </Grid>
                                    <TextBlock Classes="tabHint" Text="Loading traffic…" IsVisible="{Binding CurrentAnalytics.ShowLoading, FallbackValue=False}"/>
                                    <Border Classes="note danger" IsVisible="{Binding CurrentAnalytics.HasError, FallbackValue=False}">
                                        <TextBlock Text="{Binding CurrentAnalytics.Error, FallbackValue=''}"/>
                                    </Border>
                                    <StackPanel Spacing="12" IsVisible="{Binding CurrentAnalytics.ShowContent, FallbackValue=False}">
                                        <UniformGrid x:Name="Tiles" ColumnSpacing="8" RowSpacing="8">
                                            <Border Classes="stat">
                                                <StackPanel>
                                                    <TextBlock Classes="statNum" Text="{Binding CurrentAnalytics.Requests, FallbackValue='–'}"/>
                                                    <TextBlock Classes="statLabel" Text="Requests"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Classes="stat" ToolTip.Tip="{Binding CurrentAnalytics.CachedSub, FallbackValue=''}">
                                                <StackPanel>
                                                    <TextBlock Classes="statNum" Text="{Binding CurrentAnalytics.Cached, FallbackValue='–'}"/>
                                                    <TextBlock Classes="statLabel" Text="From cache"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Classes="stat" ToolTip.Tip="{Binding CurrentAnalytics.BandwidthSub, FallbackValue=''}">
                                                <StackPanel>
                                                    <TextBlock Classes="statNum" Text="{Binding CurrentAnalytics.Bandwidth, FallbackValue='–'}"/>
                                                    <TextBlock Classes="statLabel" Text="Data served"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Classes="stat">
                                                <StackPanel>
                                                    <TextBlock Classes="statNum" Text="{Binding CurrentAnalytics.Visitors, FallbackValue='–'}"/>
                                                    <TextBlock Classes="statLabel" Text="Unique visitors"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Classes="stat">
                                                <StackPanel>
                                                    <TextBlock Classes="statNum" Text="{Binding CurrentAnalytics.PageViews, FallbackValue='–'}"/>
                                                    <TextBlock Classes="statLabel" Text="Page views"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Classes="stat">
                                                <StackPanel>
                                                    <TextBlock Classes="statNum" Text="{Binding CurrentAnalytics.Threats, FallbackValue='–'}"/>
                                                    <TextBlock Classes="statLabel" Text="Threats stopped"/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                        <StackPanel Spacing="4">
                                            <ctl:CfBarChart Height="56" Values="{Binding CurrentAnalytics.Bars, FallbackValue={x:Null}}"
                                                            BarBrush="{DynamicResource Accent}" BaselineBrush="{DynamicResource Border.Default}"/>
                                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8">
                                                <TextBlock Classes="axis" Text="{Binding CurrentAnalytics.BarsStart, FallbackValue=''}"/>
                                                <TextBlock Grid.Column="1" Classes="axis" HorizontalAlignment="Center" Text="{Binding CurrentAnalytics.BarsPeak, FallbackValue=''}"/>
                                                <TextBlock Grid.Column="2" Classes="axis" Text="{Binding CurrentAnalytics.BarsEnd, FallbackValue=''}"/>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- quick actions: I'm under attack, development mode (the same switch as in Cache) -->
                            <Border x:Name="QuickCard" Classes="card setCard" VerticalAlignment="Top"
                                    Classes.uamOn="{Binding CurrentSettings.UnderAttack.IsOn, FallbackValue=False}">
                                <StackPanel>
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SettingsState}" Margin="16,12"
                                                    IsVisible="{Binding CurrentSettings.ShowState, FallbackValue=False}"/>
                                    <ItemsControl ItemsSource="{Binding CurrentSettings.UnderAttackRow, FallbackValue={x:Null}}" ItemTemplate="{StaticResource UnderAttackRow}"/>
                                    <Border Classes="divider"/>
                                    <ItemsControl ItemsSource="{Binding CurrentSettings.QuickRows, FallbackValue={x:Null}}" ItemTemplate="{StaticResource SettingRow}"/>
                                </StackPanel>
                            </Border>

                            <!-- top countries -->
                            <Border x:Name="CountryCard" Classes="card" Padding="12" VerticalAlignment="Top"
                                    IsVisible="{Binding CurrentAnalytics.HasCountries, FallbackValue=False}">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="setTitle" Text="Top countries"/>
                                    <ItemsControl ItemsSource="{Binding CurrentAnalytics.Countries, FallbackValue={x:Null}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CfCountryRow">
                                                <Grid ColumnDefinitions="Auto, *, Auto, Auto" RowDefinitions="Auto, Auto" ColumnSpacing="8" RowSpacing="4">
                                                    <Image Width="16" Height="12" VerticalAlignment="Center"
                                                           Source="{Binding Code, Converter={x:Static helpers:CountryFlagConverter.Instance}}"/>
                                                    <TextBlock Grid.Column="1" Classes="cName" Text="{Binding Name}"/>
                                                    <TextBlock Grid.Column="2" Classes="cNum" Text="{Binding Requests}"/>
                                                    <TextBlock Grid.Column="3" Classes="axis" Text="{Binding ShareText}" Width="34" TextAlignment="Right"
                                                               VerticalAlignment="Center"/>
                                                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="4" Classes="share" Minimum="0" Maximum="1" Value="{Binding Share}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- ======================= DNS RECORDS ======================= -->
                <TabItem AutomationProperties.Name="DNS records">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="DNS"/>
                            <TextBlock Classes="wideOnly" Text=" records"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid RowDefinitions="Auto, *">
                        <!-- toolbar: [search ......][type] [Add record] [Backup] [Restore] [⋯] -->
                        <Grid x:Name="DnsBar" Grid.Row="0" ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto"
                              helpers:Responsive.BreakWidth="700">
                            <Grid x:Name="DnsFind" ColumnDefinitions="*, Auto" ColumnSpacing="8" helpers:Responsive.BreakWidth="440">
                                <TextBox x:Name="RecordSearch" Grid.Column="0" Classes="field" Text="{Binding SearchText}"
                                         helpers:InputAssist.SelectAllOnFocus="True" Padding="8,0,8,0">
                                    <TextBox.InnerLeftContent>
                                        <Path Classes="glyph" Data="{StaticResource CfGlyphSearch}" Stroke="{DynamicResource Text.Muted}" Margin="12,0,0,0"/>
                                    </TextBox.InnerLeftContent>
                                    <TextBox.InnerRightContent>
                                        <TextBlock Text="{Binding RecordCountText}" FontSize="{StaticResource Font.Small}" Foreground="{DynamicResource Text.Muted}"
                                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    </TextBox.InnerRightContent>
                                </TextBox>
                                <ComboBox x:Name="TypeFilterBox" Grid.Column="1" Classes="field" ItemsSource="{Binding TypeFilters}"
                                          SelectedItem="{Binding SelectedTypeFilter}" ToolTip.Tip="Show one record type"/>
                            </Grid>
                            <WrapPanel x:Name="DnsActions" ItemSpacing="8" LineSpacing="8">
                                <Button Classes="primary" Command="{Binding NewRecordCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Classes="glyph" Data="{StaticResource CfGlyphPlus}"/>
                                        <TextBlock Text="Add record" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BackupButton" Classes="secondary" Click="OnBackup" IsEnabled="{Binding CanBackup}"
                                        ToolTip.Tip="Save this zone's records to a JSON file">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Classes="glyph" Data="{StaticResource CfGlyphBackup}"/>
                                        <TextBlock Text="Backup" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RestoreButton" Classes="secondary" Click="OnRestore" IsEnabled="{Binding CanBackup}"
                                        ToolTip.Tip="Restore records from a backup file (shows a preview first)">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Classes="glyph" Data="{StaticResource CfGlyphRestore}"/>
                                        <TextBlock Text="Restore" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="icon" ToolTip.Tip="More" AutomationProperties.Name="More record actions">
                                    <Path Classes="glyph dots" Data="{StaticResource CfGlyphMore}"/>
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuItem Header="Import a BIND zone file…" Click="OnImportZoneFile"/>
                                            <MenuItem Header="Export as BIND zone file" Click="OnExportZoneFile"/>
                                            <MenuItem Header="DNSSEC…" Command="{Binding OpenDnssecCommand}"/>
                                            <MenuItem Header="Dynamic DNS…" Command="{Binding OpenDdnsCommand}"/>
                                            <MenuItem Header="Reload records" Command="{Binding ReloadRecordsCommand}"/>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                                <!-- dynamic DNS: shown once a record follows the public IP (green: all fine, amber: a check failed) -->
                                <Button Classes="chip tool" Command="{Binding OpenDdnsCommand}" IsVisible="{Binding HasDdns}"
                                        Classes.on="{Binding DdnsAllOk}" Classes.pending="{Binding DdnsHasProblem}"
                                        ToolTip.Tip="Dynamic DNS: the records kept on this device's public IP" AutomationProperties.Name="Dynamic DNS">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Classes="glyph" Data="{StaticResource CfGlyphSync}"/>
                                        <TextBlock Text="{Binding DdnsChipText}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </Grid>

                        <Border Grid.Row="1" Classes="card output" Margin="0,12,0,0" ClipToBounds="True">
                            <Grid RowDefinitions="Auto, *">
                                <!-- column heads (wide only) — mirror the row template's columns -->
                                <Border x:Name="RecHeader" Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Border.Subtle}">
                                    <Grid ColumnDefinitions="Auto, 2*, 3*, Auto, Auto" ColumnSpacing="12" Margin="12,8,4,8">
                                        <TextBlock Grid.Column="0" Classes="colHead" Text="Type" Width="62"/>
                                        <TextBlock Grid.Column="1" Classes="colHead" Text="Name"/>
                                        <TextBlock Grid.Column="2" Classes="colHead" Text="Content"/>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12">
                                            <TextBlock Classes="colHead" Text="Proxy" Width="80" TextAlignment="Center"/>
                                            <TextBlock Classes="colHead" Text="TTL" Width="52" TextAlignment="Right"/>
                                        </StackPanel>
                                        <Border Grid.Column="4" Width="106"/>
                                    </Grid>
                                </Border>

                                <ListBox x:Name="RecordList" Grid.Row="1" ItemsSource="{Binding VisibleRecords}" SelectedItem="{Binding SelectedRecord}"
                                         Background="{DynamicResource Bg.Inset}" BorderThickness="0" Padding="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" DoubleTapped="OnRecordDoubleTapped">
                                    <ListBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding EditSelectedCommand}"/>
                                    </ListBox.KeyBindings>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CfRecord">
                                            <Panel>
                                                <Grid Classes="recRow" ColumnDefinitions="Auto, 2*, 3*, Auto, Auto" RowDefinitions="Auto, Auto"
                                                      ColumnSpacing="12" Margin="12,4,4,4">
                                                    <Border Grid.Column="0" Classes="badge accent recType">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding Type}"/>
                                                            <!-- phones: follows the public IP (the ↻ button is desktop-only) -->
                                                            <Panel Classes="ddnsMarkSlot">
                                                                <Path Classes="ddnsMark" Data="{StaticResource CfGlyphSync}" IsVisible="{Binding DdnsOn}"/>
                                                            </Panel>
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Classes="recName" Text="{Binding Name}"/>
                                                    <TextBlock Classes="recContent" Text="{Binding DisplayContent}"/>
                                                    <StackPanel Grid.Column="3" Classes="recMeta" VerticalAlignment="Center">
                                                        <Panel Width="80" HorizontalAlignment="Right">
                                                            <Button Classes="pill" Classes.on="{Binding Proxied}" IsVisible="{Binding CanProxy}" IsEnabled="{Binding IsIdle}"
                                                                    Command="{Binding $parent[UserControl].((vm:CloudflareViewModel)DataContext).ToggleProxiedCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip.Tip="Proxied (orange cloud) hides your origin's IP. Click to switch."
                                                                    Content="{Binding ProxiedText}"/>
                                                            <TextBlock Classes="dnsOnly" Text="DNS only" IsVisible="{Binding ShowDnsOnly}"/>
                                                        </Panel>
                                                        <TextBlock Classes="recTtl" Text="{Binding TtlText}" Width="52" HorizontalAlignment="Right"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="4" Classes="recActions" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <!-- dynamic DNS (A / AAAA only; an empty slot keeps the columns lined up) -->
                                                        <Panel Classes="ddnsSlot" Width="{DynamicResource Control.Height}">
                                                            <Button Classes="rowBtn ddns" Classes.on="{Binding DdnsOn}" Classes.err="{Binding DdnsError}"
                                                                    IsVisible="{Binding CanDdns}"
                                                                    Command="{Binding $parent[UserControl].((vm:CloudflareViewModel)DataContext).ToggleDdnsCommand}"
                                                                    CommandParameter="{Binding}" ToolTip.Tip="{Binding DdnsTip}"
                                                                    AutomationProperties.Name="Keep updated with my IP">
                                                                <Path Classes="glyph" Data="{StaticResource CfGlyphSync}"/>
                                                            </Button>
                                                        </Panel>
                                                        <Button Classes="rowBtn" IsEnabled="{Binding IsIdle}"
                                                                Command="{Binding $parent[UserControl].((vm:CloudflareViewModel)DataContext).EditRecordCommand}"
                                                                CommandParameter="{Binding}" ToolTip.Tip="Edit" AutomationProperties.Name="Edit record">
                                                            <Path Classes="glyph" Data="{StaticResource CfGlyphEdit}"/>
                                                        </Button>
                                                        <Button Classes="rowBtn del" IsEnabled="{Binding IsIdle}"
                                                                Command="{Binding $parent[UserControl].((vm:CloudflareViewModel)DataContext).RequestDeleteRecordCommand}"
                                                                CommandParameter="{Binding}" ToolTip.Tip="Delete" AutomationProperties.Name="Delete record">
                                                            <Path Classes="glyph" Data="{StaticResource CfGlyphTrash}"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- inline delete confirmation, over the row -->
                                                <Border Classes="confirm" IsVisible="{Binding PendingDelete}" Margin="6,3">
                                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                                        <TextBlock Classes="confirmText" Text="{Binding Name, StringFormat='Delete {0}?'}"
                                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                            <Button Classes="secondary" Content="Cancel"
                                                                    Command="{Binding $parent[UserControl].((vm:CloudflareViewModel)DataContext).CancelDeleteRecordCommand}"
                                                                    CommandParameter="{Binding}"/>
                                                            <Button Classes="danger" Content="Delete"
                                                                    Command="{Binding $parent[UserControl].((vm:CloudflareViewModel)DataContext).DeleteRecordCommand}"
                                                                    CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </Panel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- empty / loading / no match -->
                                <TextBlock Grid.Row="1" IsVisible="{Binding ShowRecordsEmpty}" IsHitTestVisible="False"
                                           Text="{Binding RecordsEmptyText}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                           Margin="24" FontSize="{StaticResource Font.Small}" Foreground="{DynamicResource Text.Muted}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ======================= SSL / TLS ======================= -->
                <TabItem Header="SSL/TLS">
                    <TabControl Classes="sub" SelectedIndex="{Binding SslTabIndex}">
                        <TabItem Header="Encryption">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel Classes="setStack" Spacing="12">
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SettingsState}"
                                                    IsVisible="{Binding CurrentSettings.ShowState, FallbackValue=False}"/>
                                    <!-- ECH first: on networks that block it, this is the switch that makes the site reachable -->
                                    <Border Classes="card setCard ech">
                                        <ItemsControl ItemsSource="{Binding CurrentSettings.EchRow, FallbackValue={x:Null}}" ItemTemplate="{StaticResource SettingRow}"/>
                                    </Border>
                                    <Border Classes="card setCard">
                                        <ItemsControl ItemsSource="{Binding CurrentSettings.SslModeRow, FallbackValue={x:Null}}" ItemTemplate="{StaticResource SettingRow}"/>
                                    </Border>
                                    <Border Classes="card setCard">
                                        <ItemsControl ItemsSource="{Binding CurrentSettings.SslRows, FallbackValue={x:Null}}" ItemTemplate="{StaticResource SettingRow}"/>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Edge certificates">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel Classes="setStack" Spacing="12">
                                    <TextBlock Classes="tabHint" Text="Loading certificates…"
                                               IsVisible="{Binding CurrentExtras.Certificates.ShowLoading, FallbackValue=False}"/>
                                    <Border Classes="note danger" IsVisible="{Binding CurrentExtras.Certificates.HasError, FallbackValue=False}">
                                        <TextBlock Text="{Binding CurrentExtras.Certificates.Error, FallbackValue=''}"/>
                                    </Border>
                                    <!-- Universal SSL + the certificate packs -->
                                    <Border Classes="card setCard" IsVisible="{Binding CurrentExtras.Certificates.ShowContent, FallbackValue=False}">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding CurrentExtras.Certificates.UniversalRow, FallbackValue={x:Null}}"
                                                          ItemTemplate="{StaticResource SettingRow}"/>
                                            <Border Classes="divider" IsVisible="{Binding CurrentExtras.Certificates.HasPacks, FallbackValue=False}"/>
                                            <ItemsControl ItemsSource="{Binding CurrentExtras.Certificates.Packs, FallbackValue={x:Null}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:CfCertPack">
                                                        <Border Classes="setRow certRow">
                                                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                                                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                                                    <TextBlock Classes="setTitle" Text="{Binding Hosts}"/>
                                                                    <TextBlock Classes="setDesc" Classes.warnText="{Binding ExpiresSoon}" Text="{Binding Details}"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                    <Border Classes="badge"><TextBlock Text="{Binding Type}"/></Border>
                                                                    <Border Classes="badge" Classes.success="{Binding IsActive}" Classes.warning="{Binding IsWarning}"
                                                                            Classes.danger="{Binding IsBad}">
                                                                        <TextBlock Text="{Binding Status}"/>
                                                                    </Border>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Classes="tabHint" Margin="16,12" Text="{Binding CurrentExtras.Certificates.PacksError, FallbackValue=''}"
                                                       IsVisible="{Binding CurrentExtras.Certificates.PacksError, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- HSTS (a zone setting) -->
                                    <Border Classes="card">
                                        <ItemsControl ItemsSource="{Binding CurrentSettings.HstsRow, FallbackValue={x:Null}}" ItemTemplate="{StaticResource HstsCard}"/>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </TabItem>

                <!-- ======================= SECURITY ======================= -->
                <TabItem Header="Security">
                    <TabControl Classes="sub" SelectedIndex="{Binding SecurityTabIndex}">
                        <TabItem Header="Settings">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel Classes="setStack" Spacing="12">
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SettingsState}"
                                                    IsVisible="{Binding CurrentSettings.ShowState, FallbackValue=False}"/>
                                    <Border Classes="card setCard" Classes.uamOn="{Binding CurrentSettings.UnderAttack.IsOn, FallbackValue=False}">
                                        <ItemsControl ItemsSource="{Binding CurrentSettings.UnderAttackRow, FallbackValue={x:Null}}" ItemTemplate="{StaticResource UnderAttackRow}"/>
                                    </Border>
                                    <Border Classes="card setCard">
                                        <ItemsControl ItemsSource="{Binding CurrentSettings.SecurityRows, FallbackValue={x:Null}}" ItemTemplate="{StaticResource SettingRow}"/>
                                    </Border>
                                    <!-- bots (their own endpoint) -->
                                    <TextBlock Classes="tabHint" Text="Loading bot settings…" IsVisible="{Binding CurrentExtras.Bot.ShowLoading, FallbackValue=False}"/>
                                    <Border Classes="note danger" IsVisible="{Binding CurrentExtras.Bot.HasError, FallbackValue=False}">
                                        <TextBlock Text="{Binding CurrentExtras.Bot.Error, FallbackValue=''}"/>
                                    </Border>
                                    <Border Classes="note" IsVisible="{Binding CurrentExtras.Bot.HasNote, FallbackValue=False}">
                                        <TextBlock Text="{Binding CurrentExtras.Bot.Note, FallbackValue=''}"/>
                                    </Border>
                                    <Border Classes="card setCard" IsVisible="{Binding !!CurrentExtras.Bot.Rows.Count, FallbackValue=False}">
                                        <ItemsControl ItemsSource="{Binding CurrentExtras.Bot.Rows, FallbackValue={x:Null}}" ItemTemplate="{StaticResource SettingRow}"/>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="WAF rules">
                            <ContentControl Content="{Binding CurrentExtras.Waf, FallbackValue={x:Null}}" ContentTemplate="{StaticResource RuleList}"/>
                        </TabItem>

                        <TabItem Header="IP access">
                            <Grid RowDefinitions="Auto, *">
                                <!-- add: the kind of value (IP, range, AS number, country) is recognized from the text itself -->
                                <Border Classes="card" Padding="12">
                                    <StackPanel Spacing="6">
                                        <Grid x:Name="AccessForm" ColumnDefinitions="2*, *, *, Auto" RowDefinitions="Auto, Auto" ColumnSpacing="8"
                                              helpers:Responsive.BreakWidth="560">
                                            <TextBox x:Name="AccessValueBox" Classes="field mono" Text="{Binding AccessInput}"
                                                     PlaceholderText="IP, range, ASN or country" helpers:InputAssist.SelectAllOnFocus="True"
                                                     ToolTip.Tip="An IP (192.0.2.7), a range (198.51.100.0/24), an AS number (AS13335) or a country (US)"
                                                     AutomationProperties.Name="IP, range, AS number or country">
                                                <TextBox.KeyBindings>
                                                    <KeyBinding Gesture="Enter" Command="{Binding AddAccessRuleCommand}"/>
                                                </TextBox.KeyBindings>
                                            </TextBox>
                                            <ComboBox x:Name="AccessModeBox" Classes="field" ItemsSource="{Binding AccessModeOptions}" SelectedItem="{Binding AccessMode}"
                                                      ToolTip.Tip="What happens to matching visitors">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:CfOption"><TextBlock Text="{Binding Label}"/></DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBox x:Name="AccessNoteBox" Classes="field" Text="{Binding AccessNote}" MaxLength="500">
                                                <TextBox.KeyBindings>
                                                    <KeyBinding Gesture="Enter" Command="{Binding AddAccessRuleCommand}"/>
                                                </TextBox.KeyBindings>
                                            </TextBox>
                                            <Button x:Name="AccessAddButton" Classes="primary" Command="{Binding AddAccessRuleCommand}"
                                                    IsEnabled="{Binding !IsAddingAccess}" Content="Add"/>
                                        </Grid>
                                        <TextBlock Classes="hint" Margin="2,0,0,0" Text="{Binding AccessDetected}"
                                                   IsVisible="{Binding AccessDetected, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        <TextBlock Classes="setError" Margin="2,0,0,0" Text="{Binding AccessError}" IsVisible="{Binding HasAccessError}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Classes="card output" Margin="0,12,0,0" ClipToBounds="True">
                                    <Panel>
                                        <ListBox Classes="plainList" ItemsSource="{Binding CurrentExtras.Access.Rules, FallbackValue={x:Null}}"
                                                 Background="{DynamicResource Bg.Inset}" BorderThickness="0" Padding="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:CfAccessRule">
                                                    <Panel>
                                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10" Margin="12,6,4,6">
                                                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                                                <TextBlock Classes="recName mono" Text="{Binding ValueText}"/>
                                                                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                                                                    <Border Classes="badge" Classes.danger="{Binding IsBlock}" Classes.success="{Binding IsAllow}"
                                                                            Classes.warning="{Binding IsChallenge}">
                                                                        <TextBlock Text="{Binding ModeText}"/>
                                                                    </Border>
                                                                    <TextBlock Grid.Column="1" Classes="recMeta" Text="{Binding Meta}"/>
                                                                </Grid>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Classes="rowBtn del" IsEnabled="{Binding IsIdle}" VerticalAlignment="Center"
                                                                    Command="{Binding $parent[UserControl].((vm:CloudflareViewModel)DataContext).RequestDeleteAccessCommand}"
                                                                    CommandParameter="{Binding}" ToolTip.Tip="Delete" AutomationProperties.Name="Delete rule">
                                                                <Path Classes="glyph" Data="{StaticResource CfGlyphTrash}"/>
                                                            </Button>
                                                        </Grid>
                                                        <Border Classes="confirm" IsVisible="{Binding PendingDelete}" Margin="6,3">
                                                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                                                <TextBlock Classes="confirmText" Text="{Binding Value, StringFormat='Delete the rule for {0}?'}"
                                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                                    <Button Classes="secondary" Content="Cancel"
                                                                            Command="{Binding $parent[UserControl].((vm:CloudflareViewModel)DataContext).CancelDeleteAccessCommand}"
                                                                            CommandParameter="{Binding}"/>
                                                                    <Button Classes="danger" Content="Delete"
                                                                            Command="{Binding $parent[UserControl].((vm:CloudflareViewModel)DataContext).DeleteAccessCommand}"
                                                                            CommandParameter="{Binding}"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </Panel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock Classes="emptyText" Text="Loading IP access rules…"
                                                   IsVisible="{Binding CurrentExtras.Access.ShowLoading, FallbackValue=False}"/>
                                        <TextBlock Classes="emptyText" Text="{Binding CurrentExtras.Access.Error, FallbackValue=''}"
                                                   Foreground="{DynamicResource Danger}" IsVisible="{Binding CurrentExtras.Access.HasError, FallbackValue=False}"/>
                                        <TextBlock Classes="emptyText" IsVisible="{Binding CurrentExtras.Access.IsEmpty, FallbackValue=False}"
                                                   Text="No IP access rules yet. Add an IP, a range, an AS number or a country above."/>
                                    </Panel>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </TabItem>

                <!-- ======================= SPEED & CACHE ======================= -->
                <TabItem AutomationProperties.Name="Speed and cache">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Speed"/>
                            <TextBlock Classes="wideOnly" Text=" &amp; cache"/>
                        </StackPanel>
                    </TabItem.Header>
                    <TabControl Classes="sub" SelectedIndex="{Binding SpeedTabIndex}">
                        <TabItem Header="Optimization">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel Classes="setStack" Spacing="12">
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SettingsState}"
                                                    IsVisible="{Binding CurrentSettings.ShowState, FallbackValue=False}"/>
                                    <Border Classes="card setCard">
                                        <ItemsControl ItemsSource="{Binding CurrentSettings.SpeedRows, FallbackValue={x:Null}}" ItemTemplate="{StaticResource SettingRow}"/>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Cache">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel Classes="setStack" Spacing="12">
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SettingsState}"
                                                    IsVisible="{Binding CurrentSettings.ShowState, FallbackValue=False}"/>

                                    <!-- purge -->
                                    <Border Classes="card" Padding="16,14">
                                        <StackPanel Spacing="12">
                                            <Grid x:Name="PurgeAllRow" ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" ColumnSpacing="12">
                                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                                    <TextBlock Classes="setTitle" Text="Purge everything"/>
                                                    <TextBlock Classes="setDesc" Text="Drops all cached files; expect more origin load for a while."
                                                               ToolTip.Tip="Drops every cached file of this site. Your origin serves the next requests, so expect more load for a while."/>
                                                </StackPanel>
                                                <Button Classes="danger" Content="Purge everything" Command="{Binding RequestPurgeAllCommand}" IsVisible="{Binding !PurgeAllConfirm}"
                                                        IsEnabled="{Binding !IsPurging}" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Border Classes="confirm" IsVisible="{Binding PurgeAllConfirm}">
                                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                                    <TextBlock Classes="confirmText" Text="{Binding SelectedZone.Name, StringFormat='Purge the whole cache of {0}?', FallbackValue=''}"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <Button Classes="secondary" Content="Cancel" Command="{Binding CancelPurgeAllCommand}"/>
                                                        <Button Classes="danger" Content="Purge" Command="{Binding PurgeAllCommand}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Border Classes="divider"/>

                                            <StackPanel Spacing="3">
                                                <TextBlock Classes="setTitle" Text="Purge by URL"/>
                                                <TextBlock Classes="setDesc" Text="One full URL per line."
                                                           ToolTip.Tip="One full URL per line (http:// or https://) on this site. They're sent 30 at a time."/>
                                            </StackPanel>
                                            <TextBox x:Name="PurgeUrlsBox" Classes="field multiline" Text="{Binding PurgeUrlsText}" AcceptsReturn="True" TextWrapping="NoWrap"
                                                     Height="112" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource Font.Small}"
                                                     helpers:InputAssist.PasteMode="Lines"
                                                     PlaceholderText="https://example.com/style.css&#10;https://example.com/images/logo.png"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                                            <TextBlock Classes="setError" Text="{Binding PurgeUrlsError}" IsVisible="{Binding HasPurgeUrlsError}" Margin="2,0,0,0"/>
                                            <Button Classes="secondary" Content="Purge URLs" Command="{Binding PurgeUrlsCommand}" IsEnabled="{Binding !IsPurging}"
                                                    HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Classes="card setCard">
                                        <ItemsControl ItemsSource="{Binding CurrentSettings.CacheRows, FallbackValue={x:Null}}" ItemTemplate="{StaticResource SettingRow}"/>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </TabItem>

                <!-- ======================= NETWORK ======================= -->
                <TabItem Header="Network">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Classes="setStack" Spacing="12">
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SettingsState}"
                                            IsVisible="{Binding CurrentSettings.ShowState, FallbackValue=False}"/>
                            <Border Classes="card setCard">
                                <ItemsControl ItemsSource="{Binding CurrentSettings.NetworkRows, FallbackValue={x:Null}}" ItemTemplate="{StaticResource SettingRow}"/>
                            </Border>

                            <!-- pause: exposes the origin, so it asks first -->
                            <Border Classes="card" Padding="16,14">
                                <StackPanel Spacing="10">
                                    <Grid x:Name="PauseRow" ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Classes="setTitle" Text="Pause Cloudflare"/>
                                            <TextBlock Classes="setDesc" Text="Traffic skips Cloudflare: your origin IP is public; SSL, cache and security stop."
                                                       ToolTip.Tip="While paused, visitors connect straight to your origin: its IP is public, and SSL, caching and security settings stop applying. DNS stays on Cloudflare."/>
                                            <TextBlock Classes="setNote" Text="Paused: traffic goes straight to your origin."
                                                       IsVisible="{Binding SelectedZone.Paused, FallbackValue=False}"/>
                                        </StackPanel>
                                        <Panel x:Name="PauseButtons" VerticalAlignment="Center" IsVisible="{Binding !PauseConfirm}">
                                            <Button Classes="danger" Content="Pause" Command="{Binding RequestPauseCommand}"
                                                    IsVisible="{Binding !SelectedZone.Paused, FallbackValue=True}" IsEnabled="{Binding !IsPausing}"/>
                                            <Button Classes="primary" Content="Resume" Command="{Binding RequestPauseCommand}"
                                                    IsVisible="{Binding SelectedZone.Paused, FallbackValue=False}" IsEnabled="{Binding !IsPausing}"/>
                                        </Panel>
                                    </Grid>
                                    <Border Classes="confirm" IsVisible="{Binding PauseConfirm}">
                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                            <TextBlock Classes="confirmText" Text="{Binding SelectedZone.Name, StringFormat='Pause Cloudflare on {0}? Your origin IP becomes public.', FallbackValue=''}"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Button Classes="secondary" Content="Cancel" Command="{Binding CancelPauseCommand}"/>
                                                <Button Classes="danger" Content="Pause" Command="{Binding ConfirmPauseCommand}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ======================= RULES (single redirects) ======================= -->
                <TabItem Header="Rules">
                    <ContentControl Content="{Binding CurrentExtras.Redirects, FallbackValue={x:Null}}" ContentTemplate="{StaticResource RuleList}"/>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- ============ NOT CONNECTED YET ============ -->
        <Border Grid.Row="2" Classes="card output" Margin="0,12,0,0" IsVisible="{Binding ShowEmptyCard}">
            <StackPanel MaxWidth="420" Spacing="8" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="44" Height="44" CornerRadius="{StaticResource Radius.Lg}" HorizontalAlignment="Center"
                        Background="{DynamicResource Bg.Raised}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                    <Path Classes="ico" Data="{StaticResource IcoCloudflare}" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock Classes="sectionTitle" Text="{Binding EmptyTitle}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding EmptyText}" FontSize="{StaticResource Font.Small}" Foreground="{DynamicResource Text.Muted}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" LineHeight="18"/>
                <WrapPanel HorizontalAlignment="Center" Margin="0,6,0,0" ItemSpacing="8" LineSpacing="8">
                    <!-- connect the active account (again) -->
                    <Button Classes="primary" Command="{Binding LoadZonesCommand}" Content="{Binding ConnectLabel}"
                            IsVisible="{Binding CanRetryConnect}"/>
                    <!-- no account yet: the form is folded away (Cancel isn't offered then, but keep a way back) -->
                    <Button Classes="primary" Command="{Binding AddAccountCommand}" Content="Add account"
                            IsVisible="{Binding !HasAccounts}"/>
                    <!-- the token works but has no zone: maybe there is none yet -->
                    <Button Classes="secondary" Command="{Binding OpenAddZoneCommand}" IsVisible="{Binding CanAddSiteFromEmpty}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Classes="glyph" Data="{StaticResource CfGlyphPlus}"/>
                            <TextBlock Text="Add a site" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Border>


        <!-- ============ STATUS ============ -->
        <Border x:Name="StatusBar" Grid.Row="3" Margin="0,12,0,0" Padding="12,8" CornerRadius="{StaticResource Radius.Md}" BorderThickness="1"
                Classes.error="{Binding StatusIsError}">
            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                <Ellipse Grid.Column="0" Classes="statusDot" Classes.busy="{Binding IsBusy}" Width="7" Height="7"
                         VerticalAlignment="Top" Margin="0,5,0,0"/>
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontSize="{StaticResource Font.Small}" TextWrapping="Wrap"/>
            </Grid>
        </Border>
      </Grid>

      <!-- ============ RECORD EDITOR — takes over the tool on a solid backdrop (no see-through overlay) ============ -->
      <Border IsVisible="{Binding IsEditorOpen}" Background="{DynamicResource Bg.App}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <Border Classes="card" Padding="24" MaxWidth="520" Margin="0,8" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                  <StackPanel Spacing="14">
                      <StackPanel Spacing="4">
                          <TextBlock Classes="sectionTitle" Text="Add record" IsVisible="{Binding IsNewRecord}"/>
                          <TextBlock Classes="sectionTitle" Text="Edit record" IsVisible="{Binding !IsNewRecord}"/>
                          <TextBlock Text="{Binding SelectedZone.Name, FallbackValue=''}" FontSize="{StaticResource Font.Small}"
                                     Foreground="{DynamicResource Text.Muted}"/>
                      </StackPanel>

                      <Grid x:Name="EdForm" ColumnDefinitions="*, 2*" RowDefinitions="Auto, Auto" ColumnSpacing="12"
                            helpers:Responsive.BreakWidth="380">
                          <StackPanel x:Name="EdTypeField">
                              <TextBlock Classes="fieldLabel" Text="Type"/>
                              <ComboBox Classes="field" ItemsSource="{Binding RecordTypes}" SelectedItem="{Binding NewRecordType}"
                                        FontFamily="{StaticResource MonoFont}" IsVisible="{Binding IsNewRecord}"/>
                              <!-- an existing record keeps its type -->
                              <TextBox Classes="field mono" Text="{Binding EditType, Mode=OneWay}" IsReadOnly="True" IsVisible="{Binding !IsNewRecord}"
                                       ToolTip.Tip="A record's type can't change: add a new record instead"/>
                          </StackPanel>
                          <StackPanel x:Name="EdNameField">
                              <TextBlock Classes="fieldLabel" Text="Name"/>
                              <TextBox Classes="field" helpers:InputAssist.SelectAllOnFocus="True" Text="{Binding EditName}"
                                       PlaceholderText="{Binding NamePlaceholder}"/>
                          </StackPanel>
                      </Grid>

                      <!-- content: one line (A, AAAA, CNAME, MX, NS, PTR) or text (TXT) -->
                      <StackPanel x:Name="EdContentField" IsVisible="{Binding ShowContentField}">
                          <TextBlock Classes="fieldLabel" Text="{Binding ContentLabel}"/>
                          <TextBox Classes="field mono" helpers:InputAssist.SelectAllOnFocus="True" Text="{Binding EditContent}"
                                   PlaceholderText="{Binding ContentPlaceholder}"/>
                      </StackPanel>
                      <StackPanel IsVisible="{Binding ShowTxtField}">
                          <TextBlock Classes="fieldLabel" Text="Content"/>
                          <TextBox Classes="field multiline mono" Text="{Binding EditContent}" TextWrapping="Wrap" Height="88"
                                   PlaceholderText="{Binding ContentPlaceholder}"/>
                      </StackPanel>
                      <!-- a type without fields here: shown, never sent -->
                      <StackPanel IsVisible="{Binding ShowReadOnlyContent}" Spacing="6">
                          <TextBlock Classes="fieldLabel" Text="Content" Margin="2,0,0,0"/>
                          <TextBox Classes="field multiline mono" Text="{Binding EditContent, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"/>
                          <TextBlock Classes="hint" Text="Not editable here; name, TTL and comment changes keep it as is."/>
                      </StackPanel>

                      <!-- CAA: flags, tag, value -->
                      <Grid IsVisible="{Binding ShowCaaFields}" ColumnDefinitions="*, 2*" RowDefinitions="Auto, Auto" ColumnSpacing="12" RowSpacing="12">
                          <StackPanel Grid.Column="0">
                              <TextBlock Classes="fieldLabel" Text="Flags"/>
                              <TextBox Classes="field mono" Text="{Binding EditCaaFlags}" PlaceholderText="0" ToolTip.Tip="0, or 128 for issuer critical"/>
                          </StackPanel>
                          <StackPanel Grid.Column="1">
                              <TextBlock Classes="fieldLabel" Text="Tag"/>
                              <ComboBox Classes="field" ItemsSource="{Binding CaaTags}" SelectedItem="{Binding EditCaaTag}"
                                        ToolTip.Tip="issue: who may issue certificates · issuewild: wildcard certificates · iodef: where to report"/>
                          </StackPanel>
                          <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                              <TextBlock Classes="fieldLabel" Text="Value"/>
                              <TextBox Classes="field mono" Text="{Binding EditCaaValue}" PlaceholderText="letsencrypt.org"/>
                          </StackPanel>
                      </Grid>

                      <!-- SRV: priority, weight, port, target -->
                      <Grid IsVisible="{Binding ShowSrvFields}" ColumnDefinitions="*, *, *" RowDefinitions="Auto, Auto" ColumnSpacing="12" RowSpacing="12">
                          <StackPanel Grid.Column="0">
                              <TextBlock Classes="fieldLabel" Text="Priority"/>
                              <TextBox Classes="field mono" Text="{Binding EditSrvPriority}" PlaceholderText="10"/>
                          </StackPanel>
                          <StackPanel Grid.Column="1">
                              <TextBlock Classes="fieldLabel" Text="Weight"/>
                              <TextBox Classes="field mono" Text="{Binding EditSrvWeight}" PlaceholderText="5"/>
                          </StackPanel>
                          <StackPanel Grid.Column="2">
                              <TextBlock Classes="fieldLabel" Text="Port"/>
                              <TextBox Classes="field mono" Text="{Binding EditSrvPort}" PlaceholderText="443"/>
                          </StackPanel>
                          <StackPanel Grid.Row="1" Grid.ColumnSpan="3">
                              <TextBlock Classes="fieldLabel" Text="Target"/>
                              <TextBox Classes="field mono" Text="{Binding EditSrvTarget}" PlaceholderText="sip.example.com"/>
                          </StackPanel>
                      </Grid>

                      <!-- TTL (+ MX priority) -->
                      <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                          <StackPanel Grid.Column="0">
                              <TextBlock Classes="fieldLabel" Text="TTL"/>
                              <ComboBox Classes="field" ItemsSource="{Binding TtlOptions}" SelectedItem="{Binding EditTtl}" IsEnabled="{Binding CanEditTtl}"
                                        ToolTip.Tip="How long resolvers may cache the answer. Proxied records are always Auto.">
                                  <ComboBox.ItemTemplate>
                                      <DataTemplate x:DataType="vm:CfOption"><TextBlock Text="{Binding Label}"/></DataTemplate>
                                  </ComboBox.ItemTemplate>
                              </ComboBox>
                          </StackPanel>
                          <StackPanel Grid.Column="1" IsVisible="{Binding ShowPriorityField}">
                              <TextBlock Classes="fieldLabel" Text="Priority"/>
                              <TextBox Classes="field mono" Text="{Binding EditPriority}" PlaceholderText="10" ToolTip.Tip="Lower is preferred (0–65535)"/>
                          </StackPanel>
                          <!-- beside the TTL: only A / AAAA / CNAME can be proxied, and only MX has a priority -->
                          <CheckBox Grid.Column="1" IsChecked="{Binding EditProxied}" IsVisible="{Binding ShowProxiedField}"
                                    VerticalAlignment="Bottom" Content="Proxied" AutomationProperties.Name="Proxied through Cloudflare"
                                    ToolTip.Tip="Proxied through Cloudflare (orange cloud): visitors reach Cloudflare instead of your origin, whose IP stays hidden. The TTL is then automatic."/>
                      </Grid>

                      <!-- dynamic DNS (A / AAAA): applied with Save -->
                      <StackPanel Spacing="4" IsVisible="{Binding ShowDdnsField}">
                          <CheckBox IsChecked="{Binding EditDdns}" Content="Keep updated with my IP"
                                    ToolTip.Tip="Dynamic DNS: Echoes points this record at this device's public IP and keeps it there"/>
                          <TextBlock Classes="hint" Margin="28,0,0,0" IsVisible="{Binding EditDdns}"
                                     Text="Checked every 5 min, using a device-encrypted token copy."
                                     ToolTip.Tip="Checked every 5 minutes while Echoes runs (also in the tray). Echoes keeps a device-encrypted copy of this account's token for it."/>
                      </StackPanel>

                      <StackPanel>
                          <TextBlock Classes="fieldLabel" Text="Comment"/>
                          <TextBox Classes="field" Text="{Binding EditComment}" PlaceholderText="Optional, not in DNS" MaxLength="500"/>
                      </StackPanel>

                      <Border Classes="note danger" IsVisible="{Binding HasEditorError}">
                          <TextBlock Text="{Binding EditorError}"/>
                      </Border>

                      <Border Classes="divider"/>

                      <Panel>
                          <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="8" IsVisible="{Binding !EditorDeleteConfirm}">
                              <!-- only an existing record can be deleted (a new one has no id yet) -->
                              <Button Grid.Column="0" Classes="ghost" Command="{Binding RequestEditorDeleteCommand}"
                                      IsVisible="{Binding !IsNewRecord}" IsEnabled="{Binding !IsSaving}" ToolTip.Tip="Delete this record">
                                  <StackPanel Orientation="Horizontal" Spacing="6">
                                      <Path Classes="glyph" Data="{StaticResource CfGlyphTrash}"/>
                                      <TextBlock Text="Delete" VerticalAlignment="Center"/>
                                  </StackPanel>
                              </Button>
                              <Button Grid.Column="2" Classes="ghost" Content="Cancel" Command="{Binding CancelEditCommand}"/>
                              <Button Grid.Column="3" Classes="primary" Command="{Binding SaveRecordCommand}" IsEnabled="{Binding !IsSaving}" MinWidth="88">
                                  <Panel>
                                      <TextBlock Text="Save" IsVisible="{Binding !IsSaving}"/>
                                      <TextBlock Text="Saving…" IsVisible="{Binding IsSaving}"/>
                                  </Panel>
                              </Button>
                          </Grid>
                          <Border Classes="confirm" IsVisible="{Binding EditorDeleteConfirm}">
                              <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                  <TextBlock Classes="confirmText" Text="Delete this record? This can't be undone."/>
                                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                      <Button Classes="secondary" Content="Cancel" Command="{Binding CancelEditorDeleteCommand}"/>
                                      <Button Classes="danger" Content="Delete" Command="{Binding DeleteEditedRecordCommand}"/>
                                  </StackPanel>
                              </Grid>
                          </Border>
                      </Panel>
                  </StackPanel>
              </Border>
          </ScrollViewer>
      </Border>

      <!-- ============ RESTORE — preview first, then progress, then a summary (solid backdrop) ============ -->
      <Border IsVisible="{Binding IsRestoreOpen}" Background="{DynamicResource Bg.App}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <Border Classes="card" Padding="24" MaxWidth="640" Margin="0,8" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                  <StackPanel Spacing="12">
                      <StackPanel Spacing="4">
                          <TextBlock Classes="sectionTitle" Text="Restore DNS records"/>
                          <TextBlock Text="{Binding RestoreSource}" FontSize="{StaticResource Font.Small}" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding RestoreTarget, StringFormat='Into {0}'}" FontSize="{StaticResource Font.Small}" Foreground="{DynamicResource Text.Muted}"/>
                      </StackPanel>

                      <!-- ===== preview ===== -->
                      <StackPanel Spacing="12" IsVisible="{Binding IsRestorePreview}">
                          <Border Classes="note warning" IsVisible="{Binding RestoreZoneDiffers}">
                              <StackPanel Spacing="8">
                                  <TextBlock Text="This backup is from another zone."/>
                                  <CheckBox IsChecked="{Binding RestoreRename}" Content="{Binding RestoreRenameText}"/>
                              </StackPanel>
                          </Border>
                          <UniformGrid Columns="3" ColumnSpacing="8">
                              <Border Classes="stat add">
                                  <StackPanel>
                                      <TextBlock Classes="statNum" Text="{Binding RestoreAdds}"/>
                                      <TextBlock Classes="statLabel" Text="to add"/>
                                  </StackPanel>
                              </Border>
                              <Border Classes="stat upd">
                                  <StackPanel>
                                      <TextBlock Classes="statNum" Text="{Binding RestoreUpdates}"/>
                                      <TextBlock Classes="statLabel" Text="to update"/>
                                  </StackPanel>
                              </Border>
                              <Border Classes="stat">
                                  <StackPanel>
                                      <TextBlock Classes="statNum" Text="{Binding RestorePresent}"/>
                                      <TextBlock Classes="statLabel" Text="unchanged" ToolTip.Tip="Already in the zone as in the backup"/>
                                  </StackPanel>
                              </Border>
                          </UniformGrid>
                          <Border Classes="note info">
                              <TextBlock Text="A restore only adds and updates; it never deletes."
                                         ToolTip.Tip="Records in the zone that aren't in the backup are left untouched. A restore never deletes anything."/>
                          </Border>
                          <TextBlock Classes="hint" Text="{Binding RestoreNotes}" IsVisible="{Binding RestoreNotes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                      </StackPanel>

                      <!-- ===== applying ===== -->
                      <StackPanel Spacing="8" IsVisible="{Binding IsRestoring}">
                          <TextBlock Text="{Binding RestoreProgressText}" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource Text.Primary}"/>
                          <ProgressBar Minimum="0" Maximum="1" Value="{Binding RestoreProgress}" IsIndeterminate="False" Height="6" MinHeight="0"/>
                      </StackPanel>

                      <!-- ===== done ===== -->
                      <StackPanel Spacing="10" IsVisible="{Binding IsRestoreDone}">
                          <Border Classes="note" Classes.success="{Binding !RestoreFailed}" Classes.danger="{Binding !!RestoreFailed}">
                              <TextBlock Text="{Binding RestoreSummary}"/>
                          </Border>
                      </StackPanel>

                      <!-- the decision first; the details follow -->
                      <Panel>
                          <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="8" IsVisible="{Binding IsRestorePreview}">
                              <Button Grid.Column="1" Classes="ghost" Content="Cancel" Command="{Binding CancelRestoreCommand}"/>
                              <Button Grid.Column="2" Classes="primary" Content="{Binding ApplyRestoreLabel}" Command="{Binding ApplyRestoreCommand}"
                                      IsEnabled="{Binding CanApplyRestore}"/>
                          </Grid>
                          <Grid ColumnDefinitions="*, Auto" IsVisible="{Binding IsRestoring}">
                              <Button Grid.Column="1" Classes="secondary" Content="Stop" Command="{Binding StopRestoreCommand}"
                                      ToolTip.Tip="Stop after the current record"/>
                          </Grid>
                          <Grid ColumnDefinitions="*, Auto" IsVisible="{Binding IsRestoreDone}">
                              <Button Grid.Column="1" Classes="primary" Content="Done" Command="{Binding FinishRestoreCommand}"/>
                          </Grid>
                      </Panel>

                      <!-- the planned changes and skipped entries (preview) / the failures (done) -->
                      <StackPanel IsVisible="{Binding !IsRestoring}">
                          <StackPanel Spacing="8" IsVisible="{Binding !!RestoreRows.Count}">
                              <Border Classes="divider" Margin="0,0,0,4"/>
                              <TextBlock Classes="fieldLabel" Text="Changes and skipped entries" IsVisible="{Binding IsRestorePreview}" Margin="0"/>
                              <TextBlock Classes="fieldLabel" Text="Not applied" IsVisible="{Binding IsRestoreDone}" Margin="0"/>
                              <ItemsControl ItemsSource="{Binding RestoreRows}">
                                  <ItemsControl.ItemTemplate>
                                      <DataTemplate x:DataType="vm:CfRestoreRow">
                                          <Border Classes="rrow">
                                              <Grid ColumnDefinitions="Auto, Auto, *" ColumnSpacing="10">
                                                  <Border Grid.Column="0" Classes="badge" Width="64" VerticalAlignment="Top"
                                                          Classes.accent="{Binding IsAdd}" Classes.info="{Binding IsUpdate}" Classes.danger="{Binding IsFailed}">
                                                      <TextBlock Text="{Binding Action}" HorizontalAlignment="Center"/>
                                                  </Border>
                                                  <TextBlock Grid.Column="1" Text="{Binding Type}" FontFamily="{StaticResource MonoFont}" Width="44"
                                                             FontSize="{StaticResource Font.Small}" Foreground="{DynamicResource Text.Secondary}" Margin="0,3,0,0"/>
                                                  <StackPanel Grid.Column="2" Spacing="2">
                                                      <TextBlock Text="{Binding Name}" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource Text.Primary}"
                                                                 TextTrimming="CharacterEllipsis"/>
                                                      <TextBlock Text="{Binding Content}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource Font.Small}"
                                                                 Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis"
                                                                 IsVisible="{Binding Content, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                      <TextBlock Text="{Binding Detail}" FontSize="{StaticResource Font.Small}" Foreground="{DynamicResource Text.Muted}"
                                                                 TextWrapping="Wrap" IsVisible="{Binding HasDetail}"/>
                                                  </StackPanel>
                                              </Grid>
                                          </Border>
                                      </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <TextBlock Classes="hint" Text="{Binding RestoreRowsMore}" IsVisible="{Binding RestoreRowsMore, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                          </StackPanel>
                      </StackPanel>
                  </StackPanel>
              </Border>
          </ScrollViewer>
      </Border>

      <!-- ============ RULE EDITOR (a custom rule or a redirect) — solid backdrop ============ -->
      <Border IsVisible="{Binding IsRuleEditorOpen}" Background="{DynamicResource Bg.App}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <Border Classes="card" Padding="24" MaxWidth="600" Margin="0,8" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                  <StackPanel Spacing="14">
                      <!-- title | the rule's on / off (top right, so it takes no row of its own) -->
                      <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                          <StackPanel Spacing="4">
                              <TextBlock Classes="sectionTitle" Text="{Binding RuleEditorTitle}"/>
                              <TextBlock Text="{Binding SelectedZone.Name, FallbackValue=''}" FontSize="{StaticResource Font.Small}"
                                         Foreground="{DynamicResource Text.Muted}"/>
                          </StackPanel>
                          <CheckBox Grid.Column="1" IsChecked="{Binding RuleEnabled}" Content="Rule on" VerticalAlignment="Top"
                                    ToolTip.Tip="The rule is on"/>
                      </Grid>

                      <ComboBox Classes="field" ItemsSource="{Binding RuleExamples}" SelectedItem="{Binding SelectedRuleExample}"
                                PlaceholderText="Start from an example…" ToolTip.Tip="Fills in the fields; change what you need"/>

                      <StackPanel>
                          <TextBlock Classes="fieldLabel" Text="Name"/>
                          <TextBox Classes="field" Text="{Binding RuleName}" PlaceholderText="What the rule is for" MaxLength="500"/>
                      </StackPanel>

                      <StackPanel>
                          <TextBlock Classes="fieldLabel" Text="When"/>
                          <TextBox Classes="field multiline mono" Text="{Binding RuleExpression}" AcceptsReturn="True" TextWrapping="Wrap" Height="96"
                                   FontSize="{StaticResource Font.Small}" PlaceholderText="(http.request.uri.path eq &quot;/login&quot;)"
                                   AutomationProperties.Name="When the request matches"
                                   ToolTip.Tip="Cloudflare's rule language: fields like ip.src, ip.src.country, http.host and http.request.uri.path; eq, ne, contains, in {…}; and, or, not."/>
                          <TextBlock Classes="hint" Margin="2,6,0,0"
                                     Text="Fields like ip.src, http.host, http.request.uri.path; eq, contains, in {…}; and, or."
                                     ToolTip.Tip="Cloudflare's rule language: fields like ip.src, ip.src.country, http.host and http.request.uri.path; eq, ne, contains, in {…}; and, or, not."/>
                      </StackPanel>

                      <!-- custom rule: what happens -->
                      <StackPanel IsVisible="{Binding ShowRuleAction}">
                          <TextBlock Classes="fieldLabel" Text="Then"/>
                          <ComboBox Classes="field" ItemsSource="{Binding RuleActionOptions}" SelectedItem="{Binding RuleAction}">
                              <ComboBox.ItemTemplate>
                                  <DataTemplate x:DataType="vm:CfOption"><TextBlock Text="{Binding Label}"/></DataTemplate>
                              </ComboBox.ItemTemplate>
                          </ComboBox>
                      </StackPanel>

                      <!-- redirect: where to, which status code, the query string -->
                      <StackPanel IsVisible="{Binding ShowRedirectFields}" Spacing="14">
                          <StackPanel>
                              <TextBlock Classes="fieldLabel" Text="Redirect to"/>
                              <TextBox Classes="field mono" Text="{Binding RuleTarget}" FontSize="{StaticResource Font.Small}"
                                       PlaceholderText="https://example.com/new-page  or  concat(…)"/>
                              <TextBlock Classes="hint" Margin="2,6,0,0" Text="{Binding RuleTargetKind}"
                                         IsVisible="{Binding RuleTargetKind, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                          </StackPanel>
                          <Grid x:Name="RuleBottom" ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="12"
                                helpers:Responsive.BreakWidth="420">
                              <StackPanel x:Name="RuleStatusField">
                                  <TextBlock Classes="fieldLabel" Text="Status code"/>
                                  <ComboBox Classes="field" ItemsSource="{Binding RedirectStatusOptions}" SelectedItem="{Binding RuleStatus}">
                                      <ComboBox.ItemTemplate>
                                          <DataTemplate x:DataType="vm:CfOption"><TextBlock Text="{Binding Label}"/></DataTemplate>
                                      </ComboBox.ItemTemplate>
                                  </ComboBox>
                              </StackPanel>
                              <CheckBox x:Name="RulePreserveBox" IsChecked="{Binding RulePreserveQuery}" Content="Keep query string"
                                        ToolTip.Tip="Keep the query string (?a=b) on the new URL"/>
                          </Grid>
                      </StackPanel>

                      <Border Classes="note danger" IsVisible="{Binding HasRuleError}">
                          <TextBlock Text="{Binding RuleError}"/>
                      </Border>

                      <Border Classes="divider"/>

                      <Panel>
                          <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="8" IsVisible="{Binding !RuleDeleteConfirm}">
                              <Button Grid.Column="0" Classes="ghost" Command="{Binding RequestRuleEditorDeleteCommand}"
                                      IsVisible="{Binding !IsNewRule}" IsEnabled="{Binding !IsSavingRule}" ToolTip.Tip="Delete this rule">
                                  <StackPanel Orientation="Horizontal" Spacing="6">
                                      <Path Classes="glyph" Data="{StaticResource CfGlyphTrash}"/>
                                      <TextBlock Text="Delete" VerticalAlignment="Center"/>
                                  </StackPanel>
                              </Button>
                              <Button Grid.Column="2" Classes="ghost" Content="Cancel" Command="{Binding CancelRuleEditorCommand}"/>
                              <Button Grid.Column="3" Classes="primary" Command="{Binding SaveRuleCommand}" IsEnabled="{Binding !IsSavingRule}" MinWidth="88">
                                  <Panel>
                                      <TextBlock Text="Save" IsVisible="{Binding !IsSavingRule}"/>
                                      <TextBlock Text="Saving…" IsVisible="{Binding IsSavingRule}"/>
                                  </Panel>
                              </Button>
                          </Grid>
                          <Border Classes="confirm" IsVisible="{Binding RuleDeleteConfirm}">
                              <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                  <TextBlock Classes="confirmText" Text="Delete this rule? This can't be undone."/>
                                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                      <Button Classes="secondary" Content="Cancel" Command="{Binding CancelRuleEditorDeleteCommand}"/>
                                      <Button Classes="danger" Content="Delete" Command="{Binding DeleteEditedRuleCommand}"/>
                                  </StackPanel>
                              </Grid>
                          </Border>
                      </Panel>
                  </StackPanel>
              </Border>
          </ScrollViewer>
      </Border>

      <!-- ============ DNSSEC — status, on / off, and the DS record for the registrar (solid backdrop) ============ -->
      <Border IsVisible="{Binding IsDnssecOpen}" Background="{DynamicResource Bg.App}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <Border Classes="card" Padding="24" MaxWidth="640" Margin="0,8" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                  <StackPanel Classes="page" Spacing="14" helpers:Responsive.BreakWidth="440">
                      <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                          <StackPanel Spacing="4">
                              <TextBlock Classes="sectionTitle" Text="DNSSEC"/>
                              <TextBlock Text="{Binding SelectedZone.Name, FallbackValue=''}" FontSize="{StaticResource Font.Small}"
                                         Foreground="{DynamicResource Text.Muted}"/>
                          </StackPanel>
                          <Border Grid.Column="1" Classes="badge" VerticalAlignment="Top" IsVisible="{Binding CurrentDnssec.IsLoaded, FallbackValue=False}"
                                  Classes.success="{Binding CurrentDnssec.IsActive, FallbackValue=False}"
                                  Classes.warning="{Binding CurrentDnssec.IsPending, FallbackValue=False}"
                                  Classes.danger="{Binding CurrentDnssec.IsError, FallbackValue=False}">
                              <TextBlock Text="{Binding CurrentDnssec.StatusText, FallbackValue=''}"/>
                          </Border>
                      </Grid>

                      <TextBlock Classes="tabHint" Text="Reading the DNSSEC status…" IsVisible="{Binding CurrentDnssec.ShowLoading, FallbackValue=False}"/>
                      <Border Classes="note danger" IsVisible="{Binding CurrentDnssec.HasError, FallbackValue=False}">
                          <TextBlock Text="{Binding CurrentDnssec.Error, FallbackValue=''}"/>
                      </Border>
                      <TextBlock Classes="pageText" Text="{Binding CurrentDnssec.Explanation, FallbackValue=''}"
                                 IsVisible="{Binding CurrentDnssec.IsLoaded, FallbackValue=False}"/>

                      <!-- what goes to the registrar -->
                      <StackPanel Spacing="4" IsVisible="{Binding CurrentDnssec.HasFields, FallbackValue=False}">
                          <TextBlock Classes="fieldLabel" Text="For your registrar" Margin="0,0,0,2"/>
                          <ItemsControl ItemsSource="{Binding CurrentDnssec.Fields, FallbackValue={x:Null}}" ItemTemplate="{StaticResource FieldRow}"/>
                          <TextBlock Classes="hint" Margin="0,6,0,0" Text="{Binding CurrentDnssec.Hint, FallbackValue=''}"
                                     IsVisible="{Binding CurrentDnssec.Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}"/>
                      </StackPanel>

                      <TextBlock Classes="setBusy" Text="Saving…" IsVisible="{Binding CurrentDnssec.IsBusy, FallbackValue=False}"/>
                      <Border Classes="divider"/>
                      <Panel>
                          <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8" IsVisible="{Binding !CurrentDnssec.ConfirmDisable, FallbackValue=True}">
                              <Panel Grid.Column="0">
                                  <Button Classes="primary" Content="Turn on DNSSEC" Command="{Binding EnableDnssecCommand}"
                                          IsVisible="{Binding CurrentDnssec.CanEnable, FallbackValue=False}"/>
                                  <Button Classes="danger" Content="Turn off DNSSEC" Command="{Binding RequestDisableDnssecCommand}"
                                          IsVisible="{Binding CurrentDnssec.CanDisable, FallbackValue=False}"/>
                              </Panel>
                              <Button Grid.Column="2" Classes="ghost" Content="Close" Command="{Binding CloseDnssecCommand}"/>
                          </Grid>
                          <Border Classes="confirm" IsVisible="{Binding CurrentDnssec.ConfirmDisable, FallbackValue=False}">
                              <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                  <TextBlock Classes="confirmText"
                                             Text="Remove the DS record at your registrar first, or the domain stops resolving. Turn DNSSEC off now?"/>
                                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                      <Button Classes="secondary" Content="Cancel" Command="{Binding CancelDisableDnssecCommand}"/>
                                      <Button Classes="danger" Content="Turn off" Command="{Binding DisableDnssecCommand}"/>
                                  </StackPanel>
                              </Grid>
                          </Border>
                      </Panel>
                  </StackPanel>
              </Border>
          </ScrollViewer>
      </Border>

      <!-- ============ DYNAMIC DNS — the records kept on this device's public IP (solid backdrop) ============
           The card takes the page's height; only the list scrolls. -->
      <Border IsVisible="{Binding IsDdnsOpen}" Background="{DynamicResource Bg.App}">
          <Border Classes="card" Padding="20" MaxWidth="640" MaxHeight="640" Margin="0,8"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
              <Grid x:Name="DdnsPage" RowDefinitions="Auto, Auto, *, Auto, Auto" RowSpacing="12" helpers:Responsive.BreakWidth="440">
                  <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                      <StackPanel Spacing="4">
                          <TextBlock Classes="sectionTitle" Text="Dynamic DNS"/>
                          <TextBlock Classes="pageText" Text="These A / AAAA records follow this device's public IP (checked every 5 min)."
                                     ToolTip.Tip="Echoes checks the IP every 5 minutes while it runs (in the tray too) and changes a record only when two IP services agree."/>
                      </StackPanel>
                      <!-- icon-only on a phone -->
                      <Button Grid.Column="1" Classes="secondary" Command="{Binding DdnsCheckNowCommand}" VerticalAlignment="Top"
                              IsEnabled="{Binding HasDdns}" ToolTip.Tip="Look up the public IP and check every record now"
                              AutomationProperties.Name="Check now">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                              <Path Classes="glyph" Data="{StaticResource CfGlyphRefresh}"/>
                              <TextBlock Classes="wideOnly" Text="Check now" VerticalAlignment="Center"/>
                          </StackPanel>
                      </Button>
                  </Grid>

                  <StackPanel Grid.Row="1" Spacing="8">
                      <TextBlock Classes="tabHint" Text="{Binding DdnsPublicText}"/>
                      <Border Classes="note warning" IsVisible="{Binding DdnsUnreadable}">
                          <TextBlock Text="Saved dynamic DNS records can't be read now (device key unavailable). They're kept; restart Echoes."/>
                      </Border>
                  </StackPanel>

                  <Border Grid.Row="2" Classes="card output" ClipToBounds="True">
                      <Panel>
                          <ScrollViewer x:Name="DdnsList" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasDdns}">
                              <ItemsControl ItemsSource="{Binding DdnsRows}">
                                  <ItemsControl.ItemTemplate>
                                      <DataTemplate x:DataType="vm:CfDdnsRow">
                                          <Border Classes="ddnsRow">
                                              <Grid ColumnDefinitions="Auto, *, Auto, Auto" RowDefinitions="Auto, Auto, Auto, Auto" ColumnSpacing="10">
                                                  <Border Grid.Column="0" Classes="badge accent recType ddnsType" VerticalAlignment="Center">
                                                      <TextBlock Text="{Binding Type}"/>
                                                  </Border>
                                                  <TextBlock Grid.Column="1" Classes="recName" Text="{Binding Title}"/>
                                                  <Border Grid.Column="2" Classes="badge" VerticalAlignment="Center"
                                                          Classes.success="{Binding IsOk}" Classes.warning="{Binding IsWarn}" Classes.danger="{Binding IsBad}">
                                                      <TextBlock Text="{Binding StatusText}"/>
                                                  </Border>
                                                  <Button Grid.Column="3" Grid.RowSpan="2" Classes="rowBtn del" VerticalAlignment="Top"
                                                          Command="{Binding $parent[UserControl].((vm:CloudflareViewModel)DataContext).RemoveDdnsCommand}"
                                                          CommandParameter="{Binding}" AutomationProperties.Name="Stop updating this record"
                                                          ToolTip.Tip="Stop updating this record (the record itself stays). Deletes its saved token copy.">
                                                      <Path Classes="glyph" Data="{StaticResource CfGlyphTrash}"/>
                                                  </Button>
                                                  <!-- phone: the type badge gives its room to the name; the type leads this line instead -->
                                                  <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,3,0,0" Classes="ddnsWhere wideOnly"
                                                             FontSize="{StaticResource Font.Small}" Foreground="{DynamicResource Text.Muted}"
                                                             TextTrimming="CharacterEllipsis">
                                                      <Run Text="{Binding IpText}" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Text.Secondary}"/>
                                                      <Run Text="  ·  "/>
                                                      <Run Text="{Binding Where}"/>
                                                  </TextBlock>
                                                  <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,3,0,0" Classes="ddnsWhere narrowOnly"
                                                             FontSize="{StaticResource Font.Small}" Foreground="{DynamicResource Text.Muted}"
                                                             TextTrimming="CharacterEllipsis">
                                                      <Run Text="{Binding Type}" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Accent.Text}"/>
                                                      <Run Text="  "/>
                                                      <Run Text="{Binding IpText}" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Text.Secondary}"/>
                                                      <Run Text="  ·  "/>
                                                      <Run Text="{Binding Where}"/>
                                                  </TextBlock>
                                                  <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,2,0,0" Classes="hint"
                                                             Text="{Binding WhenText}"/>
                                                  <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,4,0,0" Classes="ddnsMsg"
                                                             Classes.warn="{Binding IsWarn}" Classes.bad="{Binding IsBad}"
                                                             Text="{Binding Message}" IsVisible="{Binding HasMessage}"/>
                                              </Grid>
                                          </Border>
                                      </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                              </ItemsControl>
                          </ScrollViewer>
                          <TextBlock Classes="emptyText" IsVisible="{Binding !HasDdns}"
                                     Text="No record follows your IP yet. Use ↻ on an A or AAAA record, or tick &quot;Keep updated with my IP&quot; in its editor."/>
                      </Panel>
                  </Border>

                  <Border Grid.Row="3" Classes="note info">
                      <TextBlock Text="A device-encrypted token copy keeps updates running while Echoes is locked; removing the record or account deletes it. Needs Zone → DNS : Edit."/>
                  </Border>

                  <Grid Grid.Row="4" ColumnDefinitions="*, Auto">
                      <Button Grid.Column="1" Classes="primary" Content="Close" Command="{Binding CloseDdnsCommand}" MinWidth="88"/>
                  </Grid>
              </Grid>
          </Border>
      </Border>

      <!-- ============ IMPORT A BIND ZONE FILE — preview first, then the result (solid backdrop) ============ -->
      <Border IsVisible="{Binding IsImportOpen}" Background="{DynamicResource Bg.App}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <Border Classes="card" Padding="24" MaxWidth="640" Margin="0,8" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                  <StackPanel Spacing="12">
                      <StackPanel Spacing="4">
                          <TextBlock Classes="sectionTitle" Text="Import a BIND zone file"/>
                          <TextBlock Text="{Binding ImportSource}" FontSize="{StaticResource Font.Small}" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding SelectedZone.Name, StringFormat='Into {0}', FallbackValue=''}" FontSize="{StaticResource Font.Small}"
                                     Foreground="{DynamicResource Text.Muted}"/>
                      </StackPanel>

                      <!-- ===== preview ===== -->
                      <StackPanel Spacing="12" IsVisible="{Binding IsImportPreview}">
                          <UniformGrid Columns="3" ColumnSpacing="8">
                              <Border Classes="stat add">
                                  <StackPanel>
                                      <TextBlock Classes="statNum" Text="{Binding ImportNew}"/>
                                      <TextBlock Classes="statLabel" Text="to add"/>
                                  </StackPanel>
                              </Border>
                              <Border Classes="stat">
                                  <StackPanel>
                                      <TextBlock Classes="statNum" Text="{Binding ImportExisting}"/>
                                      <TextBlock Classes="statLabel" Text="in the zone"/>
                                  </StackPanel>
                              </Border>
                              <Border Classes="stat">
                                  <StackPanel>
                                      <TextBlock Classes="statNum" Text="{Binding ImportSkipped}"/>
                                      <TextBlock Classes="statLabel" Text="skipped"/>
                                  </StackPanel>
                              </Border>
                          </UniformGrid>
                          <CheckBox IsChecked="{Binding ImportProxied}" Content="Proxy new records (orange cloud)"
                                    ToolTip.Tip="Proxy the new A, AAAA and CNAME records. Off: they're added as DNS only, as at your old DNS host. Lines with cf_tags=cf-proxied keep their own setting."/>
                          <Border Classes="note info">
                              <TextBlock Text="Only new records are sent; nothing in the zone is changed or deleted."/>
                          </Border>
                          <TextBlock Classes="hint" Text="{Binding ImportNotes}" IsVisible="{Binding ImportNotes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                      </StackPanel>

                      <!-- ===== sending ===== -->
                      <TextBlock IsVisible="{Binding IsImporting}" Text="Importing…" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource Text.Primary}"/>

                      <!-- ===== done ===== -->
                      <Border Classes="note" Classes.success="{Binding !ImportFailed}" Classes.danger="{Binding ImportFailed}" IsVisible="{Binding IsImportDone}">
                          <TextBlock Text="{Binding ImportSummary}"/>
                      </Border>

                      <Panel>
                          <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="8" IsVisible="{Binding IsImportPreview}">
                              <Button Grid.Column="1" Classes="ghost" Content="Cancel" Command="{Binding CancelImportCommand}"/>
                              <Button Grid.Column="2" Classes="primary" Content="{Binding ApplyImportLabel}" Command="{Binding ApplyImportCommand}"
                                      IsEnabled="{Binding CanApplyImport}"/>
                          </Grid>
                          <Grid ColumnDefinitions="*, Auto" IsVisible="{Binding IsImportDone}">
                              <Button Grid.Column="1" Classes="primary" Content="Done" Command="{Binding FinishImportCommand}"/>
                          </Grid>
                      </Panel>

                      <!-- the records in the file: what is added, what is skipped and why -->
                      <StackPanel Spacing="8" IsVisible="{Binding IsImportPreview}">
                          <StackPanel Spacing="8" IsVisible="{Binding !!ImportRows.Count}">
                              <Border Classes="divider" Margin="0,0,0,4"/>
                              <TextBlock Classes="fieldLabel" Text="Records in the file" Margin="0"/>
                              <ItemsControl ItemsSource="{Binding ImportRows}" ItemTemplate="{StaticResource ChangeRow}"/>
                              <TextBlock Classes="hint" Text="{Binding ImportRowsMore}" IsVisible="{Binding ImportRowsMore, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                          </StackPanel>
                      </StackPanel>
                  </StackPanel>
              </Border>
          </ScrollViewer>
      </Border>

      <!-- ============ ADD A SITE — the domain, then its name servers (solid backdrop) ============ -->
      <Border IsVisible="{Binding IsAddZoneOpen}" Background="{DynamicResource Bg.App}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <Border Classes="card" Padding="24" MaxWidth="520" Margin="0,8" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                  <StackPanel Classes="page" Spacing="14" helpers:Responsive.BreakWidth="440">
                      <StackPanel Spacing="4">
                          <TextBlock Classes="sectionTitle" Text="Add a site"/>
                          <TextBlock Classes="pageText" Text="It stays pending until its name servers point to Cloudflare."/>
                      </StackPanel>

                      <!-- the form -->
                      <StackPanel Spacing="12" IsVisible="{Binding IsAddZoneForm}">
                          <StackPanel>
                              <TextBlock Classes="fieldLabel" Text="Domain"/>
                              <TextBox Classes="field" Text="{Binding NewZoneName}" PlaceholderText="example.com" helpers:InputAssist.SelectAllOnFocus="True">
                                  <TextBox.KeyBindings>
                                      <KeyBinding Gesture="Enter" Command="{Binding AddZoneCommand}"/>
                                  </TextBox.KeyBindings>
                              </TextBox>
                          </StackPanel>
                          <StackPanel IsVisible="{Binding ShowAccountPicker}">
                              <TextBlock Classes="fieldLabel" Text="Account"/>
                              <ComboBox Classes="field" ItemsSource="{Binding Accounts}" SelectedItem="{Binding NewZoneAccount}">
                                  <ComboBox.ItemTemplate>
                                      <DataTemplate x:DataType="vm:CfOption"><TextBlock Text="{Binding Label}"/></DataTemplate>
                                  </ComboBox.ItemTemplate>
                              </ComboBox>
                          </StackPanel>
                          <TextBlock Classes="tabHint" Text="Looking up your account…" IsVisible="{Binding IsLoadingAccounts}"/>
                          <Border Classes="note danger" IsVisible="{Binding HasAddZoneError}">
                              <TextBlock Text="{Binding AddZoneError}"/>
                          </Border>
                          <TextBlock Classes="hint" Text="Needs Zone → Zone : Edit on all zones of an account."
                                     ToolTip.Tip="The token needs Zone → Zone : Edit with Zone Resources set to All zones from an account."/>
                          <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="8">
                              <Button Grid.Column="1" Classes="ghost" Content="Cancel" Command="{Binding CloseAddZoneCommand}"/>
                              <Button Grid.Column="2" Classes="primary" Command="{Binding AddZoneCommand}" IsEnabled="{Binding !IsAddingZone}" MinWidth="88">
                                  <Panel>
                                      <TextBlock Text="Add site" IsVisible="{Binding !IsAddingZone}"/>
                                      <TextBlock Text="Adding…" IsVisible="{Binding IsAddingZone}"/>
                                  </Panel>
                              </Button>
                          </Grid>
                      </StackPanel>

                      <!-- added: the name servers to set at the registrar -->
                      <StackPanel Spacing="12" IsVisible="{Binding IsAddZoneDone}">
                          <Border Classes="note success">
                              <TextBlock Text="{Binding AddedZone.Name, StringFormat='{}{0} is on Cloudflare now, waiting for its name servers.', FallbackValue=''}"/>
                          </Border>
                          <TextBlock Classes="pageText" Text="Set these name servers at your registrar. The site turns active once Cloudflare sees them (minutes to a day)."/>
                          <ItemsControl ItemsSource="{Binding AddedZoneFields}" ItemTemplate="{StaticResource FieldRow}"/>
                          <TextBlock Classes="hint" Text="Next: add DNS records, or import a zone file (DNS → ⋯ → Import)."/>
                          <Grid ColumnDefinitions="*, Auto">
                              <Button Grid.Column="1" Classes="primary" Content="Open the site" Command="{Binding CloseAddZoneCommand}"/>
                          </Grid>
                      </StackPanel>
                  </StackPanel>
              </Border>
          </ScrollViewer>
      </Border>
    </Panel>
</UserControl>
