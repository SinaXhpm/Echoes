<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Echoes.ViewModels"
             x:Class="Echoes.Views.PingView"
             x:DataType="vm:PingViewModel"
             x:CompileBindings="True">

    <Grid RowDefinitions="Auto, Auto, *, Auto" Margin="12">
        
        <Grid Grid.Row="0" ColumnDefinitions="*, 100" Margin="0,0,0,12">
            <AutoCompleteBox Grid.Column="0" Classes="field"
                     Text="{Binding TargetHost}"
                     ItemsSource="{Binding TargetHostHistory}"
                     FilterMode="ContainsOrdinal"
                     MinimumPrefixLength="0"
                     Watermark="Enter Host or IP (e.g. 8.8.8.8)"
                     Margin="0,0,8,0">
                <AutoCompleteBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding TogglePingCommand}" />
                </AutoCompleteBox.KeyBindings>
            </AutoCompleteBox>

            <Button Grid.Column="1" Classes="toggle"
                    Command="{Binding TogglePingCommand}"
                    HorizontalAlignment="Stretch"
                    Classes.active="{Binding IsPinging}">
                <Panel>
                    <TextBlock Text="START" IsVisible="{Binding !IsPinging}" FontSize="12"/>
                    <TextBlock Text="STOP" IsVisible="{Binding IsPinging}" FontSize="12"/>
                </Panel>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="20" Margin="5,0,0,12">
            <CheckBox IsChecked="{Binding IsTraceRoute}" Content="Trace Route" FontSize="11.5" Foreground="White" FontWeight="SemiBold"/>
            <CheckBox IsChecked="{Binding NotifyOnline}" Content="Alert Online" FontSize="11.5" Foreground="White" FontWeight="SemiBold"/>
            <CheckBox IsChecked="{Binding NotifyOffline}" Content="Alert Offline" FontSize="11.5" Foreground="White" FontWeight="SemiBold"/>
        </StackPanel>

        <Border Grid.Row="2" Classes="card output">
            <ListBox Name="LogList"
                     ItemsSource="{Binding LogItems}"
                     Background="Transparent"
                     BorderThickness="0"
                     FontSize="11.5"
                     Foreground="#00FF99"
                     FontFamily="Cascadia Code,Consolas,Monospace">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="4,2"/>
                        <Setter Property="MinHeight" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#25FFFFFF"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </Border>

        <Button Grid.Row="2" Classes="ghost" Command="{Binding CopyLogCommand}" Content="COPY"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,14,0"
                Height="26" FontSize="9" Padding="10,0"/>

        <Border Grid.Row="3" Margin="0,12,0,0" Padding="10,6" Background="#2AFFFFFF" CornerRadius="8" BorderThickness="1" BorderBrush="#40FFFFFF">
            <TextBlock Text="{Binding StatsSummary}" FontSize="11.5" FontFamily="Consolas" Foreground="White" FontWeight="Medium"/>
        </Border>
    </Grid>
</UserControl>