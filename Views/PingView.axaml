<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Echoes.ViewModels"
             x:Class="Echoes.Views.PingView"
             x:DataType="vm:PingViewModel"
             x:CompileBindings="True">

    <Grid RowDefinitions="Auto, Auto, *, Auto" Margin="12">
        
        <Grid Grid.Row="0" ColumnDefinitions="*, 100" Margin="0,0,0,12">
            <TextBox Grid.Column="0"
                     Text="{Binding TargetHost}"
                     Watermark="Enter Host or IP (e.g. 8.8.8.8)"
                     FontSize="12" Height="34"
                     VerticalContentAlignment="Center"
                     Foreground="White"
                     Background="#25000000"
                     BorderBrush="#60FFFFFF"
                     Margin="0,0,8,0">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding TogglePingCommand}" />
                </TextBox.KeyBindings>
            </TextBox>

            <Button Grid.Column="1"
                    Command="{Binding TogglePingCommand}"
                    Height="34" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Classes.active="{Binding IsPinging}"> 
                <Button.Styles>
                    <Style Selector="Button">
                        <Setter Property="Background" Value="#42B883"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Transitions">
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.2"/>
                            </Transitions>
                        </Setter>
                    </Style>

                    <Style Selector="Button.active">
                        <Setter Property="Background" Value="#FF3333"/>
                    </Style>

                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#52C893"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Style>
                    <Style Selector="Button.active:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#FF5555"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Style>
                </Button.Styles>

                <Panel>
                    <TextBlock Text="START" IsVisible="{Binding !IsPinging}" FontSize="12"/>
                    <TextBlock Text="STOP" IsVisible="{Binding IsPinging}" FontSize="12"/>
                </Panel>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="20" Margin="5,0,0,12">
            <CheckBox IsChecked="{Binding IsTraceRoute}" Content="Trace Route" FontSize="11.5" Foreground="White" FontWeight="SemiBold"/>
            <CheckBox IsChecked="{Binding NotifyOnline}" Content="Alert Online" FontSize="11.5" Foreground="White" FontWeight="SemiBold"/>
            <CheckBox IsChecked="{Binding NotifyOffline}" Content="Alert Offline" FontSize="11.5" Foreground="White" FontWeight="SemiBold"/>
        </StackPanel>

        <Border Grid.Row="2" Background="#40000000" CornerRadius="4" BorderThickness="1" BorderBrush="#35FFFFFF">
            <ListBox Name="LogList"
                     ItemsSource="{Binding LogItems}"
                     Background="Transparent"
                     BorderThickness="0"
                     FontSize="11.5"
                     Foreground="#00FF99"
                     FontFamily="Cascadia Code,Consolas,Monospace">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="4,2"/>
                        <Setter Property="MinHeight" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#25FFFFFF"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </Border>

        <Border Grid.Row="3" Margin="0,12,0,0" Padding="10,6" Background="#2AFFFFFF" CornerRadius="4" BorderThickness="1" BorderBrush="#50FFFFFF">
            <TextBlock Text="{Binding StatsSummary}" FontSize="11.5" FontFamily="Consolas" Foreground="White" FontWeight="Medium"/>
        </Border>
    </Grid>
</UserControl>