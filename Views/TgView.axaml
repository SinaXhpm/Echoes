<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Echoes.ViewModels"
             x:Class="Echoes.Views.TgView"
             x:DataType="vm:TgViewModel">

    <Grid RowDefinitions="Auto, Auto, *" Margin="12">

        <Grid Grid.Row="0" ColumnDefinitions="*, 105" Margin="0,0,0,12">
            <TextBox Text="{Binding BotToken}"
                     Watermark="Bot Token (e.g. 123456:ABC-DEF)"
                     Height="34" FontSize="12"
                     VerticalContentAlignment="Center"
                     Foreground="White"
                     Background="#25000000" 
                     BorderBrush="#60FFFFFF"
                     PasswordChar="*">
                <TextBox.KeyBindings>
                    <KeyBinding Command="{Binding ExecuteTgCommand}" Gesture="Enter"/>
                </TextBox.KeyBindings>
            </TextBox>
            
            <Button Grid.Column="1"
                    Content="EXECUTE"
                    Command="{Binding ExecuteTgCommand}"
                    IsDefault="True"
                    IsEnabled="{Binding !IsBusy}"
                    Height="34" HorizontalAlignment="Stretch"
                    Margin="8,0,0,0"
                    Background="#42B883"
                    Foreground="White"
                    FontSize="12"
                    FontWeight="Bold"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
                <Button.Styles>
                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#52C893"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Style>
                    <Style Selector="Button:disabled /template/ ContentPresenter">
                        <Setter Property="Background" Value="#2D4D3D"/>
                        <Setter Property="Opacity" Value="0.6"/>
                    </Style>
                </Button.Styles>
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*, *" Margin="0,0,0,12">
            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding AvailableMethods}"
                      SelectedItem="{Binding SelectedMethod}"
                      HorizontalAlignment="Stretch"
                      Height="34" FontSize="11.5"
                      Background="#25000000"
                      BorderBrush="#45FFFFFF"
                      Margin="0,0,8,0"/>
            
            <TextBox Grid.Column="1"
                     Text="{Binding ProxyAddress}"
                     Height="34" FontSize="12"
                     VerticalContentAlignment="Center"
                     Foreground="White"
                     Background="#25000000"
                     BorderBrush="#45FFFFFF"
                     Watermark="Proxy (e.g. http://127.0.0.1:1080)"/>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*, *">
            <Border Grid.Column="0" Margin="0,0,8,0" 
                    Background="#30000000" CornerRadius="4" 
                    BorderThickness="1" BorderBrush="#35FFFFFF">
                <TextBox Text="{Binding CustomParameters}"
                         AcceptsReturn="True"
                         Watermark="Method Parameters (key=value)"
                         FontFamily="Cascadia Code,Consolas,Monospace"
                         FontSize="11.5"
                         Foreground="#FFFFFF"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="12"/>
            </Border>

            <Border Grid.Column="1" 
                    Background="#40000000" CornerRadius="4" 
                    BorderThickness="1" BorderBrush="#35FFFFFF">
                <TextBox Text="{Binding ResponseLog}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         FontFamily="Cascadia Code,Consolas,Monospace"
                         Background="Transparent"
                         Foreground="#00FF99"
                         FontSize="11.5"
                         BorderThickness="0"
                         Padding="12"/>
            </Border>
        </Grid>

    </Grid>
</UserControl>