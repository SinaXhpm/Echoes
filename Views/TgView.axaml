<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Echoes.ViewModels"
             x:Class="Echoes.Views.TgView"
             x:DataType="vm:TgViewModel">

    <UserControl.Styles>
        <Style Selector="Button.mini">
            <Setter Property="Background" Value="#20222A"/>
            <Setter Property="Foreground" Value="#C7C8CF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.mini:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2C2F38"/>
            <Setter Property="Foreground" Value="#ECECEF"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, Auto, *" Margin="14" Background="#0F1012">

        <!-- Token + execute -->
        <Grid Grid.Row="0" ColumnDefinitions="*, 120" ColumnSpacing="10" Margin="0,0,0,10">
            <StackPanel Grid.Column="0">
                <TextBlock Classes="fieldLabel" Text="BOT TOKEN"/>
                <TextBox Classes="field"
                         Text="{Binding BotToken}"
                         PlaceholderText="123456:ABC-DEF1234ghIkl..."
                         PasswordChar="●">
                    <TextBox.KeyBindings>
                        <KeyBinding Command="{Binding ExecuteTgCommand}" Gesture="Enter"/>
                    </TextBox.KeyBindings>
                </TextBox>
            </StackPanel>

            <Button Grid.Column="1"
                    Classes="primary"
                    Command="{Binding ExecuteTgCommand}"
                    IsDefault="True"
                    IsEnabled="{Binding !IsBusy}"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Stretch">
                <Panel>
                    <TextBlock Text="EXECUTE" IsVisible="{Binding !IsBusy}"/>
                    <TextBlock Text="· · ·" IsVisible="{Binding IsBusy}"/>
                </Panel>
            </Button>
        </Grid>

        <!-- Method + proxy -->
        <Grid Grid.Row="1" ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,0,0,10">
            <StackPanel Grid.Column="0">
                <TextBlock Classes="fieldLabel" Text="METHOD"/>
                <ComboBox Classes="field"
                          ItemsSource="{Binding AvailableMethods}"
                          SelectedItem="{Binding SelectedMethod}"
                          HorizontalAlignment="Stretch"/>
                <TextBlock FontSize="9.5" Foreground="#6E6F78" FontFamily="Cascadia Code,Consolas" Margin="2,4,0,0"
                           TextTrimming="CharacterEllipsis">
                    <Run Text="POST api.telegram.org/bot…/"/><Run Text="{Binding SelectedMethod}" Foreground="#9E9FA8"/>
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Classes="fieldLabel" Text="PROXY (OPTIONAL)"/>
                <AutoCompleteBox Classes="field"
                         Text="{Binding ProxyAddress}"
                         ItemsSource="{Binding ProxyHistory}" FilterMode="ContainsOrdinal" MinimumPrefixLength="0"
                         PlaceholderText="http://127.0.0.1:1080"/>
            </StackPanel>
        </Grid>

        <!-- Params / Response are tabbed so the active one gets the full area -->
        <TabControl Grid.Row="2" Padding="0,4,0,0">
            <TabControl.Styles>
                <Style Selector="TabItem">
                    <Setter Property="FontSize" Value="11.5"/>
                    <Setter Property="MinHeight" Value="30"/>
                    <Setter Property="Padding" Value="14,0"/>
                    <Setter Property="Foreground" Value="#9E9FA8"/>
                </Style>
                <Style Selector="TabItem:selected">
                    <Setter Property="Foreground" Value="#55C795"/>
                </Style>
            </TabControl.Styles>

            <TabItem Header="PARAMETERS">
                <Border Classes="card">
                    <TextBox Text="{Binding CustomParameters}"
                             AcceptsReturn="True"
                             PlaceholderText="key=value&#x0a;chat_id=123&#x0a;text=Hello"
                             FontFamily="Cascadia Code,Consolas"
                             FontSize="12"
                             Foreground="#ECECEF"
                             CaretBrush="#42B883"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="12"/>
                </Border>
            </TabItem>

            <TabItem Header="RESPONSE">
                <Border Classes="card output">
                    <Grid RowDefinitions="Auto, *">
                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="0,6,8,4">
                            <Button Classes="mini" Content="COPY" Command="{Binding CopyResponseCommand}"/>
                            <Button Classes="mini" Content="CLEAR" Command="{Binding ClearResponseCommand}"/>
                        </StackPanel>
                        <TextBox Grid.Row="1" Text="{Binding ResponseLog}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 FontFamily="Cascadia Code,Consolas"
                                 Background="Transparent"
                                 Foreground="#55C795"
                                 FontSize="12"
                                 BorderThickness="0"
                                 Padding="12,0,12,12"/>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

    </Grid>
</UserControl>
