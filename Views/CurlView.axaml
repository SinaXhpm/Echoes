<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Echoes.ViewModels"
             xmlns:helpers="using:Echoes.Helpers"
             x:Class="Echoes.Views.CurlView"
             x:DataType="vm:CurlViewModel">

    <UserControl.Styles>
        <!-- Read-only log/body panes: scroll instead of wrapping (faster + keeps alignment) -->
        <Style Selector="TextBox[IsReadOnly=True]">
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *, Auto" Margin="12">
        
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,12">
          <Grid ColumnDefinitions="Auto, *">
            <ComboBox Grid.Column="0" ItemsSource="{Binding HttpMethods}" SelectedItem="{Binding HttpMethod}"
                      MinWidth="86" FontSize="12" HorizontalAlignment="Stretch" Margin="0,0,8,0"
                      Foreground="White" Background="#25000000"/>

            <AutoCompleteBox Grid.Column="1" Text="{Binding Url}"
                     ItemsSource="{Binding UrlHistory}" FilterMode="ContainsOrdinal" MinimumPrefixLength="0"
                     Watermark="Target URL (https://...)"
                     FontSize="12"
                     Foreground="White" Background="#25000000" BorderBrush="#60FFFFFF">
                <AutoCompleteBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding ToggleCurlCommand}" />
                </AutoCompleteBox.KeyBindings>
            </AutoCompleteBox>
          </Grid>

          <Grid ColumnDefinitions="*, 90">
            <TextBox Grid.Column="0" Text="{Binding OverrideIp}" Watermark="Override IP..."
                     FontSize="12" VerticalContentAlignment="Center"
                     Foreground="White" Background="#25000000" BorderBrush="#60FFFFFF" Margin="0,0,8,0"/>

            <Button Grid.Column="1"
                    Command="{Binding ToggleCurlCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Classes.active="{Binding IsWorking}">
                <Button.Styles>
                    <Style Selector="Button">
                        <Setter Property="Background" Value="#42B883"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </Style>
                    <Style Selector="Button.active">
                        <Setter Property="Background" Value="#FF3333"/>
                    </Style>
                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#52C893"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Style>
                    <Style Selector="Button.active:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#FF5555"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Style>
                </Button.Styles>
                <Panel>
                    <TextBlock Text="RUN" IsVisible="{Binding !IsWorking}" FontSize="12"/>
                    <TextBlock Text="STOP" IsVisible="{Binding IsWorking}" FontSize="12"/>
                </Panel>
            </Button>
          </Grid>
        </StackPanel>

        <TabControl Grid.Row="1" Padding="0,4,0,0">
            <TabControl.Styles>
                <Style Selector="TabItem">
                    <Setter Property="FontSize" Value="11.5"/>
                    <Setter Property="MinHeight" Value="32"/>
                    <Setter Property="Padding" Value="14,0"/>
                    <Setter Property="Foreground" Value="#999999"/>
                </Style>
                <Style Selector="TabItem:selected">
                    <Setter Property="Foreground" Value="White"/>
                </Style>
            </TabControl.Styles>

            <TabItem Header="LOGS">
                <Border Background="#40000000" CornerRadius="4" BorderThickness="1" BorderBrush="#35FFFFFF">
                    <TextBox Text="{Binding FullLog}" IsReadOnly="True" AcceptsReturn="True"
                             Foreground="#FFFFFF" FontFamily="Cascadia Code,Consolas" FontSize="11.5" BorderThickness="0"/>
                </Border>
            </TabItem>

            <TabItem Header="RAW BODY">
                <Border Background="#40000000" CornerRadius="4" BorderThickness="1" BorderBrush="#35FFFFFF">
                    <TextBox Text="{Binding RawBody}" IsReadOnly="True" AcceptsReturn="True"
                             Foreground="#00FF99" FontFamily="Cascadia Code,Consolas" FontSize="11.5" BorderThickness="0"/>
                </Border>
            </TabItem>

            <TabItem Header="HEADERS">
                <Border Background="#40000000" CornerRadius="4" BorderThickness="1" BorderBrush="#35FFFFFF">
                    <TextBox Text="{Binding HeadersLog}" IsReadOnly="True" AcceptsReturn="True"
                             Foreground="#FFEA00" FontFamily="Cascadia Code,Consolas" FontSize="11.5" BorderThickness="0"/>
                </Border>
            </TabItem>

            <TabItem Header="SSL INFO">
                <Border Background="#40000000" CornerRadius="4" BorderThickness="1" BorderBrush="#35FFFFFF">
                    <TextBox Text="{Binding SslLog}" IsReadOnly="True" AcceptsReturn="True"
                             Foreground="#55CCFF" FontFamily="Cascadia Code,Consolas" FontSize="11.5" BorderThickness="0"/>
                </Border>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            
            <Grid ColumnDefinitions="*, 120, 120" IsVisible="{Binding #ProxyToggle.IsChecked}" Margin="0,0,0,10">
                <AutoCompleteBox Grid.Column="0" Text="{Binding Proxy}"
                         ItemsSource="{Binding ProxyHistory}" FilterMode="ContainsOrdinal" MinimumPrefixLength="0"
                         Watermark="Proxy (IP:Port)"
                         Height="32" FontSize="12"
                         Foreground="White" Background="#25000000" BorderBrush="#45FFFFFF" Margin="0,0,6,0"/>
                <TextBox Grid.Column="1" Text="{Binding ProxyUser}" Watermark="User" 
                         Height="32" FontSize="12" VerticalContentAlignment="Center" 
                         Foreground="White" Background="#25000000" BorderBrush="#45FFFFFF" Margin="0,0,6,0"/>
                <TextBox Grid.Column="2" Text="{Binding ProxyPass}" Watermark="Pass" PasswordChar="*" 
                         Height="32" FontSize="12" VerticalContentAlignment="Center" 
                         Foreground="White" Background="#25000000" BorderBrush="#45FFFFFF"/>
            </Grid>

            <Grid ColumnDefinitions="*, Auto, Auto, Auto">
                <Border Grid.Column="0" Background="#2AFFFFFF" CornerRadius="4" Padding="8,0" BorderThickness="1" BorderBrush="#50FFFFFF"
                        IsVisible="{x:Static helpers:AppPlatform.IsDesktop}">
                    <Grid ColumnDefinitions="Auto, *">
                        <TextBlock Grid.Column="0" Text="flags &gt; " Foreground="White" FontWeight="Bold"
                                   VerticalAlignment="Center" FontSize="12" FontFamily="Consolas"/>
                        <TextBox Grid.Column="1" Text="{Binding CustomFlags}" Watermark="curl-style flags (-H, -d, -x, --resolve...)"
                                 FontSize="12" BorderThickness="0" Background="Transparent" Foreground="White"
                                 FontFamily="Cascadia Code,Consolas" VerticalContentAlignment="Center" Height="30"/>
                    </Grid>
                </Border>

                <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseDotNetEngine}"
                              OnContent=".NET" OffContent="curl" FontSize="11" FontWeight="SemiBold"
                              MinWidth="0" Margin="15,0,0,0" VerticalAlignment="Center"
                              ToolTip.Tip="Engine: system curl binary, or built-in .NET HttpClient (no curl needed)"/>

                <CheckBox Name="ProxyToggle" Grid.Column="2" Content="Proxy" FontSize="11.5"
                          Foreground="White" FontWeight="SemiBold" MinHeight="0" Margin="15,0,0,0" VerticalAlignment="Center"/>
                <CheckBox IsChecked="{Binding SkipSslVerify}" Grid.Column="3" Content="Insecure" FontSize="11.5"
                          Foreground="White" FontWeight="SemiBold" MinHeight="0" Margin="15,0,0,0" VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>

    </Grid>
</UserControl>