<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Echoes.ViewModels"
             xmlns:helpers="using:Echoes.Helpers"
             x:Class="Echoes.Views.CurlView"
             x:DataType="vm:CurlViewModel">

    <UserControl.Styles>
        <!-- Read-only log/body panes: scroll instead of wrapping (faster + keeps alignment) -->
        <Style Selector="TextBox[IsReadOnly=True]">
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *, Auto" Margin="12">
        
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,12">
          <AutoCompleteBox Classes="field" Text="{Binding Url}"
                   ItemsSource="{Binding UrlHistory}" FilterMode="ContainsOrdinal" MinimumPrefixLength="0"
                   Watermark="Target URL (https://...)">
              <AutoCompleteBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding ToggleCurlCommand}" />
              </AutoCompleteBox.KeyBindings>
          </AutoCompleteBox>

          <Grid ColumnDefinitions="Auto, *, 150, 90">
            <ComboBox Grid.Column="0" Classes="field" ItemsSource="{Binding HttpMethods}" SelectedItem="{Binding HttpMethod}"
                      MinWidth="90" HorizontalAlignment="Stretch" Margin="0,0,8,0"/>

            <ComboBox Grid.Column="1" Classes="field" ItemsSource="{Binding Interfaces}" SelectedItem="{Binding SelectedInterface}"
                      HorizontalAlignment="Stretch" Margin="0,0,8,0"
                      ToolTip.Tip="Outgoing network interface (binds the source IP). Auto = let the OS route."/>

            <TextBox Grid.Column="2" Classes="field" Text="{Binding OverrideIp}" Watermark="Override IP" Margin="0,0,8,0">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding ToggleCurlCommand}"/>
                </TextBox.KeyBindings>
            </TextBox>

            <Button Grid.Column="3" Classes="toggle"
                    Command="{Binding ToggleCurlCommand}"
                    HorizontalAlignment="Stretch"
                    Classes.active="{Binding IsWorking}">
                <Panel>
                    <TextBlock Text="RUN" IsVisible="{Binding !IsWorking}" FontSize="12"/>
                    <TextBlock Text="STOP" IsVisible="{Binding IsWorking}" FontSize="12"/>
                </Panel>
            </Button>
          </Grid>
        </StackPanel>

        <TabControl Grid.Row="1" Padding="0,4,0,0">
            <TabControl.Styles>
                <Style Selector="TabItem">
                    <Setter Property="FontSize" Value="11.5"/>
                    <Setter Property="MinHeight" Value="32"/>
                    <Setter Property="Padding" Value="14,0"/>
                    <Setter Property="Foreground" Value="#9E9FA8"/>
                </Style>
                <Style Selector="TabItem:selected">
                    <Setter Property="Foreground" Value="#ECECEF"/>
                </Style>
            </TabControl.Styles>

            <TabItem Header="LOGS">
                <Border Classes="card output">
                    <TextBox Text="{Binding FullLog}" IsReadOnly="True" AcceptsReturn="True"
                             Foreground="#ECECEF" FontFamily="Cascadia Code,Consolas" FontSize="11.5" BorderThickness="0"/>
                </Border>
            </TabItem>

            <TabItem Header="RAW BODY">
                <Border Classes="card output">
                    <Grid RowDefinitions="Auto, *">
                        <CheckBox Grid.Row="0" IsChecked="{Binding WrapRawBody}" Content="Wrap" FontSize="11"
                                  Foreground="#9E9FA8" FontWeight="SemiBold" MinHeight="0"
                                  HorizontalAlignment="Right" Margin="0,0,2,4"/>
                        <TextBox Grid.Row="1" Text="{Binding RawBody}" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="{Binding RawBodyWrapping}"
                                 Foreground="#4FCB97" FontFamily="Cascadia Code,Consolas" FontSize="11.5" BorderThickness="0"/>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="HEADERS">
                <Border Classes="card output">
                    <TextBox Text="{Binding HeadersLog}" IsReadOnly="True" AcceptsReturn="True"
                             Foreground="#FFEA00" FontFamily="Cascadia Code,Consolas" FontSize="11.5" BorderThickness="0"/>
                </Border>
            </TabItem>

            <TabItem Header="SSL INFO">
                <Border Classes="card output">
                    <TextBox Text="{Binding SslLog}" IsReadOnly="True" AcceptsReturn="True"
                             Foreground="#55CCFF" FontFamily="Cascadia Code,Consolas" FontSize="11.5" BorderThickness="0"/>
                </Border>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            
            <Grid ColumnDefinitions="*, 120, 120" IsVisible="{Binding #ProxyToggle.IsChecked}" Margin="0,0,0,10">
                <AutoCompleteBox Grid.Column="0" Classes="field" Text="{Binding Proxy}"
                         ItemsSource="{Binding ProxyHistory}" FilterMode="ContainsOrdinal" MinimumPrefixLength="0"
                         Watermark="Proxy (IP:Port)" Margin="0,0,6,0"/>
                <TextBox Grid.Column="1" Classes="field" Text="{Binding ProxyUser}" Watermark="User" Margin="0,0,6,0"/>
                <TextBox Grid.Column="2" Classes="field" Text="{Binding ProxyPass}" Watermark="Pass" PasswordChar="*"/>
            </Grid>

            <Grid ColumnDefinitions="*, Auto, Auto, Auto">
                <Border Grid.Column="0" Background="#1D1E25" CornerRadius="6" Padding="8,0" BorderThickness="1" BorderBrush="#3B3D47"
                        IsVisible="{x:Static helpers:AppPlatform.IsDesktop}">
                    <Grid ColumnDefinitions="Auto, *">
                        <TextBlock Grid.Column="0" Text="flags &gt; " Foreground="#42B883" FontWeight="Bold"
                                   VerticalAlignment="Center" FontSize="12" FontFamily="Consolas"/>
                        <TextBox Grid.Column="1" Text="{Binding CustomFlags}" Watermark="curl-style flags (-H, -d, -x, --resolve...)"
                                 FontSize="12" BorderThickness="0" Background="Transparent" Foreground="#ECECEF"
                                 FontFamily="Cascadia Code,Consolas" VerticalContentAlignment="Center" Height="30"/>
                    </Grid>
                </Border>

                <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseDotNetEngine}"
                              OnContent=".NET" OffContent="curl" FontSize="11" FontWeight="SemiBold"
                              MinWidth="0" Margin="15,0,0,0" VerticalAlignment="Center"
                              ToolTip.Tip="Engine: system curl binary, or built-in .NET HttpClient (no curl needed)"/>

                <CheckBox Name="ProxyToggle" Grid.Column="2" IsChecked="{Binding UseProxy}" Content="Proxy" FontSize="11.5"
                          Foreground="#C7C8CF" FontWeight="SemiBold" MinHeight="0" Margin="15,0,0,0" VerticalAlignment="Center"/>
                <CheckBox IsChecked="{Binding SkipSslVerify}" Grid.Column="3" Content="Insecure" FontSize="11.5"
                          Foreground="#C7C8CF" FontWeight="SemiBold" MinHeight="0" Margin="15,0,0,0" VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>

    </Grid>
</UserControl>