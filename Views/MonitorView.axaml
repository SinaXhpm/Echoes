<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Echoes.ViewModels"
             xmlns:helpers="using:Echoes.Helpers"
             xmlns:views="using:Echoes.Views"
             x:Class="Echoes.Views.MonitorView"
             x:DataType="vm:MonitorViewModel">

    <Grid Margin="14">
        <TabControl>
            <TabControl.Styles>
                <Style Selector="TabItem">
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="MinHeight" Value="34"/>
                    <Setter Property="Padding" Value="16,0"/>
                    <Setter Property="Foreground" Value="#9E9FA8"/>
                </Style>
                <Style Selector="TabItem:selected">
                    <Setter Property="Foreground" Value="#ECECEF"/>
                </Style>
            </TabControl.Styles>

            <!-- ============ SETUP ============ -->
            <!-- No ScrollViewer: a single Grid fills the tab. TARGETS takes the '*' row so it grows to
                 absorb all leftover height — the page fits any window without ever scrolling. -->
            <TabItem Header="SETUP">
                <Grid Margin="0,12,0,2" RowDefinitions="Auto,*,Auto,Auto" ColumnDefinitions="*">

                    <!-- TARGETS (fills leftover height) -->
                    <TextBlock Grid.Row="0" Classes="fieldLabel" Text="TARGETS" Margin="2,0,0,5"/>
                    <TextBox Grid.Row="1" Classes="field multiline" Text="{Binding InputAddresses}" AcceptsReturn="True"
                             FontSize="12" MinHeight="64" FontFamily="Cascadia Code,Consolas"
                             VerticalContentAlignment="Top" KeyDown="Input_KeyDown"
                             PlaceholderText="host · host:port · https://url — one per line&#x0a;(Enter = Start, Shift+Enter = newline)"/>

                    <!-- CHECKS + OPTIONS on one compact strip (wraps to 2 rows only on a phone) -->
                    <Border Grid.Row="2" Classes="card" Padding="14,7" Margin="0,10,0,0">
                        <WrapPanel>
                            <WrapPanel.Styles>
                                <Style Selector="CheckBox">
                                    <Setter Property="FontSize" Value="12.5"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="0,3,14,3"/>
                                    <Setter Property="MinHeight" Value="26"/>
                                </Style>
                                <Style Selector="TextBlock.grp">
                                    <Setter Property="FontSize" Value="10"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#6E6F78"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="0,0,10,0"/>
                                </Style>
                            </WrapPanel.Styles>

                            <!-- what to probe -->
                            <TextBlock Classes="grp" Text="CHECKS"/>
                            <CheckBox IsChecked="{Binding CheckPing}" Content="Ping" ToolTip.Tip="ICMP echo round-trip"/>
                            <CheckBox IsChecked="{Binding CheckTcp}" Content="TCP" ToolTip.Tip="TCP connect to the port (default 80, or host:port)"/>
                            <CheckBox IsChecked="{Binding CheckHttp}" Content="HTTP" ToolTip.Tip="HTTP GET — status code + latency"/>

                            <!-- No divider here: once the row wraps on a narrow screen it is left
                                 dangling at the end of the line as a stray mark. -->

                            <!-- Interval and Timeout wrap independently — as one unit they overflow the frame. -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,16,3">
                                <TextBlock Text="Interval" FontSize="11.5" Foreground="#C7C8CF" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBox Classes="field" Text="{Binding Interval}" Width="50" HorizontalContentAlignment="Center"/>
                                <TextBlock Text="sec" FontSize="10.5" Foreground="#9E9FA8" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,16,3">
                                <TextBlock Text="Timeout" FontSize="11.5" Foreground="#C7C8CF" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBox Classes="field" Text="{Binding TimeoutMs}" Width="62" HorizontalContentAlignment="Center"/>
                                <TextBlock Text="ms" FontSize="10.5" Foreground="#9E9FA8" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>
                            <CheckBox IsChecked="{Binding AlertSound}" Foreground="#C7C8CF" Margin="0,3,0,3"
                                      Content="Sound alert" ToolTip.Tip="Beep when a target goes up or down"/>
                        </WrapPanel>
                    </Border>

                    <!-- START -->
                    <Button Grid.Row="3" Classes="toggle" Command="{Binding ToggleMonitorCommand}" Classes.active="{Binding IsMonitoring}"
                            Height="40" Margin="0,10,0,0" HorizontalAlignment="Stretch">
                        <Panel>
                            <TextBlock Text="START MONITORING" IsVisible="{Binding !IsMonitoring}" FontSize="12" FontWeight="Black" LetterSpacing="0.5"/>
                            <TextBlock Text="STOP" IsVisible="{Binding IsMonitoring}" FontSize="12" FontWeight="Black" LetterSpacing="0.5"/>
                        </Panel>
                    </Button>

                </Grid>
            </TabItem>

            <!-- ============ STATUS ============ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="STATUS" VerticalAlignment="Center"/>
                        <Border CornerRadius="9" Background="#2042B883" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Targets.Count}" FontSize="10" FontWeight="Bold" Foreground="#42B883"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>

                <!-- HorizontalScroll is only a fallback for an extremely narrow window; at any realistic
                     desktop/phone width the proportional columns fit and no scrollbar appears. -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,10,0,0">
                    <Grid MinWidth="380" RowDefinitions="Auto, *">
                        <Grid Grid.Row="0" Margin="12,0,12,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="{Binding CheckPing, Converter={x:Static views:BoolToStarConverter.Instance}}"/>
                                <ColumnDefinition Width="{Binding CheckTcp, Converter={x:Static views:BoolToStarConverter.Instance}}"/>
                                <ColumnDefinition Width="{Binding CheckHttp, Converter={x:Static views:BoolToStarConverter.Instance}}"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="0.7*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ADDRESS" FontSize="10" FontWeight="Bold" Foreground="#9E9FA8"/>
                            <TextBlock Grid.Column="1" Text="PING" FontSize="10" FontWeight="Bold" Foreground="#9E9FA8" HorizontalAlignment="Center" IsVisible="{Binding CheckPing}"/>
                            <TextBlock Grid.Column="2" Text="TCP" FontSize="10" FontWeight="Bold" Foreground="#9E9FA8" HorizontalAlignment="Center" IsVisible="{Binding CheckTcp}"/>
                            <TextBlock Grid.Column="3" Text="HTTP" FontSize="10" FontWeight="Bold" Foreground="#9E9FA8" HorizontalAlignment="Center" IsVisible="{Binding CheckHttp}"/>
                            <TextBlock Grid.Column="4" Text="UPTIME" FontSize="10" FontWeight="Bold" Foreground="#9E9FA8" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="FAILS" FontSize="10" FontWeight="Bold" Foreground="#9E9FA8" HorizontalAlignment="Right"/>
                        </Grid>

                        <ListBox Grid.Row="1" ItemsSource="{Binding Targets}" Background="Transparent" Padding="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:MonitorTarget">
                                    <Border CornerRadius="6" Margin="0,2" Padding="12,7" BorderThickness="1" Classes.success="{Binding IsSuccess}" Classes.failed="{Binding !IsSuccess}">
                                        <Border.Styles>
                                            <Style Selector="Border">
                                                <Setter Property="Background" Value="#191A1F"/>
                                                <Setter Property="BorderBrush" Value="#2F3139"/>
                                            </Style>
                                            <Style Selector="Border.success">
                                                <Setter Property="Background" Value="#2042B883"/>
                                                <Setter Property="BorderBrush" Value="#2042B883"/>
                                            </Style>
                                            <Style Selector="Border.failed">
                                                <Setter Property="Background" Value="#20E5484D"/>
                                                <Setter Property="BorderBrush" Value="#20E5484D"/>
                                            </Style>
                                        </Border.Styles>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="{Binding ShowPing, Converter={x:Static views:BoolToStarConverter.Instance}}"/>
                                                <ColumnDefinition Width="{Binding ShowTcp, Converter={x:Static views:BoolToStarConverter.Instance}}"/>
                                                <ColumnDefinition Width="{Binding ShowHttp, Converter={x:Static views:BoolToStarConverter.Instance}}"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="0.7*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Address}" FontSize="11.5" Foreground="#ECECEF" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding History}" FontSize="9" Foreground="#42B883" FontFamily="Cascadia Code,Consolas" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding PingStatus}" FontSize="10.5" Foreground="#C7C8CF" FontFamily="Cascadia Code,Consolas" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowPing}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding TcpStatus}" FontSize="10.5" Foreground="#C7C8CF" FontFamily="Cascadia Code,Consolas" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowTcp}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding HttpStatus}" FontSize="10.5" Foreground="#ECECEF" FontFamily="Cascadia Code,Consolas" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" IsVisible="{Binding ShowHttp}"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Uptime}" FontSize="10.5" Foreground="#4FCB97" FontFamily="Cascadia Code,Consolas" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="5" Text="{Binding FailedCount}" FontSize="11" Foreground="#E5484D" FontFamily="Cascadia Code,Consolas" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
