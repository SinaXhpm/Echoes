<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Echoes.ViewModels"
             x:Class="Echoes.Views.MonitorView"
             x:DataType="vm:MonitorViewModel">

    <Grid RowDefinitions="Auto, Auto, *" Margin="15">
        <Grid Grid.Row="0" ColumnDefinitions="*, 240" Height="100" Margin="0,0,0,20">
            <Grid Grid.Column="0" RowDefinitions="Auto, *">
                <TextBlock Grid.Row="0" Text="TARGETS" FontSize="10" FontWeight="Bold" Foreground="White" Opacity="0.4" Margin="5,0,0,5"/>
                <TextBox Grid.Row="1" Text="{Binding InputAddresses}" AcceptsReturn="True" FontSize="12" 
                         Foreground="White" Background="#10000000" BorderBrush="#30FFFFFF" CornerRadius="4"
                         VerticalAlignment="Stretch" Margin="0,0,12,0" Watermark="IP or URL per line..."/>
            </Grid>

            <Border Grid.Column="1" Background="#10000000" CornerRadius="4" Padding="12" BorderBrush="#20FFFFFF" BorderThickness="1" VerticalAlignment="Stretch">
                <Grid RowDefinitions="Auto, *">
                    <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,10">
                        <CheckBox IsChecked="{Binding CheckPing}" Content="PING" FontSize="9" Padding="4,0,0,0" HorizontalAlignment="Center"/>
                        <CheckBox IsChecked="{Binding CheckTcp}" Content="TCP" FontSize="9" Padding="4,0,0,0" HorizontalAlignment="Center"/>
                        <CheckBox IsChecked="{Binding CheckHttp}" Content="HTTP" FontSize="9" Padding="4,0,0,0" HorizontalAlignment="Center"/>
                    </UniformGrid>

                    <Grid Grid.Row="1" ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Bottom">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="INT (S):" VerticalAlignment="Center" FontSize="9" FontWeight="Bold" Opacity="0.4" Margin="0,0,5,0"/>
                            <TextBox Text="{Binding Interval}" Width="35" Height="24" Padding="0" FontSize="10" 
                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderThickness="0,0,0,1" Background="Transparent"/>
                        </StackPanel>

                        <Button Grid.Column="2" Command="{Binding ToggleMonitorCommand}" Width="90" Height="30" 
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Classes.active="{Binding IsMonitoring}">
                            <Button.Styles>
                                <Style Selector="Button">
                                    <Setter Property="Background" Value="#42B883"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Template">
                                        <ControlTemplate>
                                            <ContentPresenter x:Name="PART_ContentPresenter"
                                                              Background="{TemplateBinding Background}"
                                                              Content="{TemplateBinding Content}"
                                                              HorizontalContentAlignment="Center"
                                                              VerticalContentAlignment="Center"
                                                              CornerRadius="3"/>
                                        </ControlTemplate>
                                    </Setter>
                                </Style>
                                <Style Selector="Button.active">
                                    <Setter Property="Background" Value="#FF4444"/>
                                </Style>
                            </Button.Styles>
                            <Panel>
                                <TextBlock Text="START" IsVisible="{Binding !IsMonitoring}" FontSize="10" FontWeight="Black"/>
                                <TextBlock Text="STOP" IsVisible="{Binding IsMonitoring}" FontSize="10" FontWeight="Black"/>
                            </Panel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="2*, 1*, 1*, 1.2*, 0.8*" Margin="15,0,15,10">
            <TextBlock Grid.Column="0" Text="ADDRESS" FontSize="10" FontWeight="Bold" Opacity="0.3"/>
            <TextBlock Grid.Column="1" Text="PING" FontSize="10" FontWeight="Bold" Opacity="0.3" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="TCP" FontSize="10" FontWeight="Bold" Opacity="0.3" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="3" Text="HTTP" FontSize="10" FontWeight="Bold" Opacity="0.3" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="4" Text="FAILS" FontSize="10" FontWeight="Bold" Opacity="0.3" HorizontalAlignment="Right"/>
        </Grid>

        <ListBox Grid.Row="2" ItemsSource="{Binding Targets}" Background="Transparent" Padding="0">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:MonitorTarget">
                    <Border CornerRadius="3" Margin="0,1" Padding="12,7" Classes.success="{Binding IsSuccess}" Classes.failed="{Binding !IsSuccess}">
                        <Border.Styles>
                            <Style Selector="Border">
                                <Setter Property="Background" Value="#05FFFFFF"/>
                            </Style>
                            <Style Selector="Border.success">
                                <Setter Property="Background" Value="#1042B883"/>
                            </Style>
                            <Style Selector="Border.failed">
                                <Setter Property="Background" Value="#10FF4444"/>
                            </Style>
                        </Border.Styles>
                        <Grid ColumnDefinitions="2*, 1*, 1*, 1.2*, 0.8*">
                            <TextBlock Grid.Column="0" Text="{Binding Address}" FontSize="11.5" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding PingStatus}" FontSize="10.5" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"/>
                            <TextBlock Grid.Column="2" Text="{Binding TcpStatus}" FontSize="10.5" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"/>
                            <TextBlock Grid.Column="3" Text="{Binding HttpStatus}" FontSize="10.5" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="4" Text="{Binding FailedCount}" FontSize="11" Foreground="#FF6666" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>