<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Echoes.ViewModels"
             x:Class="Echoes.Views.MonitorView"
             x:DataType="vm:MonitorViewModel">

    <Grid RowDefinitions="Auto, Auto, *" Margin="12">
        <Grid Grid.Row="0" ColumnDefinitions="*, 50, 85, Auto, Auto" Margin="0,0,0,10">
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="TARGET" FontSize="9" FontWeight="Black" Opacity="0.4" Margin="0,0,0,3"/>
                <TextBox Text="{Binding TargetUrl}" Height="28" FontSize="11" VerticalContentAlignment="Center" Background="#12000000"/>
            </StackPanel>
            
            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="DELAY" FontSize="9" FontWeight="Black" Opacity="0.4" Margin="0,0,0,3"/>
                <TextBox Text="{Binding Interval}" Height="28" FontSize="11" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#12000000"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                <TextBlock Text="SUCCESS" FontSize="9" FontWeight="Black" Opacity="0.4" Margin="0,0,0,3"/>
                <TextBox Text="{Binding SuccessCodes}" Height="28" FontSize="10" VerticalContentAlignment="Center" Background="#12000000"/>
            </StackPanel>

            <StackPanel Grid.Column="3" Margin="0,0,10,0" VerticalAlignment="Bottom">
                <CheckBox IsChecked="{Binding EnableSound}" Content="BEEP" FontSize="9" MinHeight="28"/>
            </StackPanel>

            <Button Grid.Column="4" VerticalAlignment="Bottom" Height="28" Width="85"
                    Command="{Binding ToggleMonitorCommand}"
                    Classes.active="{Binding IsMonitoring}"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Padding="0">
                <Button.Styles>
                    <Style Selector="Button">
                        <Setter Property="Background" Value="#42B883"/>
                        <Setter Property="Transitions">
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.2"/>
                            </Transitions>
                        </Setter>
                    </Style>
                    <Style Selector="Button.active">
                        <Setter Property="Background" Value="#E35F5F"/>
                    </Style>
                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#52C893"/>
                    </Style>
                    <Style Selector="Button.active:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#F36F6F"/>
                    </Style>
                </Button.Styles>
                <Panel>
                    <TextBlock Text="START" IsVisible="{Binding !IsMonitoring}" FontSize="11" FontWeight="Black" Foreground="White"/>
                    <TextBlock Text="STOP" IsVisible="{Binding IsMonitoring}" FontSize="11" FontWeight="Black" Foreground="White"/>
                </Panel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="80, 1*, 60, 80, 80, 80" Margin="10,0,25,5">
            <TextBlock Grid.Column="0" Text="TIME" FontSize="9" Opacity="0.5"/>
            <TextBlock Grid.Column="1" Text="ADDRESS" FontSize="9" Opacity="0.5"/>
            <TextBlock Grid.Column="2" Text="HTTP" FontSize="9" Opacity="0.5"/>
            <TextBlock Grid.Column="3" Text="LATENCY" FontSize="9" Opacity="0.5"/>
            <TextBlock Grid.Column="4" Text="PING" FontSize="9" Opacity="0.5"/>
            <TextBlock Grid.Column="5" Text="MS" FontSize="9" Opacity="0.5" HorizontalAlignment="Right"/>
        </Grid>

        <ListBox Grid.Row="2" ItemsSource="{Binding Results}" Background="Transparent" Padding="0" Name="MonitorList">
    <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
            <StackPanel />
        </ItemsPanelTemplate>
    </ListBox.ItemsPanel>

    <ListBox.Styles>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
            </Style>
            <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
            </Style>
        </Style>
    </ListBox.Styles>

    <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:MonitorResult">
            <Border CornerRadius="3" Margin="2,0" Padding="8,0" MinHeight="30" VerticalAlignment="Center">
                <Border.Styles>
                    <Style Selector="Border">
                        <Setter Property="Background" Value="#08FFFFFF"/>
                    </Style>
                    <Style Selector="Border[Tag=True]">
                        <Setter Property="Background" Value="#2542B883"/>
                    </Style>
                    <Style Selector="Border[Tag=False]">
                        <Setter Property="Background" Value="#25E35F5F"/>
                    </Style>
                </Border.Styles>
                <Border.Tag>
                    <Binding Path="IsSuccess"/>
                </Border.Tag>
                
                <Grid ColumnDefinitions="80, 1*, 60, 80, 80, 80" VerticalAlignment="Center">
                    <TextBlock Grid.Column="0" Text="{Binding Time}" FontSize="10" Opacity="0.4" VerticalAlignment="Center" FontFamily="Cascadia Code,Consolas"/>
                    <TextBlock Grid.Column="1" Text="{Binding Url}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="2" Text="{Binding HttpStatus}" FontSize="11" FontWeight="Black" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding HttpLatency}" FontSize="11" VerticalAlignment="Center" Opacity="0.6"/>
                    <TextBlock Grid.Column="4" Text="{Binding PingStatus}" FontSize="10" VerticalAlignment="Center" Opacity="0.6"/>
                    <TextBlock Grid.Column="5" Text="{Binding PingLatency}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </Grid>
            </Border>
        </DataTemplate>
    </ListBox.ItemTemplate>
</ListBox>
    </Grid>
</UserControl>