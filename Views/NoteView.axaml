<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Echoes.ViewModels"
             x:Class="Echoes.Views.NoteView"
             x:DataType="vm:NoteViewModel">

    <Grid Margin="8">
        <Border IsVisible="{Binding IsLocked}" VerticalAlignment="Center" HorizontalAlignment="Center" 
                Width="300" Padding="20" Background="#30000000" CornerRadius="8" BorderBrush="#60FFFFFF" BorderThickness="1">
            <StackPanel Spacing="12">
                <TextBlock Text="ENCRYPTED STORAGE" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White"/>
                <TextBox Text="{Binding MasterKey}" PasswordChar="*" Watermark="Master Key..." 
                         FontSize="12" Height="32" VerticalContentAlignment="Center" Background="#20000000" BorderBrush="#60FFFFFF">
                    <TextBox.KeyBindings>
                        <KeyBinding Command="{Binding UnlockCommand}" Gesture="Enter"/>
                    </TextBox.KeyBindings>
                </TextBox>
                <Button Command="{Binding UnlockCommand}" Content="UNLOCK" FontSize="12" FontWeight="Bold" 
                        Height="32" Background="#42B883" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF4444" FontSize="10" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid IsVisible="{Binding !IsLocked}">
            <Grid RowDefinitions="Auto, Auto, *" IsVisible="{Binding !IsEditing}">
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto, Auto" Margin="0,0,0,8">
                    <TextBlock Grid.Column="0" Text="NOTES" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding FilteredNotes.Count, StringFormat='{}{0} item(s)'}" FontSize="10"
                               Foreground="White" Opacity="0.4" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Grid.Column="2" Command="{Binding LockAppCommand}" Content="LOCK" Background="#CCFF3333"
                            Foreground="White" FontSize="10" FontWeight="Bold" Padding="10,5" Margin="0,0,8,0"/>
                    <Button Grid.Column="3" Command="{Binding AddNoteCommand}" Content="+ NEW" Background="#42B883"
                            Foreground="White" FontWeight="Bold" FontSize="10" Padding="10,5"/>
                </Grid>

                <TextBox Grid.Row="1" Text="{Binding SearchQuery}" Watermark="Search titles &amp; content..."
                         Height="30" FontSize="11.5" VerticalContentAlignment="Center" Margin="0,0,0,8"
                         Foreground="White" Background="#20000000" BorderBrush="#45FFFFFF"/>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ListBox ItemsSource="{Binding FilteredNotes}" Background="Transparent" BorderThickness="0" Padding="0">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem Button#DelBtn">
                                <Setter Property="Opacity" Value="0"/>
                            </Style>
                            <Style Selector="ListBoxItem:pointerover Button#DelBtn">
                                <Setter Property="Opacity" Value="1"/>
                            </Style>
                            <Style Selector="ListBoxItem:pointerover Border#Card">
                                <Setter Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#6042B883"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:NoteItem">
                                <Panel Width="162" Height="84" Margin="4">
                                    <Button Command="{Binding $parent[UserControl].((vm:NoteViewModel)DataContext).OpenNoteCommand}"
                                            CommandParameter="{Binding}" Padding="0"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                            Background="Transparent" BorderThickness="0">
                                        <Border Name="Card" Background="#1EFFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1"
                                                CornerRadius="6" Padding="10,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12" Foreground="White"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Content}" FontSize="9.5" Foreground="#88FFFFFF"
                                                           TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                    <Button Name="DelBtn" Content="✕"
                                            Command="{Binding $parent[UserControl].((vm:NoteViewModel)DataContext).DeleteNoteCommand}"
                                            CommandParameter="{Binding}"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                                            FontSize="10" FontWeight="Bold" Width="20" Height="20" Padding="0"
                                            Background="#40FF3333" Foreground="White" BorderThickness="0" CornerRadius="10"/>
                                </Panel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Grid>

            <Grid RowDefinitions="Auto, *" IsVisible="{Binding IsEditing}">
                <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Margin="0,0,0,10">
                    <Button Grid.Column="0" Command="{Binding BackToListCommand}" Content="← DONE" Background="#2E86C1" 
                            Foreground="White" FontSize="11" FontWeight="Bold" Padding="12,6" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" Text="{Binding SelectedNote.Title, FallbackValue=''}" FontSize="12" FontWeight="Bold" 
                             Foreground="White" Background="#25000000" BorderBrush="#60FFFFFF" Height="32" VerticalContentAlignment="Center"/>
                </Grid>

                <Border Grid.Row="1" Background="#40000000" CornerRadius="4" BorderBrush="#35FFFFFF" BorderThickness="1">
                    <TextBox TextWrapping="Wrap" Text="{Binding SelectedNote.Content, FallbackValue=''}" AcceptsReturn="True" FontSize="12" 
                             Foreground="#FFFFFF" Background="Transparent" BorderThickness="0"
                             FontFamily="Cascadia Code,Consolas" Watermark="Type your note here..." Padding="10"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>