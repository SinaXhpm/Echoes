<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:Echoes.ViewModels"
			 x:Class="Echoes.Views.PortScannerView"
			 x:DataType="vm:PortScannerViewModel">

	<Grid RowDefinitions="Auto, Auto, *" Margin="15">
		<Grid Grid.Row="0" ColumnDefinitions="*, 180, Auto" Margin="0,0,0,10">
			<StackPanel Grid.Column="0" Margin="0,0,10,0">
				<TextBlock Text="TARGETS" FontSize="9" FontWeight="Black" Opacity="0.4" Margin="0,0,0,3"/>
				<TextBox Text="{Binding TargetInput}" AcceptsReturn="True" Height="50" FontSize="12" Watermark="IP/Range/CIDR..." VerticalContentAlignment="Top" Background="#10000000"/>
			</StackPanel>

			<StackPanel Grid.Column="1" Margin="0,0,10,0">
				<TextBlock Text="PORTS" FontSize="9" FontWeight="Black" Opacity="0.4" Margin="0,0,0,3"/>
				<TextBox Text="{Binding PortInput}" AcceptsReturn="True" Height="50" FontSize="12" Watermark="80, 443..." VerticalContentAlignment="Top" Background="#10000000"/>
			</StackPanel>

			<StackPanel Grid.Column="2" VerticalAlignment="Bottom" Spacing="4">
				<Button Command="{Binding ToggleScanCommand}"
						Classes.active="{Binding IsScanning}"
						Width="90" Height="26"
						Padding="0"
						HorizontalContentAlignment="Center"
						VerticalContentAlignment="Center">
					<Button.Styles>
						<Style Selector="Button">
							<Setter Property="Background" Value="#27AE60"/>
							<Setter Property="Transitions">
								<Transitions>
									<BrushTransition Property="Background" Duration="0:0:0.2"/>
								</Transitions>
							</Setter>
						</Style>
						<Style Selector="Button.active">
							<Setter Property="Background" Value="#C0392B"/>
						</Style>
						<Style Selector="Button:pointerover /template/ ContentPresenter">
							<Setter Property="Background" Value="#2ECC71"/>
						</Style>
						<Style Selector="Button.active:pointerover /template/ ContentPresenter">
							<Setter Property="Background" Value="#E74C3C"/>
						</Style>
					</Button.Styles>

					<Panel>
						<TextBlock Text="START" IsVisible="{Binding !IsScanning}" FontSize="11" FontWeight="Bold" Foreground="White"/>
						<TextBlock Text="STOP" IsVisible="{Binding IsScanning}" FontSize="11" FontWeight="Bold" Foreground="White"/>
					</Panel>
				</Button>

				<Button Click="Export_Click"
						Content="EXPORT CSV"
						Background="#2980B9"
						Width="90" Height="23" FontSize="9"
						HorizontalContentAlignment="Center"
						Margin="0,2,0,0"/>
			</StackPanel>
		</Grid>

		<WrapPanel Grid.Row="1" Margin="0,0,0,10">
			<CheckBox IsChecked="{Binding UseTcp}" Content="TCP" FontSize="11" Margin="0,0,10,0"/>
			<CheckBox IsChecked="{Binding UseUdp}" Content="UDP" FontSize="11" Margin="0,0,10,0"/>
			<CheckBox IsChecked="{Binding Repeat}" Content="REPEAT" FontSize="11" Margin="0,0,10,0"/>
			<NumericUpDown Value="{Binding RepeatInterval}" Minimum="1" Width="95" Height="24" FontSize="11" Margin="0,0,10,0"/>
			<NumericUpDown Value="{Binding TimeoutMs}" Minimum="100" Increment="100" Width="105" Height="24" FontSize="11"/>
		</WrapPanel>

		<Grid Grid.Row="2" RowDefinitions="Auto, *">
			<Grid Grid.Row="0" ColumnDefinitions="1.5*, 60, 60, *" Margin="10,0,25,5">
				<Button Grid.Column="0" Command="{Binding SortByCommand}" CommandParameter="IP" Content="IP ADDRESS" Background="Transparent" BorderThickness="0" FontSize="9" Opacity="0.5" HorizontalAlignment="Left"/>
				<Button Grid.Column="1" Command="{Binding SortByCommand}" CommandParameter="Port" Content="PORT" Background="Transparent" BorderThickness="0" FontSize="9" Opacity="0.5"/>
				<Button Grid.Column="2" Command="{Binding SortByCommand}" CommandParameter="Status" Content="PROTO" Background="Transparent" BorderThickness="0" FontSize="9" Opacity="0.5"/>
				<TextBlock Grid.Column="3" Text="STATUS" FontSize="9" Opacity="0.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
			</Grid>

			<ListBox Grid.Row="1" ItemsSource="{Binding Results}" Background="Transparent" Padding="0">
				<ListBox.Styles>
					<Style Selector="ListBoxItem">
						<Setter Property="Padding" Value="0"/>
						<Setter Property="Margin" Value="0,1"/>
						<Setter Property="MinHeight" Value="24"/>
					</Style>
				</ListBox.Styles>
				<ListBox.ItemTemplate>
					<DataTemplate x:DataType="vm:PortResult">
						<Border CornerRadius="2" Margin="2,0" Padding="8,2">
							<Border.Styles>
								<Style Selector="Border">
									<Setter Property="Background" Value="#08FFFFFF"/>
								</Style>
								<Style Selector="Border[Tag=OPEN]">
									<Setter Property="Background" Value="#3327AE60"/>
								</Style>
								<Style Selector="Border[Tag=CLOSED]">
									<Setter Property="Background" Value="#33C0392B"/>
								</Style>
								<Style Selector="Border[Tag=REJECT]">
									<Setter Property="Background" Value="#33C0392B"/>
								</Style>
							</Border.Styles>
							<Border.Tag>
								<Binding Path="Status"/>
							</Border.Tag>

							<Grid ColumnDefinitions="1.5*, 60, 60, *">
								<TextBlock Grid.Column="0" Text="{Binding IP}" FontSize="11" VerticalAlignment="Center"/>
								<TextBlock Grid.Column="1" Text="{Binding Port}" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
								<TextBlock Grid.Column="2" Text="{Binding Protocol}" FontSize="9" VerticalAlignment="Center" Opacity="0.4"/>
								<TextBlock Grid.Column="3" Text="{Binding Status}" FontSize="10" FontWeight="Black" HorizontalAlignment="Right" VerticalAlignment="Center"/>
							</Grid>
						</Border>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</Grid>
	</Grid>
</UserControl>