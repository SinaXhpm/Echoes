<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Echoes.ViewModels"
             xmlns:helpers="using:Echoes.Helpers"
             x:Class="Echoes.Views.PortScannerView"
             x:DataType="vm:PortScannerViewModel">

    <UserControl.Styles>
        <!-- sortable column header -->
        <Style Selector="Button.colhead">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#9E9FA8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.colhead:pointerover /template/ ContentPresenter">
            <Setter Property="Foreground" Value="#42B883"/>
        </Style>
        <!-- status pill -->
        <Style Selector="Border.pill">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="MinWidth" Value="62"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <!-- nested TabControl strip -->
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Foreground" Value="#9E9FA8"/>
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="#ECECEF"/>
        </Style>
    </UserControl.Styles>

    <Grid Margin="14">
        <TabControl>

            <!-- ===================== SETUP ===================== -->
            <!-- No ScrollViewer: a Grid fills the tab; TARGETS takes the '*' row and absorbs leftover height. -->
            <TabItem Header="SETUP">
              <!-- Row 0 holds the responsive settings; the action buttons are pinned in row 1 so
                   START is always reachable even when the window is too short to fit everything. -->
              <Grid RowDefinitions="*, Auto" Margin="2,10,2,2">
                <!-- Wide: TARGETS (left, needs vertical height) | settings (right).
                     Narrow (phone): the two columns stack, otherwise each gets ~170px and the
                     ports field and timing row are clipped by the frame. -->
                <Grid Grid.Row="0" x:Name="ScanSetupGrid" helpers:Responsive.BreakWidth="440"
                      ColumnDefinitions="1*, 1.35*" RowDefinitions="Auto, *" ColumnSpacing="12" RowSpacing="10">
                    <!-- Rows are Auto,* so that when stacked TARGETS sizes to its content at the top and
                         the options block takes the slack. When wide both columns span both rows, so the
                         split is irrelevant and each still fills the full height. -->
                    <Grid.Styles>
                        <Style Selector="Grid.wide > Grid#ScanTargetsCol">
                            <Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="1"/><Setter Property="Grid.RowSpan" Value="2"/>
                        </Style>
                        <Style Selector="Grid.narrow > Grid#ScanTargetsCol">
                            <Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="2"/><Setter Property="Grid.RowSpan" Value="1"/>
                        </Style>
                        <Style Selector="Grid.wide > Grid#ScanOptionsCol">
                            <Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.Column" Value="1"/><Setter Property="Grid.ColumnSpan" Value="1"/><Setter Property="Grid.RowSpan" Value="2"/>
                        </Style>
                        <Style Selector="Grid.narrow > Grid#ScanOptionsCol">
                            <Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="2"/><Setter Property="Grid.RowSpan" Value="1"/>
                        </Style>
                        <!-- targets box is height-driven by the row when wide; cap it once stacked -->
                        <Style Selector="Grid.narrow TextBox#ScanTargets">
                            <Setter Property="Height" Value="110"/>
                        </Style>
                    </Grid.Styles>

                    <!-- LEFT: targets — fills the full height -->
                    <Grid x:Name="ScanTargetsCol" RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Classes="fieldLabel" Text="TARGETS" Margin="0,0,0,5"/>
                        <TextBox Grid.Row="1" x:Name="ScanTargets" Classes="field multiline" Text="{Binding TargetInput}" AcceptsReturn="True"
                                 VerticalContentAlignment="Top" KeyDown="Input_KeyDown"
                                 PlaceholderText="IP / Range / CIDR — one per line&#x0a;(Enter = scan, Shift+Enter = newline)"/>
                    </Grid>

                    <!-- RIGHT: ports + scan options (actions are pinned at the tab bottom, below) -->
                    <Grid x:Name="ScanOptionsCol" RowDefinitions="Auto,Auto">

                        <!-- PORTS: unified field (custom typing OR pick a preset from the dropdown) -->
                        <StackPanel Grid.Row="0" Spacing="4">
                            <TextBlock Classes="fieldLabel" Text="PORTS"/>
                        <AutoCompleteBox Classes="field" Text="{Binding PortInput}"
                                         ItemsSource="{Binding PortPresets}"
                                         ValueMemberBinding="{Binding Ports}"
                                         FilterMode="ContainsOrdinal" MinimumPrefixLength="0"
                                         FontFamily="Cascadia Code,Consolas" FontSize="11.5"
                                         PlaceholderText="type custom (80,443,1-1024) — or pick a preset ▾">
                            <AutoCompleteBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:PortPreset">
                                    <Grid ColumnDefinitions="104,*">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Ports}" Foreground="#9E9FA8" FontSize="10"
                                                   FontFamily="Cascadia Code,Consolas" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </AutoCompleteBox.ItemTemplate>
                            <AutoCompleteBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding ToggleScanCommand}"/>
                            </AutoCompleteBox.KeyBindings>
                        </AutoCompleteBox>
                    </StackPanel>

                    <!-- protocol + nmap scan options + timing + interval/timeout -->
                    <Border Grid.Row="1" Classes="card" Padding="12,8" Margin="0,8,0,0">
                        <WrapPanel helpers:Responsive.BreakWidth="430">
                            <WrapPanel.Styles>
                                <!-- Group dividers read as stray marks once the row wraps -->
                                <Style Selector="WrapPanel.narrow > Border.sep">
                                    <Setter Property="IsVisible" Value="False"/>
                                </Style>
                                <Style Selector="CheckBox">
                                    <Setter Property="FontSize" Value="11.5"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#C7C8CF"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="0,3,14,3"/>
                                    <Setter Property="MinHeight" Value="26"/>
                                </Style>
                                <Style Selector="TextBlock.grp">
                                    <Setter Property="FontSize" Value="10"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#6E6F78"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="0,0,8,0"/>
                                </Style>
                                <Style Selector="Border.sep">
                                    <Setter Property="Width" Value="1"/>
                                    <Setter Property="Height" Value="18"/>
                                    <Setter Property="Background" Value="#33363F"/>
                                    <Setter Property="Margin" Value="4,0,14,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </WrapPanel.Styles>

                            <TextBlock Classes="grp" Text="PROTO"/>
                            <CheckBox IsChecked="{Binding UseTcp}" Content="TCP"/>
                            <CheckBox IsChecked="{Binding UseUdp}" Content="UDP"/>
                            <Border Classes="sep"/>
                            <CheckBox IsChecked="{Binding ServiceDetection}" Content="-sV version" ToolTip.Tip="Probe open ports for service + version (banner grab, HTTP / TLS / SSH / SMTP / MySQL ...)"/>
                            <CheckBox IsChecked="{Binding PingScanOnly}" Content="-sn ping" ToolTip.Tip="Host discovery only — which hosts are up, no port scan"/>
                            <CheckBox IsChecked="{Binding ShowReason}" Content="--reason" ToolTip.Tip="Show why each port is in its state (syn-ack / conn-refused / no-response)"/>
                            <CheckBox IsChecked="{Binding Repeat}" Content="repeat"/>
                            <Border Classes="sep"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,14,3">
                                <TextBlock Classes="grp" Text="TIMING"/>
                                <ComboBox ItemsSource="{Binding TimingOptions}" SelectedItem="{Binding SelectedTiming}"
                                          MinHeight="30" Height="30" FontSize="11.5" Width="150" CornerRadius="6"
                                          Background="#1D1E25" BorderBrush="#3B3D47" Foreground="#ECECEF"
                                          ToolTip.Tip="T0 Paranoid → T5 Insane — controls parallelism and per-port timeout"/>
                            </StackPanel>
                            <!-- Interval and Timeout wrap independently: as one unit they are ~330px and
                                 overflow the frame on a phone. Each is still atomic on its own. -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,14,3">
                                    <TextBlock Text="Interval" FontSize="11" Foreground="#9E9FA8" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <NumericUpDown Value="{Binding RepeatInterval}" Minimum="1" ShowButtonSpinner="False" Height="30" Width="62" FontSize="11.5"
                                                   HorizontalContentAlignment="Center" CornerRadius="6" Foreground="#ECECEF" Background="#1D1E25" BorderBrush="#3B3D47"/>
                                    <TextBlock Text="s" FontSize="10.5" Foreground="#9E9FA8" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,0,3">
                                    <TextBlock Text="Timeout" FontSize="11" Foreground="#9E9FA8" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <NumericUpDown Value="{Binding TimeoutMs}" Minimum="100" Increment="100" ShowButtonSpinner="False" Height="30" Width="76" FontSize="11.5"
                                                   HorizontalContentAlignment="Center" CornerRadius="6" Foreground="#ECECEF" Background="#1D1E25" BorderBrush="#3B3D47"/>
                                    <TextBlock Text="ms" FontSize="10.5" Foreground="#9E9FA8" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                        </WrapPanel>
                    </Border>

                    </Grid>
                </Grid>

                <!-- actions pinned at the tab bottom (row 1) — always visible/reachable -->
                <Grid Grid.Row="1" ColumnDefinitions="*, Auto" ColumnSpacing="8" Margin="0,10,0,0">
                    <Button Grid.Column="0" Classes="toggle" Command="{Binding ToggleScanCommand}"
                            Classes.active="{Binding IsScanning}" Height="34" HorizontalAlignment="Stretch">
                        <Panel>
                            <TextBlock Text="START" IsVisible="{Binding !IsScanning}" FontSize="12"/>
                            <TextBlock Text="STOP" IsVisible="{Binding IsScanning}" FontSize="12"/>
                        </Panel>
                    </Button>
                    <Button Grid.Column="1" Classes="secondary" Click="Export_Click" Height="34"
                            Content="EXPORT CSV" FontSize="11" Padding="14,0"/>
                </Grid>
              </Grid>
            </TabItem>

            <!-- ===================== RESULTS ===================== -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="RESULTS" VerticalAlignment="Center"/>
                        <Border Background="#191A1F" BorderBrush="#2A2C33" BorderThickness="1" CornerRadius="5" Padding="7,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Results.Count}" FontSize="11" FontWeight="Bold" Foreground="#42B883"
                                       FontFamily="Cascadia Code,Consolas" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>

                <Grid RowDefinitions="Auto, *" Margin="0,10,0,0">

                    <!-- live status -->
                    <TextBlock Grid.Row="0" Text="{Binding StatusMessage}" FontSize="10.5" Foreground="#42B883"
                               FontFamily="Cascadia Code,Consolas" Margin="2,0,2,8"
                               TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <!-- table: horizontal scroll so 4 columns never crush on a narrow phone -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <Grid MinWidth="580" RowDefinitions="Auto, *">

                            <!-- sortable column headers -->
                            <Grid Grid.Row="0" ColumnDefinitions="1.3*, 66, 96, 1.5*, 78" Margin="14,0,14,6">
                                <Button Grid.Column="0" Classes="colhead" Command="{Binding SortByCommand}" CommandParameter="IP" Content="IP ADDRESS" HorizontalAlignment="Left"/>
                                <Button Grid.Column="1" Classes="colhead" Command="{Binding SortByCommand}" CommandParameter="Port" Content="PORT"/>
                                <Button Grid.Column="2" Classes="colhead" Command="{Binding SortByCommand}" CommandParameter="Service" Content="SERVICE"/>
                                <TextBlock Grid.Column="3" Text="VERSION" FontSize="10" FontWeight="Bold" Foreground="#9E9FA8" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                <Button Grid.Column="4" Classes="colhead" Command="{Binding SortByCommand}" CommandParameter="Status" Content="STATE" HorizontalAlignment="Right"/>
                            </Grid>

                            <ListBox Grid.Row="1" ItemsSource="{Binding Results}" Background="#121317" BorderBrush="#2A2C33" BorderThickness="1" CornerRadius="8" Padding="0">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,1"/>
                                        <Setter Property="MinHeight" Value="32"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="#1E2027"/>
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PortResult">
                                        <Border CornerRadius="4" Margin="4,1" Padding="10,6">
                                            <Border.Styles>
                                                <Style Selector="Border">
                                                    <Setter Property="Background" Value="#191A1F"/>
                                                </Style>
                                                <Style Selector="Border[Tag=OPEN]">
                                                    <Setter Property="Background" Value="#16311F"/>
                                                </Style>
                                                <Style Selector="Border[Tag=CLOSED]">
                                                    <Setter Property="Background" Value="#2C1B1D"/>
                                                </Style>
                                                <Style Selector="Border[Tag=REJECT]">
                                                    <Setter Property="Background" Value="#2C1B1D"/>
                                                </Style>
                                            </Border.Styles>
                                            <Border.Tag>
                                                <Binding Path="Status"/>
                                            </Border.Tag>

                                            <Grid ColumnDefinitions="1.3*, 66, 96, 1.5*, 78">
                                                <SelectableTextBlock Grid.Column="0" Text="{Binding IP}" FontSize="11.5" FontFamily="Cascadia Code,Consolas"
                                                                     Foreground="#ECECEF" VerticalAlignment="Center" FontWeight="SemiBold"
                                                                     SelectionBrush="#3042B883"/>
                                                <TextBlock Grid.Column="1" Text="{Binding PortLabel}" FontSize="11" FontFamily="Cascadia Code,Consolas" Foreground="#C7C8CF" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding ServiceDisplay}" FontSize="10.5" Foreground="#9E9FA8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Version}" FontSize="10.5" FontFamily="Cascadia Code,Consolas" Foreground="#7FCBA6"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" ToolTip.Tip="{Binding Version}"/>

                                                <Border Grid.Column="4" Classes="pill" VerticalAlignment="Center">
                                                    <Border.Styles>
                                                        <Style Selector="Border">
                                                            <Setter Property="Background" Value="#242089"/>
                                                        </Style>
                                                        <Style Selector="Border[Tag=OPEN]">
                                                            <Setter Property="Background" Value="#1E3A2B"/>
                                                        </Style>
                                                        <Style Selector="Border[Tag=UP]">
                                                            <Setter Property="Background" Value="#1E3A2B"/>
                                                        </Style>
                                                        <Style Selector="Border[Tag=CLOSED]">
                                                            <Setter Property="Background" Value="#3A2124"/>
                                                        </Style>
                                                        <Style Selector="Border[Tag=DOWN]">
                                                            <Setter Property="Background" Value="#3A2124"/>
                                                        </Style>
                                                        <Style Selector="Border[Tag=REJECT]">
                                                            <Setter Property="Background" Value="#3A2124"/>
                                                        </Style>
                                                        <Style Selector="Border[Tag=FILTERED]">
                                                            <Setter Property="Background" Value="#3A3320"/>
                                                        </Style>
                                                    </Border.Styles>
                                                    <Border.Tag><Binding Path="Status"/></Border.Tag>
                                                    <TextBlock Text="{Binding Status}" FontSize="10.5" FontWeight="Bold" Foreground="#ECECEF"
                                                               HorizontalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ===================== REPORT ===================== -->
            <TabItem Header="REPORT">
                <Grid Margin="0,10,0,0">
                    <TextBox Text="{Binding ReportText}" IsReadOnly="True" AcceptsReturn="True"
                             FontFamily="Cascadia Code,Consolas" FontSize="11.5"
                             Background="#121317" Foreground="#4FCB97" BorderBrush="#2A2C33" BorderThickness="1"
                             CornerRadius="8" Padding="12" TextWrapping="NoWrap"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             PlaceholderText="Run a scan — the nmap-style report appears here."/>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
