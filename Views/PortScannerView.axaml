<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Echoes.ViewModels"
             x:Class="Echoes.Views.PortScannerView"
             x:DataType="vm:PortScannerViewModel">

    <Grid RowDefinitions="Auto, Auto, *" Margin="12">
        
        <Grid Grid.Row="0" ColumnDefinitions="*, 200, Auto" Margin="0,0,0,12">
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="TARGETS" FontSize="10" FontWeight="Bold" Foreground="White" Opacity="0.9" Margin="2,0,0,5"/>
                <TextBox Text="{Binding TargetInput}" AcceptsReturn="True" Height="54" 
                         FontSize="12" Watermark="IP/Range/CIDR (e.g. 192.168.1.1/24)" 
                         VerticalContentAlignment="Top" Padding="8,5"
                         Foreground="White" Background="#25000000" BorderBrush="#60FFFFFF"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                <TextBlock Text="PORTS" FontSize="10" FontWeight="Bold" Foreground="White" Opacity="0.9" Margin="2,0,0,5"/>
                <TextBox Text="{Binding PortInput}" AcceptsReturn="True" Height="54" 
                         FontSize="12" Watermark="80, 443, 8080-8090" 
                         VerticalContentAlignment="Top" Padding="8,5"
                         Foreground="White" Background="#25000000" BorderBrush="#60FFFFFF"/>
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Spacing="6">
                <Button Command="{Binding ToggleScanCommand}"
                        Classes.active="{Binding IsScanning}"
                        Width="105" Height="34"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">
                    <Button.Styles>
                        <Style Selector="Button">
                            <Setter Property="Background" Value="#42B883"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Transitions">
                                <Transitions>
                                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                                </Transitions>
                            </Setter>
                        </Style>
                        <Style Selector="Button.active">
                            <Setter Property="Background" Value="#FF3333"/>
                        </Style>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#52C893"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Style>
                        <Style Selector="Button.active:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#FF5555"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Style>
                    </Button.Styles>

                    <Panel>
                        <TextBlock Text="START" IsVisible="{Binding !IsScanning}" FontSize="12"/>
                        <TextBlock Text="STOP" IsVisible="{Binding IsScanning}" FontSize="12"/>
                    </Panel>
                </Button>

                <Button Click="Export_Click"
                        Content="EXPORT CSV"
                        Background="#2E86C1" Foreground="White" FontWeight="Bold"
                        Width="105" Height="26" FontSize="10.5"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            </StackPanel>
        </Grid>

        <WrapPanel Grid.Row="1" Margin="2,0,0,12" VerticalAlignment="Center">
            <CheckBox IsChecked="{Binding UseTcp}" Content="TCP" FontSize="11.5" Foreground="White" FontWeight="Bold" Margin="0,0,18,0"/>
            <CheckBox IsChecked="{Binding UseUdp}" Content="UDP" FontSize="11.5" Foreground="White" FontWeight="Bold" Margin="0,0,18,0"/>
            <CheckBox IsChecked="{Binding Repeat}" Content="REPEAT" FontSize="11.5" Foreground="White" FontWeight="Bold" Margin="0,0,18,0"/>
            
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                <TextBlock Text="Interval:" FontSize="10.5" Foreground="White" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <NumericUpDown Value="{Binding RepeatInterval}" Minimum="1" Width="105" Height="30" FontSize="11.5" 
                               Foreground="White" Background="#25000000" BorderBrush="#50FFFFFF"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Timeout:" FontSize="10.5" Foreground="White" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <NumericUpDown Value="{Binding TimeoutMs}" Minimum="100" Increment="100" Width="115" Height="30" FontSize="11.5"
                               Foreground="White" Background="#25000000" BorderBrush="#50FFFFFF"/>
            </StackPanel>
        </WrapPanel>

        <Grid Grid.Row="2" RowDefinitions="Auto, Auto, *">
            <TextBlock Grid.Row="0" Text="{Binding StatusMessage}" FontSize="10" Foreground="#42B883"
                       Opacity="0.85" Margin="12,0,0,6" IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <Grid Grid.Row="1" ColumnDefinitions="1.5*, 80, 80, *" Margin="12,0,28,10">
                <Button Grid.Column="0" Command="{Binding SortByCommand}" CommandParameter="IP" Content="IP ADDRESS" 
                        Background="Transparent" BorderThickness="0" FontSize="10.5" Foreground="White" FontWeight="Bold" Opacity="0.9" HorizontalAlignment="Left" Padding="0"/>
                <Button Grid.Column="1" Command="{Binding SortByCommand}" CommandParameter="Port" Content="PORT" 
                        Background="Transparent" BorderThickness="0" FontSize="10.5" Foreground="White" FontWeight="Bold" Opacity="0.9" Padding="0"/>
                <Button Grid.Column="2" Command="{Binding SortByCommand}" CommandParameter="Protocol" Content="PROTO" 
                        Background="Transparent" BorderThickness="0" FontSize="10.5" Foreground="White" FontWeight="Bold" Opacity="0.9" Padding="0"/>
                <TextBlock Grid.Column="3" Text="STATUS" FontSize="10.5" Foreground="White" FontWeight="Bold" Opacity="0.9" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <ListBox Grid.Row="2" ItemsSource="{Binding Results}" Background="#40000000" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="4" Padding="0">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="MinHeight" Value="30"/>
                    </Style>
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#25FFFFFF"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:PortResult">
                        <Border CornerRadius="3" Margin="4,1" Padding="10,5">
                            <Border.Styles>
                                <Style Selector="Border">
                                    <Setter Property="Background" Value="#18FFFFFF"/>
                                </Style>
                                <Style Selector="Border[Tag=OPEN]">
                                    <Setter Property="Background" Value="#4527AE60"/>
                                </Style>
                                <Style Selector="Border[Tag=CLOSED]">
                                    <Setter Property="Background" Value="#45C0392B"/>
                                </Style>
                                <Style Selector="Border[Tag=REJECT]">
                                    <Setter Property="Background" Value="#45C0392B"/>
                                </Style>
                            </Border.Styles>
                            <Border.Tag>
                                <Binding Path="Status"/>
                            </Border.Tag>

                            <Grid ColumnDefinitions="1.5*, 80, 80, *">
                                <TextBlock Grid.Column="0" Text="{Binding IP}" FontSize="11.5" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{Binding Port}" FontSize="11.5" Foreground="White" Opacity="1.0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Protocol}" FontSize="10.5" Foreground="White" VerticalAlignment="Center" Opacity="0.7"/>
                                <TextBlock Grid.Column="3" Text="{Binding Status}" FontSize="11.5" FontWeight="Heavy" 
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>