<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Echoes.ViewModels"
             xmlns:helpers="using:Echoes.Helpers"
             xmlns:sys="using:System"
             xmlns:ctl="using:Echoes.Views.Controls"
             x:Class="Echoes.Views.WebServerView"
             x:DataType="vm:WebServerViewModel">

    <UserControl.Resources>
        <StreamGeometry x:Key="WsIcoQr">M4 4 H10 V10 H4 Z M14 4 H20 V10 H14 Z M4 14 H10 V20 H4 Z M14 14 H16 V16 H14 Z M18 14 H20 M14 18 V20 H16 M18 18 H20 V20</StreamGeometry>
        <StreamGeometry x:Key="WsIcoBack">M15 5 L8 12 L15 19</StreamGeometry>
        <StreamGeometry x:Key="WsIcoClear">M4.5 7 H19.5 M9.5 7 V4.5 H14.5 V7 M6.5 7 L7.5 19.5 H16.5 L17.5 7</StreamGeometry>
        <!-- one name / value line: header, query parameter, form field, multipart part -->
        <DataTemplate x:Key="CtFieldTemplate" x:DataType="helpers:CatcherField">
            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" Margin="0,0,0,5">
                <TextBlock Classes="fieldName" Text="{Binding Name}" ToolTip.Tip="{Binding Name}"/>
                <StackPanel Grid.Column="1" Spacing="1">
                    <SelectableTextBlock Classes="fieldValue" Text="{Binding Value}"/>
                    <TextBlock Classes="hint" Text="{Binding Detail}" IsVisible="{Binding HasDetail}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <!-- stroked glyphs, 24x24 box (same convention as Assets/ToolIcons.axaml) -->
        <StreamGeometry x:Key="WsIcoPlus">M12 5 V19 M5 12 H19</StreamGeometry>
        <StreamGeometry x:Key="WsIcoFile">M14.5 3 H6.5 A1.5 1.5 0 0 0 5 4.5 V19.5 A1.5 1.5 0 0 0 6.5 21 H17.5 A1.5 1.5 0 0 0 19 19.5 V7.5 Z M14 3 V8 H19</StreamGeometry>
        <StreamGeometry x:Key="WsIcoClose">M7 7 L17 17 M17 7 L7 17</StreamGeometry>
        <StreamGeometry x:Key="WsIcoCopy">M10 8 H18 A2 2 0 0 1 20 10 V18 A2 2 0 0 1 18 20 H10 A2 2 0 0 1 8 18 V10 A2 2 0 0 1 10 8 Z M5 16 A1.5 1.5 0 0 1 4 14.5 V5.5 A1.5 1.5 0 0 1 5.5 4 H14.5 A1.5 1.5 0 0 1 16 5</StreamGeometry>
        <StreamGeometry x:Key="WsIcoOpen">M14 4 H20 V10 M20 4 L11 13 M18 14 V18.5 A1.5 1.5 0 0 1 16.5 20 H5.5 A1.5 1.5 0 0 1 4 18.5 V7.5 A1.5 1.5 0 0 1 5.5 6 H10</StreamGeometry>
        <StreamGeometry x:Key="WsIcoInbox">M4 13 H8.5 L10 15.5 H14 L15.5 13 H20 M4 13 L6.5 5.5 H17.5 L20 13 V18.5 A1.5 1.5 0 0 1 18.5 20 H5.5 A1.5 1.5 0 0 1 4 18.5 Z</StreamGeometry>
        <StreamGeometry x:Key="WsIcoChat">M5 5.5 H19 A1.5 1.5 0 0 1 20.5 7 V15 A1.5 1.5 0 0 1 19 16.5 H11 L7 20 V16.5 H5 A1.5 1.5 0 0 1 3.5 15 V7 A1.5 1.5 0 0 1 5 5.5 Z</StreamGeometry>
        <StreamGeometry x:Key="WsIcoFolder">M3.5 7 A1.5 1.5 0 0 1 5 5.5 H9.5 L11.5 7.5 H19 A1.5 1.5 0 0 1 20.5 9 V17.5 A1.5 1.5 0 0 1 19 19 H5 A1.5 1.5 0 0 1 3.5 17.5 Z</StreamGeometry>
        <StreamGeometry x:Key="WsIcoLock">M7 11 V8 A5 5 0 0 1 17 8 V11 M6 11 H18 A1 1 0 0 1 19 12 V19 A1 1 0 0 1 18 20 H6 A1 1 0 0 1 5 19 V12 A1 1 0 0 1 6 11 Z</StreamGeometry>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.card.section">
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="{StaticResource Font.Small}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- glyph inside a button: follows the button's state through Stroke (a Path doesn't inherit Foreground) -->
        <Style Selector="Button Path.glyph">
            <Setter Property="StrokeThickness" Value="1.7"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeJoin" Value="Round"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.secondary Path.glyph">
            <Setter Property="Stroke" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
        </Style>
        <Style Selector="Border.badge Ellipse.dot">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="Fill" Value="{DynamicResource Success}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.icon Path.glyph">
            <Setter Property="Stroke" Value="{DynamicResource Text.Secondary}"/>
        </Style>
        <Style Selector="Button.icon:pointerover Path.glyph">
            <Setter Property="Stroke" Value="{DynamicResource Accent.Text}"/>
        </Style>
        <Style Selector="Button.icon:disabled Path.glyph">
            <Setter Property="Stroke" Value="{DynamicResource Text.Disabled}"/>
        </Style>
        <Style Selector="Path.emptyIcon">
            <Setter Property="Stroke" Value="{DynamicResource Text.Disabled}"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeJoin" Value="Round"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Stretch" Value="None"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.hint.error">
            <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
        </Style>
        <Style Selector="TextBlock.hint.warn">
            <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
        </Style>
        <Style Selector="TabControl.wsmode > TabItem">
            <Setter Property="Padding" Value="12,0"/>
        </Style>

        <!-- ===================== SHARE & CHAT ===================== -->
        <!-- page: one screen tall on desktop; on a phone the lower card keeps its room and the page scrolls -->
        <Style Selector="ScrollViewer#ShPage.wide">
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style Selector="ScrollViewer#ShPage.narrow">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style Selector="ScrollViewer#ShPage.narrow > Grid#ShRoot">
            <Setter Property="Height" Value="{Binding $parent[ScrollViewer].Bounds.Height}"/>
            <Setter Property="MinHeight" Value="720"/>
        </Style>
        <Style Selector="ScrollViewer#ShPage.narrow > Grid#ShRoot.running">
            <Setter Property="MinHeight" Value="780"/>
        </Style>

        <!-- [listen on][port][HTTPS][PIN][start] on one line; the address on its own line on a phone -->
        <Style Selector="Grid#ShFields.wide > Grid#ShRest">
            <Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.Column" Value="1"/><Setter Property="Grid.ColumnSpan" Value="1"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
        </Style>
        <Style Selector="Grid#ShFields.narrow > Grid#ShRest">
            <Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="2"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
        <Style Selector="Grid#ShFields.narrow > StackPanel#ShBind">
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
        <Style Selector="Grid#ShRest > CheckBox">
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Margin" Value="10,0,0,2"/>
        </Style>
        <!-- start: after the switches on desktop; its own full-width row on a phone -->
        <Style Selector="Grid#ShFields.wide Button#ShToggle">
            <Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.Column" Value="3"/><Setter Property="Grid.ColumnSpan" Value="1"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
        </Style>
        <Style Selector="Grid#ShFields.narrow Button#ShToggle">
            <Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="4"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <!-- phone, while sharing: the (locked) address, port and switches fold away — the card keeps Stop and the link -->
        <Style Selector="ScrollViewer#ShPage.narrow Grid#ShRoot.running StackPanel#ShBind, ScrollViewer#ShPage.narrow Grid#ShRoot.running StackPanel#ShPortBox, ScrollViewer#ShPage.narrow Grid#ShRoot.running Grid#ShRest > CheckBox">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="ScrollViewer#ShPage.narrow Grid#ShRoot.running Grid#ShRest">
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style Selector="ScrollViewer#ShPage.narrow Grid#ShRoot.running Button#ShToggle">
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- live: link / PIN / certificate, QR beside them (desktop) or behind a button (phone) -->
        <Style Selector="Grid#ShLive.narrow > Border#ShQr">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Grid#ShLive.wide Button#ShQrBtn">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Grid#ShLive.wide TextBlock#ShTlsHint">
            <Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.Column" Value="3"/>
        </Style>
        <Style Selector="Grid#ShLive.narrow TextBlock#ShTlsHint">
            <Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="2"/><Setter Property="Grid.ColumnSpan" Value="2"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style Selector="TextBlock.liveLabel">
            <Setter Property="FontSize" Value="{StaticResource Font.Small}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="34"/>
        </Style>
        <Style Selector="TextBlock.inlineLabel">
            <Setter Property="FontSize" Value="{StaticResource Font.Small}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.pin">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent.Text}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="LetterSpacing" Value="1"/>
        </Style>
        <Style Selector="TextBlock.cert">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Small}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="TextBlock.url">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Body}"/>
            <Setter Property="TextTrimming" Value="LeadingCharacterEllipsis"/>
        </Style>
        <Style Selector="Path.lock">
            <Setter Property="Stroke" Value="{DynamicResource Success}"/>
            <Setter Property="StrokeThickness" Value="1.7"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeJoin" Value="Round"/>
            <Setter Property="Width" Value="13"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Path.lock.plain">
            <Setter Property="Stroke" Value="{DynamicResource Warning}"/>
        </Style>

        <!-- the lower card: sub-tabs Chat | Files | Log -->
        <Style Selector="TabControl.subtabs > TabItem">
            <Setter Property="Padding" Value="11,0"/>
        </Style>
        <Style Selector="Border.badge.unread">
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="MinWidth" Value="18"/>
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        </Style>
        <Style Selector="Border.badge.unread TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.OnAccent}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.panelTitle">
            <Setter Property="FontSize" Value="{StaticResource Font.Caption}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LetterSpacing" Value="0.4"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.counts">
            <Setter Property="FontSize" Value="{StaticResource Font.Caption}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="Button.icon.small">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
        </Style>
        <Style Selector="Button.icon.small Path.glyph">
            <Setter Property="Width" Value="13"/>
            <Setter Property="Height" Value="13"/>
        </Style>

        <!-- chat: a virtualized transcript (the scroll viewer inside the template), own messages tinted and indented -->
        <Style Selector="ItemsControl.chat">
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <ScrollViewer Name="PART_Scroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" Margin="10,8,10,4"/>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- received files: virtualized like the chat (up to 200 done + 100 arriving) -->
        <Style Selector="ItemsControl.received">
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="StackPanel.chatMsg">
            <Setter Property="Margin" Value="0,0,44,8"/>
        </Style>
        <Style Selector="StackPanel.chatMsg.mine">
            <Setter Property="Margin" Value="44,0,0,8"/>
        </Style>
        <Style Selector="Grid#ShLower.narrow StackPanel.chatMsg">
            <Setter Property="Margin" Value="0,0,24,8"/>
        </Style>
        <Style Selector="Grid#ShLower.narrow StackPanel.chatMsg.mine">
            <Setter Property="Margin" Value="24,0,0,8"/>
        </Style>
        <Style Selector="TextBlock.chatWho">
            <Setter Property="FontSize" Value="{StaticResource Font.Small}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="StackPanel.chatMsg.mine TextBlock.chatWho">
            <Setter Property="Foreground" Value="{DynamicResource Accent.Text}"/>
        </Style>
        <Style Selector="TextBlock.chatTime">
            <Setter Property="FontSize" Value="{StaticResource Font.Caption}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.bubble">
            <Setter Property="Background" Value="{DynamicResource Bg.Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style Selector="StackPanel.chatMsg.mine Border.bubble">
            <Setter Property="Background" Value="{DynamicResource Accent.Soft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent.Border}"/>
        </Style>
        <Style Selector="SelectableTextBlock.chatText">
            <Setter Property="FontSize" Value="{StaticResource Font.Body}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="SelectableTextBlock.chatText.file">
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        </Style>
        <Style Selector="Button.tiny">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.tiny:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Bg.Hover}"/>
        </Style>
        <Style Selector="Button.tiny Path.glyph">
            <Setter Property="Stroke" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
        </Style>
        <Style Selector="Button.tiny:pointerover Path.glyph">
            <Setter Property="Stroke" Value="{DynamicResource Accent.Text}"/>
        </Style>
        <Style Selector="TextBox.chatInput">
            <Setter Property="MinHeight" Value="{DynamicResource Control.Height}"/>
            <Setter Property="MaxHeight" Value="96"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- file rows (shared + received) -->
        <Style Selector="Border.fileRow">
            <Setter Property="Background" Value="{DynamicResource Bg.Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}"/>
            <Setter Property="Padding" Value="10,2,4,2"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style Selector="Path.fileIcon">
            <Setter Property="Stroke" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="StrokeJoin" Value="Round"/>
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.fileName">
            <Setter Property="FontSize" Value="{StaticResource Font.Body}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.fileMeta">
            <Setter Property="FontSize" Value="{StaticResource Font.Caption}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="TextBlock.fileMeta.error">
            <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
        </Style>
        <Style Selector="Button.rowAction">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.rowAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Danger.Soft}"/>
        </Style>
        <Style Selector="Button.rowAction:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Danger.Border}"/>
        </Style>
        <Style Selector="Button.rowAction Path.glyph">
            <Setter Property="Stroke" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="Width" Value="11"/>
            <Setter Property="Height" Value="11"/>
        </Style>
        <Style Selector="Button.rowAction:pointerover Path.glyph">
            <Setter Property="Stroke" Value="{DynamicResource Danger}"/>
        </Style>
        <Style Selector="Button.rowBtn">
            <Setter Property="Height" Value="{DynamicResource Control.Height}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Small}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}"/>
            <Setter Property="Background" Value="{DynamicResource Bg.Raised}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.rowBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Bg.RaisedHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
        </Style>
        <Style Selector="ProgressBar.upload">
            <Setter Property="Height" Value="3"/>
            <Setter Property="MinHeight" Value="3"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="Background" Value="{DynamicResource Border.Subtle}"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Margin" Value="0,3,0,1"/>
        </Style>
        <Style Selector="Border.emptyLine">
            <Setter Property="Background" Value="{DynamicResource Bg.Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style Selector="TextBlock.folder">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Small}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="TextTrimming" Value="LeadingCharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- received: the folder in full (wrapping), then [stored ........ Open Change Clean up]; on a phone the buttons
             go under the stored line -->
        <Style Selector="SelectableTextBlock.folderFull">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Small}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.stored">
            <Setter Property="FontSize" Value="{StaticResource Font.Small}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="2,0,8,0"/>
        </Style>
        <Style Selector="Grid#ShStoreRow.wide > StackPanel#ShStoreBtns">
            <Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.Column" Value="1"/>
        </Style>
        <Style Selector="Grid#ShStoreRow.narrow > TextBlock#ShStored">
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
        <Style Selector="Grid#ShStoreRow.narrow > StackPanel#ShStoreBtns">
            <Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="2"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style Selector="Button.rowBtn.cleanup:not(:disabled)">
            <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
        </Style>
        <Style Selector="Button.rowBtn.danger">
            <Setter Property="Background" Value="{DynamicResource Danger.Solid}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Danger.Solid}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.OnDanger}"/>
        </Style>
        <Style Selector="Button.rowBtn.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Danger.SolidHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Danger.SolidHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.OnDanger}"/>
        </Style>
        <Style Selector="Border.confirmLine">
            <Setter Property="Background" Value="{DynamicResource Danger.Soft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Danger.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
        <Style Selector="TextBlock.confirmText">
            <Setter Property="FontSize" Value="{StaticResource Font.Small}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- request log: a read-only text area that blends into its inset card -->
        <Style Selector="TextBox.log">
            <Setter Property="Background" Value="{DynamicResource Bg.Inset}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Small}"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="TextBox.log:pointerover /template/ Border#PART_BorderElement, TextBox.log:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource Bg.Inset}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.log:pointerover, TextBox.log:focus">
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        </Style>
        <Style Selector="Grid#ShLogHead.narrow > TextBlock#ShStats">
            <Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="3"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

        <!-- ===================== CATCH REQUESTS ===================== -->
        <!-- page: one screen tall on desktop; on a phone at least 640px (the page scrolls, the list keeps its room) -->
        <Style Selector="ScrollViewer#CtPage.wide">
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style Selector="ScrollViewer#CtPage.narrow">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style Selector="ScrollViewer#CtPage.narrow > Grid#CtRoot">
            <Setter Property="Height" Value="{Binding $parent[ScrollViewer].Bounds.Height}"/>
            <Setter Property="MinHeight" Value="640"/>
        </Style>
        <!-- phone, reply editor open: the page grows (and scrolls) rather than squeezing the list to a row -->
        <Style Selector="ScrollViewer#CtPage.narrow > Grid#CtRoot.replyOpen">
            <Setter Property="MinHeight" Value="1000"/>
        </Style>

        <!-- [listen on][port][start] on one line; the address on its own line on a phone -->
        <Style Selector="Grid#CtFields.wide > Grid#CtRest">
            <Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.Column" Value="1"/><Setter Property="Grid.ColumnSpan" Value="1"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <Style Selector="Grid#CtFields.narrow > Grid#CtRest">
            <Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="2"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
        <Style Selector="Grid#CtFields.narrow > StackPanel#CtBind">
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
        <Style Selector="Grid#CtFields.narrow Button#CtToggle">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <!-- phone, while catching: the (locked) address and port fold away — the card keeps Stop and the URL -->
        <Style Selector="ScrollViewer#CtPage.narrow Grid#CtRoot.running StackPanel#CtBind, ScrollViewer#CtPage.narrow Grid#CtRoot.running StackPanel#CtPortBox">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="ScrollViewer#CtPage.narrow Grid#CtRoot.running Grid#CtRest">
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- reply editor: [status][content type][delay] / [body]; the content type on its own line on a phone -->
        <Style Selector="Grid#CtReply > StackPanel#CtReplyType">
            <Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.Column" Value="1"/>
        </Style>
        <Style Selector="Grid#CtReply > StackPanel#CtReplyDelay">
            <Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.Column" Value="2"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <Style Selector="Grid#CtReply.narrow > StackPanel#CtReplyType">
            <Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="3"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
        <Style Selector="Grid#CtReply.narrow > StackPanel#CtReplyDelay">
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="TextBox.replyBody">
            <Setter Property="MinHeight" Value="52"/>
            <Setter Property="MaxHeight" Value="96"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Small}"/>
        </Style>

        <!-- list | details side by side; on a phone the list, or the details of the one picked (with a back button) -->
        <Style Selector="Grid#CtSplit.wide > Grid#CtListPane">
            <Setter Property="Width" Value="268"/>
        </Style>
        <Style Selector="Grid#CtSplit.wide > Border#CtDetailPane">
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="BorderThickness" Value="1,0,0,0"/>
        </Style>
        <Style Selector="Grid#CtSplit.wide Button#CtBack">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Grid#CtSplit.narrow > Grid#CtListPane, Grid#CtSplit.narrow > Border#CtDetailPane">
            <Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
        <Style Selector="Grid#CtSplit.narrow.detail > Grid#CtListPane">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Grid#CtSplit.narrow:not(.detail) > Border#CtDetailPane">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <!-- request rows -->
        <Style Selector="ListBox.reqs ListBoxItem">
            <Setter Property="Padding" Value="10,5,10,5"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Margin" Value="4,1"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ListBox.reqs ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Bg.Hover}"/>
        </Style>
        <Style Selector="ListBox.reqs ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Bg.Selected}"/>
        </Style>
        <Style Selector="Border.badge.method">
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="MinWidth" Value="44"/>
        </Style>
        <Style Selector="Border.badge.method TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.badge.violet">
            <Setter Property="Background" Value="{DynamicResource Violet.Soft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Violet.Border}"/>
        </Style>
        <Style Selector="Border.badge.violet TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Violet}"/>
        </Style>
        <Style Selector="TextBlock.reqPath">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Small}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.reqStatus">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Small}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.reqStatus.ok"><Setter Property="Foreground" Value="{DynamicResource Success}"/></Style>
        <Style Selector="TextBlock.reqStatus.redirect"><Setter Property="Foreground" Value="{DynamicResource Info}"/></Style>
        <Style Selector="TextBlock.reqStatus.client"><Setter Property="Foreground" Value="{DynamicResource Warning}"/></Style>
        <Style Selector="TextBlock.reqStatus.server"><Setter Property="Foreground" Value="{DynamicResource Danger}"/></Style>
        <Style Selector="TextBlock.reqMeta">
            <Setter Property="FontSize" Value="{StaticResource Font.Caption}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>

        <!-- details -->
        <Style Selector="SelectableTextBlock.reqLine">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Small}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TabControl.detailTabs > TabItem">
            <Setter Property="Padding" Value="10,0"/>
        </Style>
        <Style Selector="TextBlock.bodyLabel">
            <Setter Property="FontSize" Value="{StaticResource Font.Caption}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
        </Style>
        <Style Selector="SelectableTextBlock.bodyText, SelectableTextBlock.fieldValue">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Small}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.fieldName">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Small}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Width" Value="128"/>
        </Style>
        <Style Selector="Grid#CtSplit.narrow TextBlock.fieldName">
            <Setter Property="Width" Value="104"/>
        </Style>
        <Style Selector="ctl|HexDumpView.bodyHex">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Small}"/>
            <Setter Property="OffsetBrush" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="HexBrush" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="AsciiBrush" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </UserControl.Styles>

    <Panel>
    <!-- ===================== SHARE & CHAT =====================
         One screen tall on desktop (the chat / files / log card takes what the server card leaves; lists scroll inside);
         on a phone the page scrolls rather than squeezing the chat. -->
    <ScrollViewer x:Name="ShPage" helpers:Responsive.BreakWidth="560" HorizontalScrollBarVisibility="Disabled"
                  IsVisible="{Binding IsShareMode}">
        <Grid x:Name="ShRoot" RowDefinitions="Auto, *" RowSpacing="12" Classes.running="{Binding IsRunning}">

            <!-- ===== server: listen settings + start, then the link / PIN / certificate / QR while sharing ===== -->
            <Border Grid.Row="0" Classes="card section">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*, Auto">
                        <TabControl Grid.Column="0" Classes="seg wsmode" Padding="0" SelectedIndex="{Binding ModeIndex}" VerticalAlignment="Center"
                                    ToolTip.Tip="Chat and swap files with browsers on your network, or catch the requests a webhook / app sends">
                            <TabItem Header="Share &amp; chat"/>
                            <TabItem Header="Catch requests"/>
                        </TabControl>
                        <Border Grid.Column="1" Classes="badge" Classes.success="{Binding IsRunning}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Classes="dot" IsVisible="{Binding IsRunning}"/>
                                <TextBlock Text="Running" IsVisible="{Binding IsRunning}"/>
                                <TextBlock Text="Starting" IsVisible="{Binding IsStarting}"/>
                                <TextBlock Text="Stopped" IsVisible="{Binding IsIdle}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Listen settings are locked while running: the hub captures them at start. -->
                    <Grid x:Name="ShFields" helpers:Responsive.BreakWidth="560" ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                        <StackPanel x:Name="ShBind">
                            <TextBlock Classes="fieldLabel" Text="Listen on"/>
                            <ComboBox x:Name="ShBindBox" Classes="field" ItemsSource="{Binding BindOptions}" SelectedItem="{Binding SelectedBind}"
                                      HorizontalAlignment="Stretch" IsEnabled="{Binding IsIdle}"
                                      ToolTip.Tip="All interfaces = this device and others on your network; this device only = 127.0.0.1; or one interface's address">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BindOption">
                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <Grid x:Name="ShRest" ColumnDefinitions="Auto, Auto, Auto, *" RowDefinitions="Auto, Auto">
                            <StackPanel x:Name="ShPortBox" Grid.Column="0" Width="76">
                                <TextBlock Classes="fieldLabel" Text="Port"/>
                                <NumericUpDown Classes="field" Value="{Binding Port}" Minimum="1" Maximum="65535" ShowButtonSpinner="False"
                                               FormatString="0" IsEnabled="{Binding IsIdle}"/>
                            </StackPanel>
                            <CheckBox x:Name="ShHttps" Grid.Column="1" Content="HTTPS" IsChecked="{Binding HttpsOn}" IsEnabled="{Binding IsIdle}"
                                      ToolTip.Tip="Encrypt everything with this device's own certificate (browsers warn once). Off = plain HTTP."/>
                            <CheckBox x:Name="ShPin" Grid.Column="2" Content="PIN" IsChecked="{Binding PinOn}" IsEnabled="{Binding IsIdle}"
                                      ToolTip.Tip="Browsers need the 8-digit PIN (the link and QR carry it). Off = anyone who can reach the port joins."/>
                            <Button x:Name="ShToggle" Classes="toggle" MinWidth="120" VerticalAlignment="Bottom"
                                    Command="{Binding ToggleServerCommand}" Classes.active="{Binding IsRunning}" IsEnabled="{Binding !IsStarting}">
                                <Panel>
                                    <TextBlock Text="Start sharing" IsVisible="{Binding IsIdle}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Starting…" IsVisible="{Binding IsStarting}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Stop" IsVisible="{Binding IsRunning}" HorizontalAlignment="Center"/>
                                </Panel>
                            </Button>
                        </Grid>
                    </Grid>

                    <!-- while sharing: the link (with the PIN in it), the PIN, the certificate — and the QR -->
                    <Grid x:Name="ShLive" helpers:Responsive.BreakWidth="500" ColumnDefinitions="*, Auto" ColumnSpacing="12" IsVisible="{Binding IsRunning}">
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto" ColumnSpacing="6">
                                <TextBlock Classes="liveLabel" Text="Link"/>
                                <ComboBox x:Name="ShUrlBox" Grid.Column="1" Classes="field" ItemsSource="{Binding Addresses}" SelectedItem="{Binding SelectedShareUrl}"
                                          HorizontalAlignment="Stretch"
                                          ToolTip.Tip="Open it on the other device (same Wi-Fi / network). Copy, Open and the QR include the PIN, so they log in directly.">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="sys:String">
                                            <TextBlock Classes="url" Text="{Binding}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="2" Classes="icon" ToolTip.Tip="Copy the link (with the PIN)" Command="{Binding CopyLinkCommand}">
                                    <Path Classes="glyph" Data="{StaticResource WsIcoCopy}"/>
                                </Button>
                                <Button Grid.Column="3" Classes="icon" ToolTip.Tip="Open in this device's browser" Command="{Binding OpenLinkCommand}"
                                        IsVisible="{x:Static helpers:AppPlatform.IsDesktop}">
                                    <Path Classes="glyph" Data="{StaticResource WsIcoOpen}"/>
                                </Button>
                                <Button x:Name="ShQrBtn" Grid.Column="4" Classes="icon" ToolTip.Tip="Show the QR code">
                                    <Path Classes="glyph" Data="{StaticResource WsIcoQr}"/>
                                    <Button.Flyout>
                                        <Flyout Placement="BottomEdgeAlignedRight">
                                            <StackPanel Spacing="8">
                                                <Border CornerRadius="{StaticResource Radius.Md}" ClipToBounds="True" HorizontalAlignment="Center">
                                                    <Image Source="{Binding QrImage}" Width="180" Height="180" RenderOptions.BitmapInterpolationMode="None"/>
                                                </Border>
                                                <TextBlock Text="Scan with the other device's camera" HorizontalAlignment="Center"
                                                           FontSize="{StaticResource Font.Small}" Foreground="{DynamicResource Text.Secondary}"/>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                            <Grid ColumnDefinitions="Auto, Auto, Auto, Auto, *" ColumnSpacing="6" IsVisible="{Binding ShowRunningPin}">
                                <TextBlock Classes="liveLabel" Text="PIN"/>
                                <SelectableTextBlock Grid.Column="1" Classes="pin" Text="{Binding PinText}" FontFamily="{StaticResource MonoFont}"
                                                     FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Accent.Text}" VerticalAlignment="Center"
                                                     ToolTip.Tip="The page asks for it once (the link and QR carry it). Scripts: the PIN is the Basic-auth password, e.g. curl -k -u :PIN -OJ followed by a download link from the page."/>
                                <Button Grid.Column="2" Classes="icon small" ToolTip.Tip="Copy the PIN" Command="{Binding CopyPinCommand}" Margin="4,0,0,0">
                                    <Path Classes="glyph" Data="{StaticResource WsIcoCopy}"/>
                                </Button>
                                <Button Grid.Column="3" Classes="ghost" Content="New PIN" Command="{Binding NewPinCommand}" Padding="10,0"
                                        ToolTip.Tip="A new random PIN: every browser has to enter it again"/>
                            </Grid>
                            <Grid x:Name="ShTls" ColumnDefinitions="Auto, Auto, Auto, *" RowDefinitions="Auto, Auto" ColumnSpacing="6">
                                <TextBlock Classes="liveLabel" Text="TLS"/>
                                <Path Grid.Column="1" Classes="lock" Classes.plain="{Binding !IsHttpsActive}" Data="{StaticResource WsIcoLock}"/>
                                <TextBlock Grid.Column="2" Classes="cert" Text="{Binding CertText}" ToolTip.Tip="{Binding CertTip}" IsVisible="{Binding IsHttpsActive}"/>
                                <TextBlock Grid.Column="2" Classes="cert" Text="Plain HTTP — not encrypted" IsVisible="{Binding !IsHttpsActive}"
                                           ToolTip.Tip="Turn HTTPS on (when stopped) to encrypt the chat and the files"/>
                                <TextBlock x:Name="ShTlsHint" Classes="hint" Text="· browsers warn once (own certificate)"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           IsVisible="{Binding IsHttpsActive}" ToolTip.Tip="{Binding CertTip}"/>
                            </Grid>
                        </StackPanel>
                        <!-- QR of the link (the bitmap carries its own white quiet zone); a phone shows it behind the QR button -->
                        <Border x:Name="ShQr" Grid.Column="1" CornerRadius="{StaticResource Radius.Md}" ClipToBounds="True" VerticalAlignment="Center"
                                BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"
                                ToolTip.Tip="Scan with the other device's camera: it opens the page logged in">
                            <Image Source="{Binding QrImage}" Width="104" Height="104" RenderOptions.BitmapInterpolationMode="None"
                                   IsVisible="{Binding QrImage, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="ShStatus" Classes="hint" Text="{Binding StatusMessage}" Classes.error="{Binding StatusIsError}"/>
                    <TextBlock Classes="hint warn" Text="{Binding TlsNote}"
                               IsVisible="{Binding HasTlsNote}"/>
                </StackPanel>
            </Border>

            <!-- ===== chat | files | log ===== -->
            <Border Grid.Row="1" Classes="card output">
                <Grid x:Name="ShLower" helpers:Responsive.BreakWidth="520" RowDefinitions="Auto, *">
                    <Grid Margin="10,8,10,6" ColumnDefinitions="*, Auto">
                        <TabControl Classes="seg subtabs" Padding="0" SelectedIndex="{Binding SubTabIndex}" VerticalAlignment="Center">
                            <TabItem>
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Chat" VerticalAlignment="Center"/>
                                        <Border Classes="badge unread" IsVisible="{Binding HasUnread}">
                                            <TextBlock Text="{Binding UnreadText}"/>
                                        </Border>
                                    </StackPanel>
                                </TabItem.Header>
                            </TabItem>
                            <TabItem Header="Files"/>
                            <TabItem Header="Log"/>
                        </TabControl>
                        <Button Grid.Column="1" Classes="icon small" Command="{Binding ClearChatCommand}" ToolTip.Tip="Clear the chat (here and on every page)"
                                IsVisible="{Binding IsChatTab}" IsEnabled="{Binding HasChat}">
                            <Path Classes="glyph" Data="{StaticResource WsIcoClear}"/>
                        </Button>
                        <Button Grid.Column="1" Classes="icon small" Command="{Binding ClearLogCommand}" ToolTip.Tip="Clear the log"
                                IsVisible="{Binding IsLogTab}">
                            <Path Classes="glyph" Data="{StaticResource WsIcoClear}"/>
                        </Button>
                    </Grid>

                    <Panel Grid.Row="1">
                        <!-- ===== chat ===== -->
                        <Grid IsVisible="{Binding IsChatTab}" RowDefinitions="*, Auto">
                            <Panel>
                                <ItemsControl x:Name="ChatList" Classes="chat" ItemsSource="{Binding ChatItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ChatRow">
                                            <StackPanel Classes="chatMsg" Classes.mine="{Binding IsMine}" Spacing="2">
                                                <Grid ColumnDefinitions="Auto, Auto, *, Auto, Auto" ColumnSpacing="6" Margin="2,0,0,0">
                                                    <TextBlock Classes="chatWho" Text="{Binding Header}" MaxWidth="220"/>
                                                    <TextBlock Grid.Column="1" Classes="chatTime" Text="{Binding TimeText}"/>
                                                    <Button Grid.Column="3" Classes="tiny" IsVisible="{Binding HasUrl}" ToolTip.Tip="Open the link"
                                                            Command="{Binding $parent[ItemsControl].((vm:WebServerViewModel)DataContext).OpenChatLinkCommand}"
                                                            CommandParameter="{Binding}">
                                                        <Path Classes="glyph" Data="{StaticResource WsIcoOpen}"/>
                                                    </Button>
                                                    <Button Grid.Column="4" Classes="tiny" IsVisible="{Binding CanCopy}" ToolTip.Tip="Copy the message"
                                                            Command="{Binding $parent[ItemsControl].((vm:WebServerViewModel)DataContext).CopyChatCommand}"
                                                            CommandParameter="{Binding}">
                                                        <Path Classes="glyph" Data="{StaticResource WsIcoCopy}"/>
                                                    </Button>
                                                </Grid>
                                                <Border Classes="bubble">
                                                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                                                        <Path Classes="fileIcon" Data="{StaticResource WsIcoFile}" IsVisible="{Binding IsFile}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                                        <SelectableTextBlock Grid.Column="1" Classes="chatText" Classes.file="{Binding IsFile}" Text="{Binding Body}" FlowDirection="{Binding TextFlow}"/>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Spacing="6" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            IsHitTestVisible="False" IsVisible="{Binding !HasChat}">
                                    <Path Classes="emptyIcon" Data="{StaticResource WsIcoChat}"/>
                                    <TextBlock Text="No messages yet" HorizontalAlignment="Center" FontWeight="SemiBold"
                                               FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource Text.Secondary}"/>
                                    <TextBlock Classes="hint" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="260"
                                               Text="Messages from every browser show up here."/>
                                </StackPanel>
                            </Panel>
                            <Border Grid.Row="1" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0" Padding="10,8">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8">
                                        <Button Classes="icon" Click="Attach_Click" IsEnabled="{Binding CanAttach}" VerticalAlignment="Bottom"
                                                ToolTip.Tip="Share files: each shows as a download link on every page">
                                            <Path Classes="glyph" Data="{StaticResource WsIcoPlus}"/>
                                        </Button>
                                        <TextBox x:Name="ChatBox" Grid.Column="1" Classes="field chatInput" Text="{Binding ChatDraft}"
                                                 AcceptsReturn="True" TextWrapping="Wrap" PlaceholderText="Message" IsEnabled="{Binding IsRunning}"
                                                 ToolTip.Tip="Enter sends · Shift+Enter adds a line"/>
                                        <Button Grid.Column="2" Classes="primary" MinWidth="64" Content="Send" VerticalAlignment="Bottom"
                                                Command="{Binding SendChatCommand}" IsEnabled="{Binding CanSendChat}"/>
                                    </Grid>
                                    <TextBlock Classes="hint error" Text="{Binding ChatError}" Margin="2,0,0,0"
                                               IsVisible="{Binding ChatError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ===== files: shared by this device / received from browsers ===== -->
                        <Grid IsVisible="{Binding IsFilesTab}" RowDefinitions="Auto, Auto, Auto, *, Auto" Margin="10,0,10,8">
                            <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="6" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Classes="panelTitle" Text="SHARED"/>
                                    <TextBlock Classes="counts" Text="{Binding Files.Count}" IsVisible="{Binding HasFiles}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="rowBtn" Click="AddFiles_Click" ToolTip.Tip="Files every browser can download">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Classes="glyph" Data="{StaticResource WsIcoPlus}" Stroke="{DynamicResource Text.Primary}" Width="11" Height="11"/>
                                        <TextBlock Text="Add files" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Classes="icon small" Command="{Binding ClearFilesCommand}" IsEnabled="{Binding HasFiles}"
                                        ToolTip.Tip="Stop sharing all of them">
                                    <Path Classes="glyph" Data="{StaticResource WsIcoClear}"/>
                                </Button>
                            </Grid>
                            <Panel Grid.Row="1">
                                <Border Classes="emptyLine" IsVisible="{Binding !HasFiles}">
                                    <TextBlock Classes="hint" Text="Nothing shared yet. Added files appear as downloads on the page."/>
                                </Border>
                                <ScrollViewer MaxHeight="104" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasFiles}">
                                    <ItemsControl ItemsSource="{Binding Files}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SharedFileRow">
                                                <Border Classes="fileRow">
                                                    <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto" ColumnSpacing="8">
                                                        <Path Grid.Column="0" Classes="fileIcon" Data="{StaticResource WsIcoFile}"/>
                                                        <TextBlock Grid.Column="1" Classes="fileName" Text="{Binding Name}" ToolTip.Tip="{Binding Name}"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Downloads, StringFormat='↓ {0}'}" IsVisible="{Binding HasDownloads}"
                                                                   FontSize="{StaticResource Font.Small}" FontWeight="SemiBold" Foreground="{DynamicResource Success}"
                                                                   VerticalAlignment="Center" ToolTip.Tip="Complete downloads of this file"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="{StaticResource Font.Small}"
                                                                   Foreground="{DynamicResource Text.Muted}" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="4" Classes="rowAction" ToolTip.Tip="Stop sharing it"
                                                                Command="{Binding $parent[ItemsControl].((vm:WebServerViewModel)DataContext).RemoveFileCommand}"
                                                                CommandParameter="{Binding}">
                                                            <Path Classes="glyph" Data="{StaticResource WsIcoClose}"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Panel>

                            <!-- RECEIVED: the folder they go to (in full), what is stored there and Clean up, the size cap -->
                            <StackPanel x:Name="ShInboxRow" Grid.Row="2" Spacing="5" Margin="0,8,0,6">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Classes="panelTitle" Text="RECEIVED"/>
                                        <TextBlock Classes="counts" Text="{Binding ReceivedFiles.Count}" IsVisible="{Binding HasReceived}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                                ToolTip.Tip="The largest file a browser may send (MB). Free space is checked too.">
                                        <TextBlock Classes="inlineLabel" Text="Max MB"/>
                                        <NumericUpDown Classes="field" Width="72" Value="{Binding MaxUploadMb}" Minimum="1" Maximum="1048576"
                                                       ShowButtonSpinner="False" FormatString="0"/>
                                    </StackPanel>
                                </Grid>
                                <!-- the folder, never cut short: it wraps -->
                                <Border x:Name="ShFolder" Classes="emptyLine" Padding="8,6" Margin="0">
                                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                                        <Path Classes="fileIcon" Data="{StaticResource WsIcoFolder}" Width="14" Height="14" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                        <SelectableTextBlock Grid.Column="1" Classes="folderFull" Text="{Binding InboxDisplay}"
                                                             ToolTip.Tip="Where files sent from a browser are saved"/>
                                    </Grid>
                                </Border>
                                <!-- what is stored + Open / Change / Clean up; Clean up asks first -->
                                <Grid x:Name="ShStoreRow" helpers:Responsive.BreakWidth="440" ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto"
                                      IsVisible="{Binding IsNotConfirmingCleanup}">
                                    <TextBlock x:Name="ShStored" Classes="stored" Text="{Binding StoredText}"
                                               ToolTip.Tip="What Echoes received and still keeps: what Clean up would free"/>
                                    <StackPanel x:Name="ShStoreBtns" Orientation="Horizontal" Spacing="6">
                                        <Button Classes="rowBtn" Content="Open" Command="{Binding OpenInboxCommand}" IsVisible="{Binding CanOpenInbox}"
                                                ToolTip.Tip="Open the folder"/>
                                        <Button Classes="rowBtn" Content="Change" Click="ChangeInbox_Click" IsVisible="{Binding CanChangeInbox}"
                                                ToolTip.Tip="Pick the folder received files go to"/>
                                        <Button Classes="rowBtn cleanup" Content="Clean up" Command="{Binding AskCleanUpCommand}" IsEnabled="{Binding CanCleanUp}"
                                                ToolTip.Tip="Delete the files Echoes received to free the space (only those: nothing else in the folder)"/>
                                    </StackPanel>
                                </Grid>
                                <Border Classes="confirmLine" IsVisible="{Binding IsConfirmingCleanup}">
                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                        <TextBlock Classes="confirmText" Text="{Binding CleanupPrompt}"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button Classes="rowBtn danger" Content="Delete" Command="{Binding ConfirmCleanUpCommand}"/>
                                            <Button Classes="rowBtn" Content="Cancel" Command="{Binding CancelCleanUpCommand}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <Panel Grid.Row="3">
                                <Border Classes="emptyLine" VerticalAlignment="Top" IsVisible="{Binding !HasReceived}">
                                    <TextBlock Classes="hint" Text="Files sent from a browser land in the folder above."/>
                                </Border>
                                <ItemsControl Classes="received" ItemsSource="{Binding ReceivedFiles}" IsVisible="{Binding HasReceived}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ReceivedFileRow">
                                                <Border Classes="fileRow">
                                                    <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto" ColumnSpacing="8">
                                                        <Path Grid.Column="0" Classes="fileIcon" Data="{StaticResource WsIcoFile}"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,2">
                                                            <TextBlock Classes="fileName" Text="{Binding Name}" ToolTip.Tip="{Binding Name}"/>
                                                            <TextBlock Classes="fileMeta" Classes.error="{Binding IsFailed}" Text="{Binding Detail}"/>
                                                            <ProgressBar Classes="upload" Value="{Binding Percent}" IsVisible="{Binding IsPending}"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Classes="rowBtn" Content="Open" IsVisible="{Binding CanOpen}" Click="OpenReceived_Click"
                                                                ToolTip.Tip="Open it with its app"/>
                                                        <Button Grid.Column="3" Classes="rowBtn" Content="Show" IsVisible="{Binding CanShow}"
                                                                Command="{Binding $parent[ItemsControl].((vm:WebServerViewModel)DataContext).ShowReceivedCommand}"
                                                                CommandParameter="{Binding}" ToolTip.Tip="Show it in its folder"/>
                                                        <Button Grid.Column="4" Classes="rowBtn" Content="Save" IsVisible="{Binding CanSave}" Click="SaveReceived_Click"
                                                                ToolTip.Tip="Save it somewhere on this device"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Panel>
                            <TextBlock Grid.Row="4" Classes="hint error" Margin="2,4,0,0" Text="{Binding FilesError}"
                                       IsVisible="{Binding FilesError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </Grid>

                        <!-- ===== log ===== -->
                        <Grid IsVisible="{Binding IsLogTab}" RowDefinitions="Auto, *" Margin="10,0,10,8">
                            <Grid x:Name="ShLogHead" helpers:Responsive.BreakWidth="460" ColumnDefinitions="*, Auto, Auto" RowDefinitions="Auto, Auto"
                                  ColumnSpacing="6" Margin="0,0,0,6">
                                <TextBlock x:Name="ShStats" Classes="counts" VerticalAlignment="Center">
                                    <Run Text="{Binding ClientCount}"/><Run Text=" online · "/><Run Text="{Binding TotalConnections}"/><Run Text=" connections · ↑ "/><Run Text="{Binding BytesSentText}"/><Run Text=" · ↓ "/><Run Text="{Binding BytesReceivedText}"/>
                                </TextBlock>
                                <TextBlock Grid.Column="1" Classes="inlineLabel" Text="Max connections"
                                           ToolTip.Tip="Most connections at once (a browser uses up to 6, plus its live connection)"/>
                                <NumericUpDown Grid.Column="2" Classes="field" Width="64" Value="{Binding MaxConnections}"
                                               Minimum="4" Maximum="512" ShowButtonSpinner="False" FormatString="0" IsEnabled="{Binding IsIdle}"
                                               ToolTip.Tip="Most connections at once (a browser uses up to 6, plus its live connection)"/>
                            </Grid>
                            <TextBox Grid.Row="1" Classes="log" Text="{Binding Log}" IsReadOnly="True" AcceptsReturn="True"
                                     TextWrapping="NoWrap" MinHeight="64"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     PlaceholderText="Logins, downloads and files received show up here."/>
                        </Grid>
                    </Panel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>

    <!-- ===================== CATCH REQUESTS =====================
         One screen tall on desktop (the request list takes what the server card leaves, lists scroll inside);
         on a phone never shorter than 640px, so the page scrolls instead of squeezing the list. -->
    <ScrollViewer x:Name="CtPage" helpers:Responsive.BreakWidth="560" HorizontalScrollBarVisibility="Disabled"
                  IsVisible="{Binding IsCatchMode}">
        <Grid x:Name="CtRoot" RowDefinitions="Auto, *" RowSpacing="12" Classes.running="{Binding IsCatching}" Classes.replyOpen="{Binding IsReplyOpen}">

            <!-- ===== server + reply ===== -->
            <Border Grid.Row="0" Classes="card section">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*, Auto">
                        <TabControl Grid.Column="0" Classes="seg wsmode" Padding="0" SelectedIndex="{Binding ModeIndex}" VerticalAlignment="Center">
                            <TabItem Header="Share &amp; chat"/>
                            <TabItem Header="Catch requests"/>
                        </TabControl>
                        <Border Grid.Column="1" Classes="badge" Classes.success="{Binding IsCatching}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Classes="dot" IsVisible="{Binding IsCatching}"/>
                                <TextBlock Text="Listening" IsVisible="{Binding IsCatching}"/>
                                <TextBlock Text="Stopped" IsVisible="{Binding !IsCatching}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- [listen on][port][start] — the URL(s) to send to once it runs -->
                    <Grid x:Name="CtFields" helpers:Responsive.BreakWidth="520" ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                        <StackPanel x:Name="CtBind">
                            <TextBlock Classes="fieldLabel" Text="Listen on"/>
                            <ComboBox x:Name="CtBindBox" Classes="field" ItemsSource="{Binding CatchBindOptions}" SelectedItem="{Binding SelectedCatchBind}"
                                      IsEnabled="{Binding !IsCatching}"
                                      ToolTip.Tip="All interfaces = this device and other devices on your network; this device only = 127.0.0.1">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BindOption">
                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <Grid x:Name="CtRest" ColumnDefinitions="Auto, *">
                            <StackPanel x:Name="CtPortBox" Grid.Column="0" Width="88" Margin="0,0,8,0">
                                <TextBlock Classes="fieldLabel" Text="Port"/>
                                <NumericUpDown Classes="field" Value="{Binding CatchPort}" Minimum="1" Maximum="65535" ShowButtonSpinner="False"
                                               FormatString="0" IsEnabled="{Binding !IsCatching}"/>
                            </StackPanel>
                            <Button x:Name="CtToggle" Grid.Column="1" Classes="toggle" MinWidth="132" VerticalAlignment="Bottom"
                                    Command="{Binding ToggleCatcherCommand}" Classes.active="{Binding IsCatching}">
                                <Panel>
                                    <TextBlock Text="Start catching" IsVisible="{Binding !IsCatching}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Stop" IsVisible="{Binding IsCatching}" HorizontalAlignment="Center"/>
                                </Panel>
                            </Button>
                        </Grid>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto, Auto" RowDefinitions="Auto, Auto" ColumnSpacing="8" IsVisible="{Binding IsCatching}">
                        <TextBlock Grid.ColumnSpan="3" Classes="fieldLabel" Text="Send to"/>
                        <!-- a narrow phone cuts the URL at the front ("…0.0.1:8090/"), so the port stays readable -->
                        <ComboBox x:Name="CtUrlBox" Grid.Row="1" Grid.Column="0" Classes="field" ItemsSource="{Binding CatchUrls}" SelectedItem="{Binding SelectedCatchUrl}"
                                  ToolTip.Tip="Where to send requests — 127.0.0.1 from this device, a LAN address from others">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="sys:String">
                                    <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" TextTrimming="LeadingCharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Row="1" Grid.Column="1" Classes="icon" ToolTip.Tip="Copy the URL" Command="{Binding CopyCatchUrlCommand}">
                            <Path Classes="glyph" Data="{StaticResource WsIcoCopy}"/>
                        </Button>
                        <Button Grid.Row="1" Grid.Column="2" Classes="icon" ToolTip.Tip="Show a QR code of the URL">
                            <Path Classes="glyph" Data="{StaticResource WsIcoQr}"/>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <StackPanel Spacing="8">
                                        <Border CornerRadius="{StaticResource Radius.Md}" ClipToBounds="True" HorizontalAlignment="Center">
                                            <Image Source="{Binding CatchQr}" Width="164" Height="164" RenderOptions.BitmapInterpolationMode="None"/>
                                        </Border>
                                        <TextBlock Text="{Binding SelectedCatchUrl}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource Font.Small}"
                                                   HorizontalAlignment="Center" Foreground="{DynamicResource Text.Secondary}"/>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                    <TextBlock x:Name="CtStatus" Classes="hint" Text="{Binding CatchStatus}" Classes.error="{Binding CatchError}"/>

                    <!-- reply: one summary line; the editor folds open below it -->
                    <Border Classes="divider"/>
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                        <TextBlock Classes="hint" Text="{Binding ReplySummary}" VerticalAlignment="Center" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ReplySummary}"/>
                        <Button Grid.Column="1" Classes="ghost" Command="{Binding ToggleReplyCommand}"
                                ToolTip.Tip="Status, content type, body and delay of the answer every request gets (changes apply at once)">
                            <Panel>
                                <TextBlock Text="Edit reply" IsVisible="{Binding !IsReplyOpen}"/>
                                <TextBlock Text="Done" IsVisible="{Binding IsReplyOpen}"/>
                            </Panel>
                        </Button>
                    </Grid>
                    <Grid x:Name="CtReply" helpers:Responsive.BreakWidth="480" IsVisible="{Binding IsReplyOpen}"
                          ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto, Auto, Auto, Auto">
                        <StackPanel x:Name="CtReplyStatus" Width="80" Margin="0,0,8,0">
                            <TextBlock Classes="fieldLabel" Text="Status"/>
                            <NumericUpDown Classes="field" Value="{Binding ReplyStatus}" Minimum="200" Maximum="599" ShowButtonSpinner="False" FormatString="0"/>
                        </StackPanel>
                        <StackPanel x:Name="CtReplyType">
                            <TextBlock Classes="fieldLabel" Text="Content type"/>
                            <AutoCompleteBox Classes="field" Text="{Binding ReplyContentType}" ItemsSource="{Binding ContentTypes}"
                                             FilterMode="None" MinimumPrefixLength="0" FontFamily="{StaticResource MonoFont}"/>
                        </StackPanel>
                        <StackPanel x:Name="CtReplyDelay" Width="92">
                            <TextBlock Classes="fieldLabel" Text="Delay (ms)"/>
                            <NumericUpDown Classes="field" Value="{Binding ReplyDelayMs}" Minimum="0" Maximum="60000" Increment="100"
                                           ShowButtonSpinner="False" FormatString="0"/>
                        </StackPanel>
                        <StackPanel x:Name="CtReplyBody" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0">
                            <TextBlock Classes="fieldLabel" Text="Body"/>
                            <TextBox Classes="field multiline mono replyBody" Text="{Binding ReplyBody}" AcceptsReturn="True" TextWrapping="Wrap"
                                     PlaceholderText="Empty, or e.g. {&quot;ok&quot;:true}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Classes="hint error" Margin="2,6,0,0" Text="{Binding ReplyError}"
                                   IsVisible="{Binding ReplyError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== requests | details ===== -->
            <Border Grid.Row="1" Classes="card output">
                <Grid x:Name="CtSplit" helpers:Responsive.BreakWidth="600" ColumnDefinitions="Auto, *" Classes.detail="{Binding IsDetailOpen}">

                    <!-- the list -->
                    <Grid x:Name="CtListPane" RowDefinitions="Auto, *">
                        <Grid Margin="12,8,8,6" ColumnDefinitions="*, Auto">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Classes="panelTitle" Text="REQUESTS"/>
                                <TextBlock Classes="counts" Text="{Binding CatchCounts}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Classes="icon small" Command="{Binding ClearRequestsCommand}" ToolTip.Tip="Clear the list"
                                    IsEnabled="{Binding HasRequests}">
                                <Path Classes="glyph" Data="{StaticResource WsIcoClear}"/>
                            </Button>
                        </Grid>
                        <ListBox x:Name="CtList" Grid.Row="1" Classes="reqs" ItemsSource="{Binding Requests}" SelectedItem="{Binding SelectedRequest}"
                                 Background="Transparent" BorderThickness="0" Padding="0,0,0,6"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:CatcherRow">
                                    <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto, Auto" ColumnSpacing="8">
                                        <Border Classes="badge method" Classes.info="{Binding IsGet}" Classes.success="{Binding IsPost}"
                                                Classes.warning="{Binding IsWrite}" Classes.danger="{Binding IsDelete}" Classes.violet="{Binding IsWs}">
                                            <TextBlock Text="{Binding Method}"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Classes="reqPath" Text="{Binding PathText}" ToolTip.Tip="{Binding PathText}"/>
                                        <TextBlock Grid.Column="2" Classes="reqStatus" Text="{Binding StatusText}"
                                                   Classes.ok="{Binding IsOk}" Classes.redirect="{Binding IsRedirect}"
                                                   Classes.client="{Binding IsClientError}" Classes.server="{Binding IsServerError}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Classes="reqMeta">
                                            <Run Text="{Binding TimeText}"/><Run Text="  ·  "/><Run Text="{Binding SizeText}"/><Run Text="  ·  "/><Run Text="{Binding ClientText}"/>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="1" Spacing="6" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False" IsVisible="{Binding !HasRequests}">
                            <Path Classes="emptyIcon" Data="{StaticResource WsIcoInbox}"/>
                            <TextBlock Text="No requests yet" HorizontalAlignment="Center" FontWeight="SemiBold"
                                       FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource Text.Secondary}"/>
                            <TextBlock Classes="hint" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="230"
                                       Text="Point a webhook, an app or curl at the URL."/>
                        </StackPanel>
                    </Grid>

                    <!-- the details of the selected one -->
                    <Border x:Name="CtDetailPane" BorderBrush="{DynamicResource Border.Subtle}">
                        <Panel>
                            <TextBlock Classes="hint" Text="Select a request to see its details." HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Margin="20" TextAlignment="Center" IsVisible="{Binding !HasDetail}"/>
                            <Grid RowDefinitions="Auto, Auto, *" IsVisible="{Binding HasDetail}" Margin="12,10,12,0">
                                <!-- request line + meta + note -->
                                <Grid Grid.Row="0" ColumnDefinitions="Auto, *">
                                    <Button x:Name="CtBack" Classes="icon" Margin="0,0,10,0" Command="{Binding CloseDetailCommand}" ToolTip.Tip="Back to the list"
                                            VerticalAlignment="Top">
                                        <Path Classes="glyph" Data="{StaticResource WsIcoBack}"/>
                                    </Button>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <SelectableTextBlock Classes="reqLine" Text="{Binding Detail.RequestLine, FallbackValue=''}"/>
                                        <TextBlock Classes="hint" Text="{Binding Detail.Meta, FallbackValue=''}"/>
                                        <TextBlock Classes="hint warn" Text="{Binding Detail.Note, FallbackValue=''}"
                                                   IsVisible="{Binding Detail.HasNote, FallbackValue=False}"/>
                                    </StackPanel>
                                </Grid>
                                <!-- tabs + actions -->
                                <!-- the tabs and the copy actions share a line when there's room, else the actions wrap under -->
                                <WrapPanel x:Name="CtTabsRow" Grid.Row="1" Margin="0,10,0,2" Orientation="Horizontal">
                                    <TabControl x:Name="CtTabs" Classes="seg detailTabs" Padding="0" Margin="0,0,10,8" SelectedIndex="{Binding DetailTabIndex}">
                                        <TabItem Header="Body"/>
                                        <TabItem Header="{Binding Detail.HeadersTitle, FallbackValue='Headers'}"/>
                                        <TabItem Header="{Binding Detail.QueryTitle, FallbackValue='Query'}"/>
                                    </TabControl>
                                    <StackPanel x:Name="CtActions" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                                        <Button Classes="secondary" Content="Copy as curl" Command="{Binding CopyCurlCommand}"
                                                IsEnabled="{Binding Detail.CanCopyCurl, FallbackValue=False}"
                                                ToolTip.Tip="A curl command for bash / zsh (not cmd.exe) that sends this request again"/>
                                        <Button Classes="icon" Command="{Binding CopyBodyCommand}" ToolTip.Tip="Copy the body"
                                                IsEnabled="{Binding Detail.CanCopyBody, FallbackValue=False}">
                                            <Path Classes="glyph" Data="{StaticResource WsIcoCopy}"/>
                                        </Button>
                                    </StackPanel>
                                </WrapPanel>
                                <!-- content -->
                                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,4,10">
                                    <Panel>
                                        <!-- body -->
                                        <StackPanel Spacing="6" IsVisible="{Binding IsBodyTab}">
                                            <TextBlock Classes="bodyLabel" Text="{Binding Detail.Body.Label, FallbackValue=''}"/>
                                            <TextBlock Classes="hint warn" Text="{Binding Detail.Body.Note, FallbackValue=''}"
                                                       IsVisible="{Binding Detail.HasBodyNote, FallbackValue=False}"/>
                                            <SelectableTextBlock Classes="bodyText" Text="{Binding Detail.Body.Text, FallbackValue=''}"
                                                                 IsVisible="{Binding Detail.BodyIsText, FallbackValue=False}"/>
                                            <ItemsControl ItemsSource="{Binding Detail.Body.Fields, FallbackValue={x:Null}}"
                                                          IsVisible="{Binding Detail.BodyIsFields, FallbackValue=False}"
                                                          ItemTemplate="{StaticResource CtFieldTemplate}"/>
                                            <ctl:HexDumpView Classes="bodyHex" Data="{Binding Detail.Body.Bytes, FallbackValue={x:Null}}" MaxBytes="16384"
                                                             IsVisible="{Binding Detail.BodyIsHex, FallbackValue=False}"/>
                                        </StackPanel>
                                        <!-- headers -->
                                        <Panel IsVisible="{Binding IsHeadersTab}">
                                            <ItemsControl ItemsSource="{Binding Detail.Headers, FallbackValue={x:Null}}" ItemTemplate="{StaticResource CtFieldTemplate}"/>
                                            <TextBlock Classes="hint" Text="No headers." IsVisible="{Binding !Detail.HasHeaders, FallbackValue=False}"/>
                                        </Panel>
                                        <!-- query -->
                                        <Panel IsVisible="{Binding IsQueryTab}">
                                            <ItemsControl ItemsSource="{Binding Detail.Query, FallbackValue={x:Null}}" ItemTemplate="{StaticResource CtFieldTemplate}"/>
                                            <TextBlock Classes="hint" Text="No query parameters." IsVisible="{Binding !Detail.HasQuery, FallbackValue=False}"/>
                                        </Panel>
                                    </Panel>
                                </ScrollViewer>
                            </Grid>
                        </Panel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
    </Panel>
</UserControl>
