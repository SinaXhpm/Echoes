<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:Echoes.ViewModels"
			 x:Class="Echoes.Views.StringLabView"
			 x:DataType="vm:StringLabViewModel">

	<UserControl.Styles>
		<Style Selector="TabItem">
			<Setter Property="FontSize" Value="11.5"/>
			<Setter Property="MinHeight" Value="22"/>
			<Setter Property="Padding" Value="10,0"/>
			<Setter Property="Opacity" Value="1"/>
		</Style>
		<Style Selector="TabItem.cat">
			<Setter Property="FontSize" Value="12.5"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Padding" Value="14,0"/>
		</Style>

		<!-- Textareas: high-contrast input surface, visible border, green focus -->
		<Style Selector="TextBox">
			<Setter Property="AcceptsReturn" Value="True"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
			<Setter Property="Background" Value="#1D1E25"/>
			<Setter Property="BorderBrush" Value="#3B3D47"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Foreground" Value="#ECECEF"/>
			<Setter Property="CaretBrush" Value="#42B883"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Padding" Value="10,8"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Transitions">
				<Transitions>
					<BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="TextBox:pointerover">
			<Setter Property="BorderBrush" Value="#4C4E59"/>
		</Style>
		<Style Selector="TextBox:focus">
			<Setter Property="BorderBrush" Value="#42B883"/>
		</Style>
		<!-- Read-only outputs: darker inset surface, keep columns aligned and scroll instead of wrapping/lagging -->
		<Style Selector="TextBox[IsReadOnly=True]">
			<Setter Property="TextWrapping" Value="NoWrap"/>
			<Setter Property="Background" Value="#121317"/>
			<Setter Property="BorderBrush" Value="#2A2C33"/>
			<Setter Property="Foreground" Value="#ECECEF"/>
			<Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
			<Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
		</Style>

		<Style Selector="Button">
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
		</Style>
		<!-- Vertical I/O layout: buttons flow in a wrap row (auto width) between input and result. -->
		<Style Selector="WrapPanel.btns &gt; Button">
			<Setter Property="HorizontalAlignment" Value="Left"/>
			<Setter Property="MinWidth" Value="92"/>
			<Setter Property="Margin" Value="0,0,6,6"/>
		</Style>
		<Style Selector="WrapPanel.btns &gt; CheckBox">
			<Setter Property="Margin" Value="0,0,12,6"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
	</UserControl.Styles>

	<Grid RowDefinitions="*, Auto" Margin="12,8,12,12">
		<TabControl Grid.Row="0" Background="Transparent" Padding="0">

			<!-- ============ ENCODE ============ -->
			<TabItem Header="ENCODE" Classes="cat">
				<TabControl Background="Transparent" Padding="0,4,0,0">

					<TabItem Header="BASE64">
						<Grid RowDefinitions="*, Auto, *" Margin="0,2,0,0">
							<TextBox Grid.Row="0" Text="{Binding B64Input, Mode=TwoWay}" PlaceholderText="Input..."/>
							<WrapPanel Grid.Row="1" Classes="btns" Margin="0,8">
								<Button Command="{Binding B64ActionCommand}" CommandParameter="enc" Content="ENCODE ➔" Classes="primary"/>
								<Button Command="{Binding B64ActionCommand}" CommandParameter="dec" Content="DECODE ➔" Classes="secondary"/>
								<Button Command="{Binding ClearCommand}" CommandParameter="b64" Content="CLEAR" Classes="ghost"/>
							</WrapPanel>
							<TextBox Grid.Row="2" Text="{Binding B64Output}" IsReadOnly="True" PlaceholderText="Result..."/>
						</Grid>
					</TabItem>

					<TabItem Header="URL">
						<Grid RowDefinitions="*, Auto, *" Margin="0,2,0,0">
							<TextBox Grid.Row="0" Text="{Binding UrlInput, Mode=TwoWay}" PlaceholderText="URL..."/>
							<WrapPanel Grid.Row="1" Classes="btns" Margin="0,8">
								<Button Command="{Binding UrlActionCommand}" CommandParameter="enc" Content="ENCODE ➔" Classes="primary"/>
								<Button Command="{Binding UrlActionCommand}" CommandParameter="dec" Content="DECODE ➔" Classes="secondary"/>
								<Button Command="{Binding ClearCommand}" CommandParameter="url" Content="CLEAR" Classes="ghost"/>
							</WrapPanel>
							<TextBox Grid.Row="2" Text="{Binding UrlOutput}" IsReadOnly="True" PlaceholderText="Result..."/>
						</Grid>
					</TabItem>

					<TabItem Header="HASH">
						<Grid RowDefinitions="*, Auto, *" Margin="0,2,0,0">
							<TextBox Grid.Row="0" Text="{Binding HashInput, Mode=TwoWay}" PlaceholderText="Text..."/>
							<WrapPanel Grid.Row="1" Classes="btns" Margin="0,8">
								<Button Command="{Binding HashActionCommand}" CommandParameter="md5" Content="MD5" Classes="secondary"/>
								<Button Command="{Binding HashActionCommand}" CommandParameter="sha256" Content="SHA256" Classes="secondary"/>
								<Button Command="{Binding ClearCommand}" CommandParameter="hash" Content="CLEAR" Classes="ghost"/>
							</WrapPanel>
							<TextBox Grid.Row="2" Text="{Binding HashOutput}" IsReadOnly="True" PlaceholderText="Hash..." FontFamily="Cascadia Code,Consolas"/>
						</Grid>
					</TabItem>

					<TabItem Header="HASH ID">
						<Grid RowDefinitions="Auto, *" Margin="0,2,0,0">
							<Grid Grid.Row="0" ColumnDefinitions="*, 90, 70" Margin="0,0,0,8">
								<TextBox Grid.Column="0" Text="{Binding HashIdInput, Mode=TwoWay}" AcceptsReturn="False"
										 TextWrapping="NoWrap" PlaceholderText="Paste a hash to identify..." FontFamily="Cascadia Code,Consolas" Margin="0,0,8,0">
									<TextBox.KeyBindings>
										<KeyBinding Gesture="Enter" Command="{Binding RunHashIdCommand}"/>
									</TextBox.KeyBindings>
								</TextBox>
								<Button Grid.Column="1" Command="{Binding RunHashIdCommand}" Content="IDENTIFY" Classes="primary" Margin="0,0,8,0"/>
								<Button Grid.Column="2" Command="{Binding ClearCommand}" CommandParameter="hashid" Content="CLEAR" Classes="ghost"/>
							</Grid>
							<TextBox Grid.Row="1" Text="{Binding HashIdOutput}" IsReadOnly="True" PlaceholderText="Possible hash types..." FontFamily="Cascadia Code,Consolas"/>
						</Grid>
					</TabItem>

					<TabItem Header="JWT">
						<Grid RowDefinitions="Auto, Auto, *" Margin="0,2,0,0">
							<TextBox Grid.Row="0" Text="{Binding JwtInput, Mode=TwoWay}" AcceptsReturn="False" Height="80"
									 PlaceholderText="Paste a JWT — eyJhbGci... (header.payload.signature)" FontFamily="Cascadia Code,Consolas">
								<TextBox.KeyBindings>
									<KeyBinding Gesture="Enter" Command="{Binding RunJwtCommand}"/>
								</TextBox.KeyBindings>
							</TextBox>
							<Grid Grid.Row="1" ColumnDefinitions="*, 90, 70" Margin="0,8">
								<TextBox Grid.Column="0" Text="{Binding JwtKey, Mode=TwoWay}" AcceptsReturn="False" TextWrapping="NoWrap"
										 PlaceholderText="(optional) HMAC secret or PEM public key — to verify signature"
										 FontFamily="Cascadia Code,Consolas" Margin="0,0,8,0"/>
								<Button Grid.Column="1" Command="{Binding RunJwtCommand}" Content="DECODE" Classes="primary" Margin="0,0,8,0"/>
								<Button Grid.Column="2" Command="{Binding ClearCommand}" CommandParameter="jwt" Content="CLEAR" Classes="ghost"/>
							</Grid>
							<Grid Grid.Row="2" RowDefinitions="*, Auto">
								<TextBox Grid.Row="0" Text="{Binding JwtOutput}" IsReadOnly="True"
										 PlaceholderText="Decoded header, payload &amp; claims..." FontFamily="Cascadia Code,Consolas"/>
								<TextBlock Grid.Row="1" Text="{Binding JwtVerify}" FontFamily="Cascadia Code,Consolas" FontSize="11.5"
										   Margin="2,8,2,0" Foreground="#7FCBA6" TextWrapping="Wrap"
										   IsVisible="{Binding JwtVerify, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
							</Grid>
						</Grid>
					</TabItem>

				</TabControl>
			</TabItem>

			<!-- ============ TEXT ============ -->
			<TabItem Header="TEXT" Classes="cat">
				<TabControl Background="Transparent" Padding="0,4,0,0">

					<TabItem Header="REGEX">
						<Grid RowDefinitions="Auto, Auto, *" Margin="0,2,0,0">
							<Grid Grid.Row="0" ColumnDefinitions="*, 175, 70" Margin="0,0,0,8">
								<TextBox Grid.Column="0" Text="{Binding RegexPattern, Mode=TwoWay}"
										 PlaceholderText="Regex pattern, e.g. \d+"
										 AcceptsReturn="False" TextWrapping="NoWrap"
										 FontFamily="Cascadia Code,Consolas" Margin="0,0,8,0">
									<TextBox.KeyBindings>
										<KeyBinding Gesture="Enter" Command="{Binding RunRegexCommand}"/>
									</TextBox.KeyBindings>
								</TextBox>
								<ComboBox Grid.Column="1" Classes="field" ItemsSource="{Binding DefaultRegexList}"
										  SelectedItem="{Binding SelectedRegex}"
										  PlaceholderText="Presets..."
										  HorizontalAlignment="Stretch" Margin="0,0,8,0">
									<ComboBox.ItemTemplate>
										<DataTemplate>
											<TextBlock Text="{Binding Key}" FontSize="11"/>
										</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>
								<Button Grid.Column="2" Command="{Binding RunRegexCommand}" Content="RUN" Classes="primary"/>
							</Grid>

							<Grid Grid.Row="1" ColumnDefinitions="*, 70" Margin="0,0,0,8">
								<TextBox Grid.Column="0" Text="{Binding RegexReplacement, Mode=TwoWay}"
										 PlaceholderText="Replacement (use $1, $2 for groups)... — for REPLACE"
										 AcceptsReturn="False" TextWrapping="NoWrap"
										 FontFamily="Cascadia Code,Consolas" Margin="0,0,8,0"/>
								<Button Grid.Column="1" Command="{Binding ReplaceRegexCommand}" Content="REPLACE" Classes="secondary"/>
							</Grid>

							<Grid Grid.Row="2" RowDefinitions="*, Auto, *">
								<TextBox Grid.Row="0" Text="{Binding RegexInput, Mode=TwoWay}" PlaceholderText="Text to search..."/>
								<WrapPanel Grid.Row="1" Classes="btns" Margin="0,8">
									<Button Command="{Binding RunRegexCommand}" Content="MATCH ➔" Classes="primary"/>
									<CheckBox IsChecked="{Binding RegexIgnoreCase}" Content="Ignore Case" FontSize="10" Foreground="#C7C8CF" MinHeight="0"/>
									<CheckBox IsChecked="{Binding RegexMultiline}" Content="Multiline" FontSize="10" Foreground="#C7C8CF" MinHeight="0"/>
									<Button Command="{Binding ClearCommand}" CommandParameter="regex" Content="CLEAR" Classes="ghost"/>
								</WrapPanel>
								<TextBox Grid.Row="2" Text="{Binding RegexOutput}" IsReadOnly="True" PlaceholderText="Result / Matches..." FontFamily="Cascadia Code,Consolas"/>
							</Grid>
						</Grid>
					</TabItem>

					<TabItem Header="TEXT LAB">
						<Grid RowDefinitions="Auto, *" Margin="0,2,0,0">
							<StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16" Margin="0,0,0,6">
								<TextBlock Text="{Binding CharCount, StringFormat='CHARS: \{0\}'}" FontSize="10" Foreground="#9E9FA8"/>
								<TextBlock Text="{Binding WordCount, StringFormat='WORDS: \{0\}'}" FontSize="10" Foreground="#9E9FA8"/>
								<TextBlock Text="{Binding LineCount, StringFormat='LINES: \{0\}'}" FontSize="10" Foreground="#9E9FA8"/>
							</StackPanel>
							<Grid Grid.Row="1" RowDefinitions="*, Auto">
								<TextBox Grid.Row="0" Text="{Binding EditInput, Mode=TwoWay}" PlaceholderText="Edit text here..."/>
								<WrapPanel Grid.Row="1" Classes="btns" Margin="0,8,0,0">
									<Button Command="{Binding EditActionCommand}" CommandParameter="sort" Content="SORT A-Z" Classes="secondary"/>
									<Button Command="{Binding EditActionCommand}" CommandParameter="unique" Content="DISTINCT" Classes="secondary"/>
									<Button Command="{Binding EditActionCommand}" CommandParameter="trim" Content="TRIM" Classes="secondary"/>
									<Button Command="{Binding EditActionCommand}" CommandParameter="clean" Content="CLEAN UP" Classes="secondary"/>
									<Button Command="{Binding EditActionCommand}" CommandParameter="upper" Content="UPPER" Classes="secondary"/>
									<Button Command="{Binding EditActionCommand}" CommandParameter="lower" Content="lower" Classes="secondary"/>
									<Button Command="{Binding ClearCommand}" CommandParameter="edit" Content="CLEAR" Classes="ghost"/>
								</WrapPanel>
							</Grid>
						</Grid>
					</TabItem>

					<TabItem Header="CASE">
						<Grid RowDefinitions="*, Auto, *" Margin="0,2,0,0">
							<TextBox Grid.Row="0" Text="{Binding CaseInput, Mode=TwoWay}" PlaceholderText="Input text..."/>
							<WrapPanel Grid.Row="1" Classes="btns" Margin="0,8">
								<Button Command="{Binding CaseActionCommand}" CommandParameter="upper" Content="UPPER" Classes="secondary"/>
								<Button Command="{Binding CaseActionCommand}" CommandParameter="lower" Content="lower" Classes="secondary"/>
								<Button Command="{Binding CaseActionCommand}" CommandParameter="title" Content="Title Case" Classes="secondary"/>
								<Button Command="{Binding CaseActionCommand}" CommandParameter="sentence" Content="Sentence" Classes="secondary"/>
								<Button Command="{Binding CaseActionCommand}" CommandParameter="camel" Content="camelCase" Classes="secondary"/>
								<Button Command="{Binding CaseActionCommand}" CommandParameter="pascal" Content="PascalCase" Classes="secondary"/>
								<Button Command="{Binding CaseActionCommand}" CommandParameter="snake" Content="snake_case" Classes="secondary"/>
								<Button Command="{Binding CaseActionCommand}" CommandParameter="kebab" Content="kebab-case" Classes="secondary"/>
								<Button Command="{Binding CaseActionCommand}" CommandParameter="constant" Content="CONSTANT" Classes="secondary"/>
								<Button Command="{Binding CaseActionCommand}" CommandParameter="slug" Content="slugify" Classes="secondary"/>
								<Button Command="{Binding CaseActionCommand}" CommandParameter="reverse" Content="Reverse" Classes="secondary"/>
								<Button Command="{Binding ClearCommand}" CommandParameter="case" Content="CLEAR" Classes="ghost"/>
							</WrapPanel>
							<TextBox Grid.Row="2" Text="{Binding CaseOutput}" IsReadOnly="True" PlaceholderText="Result..."/>
						</Grid>
					</TabItem>

					<TabItem Header="DIFF">
						<Grid RowDefinitions="*, Auto, *" Margin="0,2,0,0">
							<Grid Grid.Row="0" ColumnDefinitions="*, *">
								<TextBox Grid.Column="0" Text="{Binding DiffLeft, Mode=TwoWay}" PlaceholderText="Original text..." Margin="0,0,4,0" FontFamily="Cascadia Code,Consolas"/>
								<TextBox Grid.Column="1" Text="{Binding DiffRight, Mode=TwoWay}" PlaceholderText="Changed text..." Margin="4,0,0,0" FontFamily="Cascadia Code,Consolas"/>
							</Grid>
							<StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,8">
								<Button Command="{Binding RunDiffCommand}" Content="COMPARE" Classes="primary" Width="120"/>
								<Button Command="{Binding ClearCommand}" CommandParameter="diff" Content="CLEAR" Classes="ghost" Width="90"/>
							</StackPanel>
							<TextBox Grid.Row="2" Text="{Binding DiffOutput}" IsReadOnly="True" PlaceholderText="Diff result ( - removed, + added )..." FontFamily="Cascadia Code,Consolas"/>
						</Grid>
					</TabItem>

				</TabControl>
			</TabItem>

			<!-- ============ DATA ============ -->
			<TabItem Header="DATA" Classes="cat">
				<TabControl Background="Transparent" Padding="0,4,0,0">

					<TabItem Header="JSON LAB">
						<Grid RowDefinitions="*, Auto, *" Margin="0,2,0,0">
							<TextBox Grid.Row="0" Text="{Binding JsonInput, Mode=TwoWay}" PlaceholderText="Paste JSON here..."/>
							<WrapPanel Grid.Row="1" Classes="btns" Margin="0,8">
								<Button Command="{Binding JsonActionCommand}" CommandParameter="format" Content="BEAUTIFY" Classes="primary"/>
								<Button Command="{Binding JsonActionCommand}" CommandParameter="minify" Content="MINIFY" Classes="secondary"/>
								<Button Command="{Binding ClearCommand}" CommandParameter="json" Content="CLEAR" Classes="ghost"/>
							</WrapPanel>
							<TextBox Grid.Row="2" Text="{Binding JsonOutput}" IsReadOnly="True" PlaceholderText="Result..." FontFamily="Cascadia Code,Consolas"/>
						</Grid>
					</TabItem>

					<TabItem Header="CONVERT">
						<Grid RowDefinitions="*, Auto, *" Margin="0,2,0,0">
							<TextBox Grid.Row="0" Text="{Binding ConvertInput, Mode=TwoWay}" PlaceholderText="Paste JSON / YAML / CSV..." FontFamily="Cascadia Code,Consolas"/>
							<WrapPanel Grid.Row="1" Classes="btns" Margin="0,8">
								<Button Command="{Binding ConvertActionCommand}" CommandParameter="json2yaml" Content="JSON → YAML" Classes="secondary"/>
								<Button Command="{Binding ConvertActionCommand}" CommandParameter="yaml2json" Content="YAML → JSON" Classes="secondary"/>
								<Button Command="{Binding ConvertActionCommand}" CommandParameter="json2csv" Content="JSON → CSV" Classes="secondary"/>
								<Button Command="{Binding ConvertActionCommand}" CommandParameter="csv2json" Content="CSV → JSON" Classes="secondary"/>
								<Button Command="{Binding ClearCommand}" CommandParameter="convert" Content="CLEAR" Classes="ghost"/>
							</WrapPanel>
							<TextBox Grid.Row="2" Text="{Binding ConvertOutput}" IsReadOnly="True" PlaceholderText="Result..." FontFamily="Cascadia Code,Consolas"/>
						</Grid>
					</TabItem>

				</TabControl>
			</TabItem>

			<!-- ============ DEV ============ -->
			<TabItem Header="DEV" Classes="cat">
				<TabControl Background="Transparent" Padding="0,4,0,0">

					<TabItem Header="SUBNET">
						<Grid RowDefinitions="Auto, *" Margin="0,2,0,0">
							<Grid Grid.Row="0" ColumnDefinitions="*, 90, 70" Margin="0,0,0,8">
								<TextBox Grid.Column="0" Text="{Binding SubnetInput, Mode=TwoWay}" AcceptsReturn="False"
										 TextWrapping="NoWrap" PlaceholderText="192.168.1.0/24" FontFamily="Cascadia Code,Consolas" Margin="0,0,8,0">
									<TextBox.KeyBindings>
										<KeyBinding Gesture="Enter" Command="{Binding RunSubnetCommand}"/>
									</TextBox.KeyBindings>
								</TextBox>
								<Button Grid.Column="1" Command="{Binding RunSubnetCommand}" Content="CALC" Classes="primary" Margin="0,0,8,0"/>
								<Button Grid.Column="2" Command="{Binding ClearCommand}" CommandParameter="subnet" Content="CLEAR" Classes="ghost"/>
							</Grid>
							<TextBox Grid.Row="1" Text="{Binding SubnetOutput}" IsReadOnly="True" PlaceholderText="Subnet details..." FontFamily="Cascadia Code,Consolas"/>
						</Grid>
					</TabItem>

					<TabItem Header="EPOCH">
						<Grid RowDefinitions="Auto, *" Margin="0,2,0,0">
							<Grid Grid.Row="0" ColumnDefinitions="*, 70, 70, 70" Margin="0,0,0,8">
								<TextBox Grid.Column="0" Text="{Binding EpochInput, Mode=TwoWay}" AcceptsReturn="False"
										 TextWrapping="NoWrap" PlaceholderText="Unix timestamp or date string..." FontFamily="Cascadia Code,Consolas" Margin="0,0,8,0">
									<TextBox.KeyBindings>
										<KeyBinding Gesture="Enter" Command="{Binding RunEpochCommand}"/>
									</TextBox.KeyBindings>
								</TextBox>
								<Button Grid.Column="1" Command="{Binding EpochNowCommand}" Content="NOW" Classes="secondary" Margin="0,0,8,0"/>
								<Button Grid.Column="2" Command="{Binding RunEpochCommand}" Content="CONV" Classes="primary" Margin="0,0,8,0"/>
								<Button Grid.Column="3" Command="{Binding ClearCommand}" CommandParameter="epoch" Content="CLEAR" Classes="ghost"/>
							</Grid>
							<TextBox Grid.Row="1" Text="{Binding EpochOutput}" IsReadOnly="True" PlaceholderText="Converted timestamps..." FontFamily="Cascadia Code,Consolas"/>
						</Grid>
					</TabItem>

					<TabItem Header="BASE CONV">
						<Grid RowDefinitions="Auto, *" Margin="0,2,0,0">
							<Grid Grid.Row="0" ColumnDefinitions="*, 90, 70" Margin="0,0,0,8">
								<TextBox Grid.Column="0" Text="{Binding BaseInput, Mode=TwoWay}" AcceptsReturn="False"
										 TextWrapping="NoWrap" PlaceholderText="255  or  0xFF  or  0b1010  or  0o17" FontFamily="Cascadia Code,Consolas" Margin="0,0,8,0">
									<TextBox.KeyBindings>
										<KeyBinding Gesture="Enter" Command="{Binding RunBaseConvCommand}"/>
									</TextBox.KeyBindings>
								</TextBox>
								<Button Grid.Column="1" Command="{Binding RunBaseConvCommand}" Content="CONVERT" Classes="primary" Margin="0,0,8,0"/>
								<Button Grid.Column="2" Command="{Binding ClearCommand}" CommandParameter="baseconv" Content="CLEAR" Classes="ghost"/>
							</Grid>
							<TextBox Grid.Row="1" Text="{Binding BaseOutput}" IsReadOnly="True" PlaceholderText="dec / hex / oct / bin..." FontFamily="Cascadia Code,Consolas"/>
						</Grid>
					</TabItem>

					<TabItem Header="GENERATE">
						<Grid RowDefinitions="Auto, *" Margin="0,2,0,0">
							<StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,8">
								<Grid ColumnDefinitions="*, *">
									<StackPanel Grid.Column="0" Margin="0,0,4,0">
										<TextBlock Text="LENGTH" Classes="fieldLabel"/>
										<TextBox Text="{Binding GenerateLength}" AcceptsReturn="False"/>
									</StackPanel>
									<StackPanel Grid.Column="1" Margin="4,0,0,0">
										<TextBlock Text="COUNT" Classes="fieldLabel"/>
										<TextBox Text="{Binding GenerateCount}" AcceptsReturn="False"/>
									</StackPanel>
								</Grid>
								<WrapPanel Classes="btns" Margin="0,2,0,0">
									<Button Command="{Binding GenerateCommand}" CommandParameter="uuid" Content="UUID" Classes="secondary"/>
									<Button Command="{Binding GenerateCommand}" CommandParameter="password" Content="PASSWORD" Classes="secondary"/>
									<Button Command="{Binding GenerateCommand}" CommandParameter="alnum" Content="ALPHANUMERIC" Classes="secondary"/>
									<Button Command="{Binding GenerateCommand}" CommandParameter="hex" Content="HEX TOKEN" Classes="secondary"/>
									<Button Command="{Binding GenerateCommand}" CommandParameter="base64" Content="BASE64 TOKEN" Classes="secondary"/>
									<Button Command="{Binding GenerateCommand}" CommandParameter="pin" Content="PIN" Classes="secondary"/>
									<Button Command="{Binding ClearCommand}" CommandParameter="gen" Content="CLEAR" Classes="ghost"/>
								</WrapPanel>
							</StackPanel>
							<TextBox Grid.Row="1" Text="{Binding GenerateOutput}" IsReadOnly="True" PlaceholderText="Generated values..." FontFamily="Cascadia Code,Consolas"/>
						</Grid>
					</TabItem>

				</TabControl>
			</TabItem>

		</TabControl>

		<Border Grid.Row="1" Background="#33E5484D" BorderBrush="#E5484D" BorderThickness="1" CornerRadius="6" Margin="0,10,0,0" Padding="10,8" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
			<TextBlock Text="{Binding ErrorMessage}" Foreground="#ECECEF" FontSize="11" FontWeight="Bold" TextWrapping="Wrap"/>
		</Border>
	</Grid>
</UserControl>
