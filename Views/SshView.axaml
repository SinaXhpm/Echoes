<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:Echoes.ViewModels"
			 x:Class="Echoes.Views.SshView"
			 x:DataType="vm:SshViewModel">

	<UserControl.Styles>
		<Style Selector="CheckBox">
			<Setter Property="Foreground" Value="#42B883"/>
			<Setter Property="FontSize" Value="10"/>
			<Setter Property="Padding" Value="8,0,0,0"/>
		</Style>
		<Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
			<Setter Property="Background" Value="#42B883"/>
			<Setter Property="BorderBrush" Value="#42B883"/>
		</Style>
		<Style Selector="CheckBox /template/ Path#CheckGlyph">
			<Setter Property="Fill" Value="White"/>
		</Style>

		<Style Selector="TextBox.proxyInput">
			<Setter Property="Height" Value="26"/>
			<Setter Property="FontSize" Value="10"/>
			<Setter Property="Background" Value="#0AFFFFFF"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="BorderBrush" Value="#15FFFFFF"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
		</Style>
	</UserControl.Styles>

	<Grid RowDefinitions="Auto, Auto, *, Auto" Margin="15">

		<StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,12">

			<Grid ColumnDefinitions="*, 80">
				<AutoCompleteBox Grid.Column="0" Classes="field" Text="{Binding Host}" ItemsSource="{Binding HostHistory}" FilterMode="ContainsOrdinal" MinimumPrefixLength="0" Watermark="Host / IP" Margin="0,0,8,0">
					<AutoCompleteBox.KeyBindings>
						<KeyBinding Gesture="Enter" Command="{Binding ToggleConnectCommand}"/>
					</AutoCompleteBox.KeyBindings>
				</AutoCompleteBox>
				<TextBox Grid.Column="1" Classes="field" Text="{Binding Port}" Watermark="Port" HorizontalContentAlignment="Center">
					<TextBox.KeyBindings>
						<KeyBinding Gesture="Enter" Command="{Binding ToggleConnectCommand}"/>
					</TextBox.KeyBindings>
				</TextBox>
			</Grid>

			<Grid ColumnDefinitions="*, *, 110">
				<AutoCompleteBox Grid.Column="0" Classes="field" Text="{Binding Username}" ItemsSource="{Binding UserHistory}" FilterMode="ContainsOrdinal" MinimumPrefixLength="0" Watermark="Username" Margin="0,0,8,0">
					<AutoCompleteBox.KeyBindings>
						<KeyBinding Gesture="Enter" Command="{Binding ToggleConnectCommand}"/>
					</AutoCompleteBox.KeyBindings>
				</AutoCompleteBox>
				<TextBox Grid.Column="1" Classes="field" Text="{Binding Password}" PasswordChar="*" Watermark="Password" Margin="0,0,8,0">
					<TextBox.KeyBindings>
						<KeyBinding Gesture="Enter" Command="{Binding ToggleConnectCommand}"/>
					</TextBox.KeyBindings>
				</TextBox>

				<Button Grid.Column="2" Classes="toggle"
						Command="{Binding ToggleConnectCommand}"
						HorizontalAlignment="Stretch"
						Classes.active="{Binding IsConnected}">
					<Panel>
						<TextBlock Text="CONNECT" IsVisible="{Binding !IsConnected}" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
						<TextBlock Text="STOP" IsVisible="{Binding IsConnected}" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
					</Panel>
				</Button>
			</Grid>
		</StackPanel>

		<Grid Grid.Row="1" ColumnDefinitions="*, 15, *" Margin="0,0,0,12">

			<Border Grid.Column="0" Background="#05FFFFFF" CornerRadius="8" Padding="8,4">
				<Grid ColumnDefinitions="Auto, 8, *, 5, 40">
					<CheckBox Grid.Column="0" IsChecked="{Binding ConnectViaProxy}" Margin="0">
						<TextBlock Text="INBOUND" FontSize="9" FontWeight="Black" Opacity="0.6"/>
					</CheckBox>

					<TextBox Grid.Column="2" Classes="proxyInput"
							 Text="{Binding ProxyInHost}" Watermark="Host"
							 IsVisible="{Binding ConnectViaProxy}"/>

					<TextBox Grid.Column="4" Classes="proxyInput"
							 Text="{Binding ProxyInPort}" Watermark="Port"
							 Padding="0" MinWidth="0" HorizontalContentAlignment="Center"
							 IsVisible="{Binding ConnectViaProxy}"/>
				</Grid>
			</Border>

			<Border Grid.Column="2" Background="#05FFFFFF" CornerRadius="8" Padding="8,4">
				<Grid ColumnDefinitions="Auto, 8, *, 5, 40, Auto">
					<CheckBox Grid.Column="0" IsChecked="{Binding EnableSocksTunnel}" Margin="0">
						<TextBlock Text="OUTBOUND" FontSize="9" FontWeight="Black" Foreground="#3498DB" Opacity="0.8"/>
					</CheckBox>

					<TextBox Grid.Column="2" Classes="proxyInput"
							 Text="{Binding TunnelHost}" Watermark="Listen"
							 IsVisible="{Binding EnableSocksTunnel}"/>

					<TextBox Grid.Column="4" Classes="proxyInput"
							 Text="{Binding TunnelPort}" Watermark="Port"
							 Padding="0" MinWidth="0" HorizontalContentAlignment="Center"
							 IsVisible="{Binding EnableSocksTunnel}"/>

					<TextBlock Grid.Column="5" Text="●" IsVisible="{Binding IsConnected}"
							   VerticalAlignment="Center" Margin="8,0,0,0" FontSize="10" Foreground="#3498DB"/>
				</Grid>
			</Border>
		</Grid>

		<Border Grid.Row="2" Classes="card output">
			<ScrollViewer Name="TermScroll">
				<SelectableTextBlock Name="TerminalOutputBlock"
									 Text="{Binding TerminalOutput}"
									 Padding="10"
									 FontFamily="Cascadia Code,Consolas"
									 FontSize="11"
									 Foreground="#00FF66"
									 TextWrapping="Wrap"/>
			</ScrollViewer>
		</Border>

		<Grid Grid.Row="3" ColumnDefinitions="Auto, *" Margin="0,10,0,0">
			<TextBlock Grid.Column="0" Text="TERMINAL >" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="9" FontWeight="Black" Opacity="0.3"/>
			<TextBox Grid.Column="1" Classes="field" Text="{Binding CommandInput}" Watermark="Enter shell command..." Height="34" FontSize="11">
				<TextBox.KeyBindings>
					<KeyBinding Gesture="Enter" Command="{Binding SendCommandCommand}"/>
				</TextBox.KeyBindings>
			</TextBox>
		</Grid>
	</Grid>
</UserControl>
