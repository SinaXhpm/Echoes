<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Echoes.ViewModels"
             xmlns:views="using:Echoes.Views"
             xmlns:chrome="using:Avalonia.Controls.Chrome"
             x:Class="Echoes.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="#1e1e1e">

	<Panel>
		<Grid RowDefinitions="Auto, *, Auto">

			<Border Grid.Row="0" Background="Transparent"
					chrome:WindowDecorationProperties.ElementRole="TitleBar">
				<StackPanel Orientation="Horizontal" Margin="15,12,15,5" Spacing="8">
					<Border Width="80" IsVisible="{Binding IsMac}"/>
					<TextBlock Text="Echoes"
							   FontSize="20"
							   FontWeight="Black"
							   Foreground="White"
							   Opacity="0.9"
							   LetterSpacing="-0.5"/>
				</StackPanel>
			</Border>

			<TabControl Grid.Row="1" Margin="8,0,8,4" TabStripPlacement="Left">
				<TabControl.Styles>
					<Style Selector="TabItem">
						<Setter Property="FontSize" Value="11.5"/>
						<Setter Property="FontWeight" Value="SemiBold"/>
						<Setter Property="Foreground" Value="#80FFFFFF"/>
						<Setter Property="Margin" Value="0,1"/>
						<Setter Property="Padding" Value="14,0"/>
						<Setter Property="Height" Value="32"/>
						<Setter Property="MinHeight" Value="32"/>
						<Setter Property="Width" Value="120"/>
						<Setter Property="CornerRadius" Value="6"/>
						<Setter Property="HorizontalContentAlignment" Value="Left"/>
						<Setter Property="VerticalContentAlignment" Value="Center"/>
					</Style>

					<!-- Paint our own background on the template root so the theme's
					     default hover/selected brushes don't override it. -->
					<Style Selector="TabItem /template/ Border#PART_LayoutRoot">
						<Setter Property="Background" Value="Transparent"/>
						<Setter Property="CornerRadius" Value="6"/>
						<Setter Property="Transitions">
							<Transitions>
								<BrushTransition Property="Background" Duration="0:0:0.12"/>
							</Transitions>
						</Setter>
					</Style>

					<!-- Hover (non-selected): clear, brighter fill + brighter text -->
					<Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
						<Setter Property="Background" Value="#1FFFFFFF"/>
					</Style>
					<Style Selector="TabItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
						<Setter Property="Foreground" Value="#E6FFFFFF"/>
					</Style>

					<!-- Selected: green tint + white text -->
					<Style Selector="TabItem:selected /template/ Border#PART_LayoutRoot">
						<Setter Property="Background" Value="#2142B883"/>
					</Style>
					<Style Selector="TabItem:selected /template/ ContentPresenter#PART_ContentPresenter">
						<Setter Property="Foreground" Value="White"/>
					</Style>

					<!-- Selected + hover: brighter green so it stays distinguishable -->
					<Style Selector="TabItem:selected:pointerover /template/ Border#PART_LayoutRoot">
						<Setter Property="Background" Value="#3342B883"/>
					</Style>

					<Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
						<Setter Property="IsVisible" Value="False"/>
					</Style>
				</TabControl.Styles>

				<TabItem Header="PING"><views:PingView DataContext="{Binding PingVM}"/></TabItem>
				<TabItem Header="DNS"><views:DnsView DataContext="{Binding DnsVM}"/></TabItem>
				<TabItem Header="SCANNER"><views:PortScannerView DataContext="{Binding PortScannerVM}"/></TabItem>
				<TabItem Header="IP INFO"><views:IpInfoView DataContext="{Binding IpInfoVM}"/></TabItem>
				<TabItem Header="NIC"><views:NetworkInfoView DataContext="{Binding NetworkVM}"/></TabItem>
				<TabItem Header="CURL"><views:CurlView DataContext="{Binding CurlVM}"/></TabItem>
				<TabItem Header="TELEGRAM BOT">
					<views:TgView>
						<views:TgView.DataContext>
							<vm:TgViewModel/>
						</views:TgView.DataContext>
					</views:TgView>
				</TabItem>
				<TabItem Header="MONITOR"><views:MonitorView DataContext="{Binding MonitorVM}"/></TabItem>
				<TabItem Header="CLOUDFLARE"><views:CloudflareView DataContext="{Binding CloudflareVM}"/></TabItem>
				<TabItem Header="SSH"><views:SshView DataContext="{Binding SshVM}"/></TabItem>
				<TabItem Header="STRING LAB"><views:StringLabView DataContext="{Binding StringTool}"/></TabItem>
				<TabItem Header="NOTES"><views:NoteView DataContext="{Binding NoteVM}"/></TabItem>
			</TabControl>

			<Border Grid.Row="2" Height="24" Background="#10000000" BorderBrush="#10FFFFFF" BorderThickness="0,1,0,0">
				<Grid ColumnDefinitions="*, Auto, Auto">

					<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.3">
						<TextBlock FontSize="9">
							<Run Text="v"/>
							<Run Text="{Binding CurrentVersion}"/>
						</TextBlock>
					</StackPanel>

					<Button Grid.Column="1"
							Command="{Binding OpenGitHubCommand}"
							Background="Transparent"
							BorderThickness="0"
							Padding="12,0"
							Cursor="Hand"
							VerticalAlignment="Stretch">
						<Button.Styles>
							<Style Selector="Button:pointerover TextBlock">
								<Setter Property="Foreground" Value="#42B883"/>
								<Setter Property="Opacity" Value="1"/>
							</Style>
						</Button.Styles>
						<TextBlock Text="ABOUT"
								   FontSize="8"
								   FontWeight="Black"
								   Foreground="White"
								   Opacity="0.4"
								   VerticalAlignment="Center"/>
					</Button>

					<Button Grid.Column="2"
							Command="{Binding OpenReleasesCommand}"
							IsVisible="{Binding IsUpdateAvailable}"
							Background="Transparent"
							BorderThickness="0"
							Padding="10,0"
							Cursor="Hand"
							VerticalAlignment="Stretch"
							ToolTip.Tip="{Binding LatestVersion, StringFormat='Version {0} is available — click to download'}">
						<StackPanel Orientation="Horizontal" Spacing="6">
							<Ellipse Width="5" Height="5" Fill="#FF9D00" VerticalAlignment="Center"/>
							<TextBlock FontSize="8" FontWeight="Black" Foreground="#FF9D00" VerticalAlignment="Center">
								<Run Text="UPDATE TO v"/><Run Text="{Binding LatestVersion}"/>
							</TextBlock>
						</StackPanel>
					</Button>
				</Grid>
			</Border>
		</Grid>
	</Panel>
</UserControl>
