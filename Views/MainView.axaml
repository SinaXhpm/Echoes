<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Echoes.ViewModels"
             xmlns:views="using:Echoes.Views"
             xmlns:chrome="using:Avalonia.Controls.Chrome"
             x:Class="Echoes.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="#0F1012">

	<UserControl.Styles>
		<!-- The tab rail is a fixed vertical stack; once the window is shorter than the whole list
		     the last tabs were simply unreachable. Re-template the TabControl so the tab strip lives
		     in its own ScrollViewer (content host untouched) and the rail can scroll. -->
		<Style Selector="TabControl#MainTabs">
			<Setter Property="Template">
				<ControlTemplate>
					<Border Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="{TemplateBinding CornerRadius}">
						<DockPanel>
							<ScrollViewer DockPanel.Dock="{TemplateBinding TabStripPlacement}"
										  VerticalScrollBarVisibility="Auto"
										  HorizontalScrollBarVisibility="Disabled"
										  AllowAutoHide="True">
								<ItemsPresenter Name="PART_ItemsPresenter"
												ItemsPanel="{TemplateBinding ItemsPanel}"/>
							</ScrollViewer>
							<ContentPresenter Name="PART_SelectedContentHost"
											  Margin="{TemplateBinding Padding}"
											  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
											  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
											  Content="{TemplateBinding SelectedContent}"
											  ContentTemplate="{TemplateBinding SelectedContentTemplate}"/>
						</DockPanel>
					</Border>
				</ControlTemplate>
			</Setter>
		</Style>
	</UserControl.Styles>

	<Panel>
		<Grid RowDefinitions="Auto, *, Auto">

			<Border Grid.Row="0" Background="Transparent"
					chrome:WindowDecorationProperties.ElementRole="TitleBar">
				<StackPanel Orientation="Horizontal" Margin="16,12,15,7" Spacing="8" VerticalAlignment="Center">
					<Border Width="80" IsVisible="{Binding IsMac}"/>
					<Border Width="9" Height="9" CornerRadius="2.5" Background="#42B883" VerticalAlignment="Center"/>
					<TextBlock Text="Echoes"
							   FontSize="15"
							   FontWeight="Bold"
							   Foreground="#E7E7EA"
							   LetterSpacing="-0.3"
							   VerticalAlignment="Center"/>
				</StackPanel>
			</Border>

			<TabControl Grid.Row="1" Margin="8,0,8,4" TabStripPlacement="Left"
						x:Name="MainTabs" SelectionChanged="OnTabSelectionChanged">
				<!-- Single vertical column — never wrap tabs into a second column -->
				<TabControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel/>
					</ItemsPanelTemplate>
				</TabControl.ItemsPanel>
				<TabControl.Styles>
					<Style Selector="TabItem.navtab">
						<Setter Property="FontSize" Value="11.5"/>
						<Setter Property="FontWeight" Value="Medium"/>
						<Setter Property="Foreground" Value="#9E9FA8"/>
						<Setter Property="Margin" Value="0,1"/>
						<!-- Sized to fit a 24px glyph plus the longest label ("TELEGRAM BOT"). -->
						<Setter Property="Padding" Value="10,0"/>
						<Setter Property="Height" Value="31"/>
						<Setter Property="MinHeight" Value="31"/>
						<Setter Property="Width" Value="150"/>
						<Setter Property="CornerRadius" Value="6"/>
						<Setter Property="HorizontalContentAlignment" Value="Left"/>
						<Setter Property="VerticalContentAlignment" Value="Center"/>
					</Style>

					<!-- Paint our own background on the template root so the theme's
					     default hover/selected brushes don't override it. -->
					<Style Selector="TabItem.navtab /template/ Border#PART_LayoutRoot">
						<Setter Property="Background" Value="Transparent"/>
						<Setter Property="CornerRadius" Value="6"/>
						<Setter Property="Transitions">
							<Transitions>
								<BrushTransition Property="Background" Duration="0:0:0.12"/>
							</Transitions>
						</Setter>
					</Style>

					<!-- Hover (non-selected): subtle neutral fill + brighter text -->
					<Style Selector="TabItem.navtab:pointerover /template/ Border#PART_LayoutRoot">
						<Setter Property="Background" Value="#12FFFFFF"/>
					</Style>
					<Style Selector="TabItem.navtab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
						<Setter Property="Foreground" Value="#D7D8DE"/>
					</Style>

					<!-- Selected: neutral surface + accent-green text (Linear-style) -->
					<Style Selector="TabItem.navtab:selected /template/ Border#PART_LayoutRoot">
						<Setter Property="Background" Value="#2A2B33"/>
					</Style>
					<Style Selector="TabItem.navtab:selected /template/ ContentPresenter#PART_ContentPresenter">
						<Setter Property="Foreground" Value="#55C795"/>
					</Style>

					<Style Selector="TabItem.navtab:selected:pointerover /template/ Border#PART_LayoutRoot">
						<Setter Property="Background" Value="#32333C"/>
					</Style>

					<Style Selector="TabItem.navtab:selected /template/ Border#PART_SelectedPipe">
						<Setter Property="IsVisible" Value="False"/>
					</Style>

					<!-- Glyphs track the tab state via Stroke: the ContentPresenter Foreground rules
					     above only reach the label, since a Path does not inherit Foreground. -->
					<Style Selector="TabItem.navtab:pointerover Path.ico">
						<Setter Property="Stroke" Value="#D7D8DE"/>
					</Style>
					<Style Selector="TabItem.navtab:selected Path.ico">
						<Setter Property="Stroke" Value="#55C795"/>
					</Style>
				</TabControl.Styles>

				<!-- Ordered by importance -->
				<TabItem Classes="navtab" Tag="PING" AutomationProperties.Name="PING">
					<TabItem.Header>
						<StackPanel Orientation="Horizontal" Spacing="9">
							<Path Classes="ico" Data="{StaticResource IcoPing}"/>
							<TextBlock Text="PING" VerticalAlignment="Center"/>
						</StackPanel>
					</TabItem.Header><views:PingView DataContext="{Binding PingVM}"/></TabItem>
				<TabItem Classes="navtab" Tag="DNS" AutomationProperties.Name="DNS">
					<TabItem.Header>
						<StackPanel Orientation="Horizontal" Spacing="9">
							<Path Classes="ico" Data="{StaticResource IcoDns}"/>
							<TextBlock Text="DNS" VerticalAlignment="Center"/>
						</StackPanel>
					</TabItem.Header><views:DnsView DataContext="{Binding DnsVM}"/></TabItem>
				<TabItem Classes="navtab" Tag="CURL" AutomationProperties.Name="CURL">
					<TabItem.Header>
						<StackPanel Orientation="Horizontal" Spacing="9">
							<Path Classes="ico" Data="{StaticResource IcoCurl}"/>
							<TextBlock Text="CURL" VerticalAlignment="Center"/>
						</StackPanel>
					</TabItem.Header><views:CurlView DataContext="{Binding CurlVM}"/></TabItem>
				<TabItem Classes="navtab" Tag="IP INFO" AutomationProperties.Name="IP INFO">
					<TabItem.Header>
						<StackPanel Orientation="Horizontal" Spacing="9">
							<Path Classes="ico" Data="{StaticResource IcoIpInfo}"/>
							<TextBlock Text="IP INFO" VerticalAlignment="Center"/>
						</StackPanel>
					</TabItem.Header><views:IpInfoView DataContext="{Binding IpInfoVM}"/></TabItem>
				<TabItem Classes="navtab" Tag="CHECK-HOST" AutomationProperties.Name="CHECK-HOST">
					<TabItem.Header>
						<StackPanel Orientation="Horizontal" Spacing="9">
							<Path Classes="ico" Data="{StaticResource IcoCheckHost}"/>
							<TextBlock Text="CHECK-HOST" VerticalAlignment="Center"/>
						</StackPanel>
					</TabItem.Header><views:CheckHostView DataContext="{Binding CheckHostVM}"/></TabItem>
				<TabItem Classes="navtab" Tag="CLOUDFLARE" AutomationProperties.Name="CLOUDFLARE">
					<TabItem.Header>
						<StackPanel Orientation="Horizontal" Spacing="9">
							<Path Classes="ico" Data="{StaticResource IcoCloudflare}"/>
							<TextBlock Text="CLOUDFLARE" VerticalAlignment="Center"/>
						</StackPanel>
					</TabItem.Header><views:CloudflareView DataContext="{Binding CloudflareVM}"/></TabItem>
				<TabItem Classes="navtab" Tag="SCANNER" AutomationProperties.Name="SCANNER">
					<TabItem.Header>
						<StackPanel Orientation="Horizontal" Spacing="9">
							<Path Classes="ico" Data="{StaticResource IcoScanner}"/>
							<TextBlock Text="SCANNER" VerticalAlignment="Center"/>
						</StackPanel>
					</TabItem.Header><views:PortScannerView DataContext="{Binding PortScannerVM}"/></TabItem>
				<TabItem Classes="navtab" Tag="WEB SERVER" AutomationProperties.Name="WEB SERVER">
					<TabItem.Header>
						<StackPanel Orientation="Horizontal" Spacing="9">
							<Path Classes="ico" Data="{StaticResource IcoWebServer}"/>
							<TextBlock Text="WEB SERVER" VerticalAlignment="Center"/>
						</StackPanel>
					</TabItem.Header><views:WebServerView DataContext="{Binding WebServerVM}"/></TabItem>
				<TabItem Classes="navtab" Tag="PROXY" AutomationProperties.Name="PROXY">
					<TabItem.Header>
						<StackPanel Orientation="Horizontal" Spacing="9">
							<Path Classes="ico" Data="{StaticResource IcoProxy}"/>
							<TextBlock Text="PROXY" VerticalAlignment="Center"/>
						</StackPanel>
					</TabItem.Header><views:ProxyView DataContext="{Binding ProxyVM}"/></TabItem>
				<TabItem Classes="navtab" Tag="NETWORK" AutomationProperties.Name="NETWORK">
					<TabItem.Header>
						<StackPanel Orientation="Horizontal" Spacing="9">
							<Path Classes="ico" Data="{StaticResource IcoNetwork}"/>
							<TextBlock Text="NETWORK" VerticalAlignment="Center"/>
						</StackPanel>
					</TabItem.Header><views:NetworkInfoView DataContext="{Binding NetworkVM}"/></TabItem>
				<TabItem Classes="navtab" Tag="MONITOR" AutomationProperties.Name="MONITOR">
					<TabItem.Header>
						<StackPanel Orientation="Horizontal" Spacing="9">
							<Path Classes="ico" Data="{StaticResource IcoMonitor}"/>
							<TextBlock Text="MONITOR" VerticalAlignment="Center"/>
						</StackPanel>
					</TabItem.Header><views:MonitorView DataContext="{Binding MonitorVM}"/></TabItem>
				<TabItem Classes="navtab" Tag="SSH" AutomationProperties.Name="SSH">
					<TabItem.Header>
						<StackPanel Orientation="Horizontal" Spacing="9">
							<Path Classes="ico" Data="{StaticResource IcoSsh}"/>
							<TextBlock Text="SSH" VerticalAlignment="Center"/>
						</StackPanel>
					</TabItem.Header><views:SshView DataContext="{Binding SshVM}"/></TabItem>
				<TabItem Classes="navtab" Tag="TELEGRAM BOT" AutomationProperties.Name="TELEGRAM BOT">
					<TabItem.Header>
						<StackPanel Orientation="Horizontal" Spacing="9">
							<Path Classes="ico" Data="{StaticResource IcoTelegram}"/>
							<TextBlock Text="TELEGRAM BOT" VerticalAlignment="Center"/>
						</StackPanel>
					</TabItem.Header>
					<views:TgView>
						<views:TgView.DataContext>
							<vm:TgViewModel/>
						</views:TgView.DataContext>
					</views:TgView>
				</TabItem>
				<TabItem Classes="navtab" Tag="STRING LAB" AutomationProperties.Name="STRING LAB">
					<TabItem.Header>
						<StackPanel Orientation="Horizontal" Spacing="9">
							<Path Classes="ico" Data="{StaticResource IcoStringLab}"/>
							<TextBlock Text="STRING LAB" VerticalAlignment="Center"/>
						</StackPanel>
					</TabItem.Header><views:StringLabView DataContext="{Binding StringTool}"/></TabItem>
				<TabItem Classes="navtab" Tag="NOTES" AutomationProperties.Name="NOTES">
					<TabItem.Header>
						<StackPanel Orientation="Horizontal" Spacing="9">
							<Path Classes="ico" Data="{StaticResource IcoNotes}"/>
							<TextBlock Text="NOTES" VerticalAlignment="Center"/>
						</StackPanel>
					</TabItem.Header><views:NoteView DataContext="{Binding NoteVM}"/></TabItem>
				<TabItem Classes="navtab" Tag="BACKUP" AutomationProperties.Name="BACKUP">
					<TabItem.Header>
						<StackPanel Orientation="Horizontal" Spacing="9">
							<Path Classes="ico" Data="{StaticResource IcoBackup}"/>
							<TextBlock Text="BACKUP" VerticalAlignment="Center"/>
						</StackPanel>
					</TabItem.Header><views:BackupView DataContext="{Binding BackupVM}"/></TabItem>
				<TabItem Classes="navtab" Tag="HISTORY" AutomationProperties.Name="HISTORY">
					<TabItem.Header>
						<StackPanel Orientation="Horizontal" Spacing="9">
							<Path Classes="ico" Data="{StaticResource IcoHistory}"/>
							<TextBlock Text="HISTORY" VerticalAlignment="Center"/>
						</StackPanel>
					</TabItem.Header><views:HistoryView DataContext="{Binding HistoryVM}"/></TabItem>
			</TabControl>

			<Border Grid.Row="2" Height="22" Background="#0C0D0F" BorderBrush="#1C1D22" BorderThickness="0,1,0,0">
				<Grid ColumnDefinitions="*, Auto, Auto">

					<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.3">
						<TextBlock FontSize="9">
							<Run Text="v"/>
							<Run Text="{Binding CurrentVersion}"/>
						</TextBlock>
					</StackPanel>

					<Button Grid.Column="1"
							Command="{Binding OpenGitHubCommand}"
							Background="Transparent"
							BorderThickness="0"
							Padding="12,0"
							Cursor="Hand"
							VerticalAlignment="Stretch">
						<Button.Styles>
							<Style Selector="Button:pointerover TextBlock">
								<Setter Property="Foreground" Value="#42B883"/>
								<Setter Property="Opacity" Value="1"/>
							</Style>
						</Button.Styles>
						<TextBlock Text="ABOUT"
								   FontSize="8"
								   FontWeight="Black"
								   Foreground="White"
								   Opacity="0.4"
								   VerticalAlignment="Center"/>
					</Button>

					<Button Grid.Column="2"
							Command="{Binding OpenReleasesCommand}"
							IsVisible="{Binding IsUpdateAvailable}"
							Background="Transparent"
							BorderThickness="0"
							Padding="10,0"
							Cursor="Hand"
							VerticalAlignment="Stretch"
							ToolTip.Tip="{Binding LatestVersion, StringFormat='Version {0} is available — click to download'}">
						<StackPanel Orientation="Horizontal" Spacing="6">
							<Ellipse Width="5" Height="5" Fill="#FF9D00" VerticalAlignment="Center"/>
							<TextBlock FontSize="8" FontWeight="Black" Foreground="#FF9D00" VerticalAlignment="Center">
								<Run Text="UPDATE TO v"/><Run Text="{Binding LatestVersion}"/>
							</TextBlock>
						</StackPanel>
					</Button>
				</Grid>
			</Border>
		</Grid>
	</Panel>
</UserControl>
