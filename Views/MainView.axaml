<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Echoes.ViewModels"
             xmlns:views="using:Echoes.Views"
             xmlns:ctl="using:Echoes.Views.Controls"
             xmlns:helpers="using:Echoes.Helpers"
             xmlns:chrome="using:Avalonia.Controls.Chrome"
             x:Class="Echoes.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource Bg.App}" FontSize="12.5">

	<UserControl.Styles>
		<!-- ===== Shell layout: [sidebar | page]. The TabControl IS the shell: its strip is the sidebar
		     nav, its content host the page (each tab's content is a lazily-filled tool host, see
		     ToolViews in MainView.axaml.cs). The sidebar always shows its labels (the user wants the menu
		     open at every size); it's kept narrow and dense instead, so the window can stay small: it opens
		     860 wide and exactly as tall as this list (MainWindow). ===== -->
		<Style Selector="TabControl#MainTabs">
			<Setter Property="Padding" Value="18,2,18,12"/>
			<Setter Property="Template">
				<ControlTemplate>
					<Grid ColumnDefinitions="Auto,*" x:DataType="vm:MainViewModel">
						<!-- SIDEBAR -->
						<Border Name="PART_Sidebar" Grid.Column="0" Width="172"
								Background="{DynamicResource Bg.Sidebar}"
								BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,1,0">
							<Grid RowDefinitions="Auto,Auto,*,Auto">
								<!-- Window drag areas (TitleBar role): they need a background to be hit-testable at all, else a
								     press falls through to the content and the window can't be moved. Solid, the colour already
								     under them; their texts are not hit-testable, so a press anywhere on them drags. -->
								<!-- macOS draws the traffic lights over the top-left corner -->
								<Border Grid.Row="0" Height="22" IsVisible="{Binding IsMac}" Background="{DynamicResource Bg.Sidebar}"
										chrome:WindowDecorationProperties.ElementRole="TitleBar"/>
								<!-- brand row: the name (a drag area) and, beside it, About + the light / dark switch — up here
								     rather than in a footer, so the list can breathe without making the window taller. The
								     buttons are siblings of the TitleBar-role border, not children, so they stay clickable. -->
								<Grid Grid.Row="1" ColumnDefinitions="*,Auto" Background="{DynamicResource Bg.Sidebar}">
									<Border Name="PART_Brand" Padding="13,9,4,9" Background="{DynamicResource Bg.Sidebar}"
											chrome:WindowDecorationProperties.ElementRole="TitleBar">
										<StackPanel Orientation="Horizontal" Spacing="9" IsHitTestVisible="False">
											<Image Source="avares://Echoes/Assets/logo-256.png" Width="20" Height="20"
												   RenderOptions.BitmapInterpolationMode="HighQuality"/>
											<TextBlock Text="Echoes" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
													   Foreground="{DynamicResource Text.Primary}"/>
										</StackPanel>
									</Border>
									<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="0,0,8,0" VerticalAlignment="Center">
										<Button Name="PART_About" Classes="sideLink headBtn" Command="{Binding OpenAboutCommand}"
												ToolTip.Tip="{Binding CurrentVersion, StringFormat='About Echoes v{0}, updates'}"
												AutomationProperties.Name="About Echoes">
											<Path Classes="ico" Data="{StaticResource IcoAbout}"/>
										</Button>
										<!-- light / dark: the icon (a sun in the dark theme, a moon in the light one) and the tip are
										     per-theme resources (Styles/Tokens.axaml), so the switch needs no state of its own -->
										<Button Name="PART_ThemeToggle" Classes="sideLink headBtn"
												Command="{Binding ToggleThemeCommand}" ToolTip.Tip="{DynamicResource Theme.ToggleTip}"
												AutomationProperties.Name="Switch between the light and dark theme">
											<Path Classes="ico" Data="{DynamicResource IcoThemeToggle}"/>
										</Button>
									</StackPanel>
								</Grid>
								<!-- nav -->
								<ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
											  HorizontalScrollBarVisibility="Disabled" AllowAutoHide="True">
									<ItemsPresenter Name="PART_ItemsPresenter" Margin="8,0,8,6"
													ItemsPanel="{TemplateBinding ItemsPanel}"/>
								</ScrollViewer>
								<!-- footer: only the update pill, when there is one -->
								<StackPanel Grid.Row="3" Name="PART_SideFooter" Margin="8,0,8,8" IsVisible="{Binding IsUpdateAvailable}">
									<Button Classes="updatePill" Command="{Binding OpenReleasesCommand}"
											ToolTip.Tip="{Binding LatestVersion, StringFormat='Version {0} is available — click to download'}">
										<StackPanel Orientation="Horizontal" Spacing="8">
											<Ellipse Width="7" Height="7" Fill="{DynamicResource Accent}" VerticalAlignment="Center"/>
											<TextBlock Classes="sideLabel" Text="{Binding LatestVersion, StringFormat='Update to v{0}'}"
													   VerticalAlignment="Center"/>
										</StackPanel>
									</Button>
								</StackPanel>
							</Grid>
						</Border>

						<!-- PAGE: fills the height but asks for none, so the window opens fitted to the nav (MainWindow) -->
						<ctl:HeightNeutral Grid.Column="1">
							<Grid RowDefinitions="Auto,*" Background="{DynamicResource Bg.App}">
								<Border Grid.Row="0" Name="PART_PageHeader" Padding="18,10,18,7" Background="{DynamicResource Bg.App}"
										chrome:WindowDecorationProperties.ElementRole="TitleBar">
									<StackPanel Spacing="2" IsHitTestVisible="False">
										<TextBlock Classes="pageTitle" Text="{Binding $parent[views:MainView].PageTitle}"/>
										<TextBlock Classes="pageSubtitle" Text="{Binding $parent[views:MainView].PageSubtitle}"/>
									</StackPanel>
								</Border>
								<ContentPresenter Grid.Row="1" Name="PART_SelectedContentHost"
												  Margin="{TemplateBinding Padding}"
												  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
												  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
												  Content="{TemplateBinding SelectedContent}"
												  ContentTemplate="{TemplateBinding SelectedContentTemplate}"/>
							</Grid>
						</ctl:HeightNeutral>
					</Grid>
				</ControlTemplate>
			</Setter>
		</Style>

		<!-- ===== Sidebar nav item: [section label] + a pill with an accent indicator ===== -->
		<Style Selector="TabItem.navtab">
			<Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
			<Setter Property="FontSize" Value="12.5"/>
			<Setter Property="FontWeight" Value="Medium"/>
			<Setter Property="Margin" Value="0"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="MinHeight" Value="0"/>
			<Setter Property="Template">
				<ControlTemplate TargetType="ctl:NavTabItem">
					<StackPanel>
						<TextBlock Name="PART_GroupLabel" Classes="navgroup" Text="{TemplateBinding Group}"
								   IsHitTestVisible="False"
								   IsVisible="{TemplateBinding Group, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
						<Border Name="PART_Pill" Height="24" CornerRadius="6" Padding="9,0"
								Background="{DynamicResource Bg.Sidebar}">
							<Panel>
								<Border Name="PART_Indicator" Width="3" Height="14" CornerRadius="2" Margin="-9,0,0,0"
										HorizontalAlignment="Left" VerticalAlignment="Center"
										Background="{DynamicResource Accent}" IsVisible="False"/>
								<ContentPresenter Name="PART_ContentPresenter" VerticalAlignment="Center"
												  Content="{TemplateBinding Header}"
												  ContentTemplate="{TemplateBinding HeaderTemplate}"
												  Foreground="{TemplateBinding Foreground}"/>
							</Panel>
						</Border>
					</StackPanel>
				</ControlTemplate>
			</Setter>
		</Style>
		<Style Selector="TabItem.navtab:pointerover /template/ Border#PART_Pill">
			<Setter Property="Background" Value="{DynamicResource Bg.Hover}"/>
		</Style>
		<Style Selector="TabItem.navtab:pointerover">
			<Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
		</Style>
		<Style Selector="TabItem.navtab:selected /template/ Border#PART_Pill">
			<Setter Property="Background" Value="{DynamicResource Bg.Selected}"/>
		</Style>
		<Style Selector="TabItem.navtab:selected:pointerover /template/ Border#PART_Pill">
			<Setter Property="Background" Value="{DynamicResource Bg.SelectedHover}"/>
		</Style>
		<Style Selector="TabItem.navtab:selected /template/ Border#PART_Indicator">
			<Setter Property="IsVisible" Value="True"/>
		</Style>
		<Style Selector="TabItem.navtab:selected">
			<Setter Property="Foreground" Value="{DynamicResource Accent.Text}"/>
		</Style>
		<!-- A Path doesn't inherit Foreground: glyphs follow the state through Stroke. Child selectors on
		     purpose: the header panel is the item's direct child, while the open tool (also a logical
		     descendant of the item) must keep its own icon colours. -->
		<Style Selector="TabItem.navtab > StackPanel > Path.ico">
			<Setter Property="Stroke" Value="{DynamicResource Text.Muted}"/>
		</Style>
		<!-- Sidebar glyphs at 18px: the shared 24-unit icons drawn three quarters size (a thicker stroke keeps the
		     line weight the same), with the -3 margins shrinking their layout box to match. Smaller glyphs are most of
		     what makes the list read as separate rows instead of a packed column. -->
		<Style Selector="TabItem.navtab > StackPanel > Path.ico, Button.headBtn > Path.ico">
			<Setter Property="RenderTransform" Value="scale(0.75)"/>
			<Setter Property="Margin" Value="-3"/>
			<Setter Property="StrokeThickness" Value="2"/>
		</Style>
		<Style Selector="TabItem.navtab:pointerover > StackPanel > Path.ico">
			<Setter Property="Stroke" Value="{DynamicResource Text.Primary}"/>
		</Style>
		<Style Selector="TabItem.navtab:selected > StackPanel > Path.ico">
			<Setter Property="Stroke" Value="{DynamicResource Accent.Text}"/>
		</Style>
		<Style Selector="TabItem.navtab:focus-visible /template/ Border#PART_Pill">
			<Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
			<Setter Property="BorderThickness" Value="1"/>
		</Style>
		<!-- the brand row's About / theme buttons: small square icon buttons (the shared .sideLink is a wide row;
		     its class style outranks template values, so this one needs a class in its selector too) -->
		<Style Selector="Button.sideLink.headBtn">
			<Setter Property="Padding" Value="5"/>
			<Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}"/>
			<Setter Property="HorizontalAlignment" Value="Left"/>
		</Style>
		<!-- section labels: a clear gap above each group, a small one before its first item -->
		<Style Selector="TabItem.navtab /template/ TextBlock#PART_GroupLabel">
			<Setter Property="Margin" Value="10,7,0,4"/>
		</Style>
		<Style Selector="TabItem.navtab:nth-child(1) /template/ TextBlock#PART_GroupLabel">
			<Setter Property="Margin" Value="10,2,0,4"/>
		</Style>
	</UserControl.Styles>

	<Panel>
	<TabControl x:Name="MainTabs" TabStripPlacement="Left"
				SelectionChanged="OnTabSelectionChanged">
		<TabControl.ItemsPanel>
			<ItemsPanelTemplate>
				<!-- a hairline of space between rows, so hover / selection pills never touch -->
				<StackPanel Spacing="2"/>
			</ItemsPanelTemplate>
		</TabControl.ItemsPanel>

		<!-- Grouped by what you're doing. Each tab's content is an empty host that gets its tool view
		     (and view-model) on first visit — see ToolViews in MainView.axaml.cs — and keeps it, so a
		     tool's state survives switching tabs. Tag = the tool id (code-behind keys on it). -->

		<!-- DIAGNOSE -->
		<ctl:NavTabItem Classes="navtab" Tag="PING" Group="Diagnose" Title="Ping"
						Subtitle="Live stats, TCP ping, traceroute and MTR"
						AutomationProperties.Name="Ping">
			<ctl:NavTabItem.Header>
				<StackPanel Orientation="Horizontal" Spacing="10">
					<Path Classes="ico" Data="{StaticResource IcoPing}"/>
					<TextBlock Classes="navlabel" Text="Ping"/>
				</StackPanel>
			</ctl:NavTabItem.Header><Decorator/></ctl:NavTabItem>
		<ctl:NavTabItem Classes="navtab" Tag="DOCTOR" Title="Doctor"
						Subtitle="Why a site won't open for you"
						AutomationProperties.Name="Doctor">
			<ctl:NavTabItem.Header>
				<StackPanel Orientation="Horizontal" Spacing="10">
					<Path Classes="ico" Data="{StaticResource IcoDoctor}"/>
					<TextBlock Classes="navlabel" Text="Doctor"/>
				</StackPanel>
			</ctl:NavTabItem.Header><Decorator/></ctl:NavTabItem>
		<ctl:NavTabItem Classes="navtab" Tag="DNS" Title="DNS &amp; WHOIS"
						Subtitle="DoH / DoT lookups, mail check, WHOIS"
						AutomationProperties.Name="DNS">
			<ctl:NavTabItem.Header>
				<StackPanel Orientation="Horizontal" Spacing="10">
					<Path Classes="ico" Data="{StaticResource IcoDns}"/>
					<TextBlock Classes="navlabel" Text="DNS"/>
				</StackPanel>
			</ctl:NavTabItem.Header><Decorator/></ctl:NavTabItem>
		<ctl:NavTabItem Classes="navtab" Tag="SCANNER" Title="Port Scanner"
						Subtitle="TCP / UDP scan, service detection"
						AutomationProperties.Name="Port Scanner">
			<ctl:NavTabItem.Header>
				<StackPanel Orientation="Horizontal" Spacing="10">
					<Path Classes="ico" Data="{StaticResource IcoScanner}"/>
					<TextBlock Classes="navlabel" Text="Scanner"/>
				</StackPanel>
			</ctl:NavTabItem.Header><Decorator/></ctl:NavTabItem>
		<ctl:NavTabItem Classes="navtab" Tag="CHECK-HOST" Title="Check Host"
						Subtitle="Checks from nodes around the world"
						AutomationProperties.Name="Check Host">
			<ctl:NavTabItem.Header>
				<StackPanel Orientation="Horizontal" Spacing="10">
					<Path Classes="ico" Data="{StaticResource IcoCheckHost}"/>
					<TextBlock Classes="navlabel" Text="Check Host"/>
				</StackPanel>
			</ctl:NavTabItem.Header><Decorator/></ctl:NavTabItem>
		<ctl:NavTabItem Classes="navtab" Tag="MONITOR" Title="Monitor"
						Subtitle="Uptime, expiry checks, Telegram alerts"
						AutomationProperties.Name="Monitor">
			<ctl:NavTabItem.Header>
				<StackPanel Orientation="Horizontal" Spacing="10">
					<Path Classes="ico" Data="{StaticResource IcoMonitor}"/>
					<TextBlock Classes="navlabel" Text="Monitor"/>
				</StackPanel>
			</ctl:NavTabItem.Header><Decorator/></ctl:NavTabItem>
		<ctl:NavTabItem Classes="navtab" Tag="NETWORK" Title="Network"
						Subtitle="Interfaces, Wi-Fi, ports and routes"
						AutomationProperties.Name="Network">
			<ctl:NavTabItem.Header>
				<StackPanel Orientation="Horizontal" Spacing="10">
					<Path Classes="ico" Data="{StaticResource IcoNetwork}"/>
					<TextBlock Classes="navlabel" Text="Network"/>
				</StackPanel>
			</ctl:NavTabItem.Header><Decorator/></ctl:NavTabItem>
		<ctl:NavTabItem Classes="navtab" Tag="SPEED TEST" Title="Speed Test"
						Subtitle="Internet speed and latency"
						AutomationProperties.Name="Speed Test">
			<ctl:NavTabItem.Header>
				<StackPanel Orientation="Horizontal" Spacing="10">
					<Path Classes="ico" Data="{StaticResource IcoSpeed}"/>
					<TextBlock Classes="navlabel" Text="Speed Test"/>
				</StackPanel>
			</ctl:NavTabItem.Header><Decorator/></ctl:NavTabItem>

		<!-- WEB & API -->
		<ctl:NavTabItem Classes="navtab" Tag="CURL" Group="Web &amp; API" Title="cURL"
						Subtitle="HTTP requests, responses and TLS"
						AutomationProperties.Name="cURL">
			<ctl:NavTabItem.Header>
				<StackPanel Orientation="Horizontal" Spacing="10">
					<Path Classes="ico" Data="{StaticResource IcoCurl}"/>
					<TextBlock Classes="navlabel" Text="cURL"/>
				</StackPanel>
			</ctl:NavTabItem.Header><Decorator/></ctl:NavTabItem>
		<ctl:NavTabItem Classes="navtab" Tag="TLS" Title="TLS Inspector"
						Subtitle="Certificates, expiry, versions, ciphers"
						AutomationProperties.Name="TLS Inspector">
			<ctl:NavTabItem.Header>
				<StackPanel Orientation="Horizontal" Spacing="10">
					<Path Classes="ico" Data="{StaticResource IcoTls}"/>
					<TextBlock Classes="navlabel" Text="TLS Inspector"/>
				</StackPanel>
			</ctl:NavTabItem.Header><Decorator/></ctl:NavTabItem>
		<ctl:NavTabItem Classes="navtab" Tag="IP INFO" Title="IP Info"
						Subtitle="Public IP and GeoIP lookups"
						AutomationProperties.Name="IP Info">
			<ctl:NavTabItem.Header>
				<StackPanel Orientation="Horizontal" Spacing="10">
					<Path Classes="ico" Data="{StaticResource IcoIpInfo}"/>
					<TextBlock Classes="navlabel" Text="IP Info"/>
				</StackPanel>
			</ctl:NavTabItem.Header><Decorator/></ctl:NavTabItem>
		<ctl:NavTabItem Classes="navtab" Tag="CLOUDFLARE" Title="Cloudflare"
						Subtitle="DNS, DDNS, SSL/TLS, security, rules"
						AutomationProperties.Name="Cloudflare">
			<ctl:NavTabItem.Header>
				<StackPanel Orientation="Horizontal" Spacing="10">
					<Path Classes="ico" Data="{StaticResource IcoCloudflare}"/>
					<TextBlock Classes="navlabel" Text="Cloudflare"/>
				</StackPanel>
			</ctl:NavTabItem.Header><Decorator/></ctl:NavTabItem>
		<ctl:NavTabItem Classes="navtab" Tag="TELEGRAM BOT" Title="Telegram Bot"
						Subtitle="Bot API calls, uploads, updates"
						AutomationProperties.Name="Telegram Bot">
			<ctl:NavTabItem.Header>
				<StackPanel Orientation="Horizontal" Spacing="10">
					<Path Classes="ico" Data="{StaticResource IcoTelegram}"/>
					<TextBlock Classes="navlabel" Text="Telegram Bot"/>
				</StackPanel>
			</ctl:NavTabItem.Header><Decorator/></ctl:NavTabItem>

		<!-- SERVE & CONNECT -->
		<ctl:NavTabItem Classes="navtab" Tag="SSH" Group="Serve &amp; Connect" Title="SSH"
						Subtitle="Terminal, files, forwards, health"
						AutomationProperties.Name="SSH">
			<ctl:NavTabItem.Header>
				<StackPanel Orientation="Horizontal" Spacing="10">
					<Path Classes="ico" Data="{StaticResource IcoSsh}"/>
					<TextBlock Classes="navlabel" Text="SSH"/>
				</StackPanel>
			</ctl:NavTabItem.Header><Decorator/></ctl:NavTabItem>
		<ctl:NavTabItem Classes="navtab" Tag="SOCKET" Title="Socket"
						Subtitle="TCP / UDP client and server, WebSocket"
						AutomationProperties.Name="Socket">
			<ctl:NavTabItem.Header>
				<StackPanel Orientation="Horizontal" Spacing="10">
					<Path Classes="ico" Data="{StaticResource IcoSocket}"/>
					<TextBlock Classes="navlabel" Text="Socket"/>
				</StackPanel>
			</ctl:NavTabItem.Header><Decorator/></ctl:NavTabItem>
		<ctl:NavTabItem Classes="navtab" Tag="WEB SERVER" Title="Web Server"
						Subtitle="Share files or catch webhooks"
						AutomationProperties.Name="Web Server">
			<ctl:NavTabItem.Header>
				<StackPanel Orientation="Horizontal" Spacing="10">
					<Path Classes="ico" Data="{StaticResource IcoWebServer}"/>
					<TextBlock Classes="navlabel" Text="Web Server"/>
				</StackPanel>
			</ctl:NavTabItem.Header><Decorator/></ctl:NavTabItem>
		<ctl:NavTabItem Classes="navtab" Tag="PROXY" Title="Proxy"
						Subtitle="SOCKS5 / HTTP server and checker"
						AutomationProperties.Name="Proxy">
			<ctl:NavTabItem.Header>
				<StackPanel Orientation="Horizontal" Spacing="10">
					<Path Classes="ico" Data="{StaticResource IcoProxy}"/>
					<TextBlock Classes="navlabel" Text="Proxy"/>
				</StackPanel>
			</ctl:NavTabItem.Header><Decorator/></ctl:NavTabItem>

		<!-- WORKSPACE -->
		<ctl:NavTabItem Classes="navtab" Tag="STRING LAB" Group="Workspace" Title="String Lab"
						Subtitle="Encode, hash, convert, diff, generate"
						AutomationProperties.Name="String Lab">
			<ctl:NavTabItem.Header>
				<StackPanel Orientation="Horizontal" Spacing="10">
					<Path Classes="ico" Data="{StaticResource IcoStringLab}"/>
					<TextBlock Classes="navlabel" Text="String Lab"/>
				</StackPanel>
			</ctl:NavTabItem.Header><Decorator/></ctl:NavTabItem>
		<ctl:NavTabItem Classes="navtab" Tag="NOTES" Title="Notes"
						Subtitle="Encrypted notes"
						AutomationProperties.Name="Notes">
			<ctl:NavTabItem.Header>
				<StackPanel Orientation="Horizontal" Spacing="10">
					<Path Classes="ico" Data="{StaticResource IcoNotes}"/>
					<TextBlock Classes="navlabel" Text="Notes"/>
				</StackPanel>
			</ctl:NavTabItem.Header><Decorator/></ctl:NavTabItem>
		<!-- HISTORY + BACKUP share one nav entry with two sub-tabs -->
		<ctl:NavTabItem Classes="navtab" Tag="DATA" Title="History &amp; Backup"
						Subtitle="Recent inputs and encrypted backups"
						AutomationProperties.Name="History and Backup">
			<ctl:NavTabItem.Header>
				<StackPanel Orientation="Horizontal" Spacing="10">
					<Path Classes="ico" Data="{StaticResource IcoBackup}"/>
					<TextBlock Classes="navlabel" Text="History &amp; Backup"/>
				</StackPanel>
			</ctl:NavTabItem.Header>
			<TabControl Padding="0">
				<TabItem Header="History"><Decorator x:Name="HistoryHost"/></TabItem>
				<TabItem Header="Backup"><Decorator x:Name="BackupHost"/></TabItem>
			</TabControl>
		</ctl:NavTabItem>
	</TabControl>
	<!-- the About box, over sidebar and page; height-neutral so the window stays fitted to the nav -->
	<ctl:HeightNeutral>
		<views:AboutView IsVisible="{Binding IsAboutOpen}"/>
	</ctl:HeightNeutral>
	</Panel>
</UserControl>
