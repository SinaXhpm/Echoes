<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Echoes design tokens — v4 (neutral graphite / light grey after modern macOS, with the logo's teal), dark and light.

         ALL COLORS ARE SOLID. No alpha, no translucency, no blur or
         shadows: every surface is a flat fill, so nothing has to be
         alpha-blended or re-composited (cheap on desktop GPUs and on
         phones). Depth comes from stepped surface colors + hairlines.

         Every color lives in the theme dictionaries below (same keys in
         Dark and Light) and views read them with {DynamicResource}, so a
         theme switch (Helpers/ThemeService) re-colors everything live.

         Use these keys instead of hex literals in views:
           surfaces  Bg.App · Bg.Sidebar · Bg.Card · Bg.Raised (dark: lighter = higher;
                     light: cards are white on a grey app) · Bg.Inset (outputs, code, logs)
           borders   Border.Subtle (cards, dividers) · Border.Default (inputs,
                     buttons) · Border.Strong (hover)
           text      Text.Primary · Text.Secondary · Text.Muted · Text.Disabled
           accent    Accent (fills) · Accent.Text (text/icons) ·
                     Accent.Soft (+ Accent.Border) for tinted chips/selection
           status    Success / Warning / Danger / Info / Violet, each with
                     .Soft (tinted solid background) and .Border
           segmented Seg.Track · Seg.Thumb (+ .ThumbBorder) · Seg.Text · Seg.TextSelected
         ============================================================ -->

    <ResourceDictionary.ThemeDictionaries>

        <!-- ======================== DARK ======================== -->
        <ResourceDictionary x:Key="Dark">
            <!-- surfaces -->
            <SolidColorBrush x:Key="Bg.App" Color="#1C1C1E"/>
            <SolidColorBrush x:Key="Bg.Sidebar" Color="#252527"/>
            <SolidColorBrush x:Key="Bg.Card" Color="#2A2A2D"/>
            <SolidColorBrush x:Key="Bg.CardHover" Color="#303033"/>
            <SolidColorBrush x:Key="Bg.Inset" Color="#19191B"/>
            <SolidColorBrush x:Key="Bg.Input" Color="#1F1F22"/>
            <SolidColorBrush x:Key="Bg.InputHover" Color="#232326"/>
            <SolidColorBrush x:Key="Bg.Hover" Color="#303033"/>
            <SolidColorBrush x:Key="Bg.Pressed" Color="#38383B"/>
            <SolidColorBrush x:Key="Bg.Selected" Color="#173431"/>
            <SolidColorBrush x:Key="Bg.SelectedHover" Color="#1B3C38"/>
            <SolidColorBrush x:Key="Bg.Raised" Color="#3A3A3D"/>
            <SolidColorBrush x:Key="Bg.RaisedHover" Color="#444447"/>
            <SolidColorBrush x:Key="Bg.RaisedPressed" Color="#4D4D51"/>
            <SolidColorBrush x:Key="Bg.Overlay" Color="#2C2C2F"/>
            <SolidColorBrush x:Key="Bg.OverlayHover" Color="#3A3A3D"/>

            <!-- borders -->
            <SolidColorBrush x:Key="Border.Subtle" Color="#343437"/>
            <SolidColorBrush x:Key="Border.Default" Color="#424245"/>
            <SolidColorBrush x:Key="Border.Strong" Color="#55555A"/>

            <!-- text -->
            <SolidColorBrush x:Key="Text.Primary" Color="#E8E8ED"/>
            <SolidColorBrush x:Key="Text.Bright" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="Text.Secondary" Color="#AEAEB4"/>
            <SolidColorBrush x:Key="Text.Muted" Color="#8A8A90"/>
            <SolidColorBrush x:Key="Text.Placeholder" Color="#6E6E74"/>
            <SolidColorBrush x:Key="Text.Disabled" Color="#56565B"/>
            <SolidColorBrush x:Key="Text.OnAccent" Color="#FFFFFF"/>
            <!-- selected text (inputs, selectable text): a solid deep teal, not a translucent accent -->
            <SolidColorBrush x:Key="Selection" Color="#24524C"/>
            <SolidColorBrush x:Key="Text.OnAccentDisabled" Color="#8FA9A5"/>
            <SolidColorBrush x:Key="Text.OnDanger" Color="#FFFFFF"/>

            <!-- accent (teal) -->
            <SolidColorBrush x:Key="Accent" Color="#0F8F80"/>
            <SolidColorBrush x:Key="Accent.Hover" Color="#12A08F"/>
            <SolidColorBrush x:Key="Accent.Pressed" Color="#0C7A6D"/>
            <SolidColorBrush x:Key="Accent.Text" Color="#4FD1C5"/>
            <SolidColorBrush x:Key="Accent.Soft" Color="#16302D"/>
            <SolidColorBrush x:Key="Accent.SoftHover" Color="#1A3A36"/>
            <SolidColorBrush x:Key="Accent.Border" Color="#235049"/>
            <SolidColorBrush x:Key="Accent.Disabled" Color="#23403C"/>

            <!-- status -->
            <SolidColorBrush x:Key="Success" Color="#32D74B"/>
            <SolidColorBrush x:Key="Success.Soft" Color="#15301B"/>
            <SolidColorBrush x:Key="Success.Border" Color="#22502C"/>
            <SolidColorBrush x:Key="Warning" Color="#FF9F0A"/>
            <SolidColorBrush x:Key="Warning.Soft" Color="#33250E"/>
            <SolidColorBrush x:Key="Warning.Border" Color="#5E4214"/>
            <SolidColorBrush x:Key="Danger" Color="#FF6961"/>
            <SolidColorBrush x:Key="Danger.Solid" Color="#E0443A"/>
            <SolidColorBrush x:Key="Danger.SolidHover" Color="#EA5147"/>
            <SolidColorBrush x:Key="Danger.SolidPressed" Color="#C83A31"/>
            <SolidColorBrush x:Key="Danger.Soft" Color="#361C1A"/>
            <SolidColorBrush x:Key="Danger.Border" Color="#5C2A26"/>
            <SolidColorBrush x:Key="Info" Color="#409CFF"/>
            <SolidColorBrush x:Key="Info.Soft" Color="#142A42"/>
            <SolidColorBrush x:Key="Info.Border" Color="#1F4369"/>
            <SolidColorBrush x:Key="Violet" Color="#BF7BFF"/>
            <SolidColorBrush x:Key="Violet.Soft" Color="#2A1D3A"/>
            <SolidColorBrush x:Key="Violet.Border" Color="#48316A"/>

            <!-- segmented control (TabControl.seg): a track with a raised thumb under the chosen segment -->
            <SolidColorBrush x:Key="Seg.Track" Color="#333336"/>
            <SolidColorBrush x:Key="Seg.Thumb" Color="#5A5A5E"/>
            <SolidColorBrush x:Key="Seg.ThumbBorder" Color="#5A5A5E"/>
            <SolidColorBrush x:Key="Seg.Text" Color="#AEAEB4"/>
            <SolidColorBrush x:Key="Seg.TextSelected" Color="#FFFFFF"/>

            <!-- sidebar rows on hover (the sidebar is greyer than the page, so the page hover would vanish on it) -->
            <SolidColorBrush x:Key="Nav.Hover" Color="#303033"/>

            <!-- quiet push button (Button.ghost): a soft grey bezel without a border, quieter than .secondary -->
            <SolidColorBrush x:Key="Btn.Quiet" Color="#343437"/>
            <SolidColorBrush x:Key="Btn.QuietHover" Color="#3E3E41"/>
            <SolidColorBrush x:Key="Btn.QuietPressed" Color="#48484B"/>

            <!-- the theme switch shows where it leads: a sun in the dark theme -->
            <StreamGeometry x:Key="IcoThemeToggle">M12 8 A4 4 0 1 0 12 16 A4 4 0 1 0 12 8 Z M12 2.5 V4.5 M12 19.5 V21.5 M2.5 12 H4.5 M19.5 12 H21.5 M5.3 5.3 L6.7 6.7 M17.3 17.3 L18.7 18.7 M5.3 18.7 L6.7 17.3 M17.3 6.7 L18.7 5.3</StreamGeometry>
            <x:String x:Key="Theme.ToggleTip">Switch to the light theme</x:String>
            <x:String x:Key="Theme.ToggleLabel">Light theme</x:String>

            <!-- ===== Fluent overrides (Fluent derives many of these with alpha; pinned to solid colors) ===== -->
            <!-- text inputs (TextBox, AutoCompleteBox, NumericUpDown) -->
            <SolidColorBrush x:Key="TextControlBackground" Color="#1F1F22"/>
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#232326"/>
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1F1F22"/>
            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#1B1B1D"/>
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#424245"/>
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#55555A"/>
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#0F8F80"/>
            <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#343437"/>
            <SolidColorBrush x:Key="TextControlForeground" Color="#E8E8ED"/>
            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#E8E8ED"/>
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#E8E8ED"/>
            <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#56565B"/>
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#6E6E74"/>
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#6E6E74"/>
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#6E6E74"/>
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="#47474B"/>
            <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#24524C"/>
            <SolidColorBrush x:Key="TextControlButtonForeground" Color="#AEAEB4"/>
            <SolidColorBrush x:Key="TextControlButtonForegroundPointerOver" Color="#E8E8ED"/>
            <SolidColorBrush x:Key="TextControlButtonBackgroundPointerOver" Color="#3A3A3D"/>
            <SolidColorBrush x:Key="TextControlButtonBackgroundPressed" Color="#444447"/>

            <!-- buttons (default / unstyled) -->
            <SolidColorBrush x:Key="ButtonBackground" Color="#3A3A3D"/>
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#444447"/>
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#4D4D51"/>
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#262628"/>
            <SolidColorBrush x:Key="ButtonForeground" Color="#E8E8ED"/>
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#E8E8ED"/>
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#56565B"/>
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#424245"/>
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#55555A"/>
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#55555A"/>
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#343437"/>

            <!-- combo boxes -->
            <SolidColorBrush x:Key="ComboBoxBackground" Color="#1F1F22"/>
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#232326"/>
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#38383B"/>
            <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#1B1B1D"/>
            <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="#1F1F22"/>
            <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="#0F8F80"/>
            <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushUnfocused" Color="#424245"/>
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#424245"/>
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#55555A"/>
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#0F8F80"/>
            <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#343437"/>
            <SolidColorBrush x:Key="ComboBoxForeground" Color="#E8E8ED"/>
            <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#56565B"/>
            <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="#E8E8ED"/>
            <SolidColorBrush x:Key="ComboBoxForegroundFocusedPressed" Color="#E8E8ED"/>
            <SolidColorBrush x:Key="ComboBoxPlaceHolderForeground" Color="#6E6E74"/>
            <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundFocusedPressed" Color="#6E6E74"/>
            <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#AEAEB4"/>
            <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocused" Color="#E8E8ED"/>
            <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocusedPressed" Color="#E8E8ED"/>
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#2C2C2F"/>
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#424245"/>
            <SolidColorBrush x:Key="ComboBoxItemBackground" Color="#2C2C2F"/>
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#3A3A3D"/>
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#444447"/>
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#173431"/>
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#1B3C38"/>
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#1F443F"/>
            <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#E8E8ED"/>
            <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#4FD1C5"/>
            <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="#4FD1C5"/>
            <SolidColorBrush x:Key="AutoCompleteBoxSuggestionsListBackground" Color="#2C2C2F"/>
            <SolidColorBrush x:Key="AutoCompleteBoxSuggestionsListBorderBrush" Color="#424245"/>

            <!-- lists: hover / selection (Fluent derives these from the accent WITH alpha) -->
            <SolidColorBrush x:Key="SystemControlHighlightListLowBrush" Color="#303033"/>
            <SolidColorBrush x:Key="SystemControlHighlightListMediumBrush" Color="#38383B"/>
            <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="#173431"/>
            <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="#1B3C38"/>
            <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="#1F443F"/>
            <SolidColorBrush x:Key="SystemControlTransientBackgroundBrush" Color="#2C2C2F"/>
            <SolidColorBrush x:Key="SystemControlTransientBorderBrush" Color="#424245"/>

            <!-- tooltips, flyouts, menus -->
            <SolidColorBrush x:Key="ToolTipBackground" Color="#2C2C2F"/>
            <SolidColorBrush x:Key="ToolTipForeground" Color="#E8E8ED"/>
            <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#424245"/>
            <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#2C2C2F"/>
            <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="#424245"/>
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#2C2C2F"/>
            <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#424245"/>
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#3A3A3D"/>
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#444447"/>
            <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="#E8E8ED"/>
            <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="#FFFFFF"/>

            <!-- check boxes / radios / toggles: accent fill with a dark glyph (contrast on teal) -->
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="#1F1F22"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="#232326"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPressed" Color="#38383B"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="#55555A"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="#67676C"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed" Color="#67676C"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#0F8F80"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#12A08F"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#0C7A6D"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#12A08F"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#0C7A6D"/>
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="CheckBoxForegroundUnchecked" Color="#E8E8ED"/>
            <SolidColorBrush x:Key="CheckBoxForegroundUncheckedPointerOver" Color="#E8E8ED"/>
            <SolidColorBrush x:Key="CheckBoxForegroundChecked" Color="#E8E8ED"/>
            <SolidColorBrush x:Key="CheckBoxForegroundCheckedPointerOver" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="RadioButtonOuterEllipseStroke" Color="#55555A"/>
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="#0F8F80"/>
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="#0F8F80"/>
            <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#0F8F80"/>
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#12A08F"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#48484B"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#48484B"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#E8E8ED"/>

            <!-- tabs (inner tool tabs; the main nav has its own template) -->
            <SolidColorBrush x:Key="TabItemHeaderForegroundUnselected" Color="#AEAEB4"/>
            <SolidColorBrush x:Key="TabItemHeaderForegroundUnselectedPointerOver" Color="#E8E8ED"/>
            <SolidColorBrush x:Key="TabItemHeaderForegroundUnselectedPressed" Color="#E8E8ED"/>
            <SolidColorBrush x:Key="TabItemHeaderForegroundSelected" Color="#E8E8ED"/>
            <SolidColorBrush x:Key="TabItemHeaderForegroundSelectedPointerOver" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TabItemHeaderForegroundSelectedPressed" Color="#E8E8ED"/>
            <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="#0F8F80"/>

            <!-- scroll bars: slim solid thumb -->
            <Color x:Key="ScrollBarThumbBackgroundColor">#48484C</Color>
            <Color x:Key="ScrollBarPanningThumbBackgroundColor">#5A5A5F</Color>
            <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#5A5A5F"/>
            <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#6A6A70"/>

            <!-- sliders / progress (accent) -->
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#0F8F80"/>
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#12A08F"/>
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#0F8F80"/>
            <SolidColorBrush x:Key="SliderTrackFill" Color="#424245"/>
        </ResourceDictionary>

        <!-- ======================== LIGHT ======================== -->
        <!-- White cards on a cool grey app, slate text, and a deeper teal (#0F766E) so white text on accent
             buttons and teal text on white both stay readable (contrast > 5:1). -->
        <ResourceDictionary x:Key="Light">
            <!-- surfaces -->
            <SolidColorBrush x:Key="Bg.App" Color="#F5F5F7"/>
            <SolidColorBrush x:Key="Bg.Sidebar" Color="#EAEAEE"/>
            <SolidColorBrush x:Key="Bg.Card" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="Bg.CardHover" Color="#F9F9FB"/>
            <SolidColorBrush x:Key="Bg.Inset" Color="#F4F4F6"/>
            <SolidColorBrush x:Key="Bg.Input" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="Bg.InputHover" Color="#FBFBFC"/>
            <SolidColorBrush x:Key="Bg.Hover" Color="#EDEDF0"/>
            <SolidColorBrush x:Key="Bg.Pressed" Color="#E2E2E7"/>
            <SolidColorBrush x:Key="Bg.Selected" Color="#DDF1EE"/>
            <SolidColorBrush x:Key="Bg.SelectedHover" Color="#D0EBE7"/>
            <SolidColorBrush x:Key="Bg.Raised" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="Bg.RaisedHover" Color="#F4F4F6"/>
            <SolidColorBrush x:Key="Bg.RaisedPressed" Color="#E8E8EC"/>
            <SolidColorBrush x:Key="Bg.Overlay" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="Bg.OverlayHover" Color="#EFEFF2"/>

            <!-- borders -->
            <SolidColorBrush x:Key="Border.Subtle" Color="#E3E3E8"/>
            <SolidColorBrush x:Key="Border.Default" Color="#D2D2D7"/>
            <SolidColorBrush x:Key="Border.Strong" Color="#B9B9BF"/>

            <!-- text -->
            <SolidColorBrush x:Key="Text.Primary" Color="#1D1D1F"/>
            <SolidColorBrush x:Key="Text.Bright" Color="#000000"/>
            <SolidColorBrush x:Key="Text.Secondary" Color="#4A4A4F"/>
            <SolidColorBrush x:Key="Text.Muted" Color="#6E6E73"/>
            <SolidColorBrush x:Key="Text.Placeholder" Color="#A1A1A6"/>
            <SolidColorBrush x:Key="Text.Disabled" Color="#B8B8BD"/>
            <SolidColorBrush x:Key="Text.OnAccent" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="Selection" Color="#BDE5DF"/>
            <SolidColorBrush x:Key="Text.OnAccentDisabled" Color="#F0F8F7"/>
            <SolidColorBrush x:Key="Text.OnDanger" Color="#FFFFFF"/>

            <!-- accent (deep teal) -->
            <SolidColorBrush x:Key="Accent" Color="#0E7C72"/>
            <SolidColorBrush x:Key="Accent.Hover" Color="#0B6C63"/>
            <SolidColorBrush x:Key="Accent.Pressed" Color="#095C55"/>
            <SolidColorBrush x:Key="Accent.Text" Color="#0B6F66"/>
            <SolidColorBrush x:Key="Accent.Soft" Color="#E2F3F0"/>
            <SolidColorBrush x:Key="Accent.SoftHover" Color="#D3ECE8"/>
            <SolidColorBrush x:Key="Accent.Border" Color="#A6D9D1"/>
            <SolidColorBrush x:Key="Accent.Disabled" Color="#B6DCD7"/>

            <!-- status -->
            <SolidColorBrush x:Key="Success" Color="#1D8A3A"/>
            <SolidColorBrush x:Key="Success.Soft" Color="#E5F4E9"/>
            <SolidColorBrush x:Key="Success.Border" Color="#B3DDBF"/>
            <SolidColorBrush x:Key="Warning" Color="#B25800"/>
            <SolidColorBrush x:Key="Warning.Soft" Color="#FDF1DE"/>
            <SolidColorBrush x:Key="Warning.Border" Color="#F2CF96"/>
            <SolidColorBrush x:Key="Danger" Color="#D1291F"/>
            <SolidColorBrush x:Key="Danger.Solid" Color="#D9342A"/>
            <SolidColorBrush x:Key="Danger.SolidHover" Color="#C02B22"/>
            <SolidColorBrush x:Key="Danger.SolidPressed" Color="#A3231C"/>
            <SolidColorBrush x:Key="Danger.Soft" Color="#FCE9E7"/>
            <SolidColorBrush x:Key="Danger.Border" Color="#F2B8B3"/>
            <SolidColorBrush x:Key="Info" Color="#0064D1"/>
            <SolidColorBrush x:Key="Info.Soft" Color="#E6F0FB"/>
            <SolidColorBrush x:Key="Info.Border" Color="#B2D1F2"/>
            <SolidColorBrush x:Key="Violet" Color="#8338C8"/>
            <SolidColorBrush x:Key="Violet.Soft" Color="#F3EBFB"/>
            <SolidColorBrush x:Key="Violet.Border" Color="#DAC4F0"/>

            <!-- segmented control (TabControl.seg): a track with a raised thumb under the chosen segment -->
            <SolidColorBrush x:Key="Seg.Track" Color="#E3E3E8"/>
            <SolidColorBrush x:Key="Seg.Thumb" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="Seg.ThumbBorder" Color="#D2D2D7"/>
            <SolidColorBrush x:Key="Seg.Text" Color="#4A4A4F"/>
            <SolidColorBrush x:Key="Seg.TextSelected" Color="#1D1D1F"/>

            <!-- sidebar rows on hover (the sidebar is greyer than the page, so the page hover would vanish on it) -->
            <SolidColorBrush x:Key="Nav.Hover" Color="#DCDCE1"/>

            <!-- quiet push button (Button.ghost): a soft grey bezel without a border, quieter than .secondary -->
            <SolidColorBrush x:Key="Btn.Quiet" Color="#EBEBEF"/>
            <SolidColorBrush x:Key="Btn.QuietHover" Color="#E1E1E6"/>
            <SolidColorBrush x:Key="Btn.QuietPressed" Color="#D6D6DC"/>

            <!-- the theme switch shows where it leads: a moon in the light theme -->
            <StreamGeometry x:Key="IcoThemeToggle">M20 14.5 A8.5 8.5 0 1 1 9.5 4 A6.8 6.8 0 0 0 20 14.5 Z</StreamGeometry>
            <x:String x:Key="Theme.ToggleTip">Switch to the dark theme</x:String>
            <x:String x:Key="Theme.ToggleLabel">Dark theme</x:String>

            <!-- ===== Fluent overrides ===== -->
            <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FBFBFC"/>
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#F4F4F6"/>
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#D2D2D7"/>
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#B9B9BF"/>
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#0E7C72"/>
            <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#E3E3E8"/>
            <SolidColorBrush x:Key="TextControlForeground" Color="#1D1D1F"/>
            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#1D1D1F"/>
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#1D1D1F"/>
            <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#B8B8BD"/>
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#A1A1A6"/>
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#A1A1A6"/>
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#A1A1A6"/>
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="#C8C8CD"/>
            <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#BDE5DF"/>
            <SolidColorBrush x:Key="TextControlButtonForeground" Color="#4A4A4F"/>
            <SolidColorBrush x:Key="TextControlButtonForegroundPointerOver" Color="#1D1D1F"/>
            <SolidColorBrush x:Key="TextControlButtonBackgroundPointerOver" Color="#EFEFF2"/>
            <SolidColorBrush x:Key="TextControlButtonBackgroundPressed" Color="#E4E4E9"/>

            <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F4F4F6"/>
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#E8E8EC"/>
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#F4F4F6"/>
            <SolidColorBrush x:Key="ButtonForeground" Color="#1D1D1F"/>
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#000000"/>
