<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Echoes"
             x:Class="Echoes.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Per-tool glyphs shared by the desktop tab rail and the mobile drawer. -->
        <ResourceInclude Source="avares://Echoes/Assets/ToolIcons.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Padding" Value="15,5"/>
    </Style>
    <StyleInclude Source="avares://Echoes/Styles/AppStyles.axaml"/>
  </Application.Styles>
</Application>