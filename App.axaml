<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Echoes"
             x:Class="Echoes.App"
             Name="Echoes"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Design tokens (solid palette, radii, type scale) + solid overrides for Fluent's own brushes. -->
        <ResourceInclude Source="avares://Echoes/Styles/Tokens.axaml"/>
        <!-- Per-tool glyphs shared by the desktop tabs / launcher and the mobile drawer. -->
        <ResourceInclude Source="avares://Echoes/Assets/ToolIcons.axaml"/>
      </ResourceDictionary.MergedDictionaries>
      <!-- Monospace for aligned output (reports, tables, hex, JSON). Cascadia/Consolas only exist on
           Windows; without the rest of this chain Linux / macOS / Android fell back to a proportional
           font and every column-aligned report came out ragged. "monospace" is the fontconfig /
           Android alias, the last resort. -->
      <FontFamily x:Key="MonoFont">Cascadia Code,Consolas,Menlo,DejaVu Sans Mono,Liberation Mono,Noto Sans Mono,monospace</FontFamily>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <!-- A fully SOLID palette: Fluent normally builds its hover / pressed / selection / border colors
           with alpha; with solid inputs everything it derives stays a flat fill: near-black zinc / light zinc
           with the blue accent, as in Styles/Tokens.axaml. -->
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark"
                               Accent="#3B82F6"
                               RegionColor="#0A0A0C"
                               AltHigh="#0A0A0C" AltMediumHigh="#0E0E10" AltMedium="#121214" AltMediumLow="#141417" AltLow="#1A1A1E"
                               BaseHigh="#E4E4E7" BaseMediumHigh="#D4D4D8" BaseMedium="#A1A1AA" BaseMediumLow="#7A7A83" BaseLow="#2A2A2F"
                               ChromeAltLow="#D4D4D8" ChromeBlackHigh="#000000" ChromeBlackLow="#0C0C0E" ChromeBlackMedium="#0A0A0C"
                               ChromeBlackMediumLow="#0E0E10" ChromeDisabledHigh="#2A2A2F" ChromeDisabledLow="#7A7A83" ChromeGray="#8B8B94"
                               ChromeHigh="#3F3F46" ChromeLow="#121214" ChromeMedium="#141417" ChromeMediumLow="#1F1F23" ChromeWhite="#FFFFFF"
                               ErrorText="#F87171" ListLow="#1A1A1E" ListMedium="#222227"/>
        <!-- light: solid stand-ins for Fluent's light defaults (which are black/white WITH alpha) -->
        <ColorPaletteResources x:Key="Light"
                               Accent="#2563EB"
                               RegionColor="#F4F4F5"
                               AltHigh="#FFFFFF" AltMediumHigh="#FCFCFC" AltMedium="#FAFAFA" AltMediumLow="#F4F4F5" AltLow="#EDEDEF"
                               BaseHigh="#18181B" BaseMediumHigh="#3F3F46" BaseMedium="#52525B" BaseMediumLow="#71717A" BaseLow="#D4D4D8"
                               ChromeAltLow="#27272A" ChromeBlackHigh="#000000" ChromeBlackLow="#D4D4D8" ChromeBlackMedium="#52525B"
                               ChromeBlackMediumLow="#71717A" ChromeDisabledHigh="#D4D4D8" ChromeDisabledLow="#71717A" ChromeGray="#71717A"
                               ChromeHigh="#D4D4D8" ChromeLow="#F4F4F5" ChromeMedium="#EDEDEF" ChromeMediumLow="#F4F4F5" ChromeWhite="#FFFFFF"
                               ErrorText="#DC2626" ListLow="#EDEDEF" ListMedium="#E4E4E7"/>
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Echoes/Styles/AppStyles.axaml"/>
  </Application.Styles>
</Application>
