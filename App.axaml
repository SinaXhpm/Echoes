<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Echoes"
             x:Class="Echoes.App"
             Name="Echoes"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Design tokens (solid palette, radii, type scale) + solid overrides for Fluent's own brushes. -->
        <ResourceInclude Source="avares://Echoes/Styles/Tokens.axaml"/>
        <!-- Per-tool glyphs shared by the desktop sidebar and the mobile drawer. -->
        <ResourceInclude Source="avares://Echoes/Assets/ToolIcons.axaml"/>
      </ResourceDictionary.MergedDictionaries>
      <!-- Monospace for aligned output (reports, tables, hex, JSON). Cascadia/Consolas only exist on
           Windows; without the rest of this chain Linux / macOS / Android fell back to a proportional
           font and every column-aligned report came out ragged. "monospace" is the fontconfig /
           Android alias, the last resort. -->
      <FontFamily x:Key="MonoFont">Cascadia Code,Consolas,Menlo,DejaVu Sans Mono,Liberation Mono,Noto Sans Mono,monospace</FontFamily>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <!-- A fully SOLID palette: Fluent normally builds its hover / pressed / selection / border colors
           with alpha; with solid inputs everything it derives stays a flat fill: neutral graphite / light grey
           with the brand teal, as in Styles/Tokens.axaml. -->
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark"
                               Accent="#0F8F80"
                               RegionColor="#1C1C1E"
                               AltHigh="#1C1C1E" AltMediumHigh="#212123" AltMedium="#2A2A2D" AltMediumLow="#2C2C2F" AltLow="#303033"
                               BaseHigh="#E8E8ED" BaseMediumHigh="#C9C9CE" BaseMedium="#AEAEB4" BaseMediumLow="#8A8A90" BaseLow="#424245"
                               ChromeAltLow="#C9C9CE" ChromeBlackHigh="#000000" ChromeBlackLow="#19191B" ChromeBlackMedium="#1C1C1E"
                               ChromeBlackMediumLow="#212123" ChromeDisabledHigh="#424245" ChromeDisabledLow="#8A8A90" ChromeGray="#98989E"
                               ChromeHigh="#55555A" ChromeLow="#2A2A2D" ChromeMedium="#2C2C2F" ChromeMediumLow="#3A3A3D" ChromeWhite="#FFFFFF"
                               ErrorText="#FF6961" ListLow="#303033" ListMedium="#38383B"/>
        <!-- light: solid stand-ins for Fluent's light defaults (which are black/white WITH alpha) -->
        <ColorPaletteResources x:Key="Light"
                               Accent="#0E7C72"
                               RegionColor="#F5F5F7"
                               AltHigh="#FFFFFF" AltMediumHigh="#FBFBFC" AltMedium="#F9F9FB" AltMediumLow="#F4F4F6" AltLow="#EFEFF2"
                               BaseHigh="#1D1D1F" BaseMediumHigh="#3A3A3E" BaseMedium="#5E5E63" BaseMediumLow="#8E8E93" BaseLow="#D2D2D7"
                               ChromeAltLow="#2C2C2E" ChromeBlackHigh="#000000" ChromeBlackLow="#D2D2D7" ChromeBlackMedium="#5E5E63"
                               ChromeBlackMediumLow="#8E8E93" ChromeDisabledHigh="#D2D2D7" ChromeDisabledLow="#8E8E93" ChromeGray="#6E6E73"
                               ChromeHigh="#D2D2D7" ChromeLow="#F4F4F6" ChromeMedium="#EDEDF0" ChromeMediumLow="#F4F4F6" ChromeWhite="#FFFFFF"
                               ErrorText="#D1291F" ListLow="#EFEFF2" ListMedium="#E3E3E8"/>
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Echoes/Styles/AppStyles.axaml"/>
  </Application.Styles>
</Application>
